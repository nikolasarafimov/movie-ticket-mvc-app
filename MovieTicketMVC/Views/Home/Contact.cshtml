@{
    ViewBag.Title = "Контакт";

    var isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;

    var isAdmin = isAuthenticated && User.IsInRole("Admin");

    var contactEmail = "info@movieticketapp.com";
    var contactPhone = "+389 70 123 456";
    var contactEmailUrl = "mailto:" + contactEmail;
    var contactPhoneUrl = "tel:+38970123456";

    var currentMoviesUrl = Url.Action("Current", "Movies");
    var ticketsUrl = Url.Action("Index", "Tickets");
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = ticketsUrl });
}

<div class="contact-page" aria-labelledby="contact-title">

    <section class="contact-hero" aria-labelledby="contact-title">
        <div class="contact-hero-glow contact-hero-glow-one" aria-hidden="true"></div>
        <div class="contact-hero-glow contact-hero-glow-two" aria-hidden="true"></div>

        <div class="contact-hero-content">
            <div class="cinema-eyebrow">КОНТАКТ И ПОДДРШКА</div>

            <h1 id="contact-title">
                Како можеме да
                <span class="cinema-text-gradient">помогнеме?</span>
            </h1>

            <p>
                Имаш прашање за резервација, билет или користењето на MovieTicket?
                Контактирај нè преку е-пошта или телефон.
            </p>

            <div class="contact-hero-actions">
                <a class="btn btn-primary contact-primary-action"
                   href="@contactEmailUrl"
                   aria-label="Испрати е-пошта на @contactEmail">
                    <span>Испрати порака</span>
                    <span aria-hidden="true">→</span>
                </a>

                <a class="btn btn-outline-secondary" href="@currentMoviesUrl">
                    Прегледај филмови
                </a>
            </div>
        </div>

        <div class="contact-hero-art" aria-hidden="true">
            <div class="contact-orbit contact-orbit-large"></div>
            <div class="contact-orbit contact-orbit-small"></div>

            <div class="contact-message-art">
                <div class="contact-message-art-line"></div>
                <div class="contact-message-art-line short"></div>
                <div class="contact-message-art-line medium"></div>
                <span>&#64;</span>
            </div>
        </div>
    </section>

    <section class="contact-section" aria-labelledby="contact-information-title">
        <div class="contact-section-heading">
            <div>
                <div class="cinema-eyebrow">СТАПИ ВО КОНТАКТ</div>
                <h2 id="contact-information-title">Контакт информации</h2>
            </div>

            <p>Избери го начинот што најмногу ти одговара.</p>
        </div>

        <div class="contact-grid">
            <article class="contact-card">
                <div class="contact-card-top">
                    <div class="contact-card-icon" aria-hidden="true">&#64;</div>
                    <span class="contact-card-number">01</span>
                </div>

                <div class="contact-card-content">
                    <span>Е-ПОШТА</span>
                    <h3>Пиши ни</h3>
                    <p>
                        За прашања поврзани со билети, резервации
                        или твојот MovieTicket профил.
                    </p>
                </div>

                <a class="contact-card-link"
                   href="@contactEmailUrl"
                   aria-label="Испрати е-пошта на @contactEmail">
                    <span>@contactEmail</span>
                    <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="contact-card">
                <div class="contact-card-top">
                    <div class="contact-card-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 11.2 18a19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 1.3 3.2 2 2 0 0 1 3.3 1h3a2 2 0 0 1 2 1.7c.12.97.35 1.91.68 2.82a2 2 0 0 1-.45 2.11L7.3 8.9a16 16 0 0 0 7.8 7.8l1.28-1.23a2 2 0 0 1 2.12-.45c.9.33 1.84.56 2.81.68a2 2 0 0 1 1.69 2Z" transform="translate(0 0) scale(.95)" />
                        </svg>
                    </div>
                    <span class="contact-card-number">02</span>
                </div>

                <div class="contact-card-content">
                    <span>ТЕЛЕФОН</span>
                    <h3>Јави ни се</h3>
                    <p>
                        Контактирај нè директно доколку ти е потребна
                        помош при користењето на платформата.
                    </p>
                </div>

                <a class="contact-card-link"
                   href="@contactPhoneUrl"
                   aria-label="Јави се на @contactPhone">
                    <span>@contactPhone</span>
                    <span aria-hidden="true">→</span>
                </a>
            </article>
        </div>
    </section>

    <section class="contact-support-panel" aria-labelledby="contact-support-title">
        <div class="contact-support-copy">
            <div class="contact-support-icon" aria-hidden="true">
                <span>?</span>
            </div>

            <div>
                <span class="contact-support-label">ПРЕД ДА НÈ КОНТАКТИРАШ</span>
                <h2 id="contact-support-title">Провери ги деталите за билетот</h2>
                <p>
                    Ако прашањето се однесува на резервација, деталите за филмот,
                    датумот, терминот и седиштата можеш да ги најдеш во делот со билети.
                </p>
            </div>
        </div>

        @if (isAuthenticated)
        {
            <a class="btn btn-outline-secondary" href="@ticketsUrl">
                @(isAdmin ? "Сите билети" : "Мои билети")
            </a>
        }
        else
        {
            <a class="btn btn-outline-secondary" href="@loginUrl">
                Најави се
            </a>
        }
    </section>

    <section class="contact-bottom" aria-labelledby="contact-bottom-title">
        <div>
            <div class="cinema-eyebrow">ПОДГОТВЕН ЗА СЛЕДНИОТ ФИЛМ?</div>
            <h2 id="contact-bottom-title">Назад кон големото платно.</h2>
            <p>Прегледај ги актуелните филмови и избери го следниот термин.</p>
        </div>

        <a class="btn btn-primary" href="@currentMoviesUrl">
            <span>Актуелни филмови</span>
            <span aria-hidden="true">→</span>
        </a>
    </section>
</div>

<style>
    .contact-page {
        width: 100%;
        min-width: 0;
    }

    .contact-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 310px);
        align-items: center;
        gap: 2rem;
        min-height: 440px;
        padding: clamp(2rem, 6vw, 4.5rem);
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient(circle at 82% 25%, rgba(214, 168, 75, 0.12), transparent 28%), radial-gradient(circle at 0% 100%, rgba(58, 101, 169, 0.14), transparent 32%), linear-gradient(145deg, #151e2b, #090e16 58%, #06090e);
        box-shadow: var(--cinema-shadow-lg);
        isolation: isolate;
    }

        .contact-hero::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.24;
            background-image: linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: linear-gradient(90deg, #000, transparent);
            -webkit-mask-image: linear-gradient(90deg, #000, transparent);
            pointer-events: none;
        }

    .contact-hero-glow {
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(25px);
        pointer-events: none;
    }

    .contact-hero-glow-one {
        top: -170px;
        right: -110px;
        width: 440px;
        height: 440px;
        background: rgba(214, 168, 75, 0.065);
    }

    .contact-hero-glow-two {
        bottom: -180px;
        left: -100px;
        width: 420px;
        height: 420px;
        background: rgba(58, 101, 169, 0.07);
    }

    .contact-hero-content {
        position: relative;
        z-index: 3;
        min-width: 0;
        max-width: 760px;
    }

    .contact-hero h1 {
        max-width: 720px;
        margin-bottom: 1.3rem;
        font-size: clamp(2.8rem, 6vw, 5.4rem);
        line-height: 1.04;
        letter-spacing: -0.055em;
        overflow-wrap: break-word;
    }

    .contact-hero-content > p {
        max-width: 600px;
        margin: 0;
        color: #c9d0dc;
        font-size: 1rem;
        line-height: 1.8;
    }

    .contact-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

        .contact-hero-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
        }

    .contact-primary-action {
        justify-content: space-between !important;
        gap: 1rem;
        min-width: 190px;
    }

        .contact-primary-action > span:last-child,
        .contact-bottom > .btn > span:last-child,
        .contact-card-link > span:last-child {
            transition: transform var(--cinema-transition);
        }

        .contact-primary-action:hover > span:last-child,
        .contact-bottom > .btn:hover > span:last-child,
        .contact-card-link:hover > span:last-child {
            transform: translateX(4px);
        }

    .contact-hero-art {
        position: relative;
        display: grid;
        place-items: center;
        width: min(100%, 280px);
        height: 280px;
        margin-inline: auto;
        pointer-events: none;
    }

    .contact-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: contact-orbit-spin 26s linear infinite;
    }

        .contact-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.68);
        }

    .contact-orbit-large {
        width: 255px;
        height: 255px;
    }

    .contact-orbit-small {
        width: 180px;
        height: 180px;
        animation-direction: reverse;
        animation-duration: 18s;
    }

    .contact-message-art {
        position: relative;
        z-index: 4;
        width: 145px;
        height: 112px;
        padding: 1.5rem 1.25rem;
        border: 1px solid rgba(214, 168, 75, 0.27);
        border-radius: 22px 22px 22px 7px;
        background: linear-gradient(145deg, rgba(31, 41, 56, 0.88), rgba(10, 14, 21, 0.97));
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35), 0 0 45px rgba(214, 168, 75, 0.06);
        transform: rotate(-3deg);
        animation: contact-message-float 6s ease-in-out infinite;
    }

        .contact-message-art > span {
            position: absolute;
            right: 16px;
            bottom: 12px;
            color: var(--cinema-gold-light);
            font-size: 0.72rem;
            font-weight: 900;
        }

    .contact-message-art-line {
        width: 100%;
        height: 5px;
        margin-bottom: 9px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.17);
    }

        .contact-message-art-line.short {
            width: 58%;
        }

        .contact-message-art-line.medium {
            width: 78%;
        }

    .contact-section {
        margin-top: clamp(3.5rem, 6vw, 5rem);
    }

    .contact-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .contact-section-heading h2 {
            margin: 0;
            font-size: clamp(1.9rem, 4vw, 2.6rem);
        }

        .contact-section-heading > p {
            margin: 0 0 0.25rem;
            color: #9da7b8;
            font-size: 0.86rem;
        }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .contact-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 310px;
        padding: clamp(1.5rem, 3vw, 2rem);
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: radial-gradient(circle at 100% 0%, rgba(214, 168, 75, 0.045), transparent 34%), linear-gradient(145deg, rgba(20, 27, 39, 0.9), rgba(9, 13, 20, 0.96));
        box-shadow: var(--cinema-shadow-sm);
        transition: transform var(--cinema-transition), border-color var(--cinema-transition), box-shadow var(--cinema-transition);
    }

        .contact-card:hover {
            border-color: rgba(214, 168, 75, 0.28);
            box-shadow: var(--cinema-shadow-lg);
            transform: translateY(-4px);
        }

    .contact-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .contact-card-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.2);
        border-radius: 15px;
        background: rgba(214, 168, 75, 0.055);
        font-size: 1.1rem;
        font-weight: 800;
    }

    .contact-card-number {
        color: #9da7b8;
        font-size: 0.67rem;
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    .contact-card-content {
        padding: 2rem 0 1.6rem;
    }

        .contact-card-content > span {
            display: block;
            margin-bottom: 0.55rem;
            color: var(--cinema-gold-light);
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.1em;
        }

        .contact-card-content h3 {
            margin-bottom: 0.7rem;
            color: var(--cinema-text);
            font-size: 1.5rem;
        }

        .contact-card-content p {
            max-width: 490px;
            margin: 0;
            color: #aeb7c5;
            font-size: 0.88rem;
            line-height: 1.7;
        }

    .contact-card-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1.15rem;
        color: #dde2eb;
        border-top: 1px solid var(--cinema-border);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        overflow-wrap: anywhere;
    }

        .contact-card-link > span:first-child {
            min-width: 0;
        }

        .contact-card-link > span:last-child {
            flex: 0 0 auto;
            color: var(--cinema-gold-light);
        }

        .contact-card-link:hover,
        .contact-card-link:focus-visible {
            color: var(--cinema-gold-light);
        }

    .contact-support-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin-top: 1rem;
        padding: 1.4rem 1.5rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: rgba(255, 255, 255, 0.02);
    }

    .contact-support-copy {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        min-width: 0;
    }

    .contact-support-icon {
        display: grid;
        flex: 0 0 44px;
        place-items: center;
        width: 44px;
        height: 44px;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.18);
        border-radius: 13px;
        background: rgba(214, 168, 75, 0.055);
    }

        .contact-support-icon > span {
            display: grid;
            place-items: center;
            width: 23px;
            height: 23px;
            border: 1px solid rgba(214, 168, 75, 0.23);
            border-radius: 50%;
            font-size: 0.78rem;
            font-weight: 900;
        }

    .contact-support-label {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--cinema-gold-light);
        font-size: 0.67rem;
        font-weight: 800;
        letter-spacing: 0.07em;
    }

    .contact-support-copy h2 {
        margin: 0 0 0.4rem;
        color: var(--cinema-text);
        font-size: 1.07rem;
    }

    .contact-support-copy p {
        max-width: 740px;
        margin: 0;
        color: #aeb7c5;
        font-size: 0.82rem;
        line-height: 1.7;
    }

    .contact-support-panel > .btn {
        flex: 0 0 auto;
    }

    .contact-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin-top: clamp(3.5rem, 6vw, 5rem);
        padding: clamp(2rem, 5vw, 3.5rem);
        border: 1px solid rgba(214, 168, 75, 0.14);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient(circle at 100% 50%, rgba(214, 168, 75, 0.07), transparent 30%), linear-gradient(145deg, rgba(20, 27, 39, 0.9), rgba(9, 13, 20, 0.96));
    }

        .contact-bottom h2 {
            margin-bottom: 0.7rem;
            font-size: clamp(1.8rem, 4vw, 2.6rem);
        }

        .contact-bottom p {
            max-width: 560px;
            margin: 0;
            color: #aeb7c5;
            font-size: 0.86rem;
            line-height: 1.7;
        }

        .contact-bottom > .btn {
            display: inline-flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            min-width: 205px;
        }

    .contact-page a:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 4px;
    }

    @@keyframes contact-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes contact-message-float {
        0%, 100% {
            transform: rotate(-3deg) translateY(0);
        }

        50% {
            transform: rotate(-1deg) translateY(-10px);
        }
    }

    @@media (max-width: 991.98px) {
        .contact-hero {
            grid-template-columns: minmax(0, 1fr);
            min-height: 0;
        }

        .contact-hero-art {
            display: none;
        }
    }

    @@media (max-width: 767.98px) {
        .contact-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .contact-section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .contact-support-panel,
        .contact-bottom {
            align-items: flex-start;
            flex-direction: column;
        }

            .contact-support-panel > .btn,
            .contact-bottom > .btn {
                width: 100%;
            }
    }

    @@media (max-width: 575.98px) {
        .contact-hero {
            padding: 2.15rem 1.2rem;
            border-radius: var(--cinema-radius-lg);
        }

            .contact-hero h1 {
                font-size: clamp(2.3rem, 9vw, 3.1rem);
                letter-spacing: -0.045em;
            }

        .contact-hero-content > p {
            font-size: 0.93rem;
        }

        .contact-hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .contact-hero-actions .btn {
                width: 100%;
            }

        .contact-card {
            min-height: 290px;
        }

        .contact-card-content {
            padding: 1.65rem 0 1.5rem;
        }

        .contact-support-copy {
            flex-direction: column;
        }

        .contact-bottom {
            padding: 2rem 1.2rem;
            border-radius: var(--cinema-radius-lg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .contact-orbit,
        .contact-message-art {
            animation: none;
        }

        .contact-card,
        .contact-primary-action > span:last-child,
        .contact-bottom > .btn > span:last-child,
        .contact-card-link > span:last-child {
            transition: none;
        }

            .contact-card:hover,
            .contact-primary-action:hover > span:last-child,
            .contact-bottom > .btn:hover > span:last-child,
            .contact-card-link:hover > span:last-child {
                transform: none;
            }
    }
</style>