@{
    ViewBag.Title = "Почетна";

    var isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;
}

<main class="home-page"
      aria-labelledby="home-title">

    <section class="cinema-panel home-hero">
        <div class="home-hero-glow home-hero-glow-left"></div>
        <div class="home-hero-glow home-hero-glow-right"></div>

        <div class="home-hero-content">

            <div class="cinema-eyebrow">
                CINEMA EXPERIENCE
            </div>

            <h1 id="home-title"
                class="home-hero-title">
                Твојот следен
                <span class="cinema-text-gradient">
                    филмски момент
                </span>
                започнува тука.
            </h1>

            <p class="home-hero-description">
                Откриј ги актуелните филмови, избери термин и
                резервирај ги твоите седишта во реално време —
                сè на едно место.
            </p>

            <div class="home-hero-actions">
                <a class="btn btn-primary home-primary-action"
                   href="@Url.Action("Current", "Movies")">
                    Разгледај филмови
                    <span aria-hidden="true">→</span>
                </a>

                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Buy", "Tickets")">
                    Купи билет
                </a>
            </div>

            <div class="home-hero-meta">
                <div class="home-meta-item">
                    <span class="home-meta-number">
                        01
                    </span>

                    <div>
                        <strong>
                            Избери филм
                        </strong>

                        <span>
                            Актуелен или најава
                        </span>
                    </div>
                </div>

                <div class="home-meta-divider"></div>

                <div class="home-meta-item">
                    <span class="home-meta-number">
                        02
                    </span>

                    <div>
                        <strong>
                            Одбери седиште
                        </strong>

                        <span>
                            Достапност во реално време
                        </span>
                    </div>
                </div>

                <div class="home-meta-divider"></div>

                <div class="home-meta-item">
                    <span class="home-meta-number">
                        03
                    </span>

                    <div>
                        <strong>
                            Добиј билет
                        </strong>

                        <span>
                            Потврда преку e-mail
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <div class="home-hero-visual"
             aria-hidden="true">

            <div class="home-orbit home-orbit-large"></div>
            <div class="home-orbit home-orbit-small"></div>

            <div class="home-ticket-preview">

                <div class="home-ticket-top">
                    <span class="home-ticket-brand">
                        MOVIETICKET
                    </span>

                    <span class="movie-badge">
                        LIVE SEATS
                    </span>
                </div>

                <div class="home-ticket-feature">
                    <span class="home-ticket-label">
                        CINEMA
                    </span>

                    <strong>
                        Premium
                        <br />
                        Movie Night
                    </strong>
                </div>

                <div class="home-ticket-line"></div>

                <div class="home-ticket-details">

                    <div>
                        <span>
                            TIME
                        </span>

                        <strong>
                            21:00
                        </strong>
                    </div>

                    <div>
                        <span>
                            ROW
                        </span>

                        <strong>
                            05
                        </strong>
                    </div>

                    <div>
                        <span>
                            SEAT
                        </span>

                        <strong>
                            07
                        </strong>
                    </div>

                </div>

                <div class="home-ticket-code">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

            </div>
        </div>
    </section>


    <section class="home-section"
             aria-labelledby="experience-title">

        <div class="cinema-page-header">
            <div>
                <div class="cinema-eyebrow">
                    THE EXPERIENCE
                </div>

                <h2 id="experience-title">
                    Сè што ти треба за
                    <span class="cinema-text-gradient">
                        филмска вечер
                    </span>
                </h2>

                <p>
                    Од откривање филм до избор на конкретно седиште,
                    MovieTicket го води целиот процес во едноставно
                    и модерно искуство.
                </p>
            </div>
        </div>

        <div class="movie-grid">

            <article class="movie-card home-feature-card">
                <div class="movie-card-body">

                    <span class="home-feature-number">
                        01
                    </span>

                    <div class="cinema-divider"></div>

                    <h3 class="movie-card-title">
                        Откриј што се прикажува
                    </h3>

                    <p class="movie-card-description">
                        Прегледај ги актуелните филмови, жанрот,
                        времетраењето, оценката и сите детали пред
                        да го направиш изборот.
                    </p>

                    <div class="movie-card-actions">
                        <a class="btn btn-outline-primary btn-sm"
                           href="@Url.Action("Current", "Movies")">
                            Актуелни филмови
                        </a>
                    </div>

                </div>
            </article>


            <article class="movie-card home-feature-card">
                <div class="movie-card-body">

                    <span class="home-feature-number">
                        02
                    </span>

                    <div class="cinema-divider"></div>

                    <h3 class="movie-card-title">
                        Резервирај во реално време
                    </h3>

                    <p class="movie-card-description">
                        Избери датум, термин и седишта преку
                        интерактивна кино сала со real-time
                        SignalR синхронизација.
                    </p>

                    <div class="movie-card-actions">
                        <a class="btn btn-outline-primary btn-sm"
                           href="@Url.Action("Buy", "Tickets")">
                            Избери седишта
                        </a>
                    </div>

                </div>
            </article>


            <article class="movie-card home-feature-card">
                <div class="movie-card-body">

                    <span class="home-feature-number">
                        03
                    </span>

                    <div class="cinema-divider"></div>

                    <h3 class="movie-card-title">
                        Чувај ги билетите
                    </h3>

                    <p class="movie-card-description">
                        По успешната резервација билетот се зачувува
                        на твојот профил, а потврдата може да биде
                        испратена и преку e-mail.
                    </p>

                    <div class="movie-card-actions">

                        @if (isAuthenticated)
                        {
                            <a class="btn btn-outline-primary btn-sm"
                               href="@Url.Action("Index", "Tickets")">
                                Мои билети
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm"
                               href="@Url.Action("Login", "Account")">
                                Најави се
                            </a>
                        }

                    </div>

                </div>
            </article>

        </div>
    </section>


    <section class="home-section">

        <div class="cinema-panel home-coming-soon">

            <div>
                <div class="cinema-eyebrow">
                    COMING SOON
                </div>

                <h2>
                    Следната премиера
                    можеби е твојот
                    <span class="cinema-text-gradient">
                        нов омилен филм.
                    </span>
                </h2>

                <p>
                    Погледни што пристигнува наскоро и испланирај
                    ја следната кино вечер однапред.
                </p>
            </div>

            <div>
                <a class="btn btn-primary"
                   href="@Url.Action("ComingSoon", "Movies")">
                    Погледни што следува
                    <span aria-hidden="true">→</span>
                </a>
            </div>

        </div>

    </section>


    <section class="home-section">

        <div class="home-final-cta">

            <div class="home-final-cta-content">

                <span class="cinema-eyebrow">
                    READY WHEN YOU ARE
                </span>

                <h2>
                    Светлата се гасат.
                    <br />
                    Филмот започнува.
                </h2>

                <p>
                    Одбери филм, термин и седиште и резервирај
                    го твоето место.
                </p>

                <div class="home-hero-actions">

                    <a class="btn btn-primary"
                       href="@Url.Action("Buy", "Tickets")">
                        Купи билет
                    </a>

                    @if (!isAuthenticated)
                    {
                        <a class="btn btn-outline-secondary"
                           href="@Url.Action("Register", "Account")">
                            Креирај профил
                        </a>
                    }

                </div>

            </div>

        </div>

    </section>

</main>

<style>
    .home-page {
        display: flex;
        flex-direction: column;
        gap: 6rem;
    }

    .home-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
        align-items: center;
        min-height: 620px;
        padding: clamp(2rem, 6vw, 5rem);
        overflow: hidden;
        isolation: isolate;
    }

        .home-hero::before {
            position: absolute;
            inset: 0;
            z-index: -3;
            content: "";
            background: linear-gradient( 90deg, rgba(8, 11, 16, 0.98) 0%, rgba(8, 11, 16, 0.88) 45%, rgba(8, 11, 16, 0.42) 100% );
        }

        .home-hero::after {
            position: absolute;
            z-index: -2;
            right: -15%;
            bottom: -40%;
            width: 760px;
            height: 760px;
            content: "";
            border-radius: 50%;
            border: 1px solid rgba(214, 168, 75, 0.08);
            background: radial-gradient( circle, rgba(214, 168, 75, 0.08), transparent 64% );
        }

    .home-hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
    }

    .home-hero-title {
        max-width: 820px;
        margin-bottom: 1.5rem;
    }

    .home-hero-description {
        max-width: 650px;
        margin-bottom: 2rem;
        color: var(--cinema-text-soft);
        font-size: 1.12rem;
        line-height: 1.8;
    }

    .home-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
    }

    .home-primary-action {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
    }

        .home-primary-action span {
            transition: transform var(--cinema-transition);
        }

        .home-primary-action:hover span {
            transform: translateX(4px);
        }

    .home-hero-meta {
        display: flex;
        align-items: center;
        gap: 1.4rem;
        margin-top: 3.5rem;
    }

    .home-meta-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .home-meta-number {
        color: var(--cinema-gold);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
    }

    .home-meta-item strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.86rem;
    }

    .home-meta-item div > span {
        display: block;
        margin-top: 0.1rem;
        color: var(--cinema-text-muted);
        font-size: 0.73rem;
    }

    .home-meta-divider {
        width: 1px;
        height: 38px;
        background: var(--cinema-border-strong);
    }

    .home-hero-visual {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 460px;
    }

    .home-hero-glow {
        position: absolute;
        z-index: -2;
        border-radius: 50%;
        filter: blur(15px);
        pointer-events: none;
    }

    .home-hero-glow-left {
        top: -180px;
        left: -180px;
        width: 360px;
        height: 360px;
        background: rgba(214, 168, 75, 0.08);
    }

    .home-hero-glow-right {
        right: -120px;
        bottom: -160px;
        width: 420px;
        height: 420px;
        background: rgba(55, 101, 165, 0.12);
    }

    .home-ticket-preview {
        position: relative;
        z-index: 3;
        width: min(100%, 340px);
        padding: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.13);
        border-radius: 26px;
        background: linear-gradient( 145deg, rgba(28, 36, 50, 0.96), rgba(11, 15, 23, 0.96) );
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.48), 0 0 80px rgba(214, 168, 75, 0.06);
        transform: perspective(1000px) rotateY(-8deg) rotateX(3deg);
        animation: home-ticket-float 6s ease-in-out infinite;
    }

        .home-ticket-preview::before,
        .home-ticket-preview::after {
            position: absolute;
            top: 56%;
            width: 28px;
            height: 28px;
            content: "";
            border: 1px solid var(--cinema-border);
            border-radius: 50%;
            background: #080b10;
            transform: translateY(-50%);
        }

        .home-ticket-preview::before {
            left: -15px;
        }

        .home-ticket-preview::after {
            right: -15px;
        }

    .home-ticket-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .home-ticket-brand {
        color: var(--cinema-text-muted);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.18em;
    }

    .home-ticket-feature {
        padding: 4rem 0 3rem;
    }

        .home-ticket-feature span {
            display: block;
            margin-bottom: 0.7rem;
            color: var(--cinema-gold);
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.18em;
        }

        .home-ticket-feature strong {
            color: var(--cinema-text);
            font-size: 2rem;
            line-height: 1.08;
            letter-spacing: -0.04em;
        }

    .home-ticket-line {
        height: 1px;
        background: repeating-linear-gradient( 90deg, rgba(255, 255, 255, 0.18) 0, rgba(255, 255, 255, 0.18) 8px, transparent 8px, transparent 16px );
    }

    .home-ticket-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        padding: 1.5rem 0;
    }

        .home-ticket-details span {
            display: block;
            margin-bottom: 0.25rem;
            color: var(--cinema-text-muted);
            font-size: 0.62rem;
            font-weight: 800;
            letter-spacing: 0.1em;
        }

        .home-ticket-details strong {
            color: var(--cinema-text);
            font-size: 0.95rem;
        }

    .home-ticket-code {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 4px;
        height: 38px;
        opacity: 0.8;
    }

        .home-ticket-code span {
            display: block;
            width: 3px;
            background: var(--cinema-text-soft);
        }

            .home-ticket-code span:nth-child(2n) {
                width: 1px;
            }

            .home-ticket-code span:nth-child(3n) {
                width: 5px;
            }

    .home-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.10);
        border-radius: 50%;
        animation: home-orbit-spin 28s linear infinite;
    }

        .home-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 20px rgba(214, 168, 75, 0.8);
        }

    .home-orbit-large {
        width: 440px;
        height: 440px;
    }

    .home-orbit-small {
        width: 320px;
        height: 320px;
        animation-direction: reverse;
        animation-duration: 20s;
    }

    .home-section {
        position: relative;
    }

    .home-feature-card {
        min-height: 310px;
    }

        .home-feature-card .movie-card-body {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .home-feature-card .movie-card-description {
            flex-grow: 1;
        }

    .home-feature-number {
        color: rgba(214, 168, 75, 0.68);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.12em;
    }

    .home-coming-soon {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        padding: clamp(2rem, 5vw, 4rem);
        background: radial-gradient( circle at 85% 50%, rgba(214, 168, 75, 0.08), transparent 30% ), linear-gradient( 145deg, rgba(20, 27, 39, 0.96), rgba(10, 14, 21, 0.96) );
    }

        .home-coming-soon > div:first-child {
            max-width: 760px;
        }

        .home-coming-soon h2 {
            margin-bottom: 1rem;
        }

        .home-coming-soon p {
            max-width: 620px;
            margin-bottom: 0;
        }

    .home-final-cta {
        position: relative;
        overflow: hidden;
        padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
        border: 1px solid rgba(214, 168, 75, 0.14);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 50% 120%, rgba(214, 168, 75, 0.17), transparent 42% ), linear-gradient( 180deg, rgba(17, 23, 34, 0.95), rgba(7, 9, 13, 0.98) );
        box-shadow: var(--cinema-shadow-lg);
        text-align: center;
    }

        .home-final-cta::before {
            position: absolute;
            top: -80%;
            left: 50%;
            width: 800px;
            height: 800px;
            content: "";
            border: 1px solid rgba(255, 255, 255, 0.025);
            border-radius: 50%;
            transform: translateX(-50%);
        }

    .home-final-cta-content {
        position: relative;
        z-index: 1;
        max-width: 700px;
        margin: 0 auto;
    }

    .home-final-cta .cinema-eyebrow {
        justify-content: center;
    }

    .home-final-cta h2 {
        margin-bottom: 1rem;
        font-size: clamp( 2rem, 5vw, 3.5rem );
    }

    .home-final-cta p {
        max-width: 540px;
        margin: 0 auto 1.8rem;
        color: var(--cinema-text-muted);
    }

    .home-final-cta .home-hero-actions {
        justify-content: center;
    }

    @@keyframes home-ticket-float {
        0%,
        100% {
            transform: perspective(1000px) rotateY(-8deg) rotateX(3deg) translateY(0);
        }

        50% {
            transform: perspective(1000px) rotateY(-5deg) rotateX(1deg) translateY(-12px);
        }
    }

    @@keyframes home-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 991.98px) {
        .home-page {
            gap: 4rem;
        }

        .home-hero {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .home-hero-content {
            max-width: 800px;
        }

        .home-hero-visual {
            min-height: 430px;
            margin-top: 2rem;
        }

        .home-ticket-preview {
            transform: none;
        }

        .home-hero-meta {
            flex-wrap: wrap;
        }

        .home-coming-soon {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 767.98px) {
        .home-hero {
            padding: 2rem 1.4rem;
        }

        .home-hero-title {
            font-size: 2.65rem;
        }

        .home-hero-description {
            font-size: 1rem;
        }

        .home-hero-meta {
            align-items: flex-start;
            flex-direction: column;
            gap: 1rem;
            margin-top: 2.5rem;
        }

        .home-meta-divider {
            display: none;
        }

        .home-hero-visual {
            min-height: 390px;
        }

        .home-orbit-large {
            width: 360px;
            height: 360px;
        }

        .home-orbit-small {
            width: 260px;
            height: 260px;
        }

        .home-ticket-preview {
            width: min(90%, 330px);
        }
    }

    @@media (max-width: 575.98px) {
        .home-page {
            gap: 3.25rem;
        }

        .home-hero {
            padding: 1.6rem 1.1rem;
        }

        .home-hero-title {
            font-size: 2.2rem;
        }

        .home-hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

            .home-hero-actions .btn {
                width: 100%;
            }

        .home-hero-visual {
            min-height: 340px;
        }

        .home-orbit-large {
            width: 300px;
            height: 300px;
        }

        .home-orbit-small {
            width: 220px;
            height: 220px;
        }

        .home-ticket-feature {
            padding: 3rem 0 2.3rem;
        }

            .home-ticket-feature strong {
                font-size: 1.65rem;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .home-ticket-preview,
        .home-orbit {
            animation: none;
        }
    }
</style>