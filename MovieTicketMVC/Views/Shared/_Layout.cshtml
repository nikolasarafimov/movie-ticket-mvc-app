@using System

@{
    var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    var currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
    var activeMovieSection = Convert.ToString(ViewBag.ActiveMovieSection);
    var viewTitle = Convert.ToString(ViewBag.Title);

    var pageTitle = string.IsNullOrWhiteSpace(viewTitle)
        ? "MovieTicket"
        : viewTitle.Trim() + " | MovieTicket";

    var isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;

    var isAdmin = isAuthenticated && User.IsInRole("Admin");

    var isHome =
        string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);

    var isContact =
        string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, "Contact", StringComparison.OrdinalIgnoreCase);

    var isMoviesController =
        string.Equals(currentController, "Movies", StringComparison.OrdinalIgnoreCase);

    if (isMoviesController && string.IsNullOrWhiteSpace(activeMovieSection))
    {
        if (string.Equals(currentAction, "Current", StringComparison.OrdinalIgnoreCase))
        {
            activeMovieSection = "Current";
        }
        else if (string.Equals(currentAction, "ComingSoon", StringComparison.OrdinalIgnoreCase))
        {
            activeMovieSection = "ComingSoon";
        }
    }

    var isCurrentMovies =
        isMoviesController &&
        string.Equals(activeMovieSection, "Current", StringComparison.OrdinalIgnoreCase);

    var isComingSoonMovies =
        isMoviesController &&
        string.Equals(activeMovieSection, "ComingSoon", StringComparison.OrdinalIgnoreCase);

    var isTicketsController =
        string.Equals(currentController, "Tickets", StringComparison.OrdinalIgnoreCase);

    var isBuyTicket =
        isTicketsController &&
        string.Equals(currentAction, "Buy", StringComparison.OrdinalIgnoreCase);

    var isTicketHistory =
        isTicketsController &&
        (string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(currentAction, "Summary", StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#07090d" />

    <meta name="description"
          content="MovieTicket - преглед на актуелни филмови и премиери, избор на седишта и резервација на кино билети." />

    <title>@pageTitle</title>

    <link rel="icon"
          type="image/png"
          href="@Url.Content("~/Content/Images/movieticket-icon.png")" />

    <link rel="shortcut icon"
          type="image/png"
          href="@Url.Content("~/Content/Images/movieticket-icon.png")" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        .cinema-skip-link {
            position: fixed;
            z-index: 1100;
            top: 0.5rem;
            left: 0.5rem;
            padding: 0.65rem 1rem;
            color: #111318;
            border-radius: 10px;
            background: var(--cinema-gold-light);
            font-weight: 700;
            transform: translateY(-180%);
        }

            .cinema-skip-link:focus {
                color: #111318;
                outline: 3px solid #fff;
                outline-offset: 2px;
                transform: translateY(0);
            }

        .navbar-brand.movie-brand {
            position: relative;
            display: inline-flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: flex-start;
            gap: 0;
            margin-right: 1rem;
            padding: 0;
            border: 0;
            text-decoration: none;
        }

            .navbar-brand.movie-brand::before {
                display: none;
                content: none;
            }

        .movie-brand-logo {
            display: block;
            width: 215px;
            max-width: 100%;
            height: 60px;
            object-fit: contain;
            object-position: left center;
            opacity: 1;
            transition: opacity var(--cinema-transition), transform var(--cinema-transition);
        }

        .movie-brand:hover .movie-brand-logo {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .movie-brand:focus-visible {
            border-radius: 8px;
            outline: 2px solid var(--cinema-gold-light);
            outline-offset: 4px;
        }

        .cinema-nav-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

            .cinema-nav-actions > .navbar-nav {
                margin: 0;
                padding: 0;
            }

        .cinema-nav-buy {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            white-space: nowrap;
        }

            .cinema-nav-buy.active {
                border-color: #ffe199;
                box-shadow: 0 0 0 2px rgba(214, 168, 75, 0.25);
            }

        .cinema-footer {
            padding: 1.5rem 0 1.25rem;
            border-top: 1px solid var(--cinema-border);
            background: rgba(6, 8, 12, 0.55);
        }

        .cinema-footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .cinema-footer-brand {
            display: block;
            margin-bottom: 0.3rem;
            color: var(--cinema-text);
            font-size: 0.9rem;
            font-weight: 800;
            letter-spacing: 0.1em;
        }

            .cinema-footer-brand:hover {
                color: var(--cinema-gold-light);
            }

        .cinema-footer-tagline {
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.75rem;
        }

        .cinema-footer-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 0.6rem 1.25rem;
        }

            .cinema-footer-links a {
                color: var(--cinema-text-soft);
                font-size: 0.79rem;
                font-weight: 600;
            }

                .cinema-footer-links a:hover {
                    color: var(--cinema-gold-light);
                }

        .cinema-footer-copyright {
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.75rem;
            white-space: nowrap;
        }

        @@media (max-width: 1199.98px) and (min-width: 992px) {
            .movie-brand-logo {
                width: 175px;
                height: 52px;
            }

            .navbar-brand.movie-brand {
                margin-right: 0.5rem;
            }
        }

        @@media (max-width: 991.98px) {
            .navbar-brand.movie-brand {
                margin-right: auto;
            }

            .movie-brand-logo {
                width: 205px;
                height: 55px;
            }

            .cinema-nav-actions {
                align-items: stretch;
                flex-direction: column;
                gap: 0.7rem;
                padding-top: 0.75rem;
                border-top: 1px solid var(--cinema-border);
            }

                .cinema-nav-actions > .navbar-nav {
                    align-items: stretch;
                }

            .cinema-nav-buy {
                width: 100%;
            }
        }

        @@media (max-width: 767.98px) {
            .cinema-footer-inner {
                align-items: center;
                flex-direction: column;
                text-align: center;
            }

            .cinema-footer-links {
                gap: 0.6rem 1rem;
            }
        }

        @@media (max-width: 575.98px) {
            .navbar-brand.movie-brand {
                margin-right: auto;
            }

            .movie-brand-logo {
                width: 175px;
                height: 48px;
            }
        }

        @@media (max-width: 359.98px) {
            .movie-brand-logo {
                width: 145px;
                height: 42px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .cinema-skip-link,
            .movie-brand-logo {
                transition: none;
            }

            .movie-brand:hover .movie-brand-logo {
                transform: none;
            }
        }


        .cinema-account .cinema-account-menu {
            min-width: 215px;
            padding: 8px;
            overflow: hidden;
            border: 1px solid rgba(214, 168, 75, 0.25) !important;
            border-radius: 14px !important;
            background: #141a24 !important;
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45) !important;
        }

            .cinema-account .cinema-account-menu .dropdown-item {
                display: flex;
                align-items: center;
                width: 100%;
                min-height: 43px;
                padding: 10px 14px;
                color: #dce1e9 !important;
                border: none !important;
                border-radius: 8px;
                background: transparent !important;
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
                transition: color 180ms ease, background-color 180ms ease;
            }

                .cinema-account .cinema-account-menu .dropdown-item:hover,
                .cinema-account .cinema-account-menu .dropdown-item:focus,
                .cinema-account .cinema-account-menu .dropdown-item:focus-visible {
                    color: #f0cb76 !important;
                    background: rgba(214, 168, 75, 0.11) !important;
                }

                .cinema-account .cinema-account-menu .dropdown-item:active {
                    color: #f0cb76 !important;
                    background: rgba(214, 168, 75, 0.17) !important;
                }

            .cinema-account .cinema-account-menu .dropdown-divider {
                margin: 5px 7px;
                border-color: rgba(255, 255, 255, 0.09) !important;
                opacity: 1;
            }

            .cinema-account .cinema-account-menu .cinema-account-register {
                color: #f0cb76 !important;
            }

            .cinema-account .cinema-account-menu .cinema-account-user {
                padding: 12px 14px;
            }

                .cinema-account .cinema-account-menu .cinema-account-user small {
                    display: block;
                    color: #848d9d;
                    font-size: 11px;
                }

                .cinema-account .cinema-account-menu .cinema-account-user strong {
                    display: block;
                    max-width: 200px;
                    overflow: hidden;
                    color: #f5f7fb;
                    font-size: 13px;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

            .cinema-account .cinema-account-menu .cinema-account-logout {
                color: #ef919a !important;
            }

                .cinema-account .cinema-account-menu .cinema-account-logout:hover {
                    color: #ffadb5 !important;
                    background: rgba(239, 102, 115, 0.09) !important;
                }
    </style>
</head>

<body>
    <a class="cinema-skip-link"
       href="#mainContent">
        Прескокни до содржината
    </a>

    <nav class="navbar navbar-expand-lg navbar-dark"
         aria-label="Главна навигација">

        <div class="container">

            <a class="navbar-brand movie-brand"
               href="@Url.Action("Index", "Home")"
               aria-label="MovieTicket - Почетна">

                <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                     alt="MovieTicket"
                     class="movie-brand-logo"
                     width="215"
                     height="60"
                     decoding="async" />

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Отвори или затвори навигација">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link @(isHome ? "active" : "")"
                           href="@Url.Action("Index", "Home")"
                           aria-current="@(isHome ? "page" : null)">
                            Почетна
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(isCurrentMovies ? "active" : "")"
                           href="@Url.Action("Current", "Movies")"
                           aria-current="@(isCurrentMovies ? "page" : null)">
                            Актуелни
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(isComingSoonMovies ? "active" : "")"
                           href="@Url.Action("ComingSoon", "Movies")"
                           aria-current="@(isComingSoonMovies ? "page" : null)">
                            Наскоро
                        </a>
                    </li>

                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isTicketHistory ? "active" : "")"
                               href="@Url.Action("Index", "Tickets")"
                               aria-current="@(isTicketHistory ? "page" : null)">
                                @(isAdmin ? "Сите билети" : "Мои билети")
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @(isContact ? "active" : "")"
                           href="@Url.Action("Contact", "Home")"
                           aria-current="@(isContact ? "page" : null)">
                            Контакт
                        </a>
                    </li>

                </ul>

                <div class="cinema-nav-actions">

                    @Html.Partial("_LoginPartial")

                    <a class="btn btn-primary btn-sm cinema-nav-buy @(isBuyTicket ? "active" : "")"
                       href="@Url.Action("Buy", "Tickets")"
                       aria-current="@(isBuyTicket ? "page" : null)">
                        Купи билет
                    </a>

                </div>

            </div>
        </div>
    </nav>

    <main id="mainContent"
          class="body-content"
          tabindex="-1">

        @RenderBody()

    </main>

    <footer class="cinema-footer">

        <div class="container cinema-footer-inner">

            <div>
                <a class="cinema-footer-brand"
                   href="@Url.Action("Index", "Home")"
                   aria-label="MovieTicket - Почетна">

                    <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                         alt="MovieTicket"
                         class="cinema-footer-logo"
                         width="160"
                         height="42"
                         loading="lazy"
                         decoding="async" />
                </a>

                <p class="cinema-footer-tagline">
                    Твојот следен филмски момент започнува тука.
                </p>

            </div>

            <nav class="cinema-footer-links"
                 aria-label="Навигација во подножјето">

                <a href="@Url.Action("Current", "Movies")">
                    Актуелни филмови
                </a>

                <a href="@Url.Action("ComingSoon", "Movies")">
                    Наскоро
                </a>

                <a href="@Url.Action("Buy", "Tickets")">
                    Купи билет
                </a>

                <a href="@Url.Action("Contact", "Home")">
                    Контакт
                </a>

            </nav>

            <p class="cinema-footer-copyright">
                &copy; @DateTime.Now.Year MovieTicket
            </p>

        </div>

    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>