@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Настана грешка";
}

<main class="error-page"
      aria-labelledby="error-title">

    <section class="error-shell">

        <div class="error-grid"
             aria-hidden="true">
        </div>

        <div class="error-glow error-glow-one"
             aria-hidden="true">
        </div>

        <div class="error-glow error-glow-two"
             aria-hidden="true">
        </div>


        <a class="error-brand"
           href="@Url.Action("Index", "Home")">

            <span></span>

            MOVIETICKET
        </a>


        <div class="error-visual"
             aria-hidden="true">

            <div class="error-orbit error-orbit-large">
            </div>

            <div class="error-orbit error-orbit-small">
            </div>


            <div class="error-ticket">

                <div class="error-ticket-top">

                    <span>
                        MOVIETICKET
                    </span>

                    <strong>
                        ERROR
                    </strong>

                </div>


                <div class="error-ticket-code">
                    500
                </div>


                <div class="error-ticket-divider">
                </div>


                <div class="error-ticket-status">

                    <span></span>

                    REQUEST INTERRUPTED

                </div>

            </div>

        </div>


        <div class="error-content">

            <div class="cinema-eyebrow error-eyebrow">
                SOMETHING WENT WRONG
            </div>

            <h1 id="error-title">
                Нешто не помина
                <span class="error-title-accent">
                    според планот.
                </span>
            </h1>

            <p class="error-description">
                Настана неочекувана грешка при обработката
                на барањето. Обиди се повторно или продолжи
                кон друга страница на MovieTicket.
            </p>


            <div class="error-status-card">

                <div class="error-status-icon"
                     aria-hidden="true">
                    !
                </div>

                <div>

                    <span>
                        REQUEST STATUS
                    </span>

                    <strong>
                        Барањето не можеше да се заврши
                    </strong>

                    <p>
                        Ако проблемот се повторува, врати се
                        на почетната страница и обиди се
                        повторно.
                    </p>

                </div>

            </div>


            <div class="error-actions">

                <a class="btn btn-primary error-primary-action"
                   href="@Url.Action("Index", "Home")">

                    <span>
                        Назад кон почетна
                    </span>

                    <span aria-hidden="true">
                        →
                    </span>

                </a>


                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Current", "Movies")">

                    Актуелни филмови

                </a>

            </div>


            <a class="error-support-link"
               href="@Url.Action("Contact", "Home")">

                <span aria-hidden="true">
                    ?
                </span>

                Потребна ти е помош? Контактирај нè.

            </a>

        </div>

    </section>

</main>


<style>
    .error-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .error-shell {
        position: relative;
        width: min(100%, 860px);
        min-height: 680px;
        padding: clamp(2rem, 6vw, 4.5rem);
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 50% 20%, rgba(215, 76, 88, 0.10), transparent 30% ), radial-gradient( circle at 0% 100%, rgba(59, 101, 169, 0.11), transparent 32% ), linear-gradient( 145deg, #151d29, #090e16 58%, #06090e );
        box-shadow: var(--cinema-shadow-lg);
        isolation: isolate;
    }


    /* =====================================================
       BACKGROUND
       ===================================================== */

    .error-grid {
        position: absolute;
        z-index: -3;
        inset: 0;
        opacity: 0.24;
        background-image: linear-gradient( rgba(255, 255, 255, 0.021) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.021) 1px, transparent 1px );
        background-size: 48px 48px;
        mask-image: linear-gradient( 180deg, #000, transparent 80% );
    }

    .error-glow {
        position: absolute;
        z-index: -2;
        border-radius: 50%;
        filter: blur(25px);
        pointer-events: none;
    }

    .error-glow-one {
        top: -180px;
        right: -120px;
        width: 450px;
        height: 450px;
        background: rgba(215, 76, 88, 0.06);
    }

    .error-glow-two {
        bottom: -200px;
        left: -130px;
        width: 450px;
        height: 450px;
        background: rgba(59, 101, 169, 0.07);
    }


    /* =====================================================
       BRAND
       ===================================================== */

    .error-brand {
        position: relative;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.2rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .error-brand:hover {
            color: var(--cinema-gold-light);
        }

        .error-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       VISUAL
       ===================================================== */

    .error-visual {
        position: relative;
        display: grid;
        width: 280px;
        height: 210px;
        margin: 0 auto 1.8rem;
        place-items: center;
    }

    .error-ticket {
        position: relative;
        z-index: 4;
        width: 180px;
        padding: 1.2rem;
        overflow: hidden;
        text-align: left;
        border: 1px solid rgba(215, 76, 88, 0.25);
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(36, 28, 34, 0.90), rgba(10, 14, 21, 0.95) );
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.38), 0 0 40px rgba(215, 76, 88, 0.07);
        transform: rotate(-3deg);
        animation: error-ticket-float 6s ease-in-out infinite;
    }

        .error-ticket::before,
        .error-ticket::after {
            position: absolute;
            top: 57%;
            width: 20px;
            height: 20px;
            content: "";
            border-radius: 50%;
            background: #0a0e15;
        }

        .error-ticket::before {
            left: -11px;
        }

        .error-ticket::after {
            right: -11px;
        }

    .error-ticket-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .error-ticket-top span {
            color: var(--cinema-text-muted);
            font-size: 0.43rem;
            font-weight: 900;
            letter-spacing: 0.12em;
        }

        .error-ticket-top strong {
            color: #ff969f;
            font-size: 0.45rem;
            letter-spacing: 0.1em;
        }

    .error-ticket-code {
        padding: 1.7rem 0 1.5rem;
        color: #ff969f;
        font-size: 3.4rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.07em;
        text-align: center;
        text-shadow: 0 0 30px rgba(215, 76, 88, 0.22);
    }

    .error-ticket-divider {
        height: 1px;
        margin-bottom: 1rem;
        background: repeating-linear-gradient( 90deg, rgba(255, 255, 255, 0.15) 0, rgba(255, 255, 255, 0.15) 6px, transparent 6px, transparent 12px );
    }

    .error-ticket-status {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--cinema-text-muted);
        font-size: 0.43rem;
        font-weight: 900;
        letter-spacing: 0.08em;
    }

        .error-ticket-status > span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--cinema-danger);
            box-shadow: 0 0 10px rgba(215, 76, 88, 0.65);
        }


    /* =====================================================
       ORBITS
       ===================================================== */

    .error-orbit {
        position: absolute;
        border: 1px solid rgba(215, 76, 88, 0.09);
        border-radius: 50%;
        animation: error-orbit-spin 24s linear infinite;
    }

        .error-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-danger);
            box-shadow: 0 0 16px rgba(215, 76, 88, 0.65);
        }

    .error-orbit-large {
        width: 210px;
        height: 210px;
    }

    .error-orbit-small {
        width: 155px;
        height: 155px;
        animation-direction: reverse;
        animation-duration: 17s;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .error-content {
        position: relative;
        z-index: 5;
    }

    .error-eyebrow {
        color: #ff969f;
    }

    .error-content h1 {
        max-width: 700px;
        margin: 0 auto 1rem;
        font-size: clamp( 2.6rem, 6vw, 4.2rem );
        line-height: 0.98;
        letter-spacing: -0.055em;
    }

    .error-title-accent {
        background: linear-gradient( 135deg, #ffc0c5, #e96873 );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .error-description {
        max-width: 590px;
        margin: 0 auto 1.8rem;
        color: var(--cinema-text-muted);
        font-size: 0.88rem;
        line-height: 1.75;
    }


    /* =====================================================
       STATUS CARD
       ===================================================== */

    .error-status-card {
        display: flex;
        max-width: 570px;
        align-items: flex-start;
        gap: 0.9rem;
        margin: 0 auto 1.7rem;
        padding: 1rem;
        text-align: left;
        border: 1px solid rgba(215, 76, 88, 0.16);
        border-radius: 14px;
        background: rgba(215, 76, 88, 0.035);
    }

    .error-status-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #ff9ca5;
        border: 1px solid rgba(215, 76, 88, 0.23);
        border-radius: 12px;
        background: rgba(215, 76, 88, 0.07);
        font-size: 0.85rem;
        font-weight: 900;
    }

    .error-status-card
    div:last-child > span {
        display: block;
        margin-bottom: 0.15rem;
        color: #ef8a93;
        font-size: 0.5rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .error-status-card strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.8rem;
    }

    .error-status-card p {
        margin: 0.25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.67rem;
        line-height: 1.55;
    }


    /* =====================================================
       ACTIONS
       ===================================================== */

    .error-actions {
        display: flex;
        justify-content: center;
        gap: 0.7rem;
    }

    .error-primary-action {
        display: inline-flex;
        min-width: 210px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .error-primary-action > span:last-child {
            transition: transform var(--cinema-transition);
        }

        .error-primary-action:hover > span:last-child {
            transform: translateX(5px);
        }


    /* =====================================================
       SUPPORT
       ===================================================== */

    .error-support-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.7rem;
        color: var(--cinema-text-muted);
        font-size: 0.7rem;
        font-weight: 600;
    }

        .error-support-link > span {
            display: grid;
            width: 23px;
            height: 23px;
            place-items: center;
            color: var(--cinema-gold-light);
            border: 1px solid rgba(214, 168, 75, 0.17);
            border-radius: 50%;
            background: rgba(214, 168, 75, 0.05);
            font-size: 0.58rem;
            font-weight: 900;
        }

        .error-support-link:hover {
            color: var(--cinema-gold-light);
        }


    /* =====================================================
       ANIMATIONS
       ===================================================== */

    @@keyframes error-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes error-ticket-float {
        0%,
        100% {
            transform: rotate(-3deg) translateY(0);
        }

        50% {
            transform: rotate(-1deg) translateY(-10px);
        }
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 575.98px) {
        .error-shell {
            min-height: 0;
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg);
        }

        .error-visual {
            width: 220px;
            height: 180px;
        }

        .error-orbit-large {
            width: 180px;
            height: 180px;
        }

        .error-orbit-small {
            width: 135px;
            height: 135px;
        }

        .error-ticket {
            width: 160px;
        }

        .error-ticket-code {
            font-size: 3rem;
        }

        .error-content h1 {
            font-size: 2.4rem;
        }

        .error-actions {
            align-items: stretch;
            flex-direction: column;
        }

            .error-actions .btn {
                width: 100%;
            }

        .error-primary-action {
            min-width: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .error-orbit,
        .error-ticket {
            animation: none;
        }
    }
</style>