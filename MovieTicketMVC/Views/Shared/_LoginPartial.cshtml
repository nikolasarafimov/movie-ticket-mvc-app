@using Microsoft.AspNet.Identity

@{
    var currentController =
        ViewContext.RouteData.Values["controller"] as string
        ?? string.Empty;

    var currentAction =
        ViewContext.RouteData.Values["action"] as string
        ?? string.Empty;
}

@if (Request.IsAuthenticated)
{
    <ul class="navbar-nav align-items-lg-center">
        <li class="nav-item">
            <a class="nav-link @(currentController == "Manage" ? "active" : "")"
               href="@Url.Action("Index", "Manage")"
               title="Manage account">
                @User.Identity.GetUserName()
            </a>
        </li>

        <li class="nav-item">
            @using (Html.BeginForm(
                "LogOff",
                "Account",
                FormMethod.Post,
                new
                {
                    id = "logoutForm",
                    @class = "d-inline"
                }))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="nav-link btn btn-link border-0">
                    Log off
                </button>
            }
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            @Html.ActionLink(
                "Register",
                "Register",
                "Account",
                routeValues: null,
                htmlAttributes: new
                {
                    @class =
                        "nav-link "
                        + (currentController == "Account" &&
                           currentAction == "Register"
                            ? "active"
                            : "")
                })
        </li>

        <li class="nav-item">
            @Html.ActionLink(
                "Log in",
                "Login",
                "Account",
                routeValues: null,
                htmlAttributes: new
                {
                    @class =
                        "nav-link "
                        + (currentController == "Account" &&
                           currentAction == "Login"
                            ? "active"
                            : "")
                })
        </li>
    </ul>
}