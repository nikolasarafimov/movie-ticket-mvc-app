@using Microsoft.AspNet.Identity

@{
    var isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;
}

<div class="cinema-account dropdown">

    <button type="button"
            class="cinema-account-toggle dropdown-toggle"
            id="cinemaAccountToggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-haspopup="true"
            style="display:inline-flex !important;
                   align-items:center !important;
                   justify-content:center !important;
                   gap:9px !important;
                   min-height:42px !important;
                   padding:9px 15px !important;
                   color:#f5f7fb !important;
                   background:#171c25 !important;
                   border:1px solid rgba(214,168,75,0.35) !important;
                   border-radius:11px !important;
                   font-family:inherit !important;
                   font-size:13px !important;
                   font-weight:600 !important;
                   line-height:1.3 !important;
                   cursor:pointer !important;
                   box-shadow:none !important;
                   appearance:none !important;">

        <svg xmlns="http://www.w3.org/2000/svg"
             width="18"
             height="18"
             viewBox="0 0 24 24"
             fill="none"
             stroke="#d6a84b"
             stroke-width="1.8"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">

            <circle cx="12" cy="8" r="4" />
            <path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2" />

        </svg>

        <span>Profile</span>

    </button>

    <ul class="dropdown-menu dropdown-menu-end cinema-account-menu"
        aria-labelledby="cinemaAccountToggle"
        style="min-width:215px;
               padding:8px;
               background:#141a24 !important;
               color:#f5f7fb !important;
               border:1px solid rgba(214,168,75,0.25) !important;
               border-radius:14px !important;
               box-shadow:0 18px 45px rgba(0,0,0,0.45) !important;">

        @if (isAuthenticated)
        {
            <li class="cinema-account-user">

                <small>Signed-in account</small>

                <strong title="@User.Identity.GetUserName()">
                    @User.Identity.GetUserName()
                </strong>

            </li>

            <li>
                <hr class="dropdown-divider" />
            </li>

            <li>
                <a class="dropdown-item cinema-account-item"
                   href="@Url.Action("Index", "Manage")">
                    My Profile
                </a>
            </li>

            <li>
                @using (Html.BeginForm(
                    "LogOff",
                    "Account",
                    FormMethod.Post,
                    new { id = "logoutForm" }))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="dropdown-item cinema-account-item cinema-account-logout">
                        Log Out
                    </button>
                }
            </li>
        }
        else
        {
            <li>
                <a class="dropdown-item cinema-account-item"
                   href="@Url.Action("Login", "Account")">
                    Log In
                </a>
            </li>

            <li>
                <hr class="dropdown-divider" />
            </li>

            <li>
                <a class="dropdown-item cinema-account-item cinema-account-register"
                   href="@Url.Action("Register", "Account")">
                    Register
                </a>
            </li>
        }

    </ul>

</div>