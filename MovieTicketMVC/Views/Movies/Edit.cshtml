@using System
@using System.Globalization
@using System.IO
@using System.Text.RegularExpressions
@model MovieTicketMVC.Models.Movie

@{
    ViewBag.Title = "Edit Movie";

    var returnSection = ViewBag.ReturnSection as string;
    if (returnSection != "Current" && returnSection != "ComingSoon")
    {
        returnSection = Model.ReleaseDate.Date <= DateTime.Today ? "Current" : "ComingSoon";
    }

    var releaseDateValue = Model.ReleaseDate != default(DateTime)
        ? Model.ReleaseDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        : string.Empty;

    var storedTrailerPath = (Model.LocalTrailerPath ?? string.Empty).Trim();
    var hasTrailer = Regex.IsMatch(
        storedTrailerPath,
        @"^~/Content/Videos/[A-Za-z0-9_-]+\.(mp4|webm|ogg)$",
        RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
    var trailerUrl = hasTrailer ? Url.Content(storedTrailerPath) : string.Empty;
    var trailerFileName = hasTrailer ? Path.GetFileName(storedTrailerPath) : string.Empty;
    var trailerExtension = hasTrailer ? Path.GetExtension(storedTrailerPath).ToLowerInvariant() : string.Empty;
    var trailerMime = trailerExtension == ".webm"
        ? "video/webm"
        : trailerExtension == ".ogg" ? "video/ogg" : "video/mp4";
    var isCurrentlyShowing = Model.ReleaseDate.Date <= DateTime.Today;
    var currentStatus = isCurrentlyShowing ? "Now Showing" : "Coming Soon";
    var returnLabel = returnSection == "Current" ? "Now Showing" : "Coming Soon";
    var todayValue = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}

<div class="movie-edit-page" aria-labelledby="movie-edit-title">
    <header class="movie-edit-hero">
        <div class="movie-edit-hero-copy">
            <a class="movie-edit-back" href="@Url.Action(returnSection, "Movies")">
                <span aria-hidden="true">←</span>
                Back to @returnLabel
            </a>
            <div class="cinema-eyebrow">ADMIN · MOVIE CATALOG</div>
            <h1 id="movie-edit-title">Edit <span class="cinema-text-gradient">Movie</span></h1>
            <p>Update the movie details, age rating, and trailer, then save your changes.</p>
            <div class="movie-edit-hero-tags">
                <span class="movie-edit-tag">Movie #@Model.Id</span>
                <span class="movie-edit-tag movie-edit-tag-status" id="heroStatus">@currentStatus</span>
            </div>
        </div>
        <div class="movie-edit-hero-art" aria-hidden="true">
            <svg viewBox="0 0 96 96" width="88" height="88" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="18" y="25" width="60" height="50" rx="11" stroke="#D6A84B" stroke-width="2" fill="#D6A84B" fill-opacity=".06" />
                <path d="M18 37H78" stroke="#D6A84B" stroke-width="2" />
                <path d="M28 25L39 37M46 25L57 37M64 25L75 37" stroke="#F0CB76" stroke-width="2" />
                <path d="M41 47V64L57 55.5L41 47Z" fill="#F0CB76" />
                <path d="M64 16H76M70 10V22" stroke="#F0CB76" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>
    </header>

    @using (Html.BeginForm("Edit", "Movies", FormMethod.Post, new { enctype = "multipart/form-data", id = "movieEditForm", @class = "movie-edit-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.Hidden("ReturnSection", returnSection)
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors movie-edit-errors", role = "alert" })

        <div class="movie-edit-layout">
            <div class="movie-edit-main">
                <section class="movie-edit-panel" aria-labelledby="movie-edit-general-title">
                    <div class="movie-edit-panel-head">
                        <span class="movie-edit-step">01</span>
                        <div>
                            <h2 id="movie-edit-general-title">Basic Information</h2>
                            <p>The details displayed in the movie catalog.</p>
                        </div>
                    </div>

                    <div class="movie-edit-fields">
                        <div class="movie-edit-field movie-edit-full">
                            @Html.LabelFor(m => m.Title, "Movie Title", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter the movie title", required = "required" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>
                        <div class="movie-edit-field">
                            @Html.LabelFor(m => m.Genre, "Genre", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Genre, new { @class = "form-control", placeholder = "e.g. Drama", required = "required" })
                            @Html.ValidationMessageFor(m => m.Genre, "", new { @class = "text-danger" })
                        </div>
                        <div class="movie-edit-field">
                            @Html.LabelFor(m => m.Language, "Language", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Language, new { @class = "form-control", placeholder = "e.g. English" })
                            @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger" })
                        </div>
                        <div class="movie-edit-field">
                            @Html.LabelFor(m => m.LengthInMinutes, "Duration", new { @class = "form-label" })
                            <div class="movie-edit-input-unit">
                                @Html.TextBoxFor(m => m.LengthInMinutes, new { @class = "form-control", type = "number", min = "1", max = "600", step = "1", required = "required" })
                                <span>min</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.LengthInMinutes, "", new { @class = "text-danger" })
                        </div>
                        <div class="movie-edit-field">
                            @Html.LabelFor(m => m.Rating, "Rating", new { @class = "form-label" })
                            <div class="movie-edit-input-unit">
                                @Html.TextBoxFor(m => m.Rating, new { @class = "form-control", type = "text", inputmode = "decimal", placeholder = "0.0", id = "Rating" })
                                <span>/ 10</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger" })
                        </div>
                        <div class="movie-edit-field movie-edit-full">
                            @Html.LabelFor(m => m.ReleaseDate, "Release Date", new { @class = "form-label" })
                            @Html.TextBox("ReleaseDate", releaseDateValue, new { @class = "form-control", type = "date", required = "required", id = "ReleaseDate" })
                            <small class="movie-edit-field-hint">The release date determines whether the movie appears in “Now Showing” or “Coming Soon”.</small>
                            @Html.ValidationMessageFor(m => m.ReleaseDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </section>

                <section class="movie-edit-panel" aria-labelledby="movie-edit-content-title">
                    <div class="movie-edit-panel-head">
                        <span class="movie-edit-step">02</span>
                        <div>
                            <h2 id="movie-edit-content-title">Description and Cast</h2>
                            <p>The information visitors will see on the movie details page.</p>
                        </div>
                    </div>
                    <div class="movie-edit-field">
                        @Html.LabelFor(m => m.Description, "Movie Description", new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description, 5, 50, new { @class = "form-control movie-edit-description", placeholder = "A short description of the movie", required = "required" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    </div>
                    <div class="movie-edit-field movie-edit-field-spaced">
                        @Html.LabelFor(m => m.Actors, "Cast", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Actors, new { @class = "form-control", placeholder = "Names of the actors" })
                        <small class="movie-edit-field-hint">Separate names with commas.</small>
                        @Html.ValidationMessageFor(m => m.Actors, "", new { @class = "text-danger" })
                    </div>
                </section>

                <section class="movie-edit-panel" aria-labelledby="movie-edit-age-title">
                    <div class="movie-edit-panel-head">
                        <span class="movie-edit-step">03</span>
                        <div>
                            <h2 id="movie-edit-age-title">Age Rating</h2>
                            <p>Specify whether the movie has an age restriction.</p>
                        </div>
                    </div>
                    <fieldset class="movie-edit-age-options">
                        <legend class="visually-hidden">Age Rating</legend>
                        <label class="movie-edit-age-option" for="IsForAdultsFalse">
                            @Html.RadioButtonFor(m => m.IsForAdults, false, new { id = "IsForAdultsFalse", required = "required" })
                            <span class="movie-edit-age-body">
                                <span class="movie-edit-age-symbol">ALL</span>
                                <span class="movie-edit-age-text">
                                    <strong>All Ages</strong>
                                    <small>No age restriction</small>
                                </span>
                                <span class="movie-edit-age-check" aria-hidden="true">✓</span>
                            </span>
                        </label>
                        <label class="movie-edit-age-option" for="IsForAdultsTrue">
                            @Html.RadioButtonFor(m => m.IsForAdults, true, new { id = "IsForAdultsTrue", required = "required" })
                            <span class="movie-edit-age-body">
                                <span class="movie-edit-age-symbol movie-edit-age-adult">18+</span>
                                <span class="movie-edit-age-text">
                                    <strong>Adults Only</strong>
                                    <small>For viewers aged 18 and over</small>
                                </span>
                                <span class="movie-edit-age-check" aria-hidden="true">✓</span>
                            </span>
                        </label>
                        @Html.ValidationMessageFor(m => m.IsForAdults, "", new { @class = "text-danger" })
                    </fieldset>
                </section>
            </div>

            <aside class="movie-edit-sidebar" aria-label="Trailer and movie information">
                <section class="movie-edit-panel movie-edit-trailer" aria-labelledby="movie-edit-trailer-title">
                    <div class="movie-edit-panel-head">
                        <span class="movie-edit-step">04</span>
                        <div>
                            <h2 id="movie-edit-trailer-title">Video Trailer</h2>
                            <p>Preview or replace the trailer video.</p>
                        </div>
                    </div>
                    @if (hasTrailer)
                    {
                        <div class="movie-edit-existing-video">
                            <div class="movie-edit-video-caption"><span class="movie-edit-presence-dot"></span>Current Trailer</div>
                            <video controls preload="metadata" playsinline aria-label="Current movie trailer">
                                <source src="@trailerUrl" type="@trailerMime" />
                                Your browser does not support video playback.
                            </video>
                            <div class="movie-edit-video-name" title="@trailerFileName">@trailerFileName</div>
                        </div>
                    }
                    else
                    {
                        <div class="movie-edit-no-video">
                            <span class="movie-edit-empty-icon" aria-hidden="true">▷</span>
                            <strong>No Trailer Uploaded</strong>
                            <span>You can upload a video below.</span>
                        </div>
                    }

                    <div class="movie-edit-upload-title">REPLACE TRAILER</div>
                    <label class="form-label" for="videoFile">Choose a Video File</label>
                    <input type="file" name="videoFile" id="videoFile" class="form-control movie-edit-file-input" accept=".mp4,.webm,.ogg,video/mp4,video/webm,video/ogg" aria-describedby="movieEditUploadHint videoClientError" />
                    <small id="movieEditUploadHint" class="movie-edit-field-hint">MP4, WebM, or Ogg · maximum 200 MB</small>
                    <div id="videoClientError" class="movie-edit-upload-error" role="alert" hidden></div>
                    @Html.ValidationMessage("videoFile", "", new { @class = "text-danger" })

                    <div id="newTrailerPreview" class="movie-edit-new-preview" hidden>
                        <span class="movie-edit-preview-caption">NEW VIDEO PREVIEW</span>
                        <video id="newTrailerVideo" controls preload="metadata" playsinline aria-label="New trailer preview before saving"></video>
                        <div class="movie-edit-file-meta">
                            <strong id="videoFileName"></strong>
                            <span id="videoFileSize"></span>
                        </div>
                    </div>
                    <p class="movie-edit-trailer-note">If you do not select a new video, the current trailer will remain unchanged.</p>
                </section>

                <section class="movie-edit-panel movie-edit-summary" aria-labelledby="movie-edit-summary-title">
                    <div class="movie-edit-summary-top">
                        <span class="cinema-eyebrow">MOVIE INFORMATION</span>
                        <h2 id="movie-edit-summary-title">Status Overview</h2>
                        <span class="movie-edit-status-indicator" id="movieEditStatusIndicator">@currentStatus</span>
                    </div>
                    <div class="movie-edit-summary-row"><span>Movie ID</span><strong>#@Model.Id</strong></div>
                    <div class="movie-edit-summary-row"><span>Release Date</span><strong id="movieEditReleaseSummary">@Model.ReleaseDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)</strong></div>
                    <div class="movie-edit-summary-row"><span>Trailer</span><strong>@(hasTrailer ? "Uploaded" : "Not Uploaded")</strong></div>
                    <p class="movie-edit-summary-help">If you change the release date, the movie status will be recalculated after saving.</p>
                </section>
            </aside>
        </div>

        <div class="movie-edit-footer-actions">
            <a class="btn btn-outline-secondary" href="@Url.Action(returnSection, "Movies")">Cancel</a>
            <a class="btn btn-outline-primary" href="@Url.Action("Details", "Movies", new { id = Model.Id })">View Movie</a>
            <button id="movieSubmitButton" type="submit" class="btn btn-primary movie-edit-submit">
                <span id="movieSubmitButtonText">Save Changes</span><span aria-hidden="true">→</span>
            </button>
        </div>
    }
</div>

<style>
    .movie-edit-page {
        --me-border: rgba(255,255,255,.105);
        --me-panel: #101722;
        --me-muted: #929dad;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        min-width: 0;
        color: var(--cinema-text,#f5f7fb)
    }

    .movie-edit-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        min-height: 220px;
        padding: clamp(1.7rem,3.6vw,2.9rem);
        overflow: hidden;
        border: 1px solid var(--me-border);
        border-radius: 24px;
        background: radial-gradient(circle at 100% 0%,rgba(214,168,75,.095),transparent 36%),linear-gradient(125deg,#151e2d 0%,#0a0e16 85%)
    }

        .movie-edit-hero:after {
            position: absolute;
            right: -80px;
            top: -190px;
            width: 365px;
            height: 365px;
            border: 1px solid rgba(214,168,75,.07);
            border-radius: 50%;
            content: "";
            pointer-events: none
        }

    .movie-edit-hero-copy {
        position: relative;
        z-index: 1;
        max-width: 690px
    }

    .movie-edit-back {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: 1.35rem;
        padding: .45rem .75rem;
        color: #bfc7d3;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 9px;
        background: rgba(255,255,255,.025);
        font-size: .77rem;
        font-weight: 650;
        text-decoration: none;
        transition: color .2s,border-color .2s,background .2s
    }

        .movie-edit-back span {
            color: var(--cinema-gold-light,#f0cb76);
            font-size: 1.1rem;
            line-height: 1
        }

        .movie-edit-back:hover {
            color: var(--cinema-gold-light,#f0cb76);
            border-color: rgba(214,168,75,.4);
            background: rgba(214,168,75,.055);
            text-decoration: none
        }

    .movie-edit-hero .cinema-eyebrow {
        margin-bottom: .7rem;
        font-size: .67rem
    }

    .movie-edit-hero h1 {
        margin: 0 0 .7rem;
        font-size: clamp(2.3rem,4.4vw,3.6rem);
        line-height: 1.08;
        letter-spacing: -.05em
    }

    .movie-edit-hero p {
        max-width: 620px;
        margin: 0;
        color: #afb9c7;
        font-size: .91rem;
        line-height: 1.7
    }

    .movie-edit-hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .55rem;
        margin-top: 1.2rem
    }

    .movie-edit-tag {
        display: inline-flex;
        align-items: center;
        padding: .35rem .65rem;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 7px;
        color: #c7ceda;
        font-size: .71rem;
        font-weight: 700;
        background: rgba(255,255,255,.035)
    }

    .movie-edit-tag-status {
        border-color: rgba(214,168,75,.26);
        color: var(--cinema-gold-light,#f0cb76);
        background: rgba(214,168,75,.065)
    }

    .movie-edit-hero-art {
        position: relative;
        z-index: 1;
        display: grid;
        flex: 0 0 126px;
        place-items: center;
        width: 126px;
        height: 126px;
        border: 1px solid rgba(214,168,75,.16);
        border-radius: 28px;
        background: rgba(214,168,75,.038)
    }

    .movie-edit-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem
    }

    .movie-edit-layout {
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(295px,335px);
        gap: 1.15rem;
        align-items: start
    }

    .movie-edit-main, .movie-edit-sidebar {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 1.15rem
    }

    .movie-edit-panel {
        min-width: 0;
        padding: clamp(1.2rem,2.6vw,1.75rem);
        border: 1px solid var(--me-border);
        border-radius: 21px;
        background: linear-gradient(150deg,rgba(19,27,40,.98),rgba(10,14,22,.98));
        box-shadow: 0 13px 33px rgba(0,0,0,.15)
    }

    .movie-edit-panel-head {
        display: flex;
        align-items: center;
        gap: .8rem;
        margin-bottom: 1.25rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--me-border)
    }

    .movie-edit-step {
        display: grid;
        flex: 0 0 36px;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 1px solid rgba(214,168,75,.24);
        border-radius: 10px;
        background: rgba(214,168,75,.075);
        color: #f0cb76;
        font-size: .65rem;
        font-weight: 850
    }

    .movie-edit-panel-head h2 {
        margin: 0 0 .15rem;
        color: #f5f7fb;
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.3
    }

    .movie-edit-panel-head p {
        margin: 0;
        color: var(--me-muted);
        font-size: .77rem;
        line-height: 1.55
    }

    .movie-edit-fields {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 1rem 1.1rem
    }

    .movie-edit-field {
        min-width: 0
    }

    .movie-edit-full {
        grid-column: 1/-1
    }

    .movie-edit-field-spaced {
        margin-top: 1.05rem
    }

    .movie-edit-page .form-label {
        display: block;
        margin-bottom: .43rem;
        color: #d7deea;
        font-size: .81rem;
        font-weight: 700
    }

    .movie-edit-page .form-control {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 45px;
        padding: .65rem .85rem;
        border: 1px solid rgba(168,183,207,.25);
        border-radius: 10px;
        background: #101722;
        color: #f5f7fb;
        font-size: .88rem;
        line-height: 1.45;
        box-shadow: none;
        transition: border-color .2s,box-shadow .2s
    }

        .movie-edit-page .form-control::placeholder {
            color: #8390a2;
            opacity: 1
        }

        .movie-edit-page .form-control:focus {
            border-color: #d6a84b;
            background: #111a26;
            color: #fff;
            box-shadow: 0 0 0 3px rgba(214,168,75,.12);
            outline: none
        }

        .movie-edit-page .form-control[type=date] {
            color-scheme: dark
        }

            .movie-edit-page .form-control[type=date]::-webkit-calendar-picker-indicator {
                cursor: pointer;
                opacity: .85
            }

        .movie-edit-page .form-control:disabled {
            opacity: .6
        }

    .movie-edit-input-unit {
        position: relative
    }

        .movie-edit-input-unit .form-control {
            padding-right: 4rem
        }

        .movie-edit-input-unit > span {
            position: absolute;
            top: 50%;
            right: .9rem;
            color: #abb4c3;
            font-size: .75rem;
            pointer-events: none;
            transform: translateY(-50%)
        }

    .movie-edit-field-hint {
        display: block;
        margin-top: .42rem;
        color: var(--me-muted);
        font-size: .73rem;
        line-height: 1.6
    }

    .movie-edit-page .text-danger {
        display: block;
        margin-top: .35rem;
        color: #ff9aa4 !important;
        font-size: .75rem;
        line-height: 1.5
    }

    .movie-edit-description {
        min-height: 132px !important;
        resize: vertical;
        line-height: 1.7 !important
    }

    .movie-edit-age-options {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: .8rem;
        margin: 0;
        padding: 0;
        border: 0
    }

    .movie-edit-age-option {
        display: block;
        position: relative;
        min-width: 0;
        margin: 0;
        cursor: pointer
    }

        .movie-edit-age-option input {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 1px;
            height: 1px;
            opacity: 0
        }

    .movie-edit-age-body {
        display: flex;
        align-items: center;
        gap: .7rem;
        height: 100%;
        min-height: 93px;
        padding: .9rem;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 13px;
        background: rgba(255,255,255,.022);
        transition: border-color .2s,box-shadow .2s,background .2s
    }

    .movie-edit-age-option:hover .movie-edit-age-body {
        border-color: rgba(214,168,75,.3);
        background: rgba(214,168,75,.035)
    }

    .movie-edit-age-option input:checked + .movie-edit-age-body {
        border-color: rgba(214,168,75,.62);
        box-shadow: 0 0 0 2px rgba(214,168,75,.075);
        background: rgba(214,168,75,.068)
    }

    .movie-edit-age-option input:focus-visible + .movie-edit-age-body {
        outline: 2px solid var(--cinema-gold-light,#f0cb76);
        outline-offset: 3px
    }

    .movie-edit-age-symbol {
        display: grid;
        flex: 0 0 45px;
        place-items: center;
        width: 45px;
        height: 45px;
        border: 1px solid rgba(66,199,131,.23);
        border-radius: 50%;
        color: #9be3b9;
        background: rgba(66,199,131,.08);
        font-size: .68rem;
        font-weight: 850
    }

    .movie-edit-age-adult {
        color: #ff9ca7;
        border-color: rgba(239,102,115,.24);
        background: rgba(239,102,115,.08)
    }

    .movie-edit-age-text {
        min-width: 0;
        flex: 1
    }

        .movie-edit-age-text strong {
            display: block;
            font-size: .8rem;
            color: #f5f7fb;
            line-height: 1.35
        }

        .movie-edit-age-text small {
            display: block;
            margin-top: .26rem;
            color: #98a4b5;
            font-size: .69rem;
            line-height: 1.45
        }

    .movie-edit-age-check {
        visibility: hidden;
        align-self: flex-start;
        color: var(--cinema-gold-light,#f0cb76);
        font-size: .95rem;
