@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            "use strict";
            var form = document.getElementById("movieEditForm");
            var fileInput = document.getElementById("videoFile");
            var errorBox = document.getElementById("videoClientError");
            var preview = document.getElementById("newTrailerPreview");
            var previewVideo = document.getElementById("newTrailerVideo");
            var fileName = document.getElementById("videoFileName");
            var fileSize = document.getElementById("videoFileSize");
            var dateInput = document.getElementById("ReleaseDate");
            var statusIndicator = document.getElementById("movieEditStatusIndicator");
            var heroStatus = document.getElementById("heroStatus");
            var dateSummary = document.getElementById("movieEditReleaseSummary");
            var submitButton = document.getElementById("movieSubmitButton");
            var submitLabel = document.getElementById("movieSubmitButtonText");
            var maxSize = 200 * 1024 * 1024;
            var today = "@todayValue";
            var previewUrl = null;
            var isSubmitting = false;

            if (!form || !fileInput || !errorBox || !preview || !previewVideo || !submitButton) return;

            function selectedFile() {
                return fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
            }
            function showError(message) {
                errorBox.textContent = message;
                errorBox.hidden = !message;
                if (message) fileInput.setAttribute("aria-invalid", "true");
                else fileInput.removeAttribute("aria-invalid");
            }
            function clearPreview() {
                previewVideo.pause();
                previewVideo.removeAttribute("src");
                previewVideo.load();
                preview.hidden = true;
                if (previewUrl && window.URL && URL.revokeObjectURL) URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            function validateVideo() {
                var file = selectedFile();
                if (!file) { showError(""); return true; }
                if (file.size <= 0) { showError("The selected file is empty."); return false; }
                if (file.size > maxSize) { showError("The video must not exceed 200 MB."); return false; }
                if (!/\.(mp4|webm|ogg)$/i.test(file.name)) { showError("Only MP4, WebM, and Ogg video files are allowed."); return false; }
                showError("");
                return true;
            }
            function updateVideo() {
                clearPreview();
                if (!validateVideo()) return;
                var file = selectedFile();
                if (!file) return;
                fileName.textContent = file.name;
                fileSize.textContent = (file.size / (1024 * 1024)).toFixed(1) + " MB";
                if (window.URL && URL.createObjectURL) {
                    previewUrl = URL.createObjectURL(file);
                    previewVideo.src = previewUrl;
                    preview.hidden = false;
                }
            }
            function updateDateStatus() {
                if (!dateInput || !dateInput.value) return;
                var isCurrent = dateInput.value <= today;
                var label = isCurrent ? "Now Showing" : "Coming Soon";
                if (statusIndicator) {
                    statusIndicator.textContent = label;
                    statusIndicator.classList.toggle("is-soon", !isCurrent);
                }
                if (heroStatus) heroStatus.textContent = label;
                if (dateSummary) {
                    var parts = dateInput.value.split("-");
                    if (parts.length === 3) dateSummary.textContent = parts[2] + "." + parts[1] + "." + parts[0];
                }
            }
            fileInput.addEventListener("change", updateVideo);
            if (dateInput) dateInput.addEventListener("change", updateDateStatus);
            updateDateStatus();

            form.addEventListener("submit", function (event) {
                if (isSubmitting) { event.preventDefault(); return; }
                if (!validateVideo()) { event.preventDefault(); fileInput.focus(); return; }
                if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); return; }
                if (window.jQuery && window.jQuery.validator && typeof window.jQuery(form).valid === "function" && !window.jQuery(form).valid()) {
                    event.preventDefault();
                    return;
                }
                if (event.defaultPrevented) return;
                isSubmitting = true;
                submitButton.disabled = true;
                submitButton.setAttribute("aria-busy", "true");
                if (submitLabel) submitLabel.textContent = "Saving...";
            });
            window.addEventListener("pageshow", function (event) {
                if (event.persisted) {
                    isSubmitting = false;
                    submitButton.disabled = false;
                    submitButton.removeAttribute("aria-busy");
                    if (submitLabel) submitLabel.textContent = "Save Changes";
                    updateVideo();
                    updateDateStatus();
                }
            });
            window.addEventListener("pagehide", clearPreview);
        })();
    </script>
}