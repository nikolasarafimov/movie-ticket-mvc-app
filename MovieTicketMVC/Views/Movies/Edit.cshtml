@using System
@model MovieTicketMVC.Models.Movie

@{
    ViewBag.Title = "Измени филм";

    var returnSection =
        ViewBag.ReturnSection as string;

    if (returnSection != "Current" &&
        returnSection != "ComingSoon")
    {
        returnSection =
            Model.ReleaseDate.Date <= DateTime.Today
                ? "Current"
                : "ComingSoon";
    }

    var releaseDateValue =
        Model.ReleaseDate != default(DateTime)
            ? Model.ReleaseDate.ToString("yyyy-MM-dd")
            : string.Empty;

    var hasTrailer =
        !string.IsNullOrWhiteSpace(
            Model.LocalTrailerPath);

    var trailerUrl =
        string.Empty;

    var trailerMime =
        "video/mp4";

    var trailerFileName =
        string.Empty;

    if (hasTrailer)
    {
        trailerUrl =
            Url.Content(
                Model.LocalTrailerPath);

        trailerFileName =
            System.IO.Path.GetFileName(
                Model.LocalTrailerPath);

        var extension =
            System.IO.Path.GetExtension(
                Model.LocalTrailerPath);

        if (!string.IsNullOrWhiteSpace(extension))
        {
            extension =
                extension.ToLowerInvariant();

            if (extension == ".webm")
            {
                trailerMime =
                    "video/webm";
            }
            else if (extension == ".ogg")
            {
                trailerMime =
                    "video/ogg";
            }
        }
    }
}

<main class="movie-editor-page"
      aria-labelledby="movie-editor-title">

    <section class="movie-editor-header">

        <div class="movie-editor-header-content">

            <div class="cinema-eyebrow">
                ADMIN · MOVIE CATALOG
            </div>

            <h1 id="movie-editor-title">
                Измени
                <span class="cinema-text-gradient">
                    филм
                </span>
            </h1>

            <p>
                Ажурирај ги информациите, датумот на премиера,
                актерската екипа или замени го постоечкиот trailer.
            </p>

        </div>

        <div class="movie-editor-header-badge"
             aria-hidden="true">

            <span>
                EDIT
            </span>

            <strong>
                ✦
            </strong>

        </div>

    </section>


    @using (Html.BeginForm(
        "Edit",
        "Movies",
        FormMethod.Post,
        new
        {
            enctype = "multipart/form-data",
            role = "form",
            id = "movieEditForm",
            @class = "movie-editor-form"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
            true,
            "",
            new
            {
                @class =
                    "validation-summary-errors movie-editor-validation"
            })

        @Html.HiddenFor(
            m => m.Id)

        @Html.Hidden(
            "ReturnSection",
            returnSection)


        <div class="movie-editor-layout">

            <div class="movie-editor-main">

                <section class="cinema-panel movie-editor-section">

                    <div class="movie-editor-section-heading">

                        <span class="movie-editor-step">
                            01
                        </span>

                        <div>
                            <h2>
                                Основни информации
                            </h2>

                            <p>
                                Измени ги податоците што се
                                прикажуваат во филмскиот каталог.
                            </p>
                        </div>

                    </div>


                    <div class="movie-editor-fields">

                        <div class="form-group movie-editor-field-full">

                            @Html.LabelFor(
                                m => m.Title,
                                "Наслов",
                                new
                                {
                                    @class =
                                        "form-label"
                                })

                            @Html.TextBoxFor(
                                m => m.Title,
                                new
                                {
                                    @class =
                                        "form-control movie-editor-input",
                                    autocomplete =
                                        "off",
                                    placeholder =
                                        "Наслов на филмот"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Title,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(
                                m => m.Genre,
                                "Жанр",
                                new
                                {
                                    @class =
                                        "form-label"
                                })

                            @Html.TextBoxFor(
                                m => m.Genre,
                                new
                                {
                                    @class =
                                        "form-control",
                                    autocomplete =
                                        "off",
                                    placeholder =
                                        "Драма, Трилер..."
                                })

                            @Html.ValidationMessageFor(
                                m => m.Genre,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(
                                m => m.Language,
                                "Јазик / Произведено во",
                                new
                                {
                                    @class =
                                        "form-label"
                                })

                            @Html.TextBoxFor(
                                m => m.Language,
                                new
                                {
                                    @class =
                                        "form-control",
                                    autocomplete =
                                        "off",
                                    placeholder =
                                        "Англиски"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Language,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(
                                m => m.LengthInMinutes,
                                "Времетраење",
                                new
                                {
                                    @class =
                                        "form-label"
                                })

                            <div class="movie-editor-input-unit">

                                @Html.TextBoxFor(
                                    m => m.LengthInMinutes,
                                    new
                                    {
                                        @class =
                                            "form-control",
                                        type =
                                            "number",
                                        min =
                                            "1",
                                        max =
                                            "600"
                                    })

                                <span>
                                    мин.
                                </span>

                            </div>

                            @Html.ValidationMessageFor(
                                m => m.LengthInMinutes,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(
                                m => m.Rating,
                                "Оценка",
                                new
                                {
                                    @class =
                                        "form-label"
                                })

                            <div class="movie-editor-input-unit">

                                @Html.TextBoxFor(
                                    m => m.Rating,
                                    new
                                    {
                                        @class =
                                            "form-control",
                                        type =
                                            "number",
                                        min =
                                            "0",
                                        max =
                                            "10",
                                        step =
                                            "0.1"
                                    })

                                <span>
                                    / 10
                                </span>

                            </div>

                            @Html.ValidationMessageFor(
                                m => m.Rating,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })

                        </div>


                        <div class="form-group movie-editor-field-full">

                            @Html.LabelFor(
                                m => m.ReleaseDate,
                                "Датум на премиера",
                                new
                                {
                                    @class =
                                        "form-label"
                                })

                            @Html.TextBox(
                                "ReleaseDate",
                                releaseDateValue,
                                new
                                {
                                    @class =
                                        "form-control",
                                    type =
                                        "date"
                                })

                            <small class="movie-editor-help">
                                Промена на датумот може автоматски
                                да го премести филмот меѓу
                                „Актуелни“ и „Наскоро“.
                            </small>

                            @Html.ValidationMessageFor(
                                m => m.ReleaseDate,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })

                        </div>

                    </div>

                </section>


                <section class="cinema-panel movie-editor-section">

                    <div class="movie-editor-section-heading">

                        <span class="movie-editor-step">
                            02
                        </span>

                        <div>
                            <h2>
                                Содржина
                            </h2>

                            <p>
                                Описот и актерската екипа што
                                корисниците ќе ги видат на
                                detail страницата.
                            </p>
                        </div>

                    </div>


                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.Description,
                            "Опис",
                            new
                            {
                                @class =
                                    "form-label"
                            })

                        @Html.TextAreaFor(
                            m => m.Description,
                            7,
                            50,
                            new
                            {
                                @class =
                                    "form-control movie-editor-description",
                                placeholder =
                                    "Краток опис на приказната..."
                            })

                        @Html.ValidationMessageFor(
                            m => m.Description,
                            "",
                            new
                            {
                                @class =
                                    "text-danger"
                            })

                    </div>


                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.Actors,
                            "Актерска екипа",
                            new
                            {
                                @class =
                                    "form-label"
                            })

                        @Html.TextBoxFor(
                            m => m.Actors,
                            new
                            {
                                @class =
                                    "form-control",
                                autocomplete =
                                    "off",
                                placeholder =
                                    "Actor One, Actor Two, Actor Three"
                            })

                        <small class="movie-editor-help">
                            Оддели ги имињата со запирка.
                        </small>

                        @Html.ValidationMessageFor(
                            m => m.Actors,
                            "",
                            new
                            {
                                @class =
                                    "text-danger"
                            })

                    </div>

                </section>


                <section class="cinema-panel movie-editor-section">

                    <div class="movie-editor-section-heading">

                        <span class="movie-editor-step">
                            03
                        </span>

                        <div>
                            <h2>
                                Возрасна категорија
                            </h2>

                            <p>
                                Измени ја рестрикцијата за
                                гледање на филмот.
                            </p>
                        </div>

                    </div>


                    <fieldset class="movie-age-selector">

                        <legend class="visually-hidden">
                            Возрасна рестрикција
                        </legend>


                        <label class="movie-age-option"
                               for="IsForAdultsFalse">

                            @Html.RadioButtonFor(
                                m => m.IsForAdults,
                                false,
                                new
                                {
                                    @class =
                                        "movie-age-radio",
                                    id =
                                        "IsForAdultsFalse"
                                })

                            <span class="movie-age-visual">

                                <span class="movie-age-symbol">
                                    ALL
                                </span>

                                <span class="movie-age-copy">

                                    <strong>
                                        Без рестрикција
                                    </strong>

                                    <small>
                                        Достапен за сите
                                        возрасни категории
                                    </small>

                                </span>

                            </span>

                        </label>


                        <label class="movie-age-option"
                               for="IsForAdultsTrue">

                            @Html.RadioButtonFor(
                                m => m.IsForAdults,
                                true,
                                new
                                {
                                    @class =
                                        "movie-age-radio",
                                    id =
                                        "IsForAdultsTrue"
                                })

                            <span class="movie-age-visual">

                                <span class="movie-age-symbol adult">
                                    18+
                                </span>

                                <span class="movie-age-copy">

                                    <strong>
                                        Само за возрасни
                                    </strong>

                                    <small>
                                        Потребна е возраст од
                                        најмалку 18 години
                                    </small>

                                </span>

                            </span>

                        </label>


                        <div>
                            @Html.ValidationMessageFor(
                                m => m.IsForAdults,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger"
                                })
                        </div>

                    </fieldset>

                </section>

            </div>


            <aside class="movie-editor-sidebar">

                <section class="cinema-panel movie-trailer-editor">

                    <div class="movie-editor-section-heading compact">

                        <span class="movie-editor-step">
                            04
                        </span>

                        <div>
                            <h2>
                                Trailer
                            </h2>

                            <p>
                                Преглед и замена на видеото.
                            </p>
                        </div>

                    </div>


                    <div id="existingTrailerContainer">

                        @if (hasTrailer)
                        {
                            <div class="movie-current-trailer">

                                <div class="movie-current-trailer-header">

                                    <span class="movie-trailer-live-dot">
                                    </span>

                                    <span>
                                        CURRENT TRAILER
                                    </span>

                                </div>

                                <div class="movie-current-trailer-video">

                                    <video controls
                                           preload="metadata"
                                           playsinline>

                                        <source src="@trailerUrl"
                                                type="@trailerMime" />

                                        Вашиот прелистувач не
                                        поддржува HTML5 видео.
                                    </video>

                                </div>

                                <div class="movie-current-trailer-file">

                                    <span>
                                        ▶
                                    </span>

                                    <div>

                                        <strong>
                                            @trailerFileName
                                        </strong>

                                        <small>
                                            Тековно видео
                                        </small>

                                    </div>

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="movie-no-current-trailer">

                                <span aria-hidden="true">
                                    ◇
                                </span>

                                <strong>
                                    Нема trailer
                                </strong>

                                <small>
                                    Можеш да прикачиш ново
                                    видео подолу.
                                </small>

                            </div>
                        }

                    </div>


                    <div class="movie-trailer-divider">

                        <span>
                            ЗАМЕНИ TRAILER
                        </span>

                    </div>


                    <label for="videoFile"
                           class="movie-upload-dropzone">

                        <span class="movie-upload-icon"
                              aria-hidden="true">
                            ▶
                        </span>

                        <strong>
                            Избери ново видео
                        </strong>

                        <span>
                            MP4, WebM или Ogg
                        </span>

                        <small>
                            Максимум 200 MB
                        </small>

                        <span class="btn btn-outline-primary btn-sm movie-upload-button">
                            Избери датотека
                        </span>

                    </label>


                    <input type="file"
                           name="videoFile"
                           id="videoFile"
                           class="movie-upload-input"
                           accept="video/mp4,video/webm,video/ogg" />


                    <div id="newTrailerPreview"
                         class="movie-new-trailer-preview"
                         hidden>

                        <div class="movie-new-trailer-label">

                            <span>
                                NEW
                            </span>

                            Нов trailer пред зачувување

                        </div>

                        <video id="newTrailerVideo"
                               controls
                               preload="metadata"
                               playsinline>
                        </video>

                    </div>


                    <div id="videoFileInfo"
                         class="movie-upload-file-info"
                         hidden>

                        <div class="movie-upload-file-icon">
                            ▶
                        </div>

                        <div>

                            <strong id="videoFileName">
                            </strong>

                            <span id="videoFileSize">
                            </span>

                        </div>

                    </div>


                    <div id="videoClientError"
                         class="text-danger movie-upload-client-error"
                         hidden>
                    </div>


                    @Html.ValidationMessage(
                        "videoFile",
                        "",
                        new
                        {
                            @class =
                                "text-danger"
                        })


                    <p class="movie-trailer-help">
                        Ако не избереш нова датотека,
                        постоечкиот trailer ќе остане непроменет.
                    </p>

                </section>


                <section class="cinema-panel movie-editor-summary">

                    <span class="movie-editor-summary-label">
                        MOVIE STATUS
                    </span>

                    <h3>
                        @(Model.ReleaseDate.Date <= DateTime.Today
                            ? "Актуелен филм"
                            : "Наскоро")
                    </h3>

                    <p>
                        Статусот автоматски се пресметува
                        според датумот на премиера.
                    </p>

                    <div class="movie-editor-summary-line"></div>

                    <div class="movie-editor-summary-item">

                        <span>
                            ID
                        </span>

                        <strong>
                            #@Model.Id
                        </strong>

                    </div>

                    <div class="movie-editor-summary-item">

                        <span>
                            Премиера
                        </span>

                        <strong>
                            @Model.ReleaseDate.ToString(
                                "dd.MM.yyyy")
                        </strong>

                    </div>

                    <div class="movie-editor-summary-item">

                        <span>
                            Trailer
                        </span>

                        <strong>
                            @(hasTrailer
                                ? "Достапен"
                                : "Нема")
                        </strong>

                    </div>

                </section>

            </aside>

        </div>


        <div class="movie-editor-actions">

            <a class="btn btn-outline-secondary"
               href="@Url.Action(
                   returnSection,
                   "Movies")">
                Откажи
            </a>

            <a class="btn btn-outline-primary"
               href="@Url.Action(
                   "Details",
                   "Movies",
                   new
                   {
                       id = Model.Id
                   })">
                Прегледај филм
            </a>

            <button type="submit"
                    id="movieSubmitButton"
                    class="btn btn-primary movie-editor-submit">

                <span>
                    Зачувај промени
                </span>

                <span aria-hidden="true">
                    →
                </span>

            </button>

        </div>
    }

</main>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            var fileInput =
                document.getElementById(
                    "videoFile");

            var fileInfo =
                document.getElementById(
                    "videoFileInfo");

            var fileName =
                document.getElementById(
                    "videoFileName");

            var fileSize =
                document.getElementById(
                    "videoFileSize");

            var clientError =
                document.getElementById(
                    "videoClientError");

            var previewContainer =
                document.getElementById(
                    "newTrailerPreview");

            var previewVideo =
                document.getElementById(
                    "newTrailerVideo");

            var form =
                document.getElementById(
                    "movieEditForm");

            var submitButton =
                document.getElementById(
                    "movieSubmitButton");

            var maxFileSize =
                200 * 1024 * 1024;

            var previewUrl =
                null;


            function formatFileSize(bytes) {
                if (!bytes) {
                    return "0 MB";
                }

                return (
                    bytes /
                    1024 /
                    1024
                ).toFixed(1) + " MB";
            }


            function clearClientError() {
                clientError.textContent =
                    "";

                clientError.hidden =
                    true;
            }


            function showClientError(message) {
                clientError.textContent =
                    message;

                clientError.hidden =
                    false;
            }


            function clearPreview() {
                if (previewUrl) {
                    URL.revokeObjectURL(
                        previewUrl);

                    previewUrl =
                        null;
                }

                previewVideo.removeAttribute(
                    "src");

                previewVideo.load();

                previewContainer.hidden =
                    true;
            }


            fileInput.addEventListener(
                "change",
                function () {

                    clearClientError();
                    clearPreview();

                    if (
                        !fileInput.files ||
                        fileInput.files.length === 0
                    ) {
                        fileInfo.hidden =
                            true;

                        return;
                    }

                    var file =
                        fileInput.files[0];

                    fileName.textContent =
                        file.name;

                    fileSize.textContent =
                        formatFileSize(
                            file.size);

                    fileInfo.hidden =
                        false;

                    if (
                        file.size >
                        maxFileSize
                    ) {
                        showClientError(
                            "Видео датотеката не смее да биде поголема од 200 MB.");

                        return;
                    }

                    previewUrl =
                        URL.createObjectURL(
                            file);

                    previewVideo.src =
                        previewUrl;

                    previewContainer.hidden =
                        false;
                });


            form.addEventListener(
                "submit",
                function (event) {

                    clearClientError();

                    if (
                        fileInput.files &&
                        fileInput.files.length > 0 &&
                        fileInput.files[0].size >
                            maxFileSize
                    ) {
                        event.preventDefault();

                        showClientError(
                            "Видео датотеката не смее да биде поголема од 200 MB.");

                        return;
                    }

                    submitButton.disabled =
                        true;

                    submitButton.querySelector(
                        "span:first-child"
                    ).textContent =
                        "Се зачувува...";
                });


            window.addEventListener(
                "beforeunload",
                function () {

                    if (previewUrl) {
                        URL.revokeObjectURL(
                            previewUrl);
                    }
                });
        })();
    </script>
}


<style>
    .movie-editor-page {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .movie-editor-header {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        padding: clamp(2rem, 5vw, 3.5rem);
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 88% 15%, rgba(90, 169, 255, 0.12), transparent 28% ), radial-gradient( circle at 70% 100%, rgba(214, 168, 75, 0.07), transparent 30% ), linear-gradient( 135deg, rgba(20, 27, 39, 0.98), rgba(8, 11, 17, 0.99) );
        box-shadow: var(--cinema-shadow);
    }

        .movie-editor-header::after {
            position: absolute;
            top: -150px;
            right: -90px;
            width: 340px;
            height: 340px;
            content: "";
            border: 1px solid rgba(90, 169, 255, 0.08);
            border-radius: 50%;
        }

    .movie-editor-header-content {
        position: relative;
        z-index: 1;
        max-width: 760px;
    }

    .movie-editor-header h1 {
        margin-bottom: 1rem;
    }

    .movie-editor-header p {
        max-width: 650px;
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 1.02rem;
    }

    .movie-editor-header-badge {
        position: relative;
        z-index: 1;
        display: grid;
        flex: 0 0 120px;
        place-items: center;
        width: 120px;
        height: 120px;
        border: 1px solid rgba(90, 169, 255, 0.20);
        border-radius: 28px;
        background: rgba(90, 169, 255, 0.055);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
    }

        .movie-editor-header-badge span {
            position: absolute;
            top: 1rem;
            color: #8fc4ff;
            font-size: 0.58rem;
            font-weight: 900;
            letter-spacing: 0.16em;
        }

        .movie-editor-header-badge strong {
            color: #8fc4ff;
            font-size: 2.6rem;
            font-weight: 400;
            line-height: 1;
        }


    /* =====================================================
       FORM
       ===================================================== */

    .movie-editor-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .movie-editor-validation:empty {
        display: none;
    }

    .movie-editor-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 370px;
        align-items: start;
        gap: 1.5rem;
    }

    .movie-editor-main {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 1.5rem;
    }

    .movie-editor-sidebar {
        position: sticky;
        top: 100px;
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 1.5rem;
