@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using System.Text.RegularExpressions
@model IEnumerable<MovieTicketMVC.Models.Movie>

@{
    ViewBag.Title = "Now Showing";
    ViewBag.ActiveMovieSection = "Current";

    var searchString =
        (Request.QueryString["searchString"] ?? string.Empty).Trim();

    var ageFilter =
        Request.QueryString["ageFilter"];

    var sortOrder =
        Request.QueryString["sortOrder"];

    var movies =
        Model != null
            ? Model.Where(m => m != null).ToList()
            : new List<MovieTicketMVC.Models.Movie>();

    var isAdmin =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated &&
        User.IsInRole("Admin");

    var isDescending =
        string.Equals(
            sortOrder,
            "title_desc",
            StringComparison.OrdinalIgnoreCase);

    var nextSortOrder =
        isDescending
            ? "title_asc"
            : "title_desc";
}

<div class="movies-page"
     aria-labelledby="movies-title">

    <section class="movies-hero">

        <div>
            <div class="cinema-eyebrow">
                NOW IN CINEMAS
            </div>

            <h1 id="movies-title">
                Now Showing
                <span class="cinema-text-gradient">
                    Movies
                </span>
            </h1>

            <p>
                Discover the movies playing right now,
                compare genres, ratings, and runtimes,
                and choose the next film for your
                movie night.
            </p>
        </div>

        <div class="movies-hero-actions">

            <div class="movies-count">
                <span>@movies.Count</span>

                <small>
                    @(movies.Count == 1
                        ? "movie"
                        : "movies")
                </small>
            </div>

            @if (isAdmin)
            {
                <a class="btn btn-primary"
                   href="@Url.Action("Create", "Movies")">

                    <span class="movies-button-icon"
                          aria-hidden="true">+</span>

                    Add Movie
                </a>
            }

        </div>

    </section>

    <section class="cinema-filter-bar movies-filter"
             aria-label="Filter movies">

        @using (Html.BeginForm(
            "Current",
            "Movies",
            FormMethod.Get,
            new
            {
                @class = "movies-filter-form",
                role = "search"
            }))
        {
            @Html.Hidden("sortOrder", sortOrder)

            <div class="movies-filter-field movies-search-field">

                <label for="searchString"
                       class="form-label">
                    Search Movies
                </label>

                <div class="movies-search-input">

                    <span class="movies-search-icon"
                          aria-hidden="true">⌕</span>

                    <input type="search"
                           id="searchString"
                           name="searchString"
                           value="@searchString"
                           class="form-control"
                           placeholder="Movie title..."
                           autocomplete="off" />

                </div>

            </div>

            <div class="movies-filter-field">

                <label for="ageFilter"
                       class="form-label">
                    Age Rating
                </label>

                <select id="ageFilter"
                        name="ageFilter"
                        class="form-select">

                    <option value=""
                            @(string.IsNullOrWhiteSpace(ageFilter) ? "selected" : "")>
                        All Movies
                    </option>

                    <option value="Over18"
                            @(string.Equals(ageFilter, "Over18", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>
                        18+ Only
                    </option>

                </select>

            </div>

            <div class="movies-filter-actions">

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Current", "Movies")">
                    Clear
                </a>

            </div>
        }

        <div class="movies-sort">

            <a class="btn btn-outline-secondary movies-sort-button"
               href="@Url.Action(
                   "Current",
                   "Movies",
                   new
                   {
                       sortOrder = nextSortOrder,
                       searchString = searchString,
                       ageFilter = ageFilter
                   })">

                @(isDescending
                    ? "Title: Z → A"
                    : "Title: A → Z")

            </a>

        </div>

    </section>

    @if (movies.Any())
    {
        <section class="movie-catalog"
                 aria-label="Movies now showing">

            @for (var index = 0; index < movies.Count; index++)
            {
                var movie = movies[index];

                var movieTitle =
                    string.IsNullOrWhiteSpace(movie.Title)
                        ? "Unknown Movie"
                        : movie.Title.Trim();

                var genre =
                    string.IsNullOrWhiteSpace(movie.Genre)
                        ? "Film"
                        : movie.Genre.Trim();

                var language =
                    string.IsNullOrWhiteSpace(movie.Language)
                        ? "Unknown"
                        : movie.Language.Trim();

                var cardNumber =
                    (index + 1).ToString(
                        "00",
                        CultureInfo.InvariantCulture);

                var ratingText =
                    movie.Rating.HasValue
                        ? movie.Rating.Value.ToString(
                            "0.0",
                            CultureInfo.InvariantCulture)
                        : "—";

                var releaseDateText =
                    movie.ReleaseDate.ToString(
                        "dd.MM.yyyy",
                        CultureInfo.InvariantCulture);

                var posterBaseName =
                    Regex.Replace(
                        movieTitle.ToLowerInvariant()
                            .Replace("’", string.Empty)
                            .Replace("‘", string.Empty)
                            .Replace("'", string.Empty),
                        @"[^a-z0-9]+",
                        "_").Trim('_');

                var posterUrl = string.Empty;

                if (!string.IsNullOrWhiteSpace(posterBaseName))
                {
                    var posterNames = new[]
                    {
                        posterBaseName,
                        posterBaseName + "_poster",
                        posterBaseName + "-poster"
                    };

                    var posterExtensions = new[]
                    {
                        ".png",
                        ".webp",
                        ".jpg",
                        ".jpeg"
                    };

                    foreach (var posterName in posterNames)
                    {
                        foreach (var extension in posterExtensions)
                        {
                            var virtualPath =
                                "~/Content/Images/"
                                + posterName
                                + extension;

                            var physicalPath =
                                System.Web.Hosting.HostingEnvironment
                                    .MapPath(virtualPath);

                            if (!string.IsNullOrEmpty(physicalPath) &&
                                System.IO.File.Exists(physicalPath))
                            {
                                posterUrl =
                                    Url.Content(virtualPath);

                                break;
                            }
                        }

                        if (!string.IsNullOrEmpty(posterUrl))
                        {
                            break;
                        }
                    }
                }

                var hasPoster =
                    !string.IsNullOrEmpty(posterUrl);

                <article class="catalog-movie-card">

                    <div class="catalog-movie-visual @(hasPoster ? "catalog-has-poster" : "catalog-no-poster")">

                        @if (hasPoster)
                        {
                            <img class="catalog-movie-poster"
                                 src="@posterUrl"
                                 alt=""
                                 loading="lazy"
                                 decoding="async" />
                        }

                        <div class="catalog-card-glow"
                             aria-hidden="true">
                        </div>

                        <div class="catalog-card-shade"
                             aria-hidden="true">
                        </div>

                        <div class="catalog-card-top">

                            <span class="catalog-index">
                                @cardNumber
                            </span>

                            <span class="catalog-status-badge">
                                <span class="catalog-status-dot"
                                      aria-hidden="true">
                                </span>

                                NOW SHOWING
                            </span>

                        </div>

                        <div class="catalog-visual-content">

                            <span class="catalog-genre">
                                @genre
                            </span>

                            <h2>
                                @movieTitle
                            </h2>

                            <div class="catalog-rating-row">

                                <div class="catalog-rating"
                                     aria-label="Rating: @(movie.Rating.HasValue ? ratingText + " out of 10" : "not rated")">

                                    @if (movie.Rating.HasValue)
                                    {
                                        <span aria-hidden="true">
                                            ★
                                        </span>

                                        <strong>
                                            @ratingText
                                        </strong>

                                        <small>
                                            / 10
                                        </small>
                                    }
                                    else
                                    {
                                        <strong>
                                            Not Rated
                                        </strong>
                                    }

                                </div>

                                @if (movie.IsForAdults == true)
                                {
                                    <span class="catalog-age-badge adult"
                                          aria-label="Ages 18 and over only">
                                        18+
                                    </span>
                                }
                                else if (movie.IsForAdults == false)
                                {
                                    <span class="catalog-age-badge"
                                          aria-label="Suitable for all ages">
                                        ALL AGES
                                    </span>
                                }
                                else
                                {
                                    <span class="catalog-age-badge unknown"
                                          aria-label="Age rating unknown">
                                        —
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <div class="catalog-movie-body">

                        <div class="catalog-meta">

                            <div class="catalog-meta-item">

                                <span>
                                    DURATION
                                </span>

                                <strong>
                                    @movie.LengthInMinutes min
                                </strong>

                            </div>

                            <div class="catalog-meta-item">

                                <span>
                                    LANGUAGE
                                </span>

                                <strong title="@language">
                                    @language
                                </strong>

                            </div>

                            <div class="catalog-meta-item">

                                <span>
                                    RELEASE DATE
                                </span>

                                <strong>
                                    @releaseDateText
                                </strong>

                            </div>

                        </div>

                        <div class="catalog-actions">

                            <a class="btn btn-primary"
                               href="@Url.Action(
                                   "Details",
                                   "Movies",
                                   new { id = movie.Id })"
                               aria-label="Details for @movieTitle">

                                Movie Details

                                <span aria-hidden="true">
                                    →
                                </span>

                            </a>

                        </div>

                        @if (isAdmin)
                        {
                            <div class="catalog-admin-actions">

                                <a class="btn btn-outline-secondary btn-sm"
                                   href="@Url.Action(
                                       "Edit",
                                       "Movies",
                                       new { id = movie.Id })"
                                   aria-label="Edit movie @movieTitle">
                                    Edit
                                </a>

                                <a class="btn btn-outline-danger btn-sm"
                                   href="@Url.Action(
                                       "Delete",
                                       "Movies",
                                       new { id = movie.Id })"
                                   aria-label="Delete movie @movieTitle">
                                    Delete
                                </a>

                            </div>
                        }

                    </div>

                </article>
            }

        </section>
    }
    else
    {
        <section class="cinema-empty-state movies-empty-state"
                 aria-labelledby="movies-empty-title">

            <div class="movies-empty-icon"
                 aria-hidden="true">
                ◇
            </div>

            <h2 id="movies-empty-title">
                No Movies Found
            </h2>

            <p>
                No movies currently showing match
                your selected criteria. Try a different search
                or clear the filters.
            </p>

            <a class="btn btn-primary"
               href="@Url.Action("Current", "Movies")">
                Clear Filters
            </a>

        </section>
    }

</div>

<style>
    .movies-page {
        display: flex;
        flex-direction: column;
        gap: 1.65rem;
        min-width: 0;
    }

        .movies-page .movies-hero {
            position: relative;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2rem;
            padding: clamp(2rem, 5vw, 3.5rem);
            overflow: hidden;
            border: 1px solid var(--cinema-border);
            border-radius: var(--cinema-radius-xl);
            background: radial-gradient( circle at 86% 8%, rgba(214, 168, 75, 0.12), transparent 35% ), linear-gradient( 135deg, #141c29, #090d14 );
            box-shadow: var(--cinema-shadow);
        }

            .movies-page .movies-hero::after {
                position: absolute;
                top: -160px;
                right: -110px;
                width: 380px;
                height: 380px;
                content: "";
                pointer-events: none;
                border: 1px solid rgba(214, 168, 75, 0.09);
                border-radius: 50%;
            }

            .movies-page .movies-hero > div:first-child {
                position: relative;
                z-index: 1;
                max-width: 760px;
            }

            .movies-page .movies-hero h1 {
                margin-bottom: 0.85rem;
            }

            .movies-page .movies-hero p {
                max-width: 690px;
                margin: 0;
                color: #acb5c4;
                font-size: 1rem;
                line-height: 1.7;
            }

        .movies-page .movies-hero-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.85rem;
        }

        .movies-page .movies-count {
            display: inline-flex;
            align-items: baseline;
            gap: 0.4rem;
            padding: 0.7rem 0.9rem;
            border: 1px solid var(--cinema-border-strong);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.03);
            white-space: nowrap;
        }

            .movies-page .movies-count span {
                color: var(--cinema-gold-light);
                font-size: 1.4rem;
                font-weight: 800;
                line-height: 1;
            }

            .movies-page .movies-count small {
                color: #aeb8c7;
                font-size: 0.76rem;
            }

        .movies-page .movies-button-icon {
            display: inline-block;
            margin-right: 0.3rem;
            font-size: 1.1rem;
        }

        .movies-page .movies-filter {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 0.9rem;
            margin: 0;
        }

        .movies-page .movies-filter-form {
            display: flex;
            align-items: flex-end;
            flex: 1;
            flex-wrap: wrap;
            gap: 0.75rem;
            min-width: 0;
        }

        .movies-page .movies-filter-field {
            flex: 0 1 190px;
            min-width: 0;
        }

        .movies-page .movies-search-field {
            flex: 1 1 265px;
        }

        .movies-page .movies-search-input {
            position: relative;
        }

        .movies-page .movies-search-icon {
            position: absolute;
            z-index: 1;
            top: 50%;
            left: 0.9rem;
            color: var(--cinema-text-muted);
            font-size: 1.1rem;
            pointer-events: none;
            transform: translateY(-50%);
        }

        .movies-page .movies-search-input .form-control {
            padding-left: 2.6rem;
        }

        .movies-page .movies-filter-actions {
            display: flex;
            gap: 0.55rem;
        }

        .movies-page .movies-sort {
            flex: 0 0 auto;
        }

        .movies-page .movies-sort-button {
            white-space: nowrap;
        }

        .movies-page .movie-catalog {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            align-items: stretch;
            gap: 1rem;
        }

        .movies-page .catalog-movie-card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 19px;
            background: #0b1018;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.21);
            transition: transform 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
        }

            .movies-page .catalog-movie-card:hover {
                transform: translateY(-5px);
                border-color: rgba(214, 168, 75, 0.38);
                box-shadow: 0 22px 45px rgba(0, 0, 0, 0.37);
            }

        .movies-page .catalog-movie-visual {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 285px;
            padding: 0.8rem 0.8rem 0.95rem;
            overflow: hidden;
            isolation: isolate;
            background: radial-gradient( circle at 78% 25%, rgba(214, 168, 75, 0.16), transparent 36% ), linear-gradient( 145deg, #192334, #0a0e15 );
        }

        .movies-page .catalog-movie-poster {
            position: absolute;
            z-index: 0;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 36%;
            transition: transform 440ms cubic-bezier( 0.22, 1, 0.36, 1 );
        }

        .movies-page .catalog-movie-card:hover .catalog-movie-poster {
            transform: scale(1.055);
        }

        .movies-page .catalog-card-glow {
            position: absolute;
            z-index: 0;
            top: -80px;
            right: -65px;
            width: 240px;
            height: 240px;
            border: 1px solid rgba(214, 168, 75, 0.12);
            border-radius: 50%;
            pointer-events: none;
        }

        .movies-page .catalog-has-poster .catalog-card-glow {
            display: none;
        }

        .movies-page .catalog-card-shade {
            position: absolute;
            z-index: 1;
            inset: 0;
            pointer-events: none;
            background: linear-gradient( 180deg, rgba(4, 7, 12, 0.5) 0%, rgba(4, 7, 12, 0.06) 30%, rgba(4, 7, 12, 0.45) 53%, rgba(4, 7, 12, 0.95) 100% );
        }

        .movies-page .catalog-no-poster .catalog-card-shade {
            background: linear-gradient( 180deg, transparent 30%, rgba(4, 7, 12, 0.55) 100% );
        }

        .movies-page .catalog-card-top {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.3rem;
        }

        .movies-page .catalog-index {
            color: #f7f8fa;
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9);
        }

        .movies-page .catalog-status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.3rem;
            max-width: 88%;
            padding: 0.28rem 0.4rem;
            color: #b0f5d1;
            border: 1px solid rgba(71, 213, 140, 0.36);
            border-radius: 999px;
            background: rgba(13, 73, 48, 0.86);
            font-size: 0.55rem;
            font-weight: 800;
            line-height: 1.15;
            text-align: center;
            white-space: nowrap;
        }

        .movies-page .catalog-status-dot {
            flex: 0 0 5px;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #8deeba;
        }

        .movies-page .catalog-visual-content {
            position: relative;
            z-index: 2;
            margin-top: auto;
            min-width: 0;
        }

        .movies-page .catalog-genre {
            display: block;
            margin-bottom: 0.4rem;
            color: #f0cb76;
            font-size: 0.63rem;
            font-weight: 800;
            line-height: 1.3;
            letter-spacing: 0.065em;
            text-transform: uppercase;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95);
        }

        .movies-page .catalog-visual-content h2 {
            display: -webkit-box;
            min-height: 2.48em;
            margin: 0 0 0.65rem;
            overflow: hidden;
            color: #fff;
            font-size: clamp(1rem, 1.12vw, 1.24rem);
            font-weight: 800;
            line-height: 1.24;
            letter-spacing: -0.025em;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.96);
            overflow-wrap: anywhere;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .movies-page .catalog-rating-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.35rem;
        }

        .movies-page .catalog-rating {
            display: inline-flex;
            align-items: baseline;
            gap: 0.22rem;
            color: #fff;
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95);
        }

            .movies-page .catalog-rating > span {
                color: #f0cb76;
                font-size: 0.86rem;
            }

            .movies-page .catalog-rating strong {
                font-size: 0.92rem;
                font-weight: 800;
            }

            .movies-page .catalog-rating small {
                color: #d2d8e1;
                font-size: 0.65rem;
            }

        .movies-page .catalog-age-badge {
            padding: 0.22rem 0.38rem;
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.32);
            border-radius: 7px;
            background: rgba(16, 45, 32, 0.82);
            font-size: 0.56rem;
            font-weight: 800;
            white-space: nowrap;
        }

            .movies-page .catalog-age-badge.adult {
                color: #ffadb6;
                border-color: rgba(239, 102, 115, 0.35);
                background: rgba(67, 24, 29, 0.78);
            }

            .movies-page .catalog-age-badge.unknown {
                color: #d3d8e0;
                border-color: rgba(255, 255, 255, 0.25);
                background: rgba(17, 22, 30, 0.8);
            }

        .movies-page .catalog-movie-body {
            display: flex;
            flex: 1;
            flex-direction: column;
            gap: 0.8rem;
            padding: 0.75rem 0.75rem 0.9rem;
        }

        .movies-page .catalog-meta {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.32rem;
        }

        .movies-page .catalog-meta-item {
            min-width: 0;
            padding: 0.48rem 0.34rem;
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.035);
        }

            .movies-page .catalog-meta-item span {
                display: block;
                margin-bottom: 0.27rem;
                overflow: hidden;
                color: #aeb9c8;
                font-size: 0.54rem;
                font-weight: 800;
                letter-spacing: 0.025em;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .movies-page .catalog-meta-item strong {
                display: block;
                overflow: hidden;
                color: #e0e5ed;
                font-size: 0.66rem;
                font-weight: 700;
                line-height: 1.3;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .movies-page .catalog-actions {
            display: flex;
            margin-top: auto;
        }

            .movies-page .catalog-actions > .btn-primary {
                display: inline-flex;
                flex: 1;
                align-items: center;
                justify-content: space-between;
                gap: 0.4rem;
                min-width: 0;
                min-height: 39px;
                padding: 0.57rem 0.7rem;
                font-size: 0.74rem;
                font-weight: 800;
                white-space: nowrap;
            }

        .movies-page .catalog-admin-actions {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.4rem;
            margin-top: 0.05rem;
        }

            .movies-page .catalog-admin-actions .btn {
                min-width: 0;
                padding-inline: 0.25rem;
            }

        .movies-page .btn-outline-danger {
            color: #ff9da8;
            border-color: rgba(239, 102, 115, 0.35);
            background: transparent;
        }

            .movies-page .btn-outline-danger:hover {
                color: #fff;
                border-color: #d94c5b;
                background: #b83c49;
            }

        .movies-page .movies-empty-icon {
            margin-bottom: 0.9rem;
            color: var(--cinema-gold);
            font-size: 2.3rem;
        }

        .movies-page a:focus-visible,
        .movies-page button:focus-visible,
        .movies-page input:focus-visible,
        .movies-page select:focus-visible {
            outline: 2px solid var(--cinema-gold-light);
            outline-offset: 3px;
        }

    @@media (max-width: 1199.98px) {
