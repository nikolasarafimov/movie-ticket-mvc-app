@using System
@using System.Globalization
@model MovieTicketMVC.Models.Movie

@{
    ViewBag.Title = "Add Movie";

    var releaseDateValue =
        Model != null && Model.ReleaseDate != default(DateTime)
            ? Model.ReleaseDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            : string.Empty;
}

<div class="movie-editor-page" aria-labelledby="movie-editor-title">
    <section class="movie-editor-header">
        <div class="movie-editor-header-content">
            <div class="cinema-eyebrow">ADMIN · MOVIE CATALOG</div>
            <h1 id="movie-editor-title">
                Add a <span class="cinema-text-gradient">New Movie</span>
            </h1>
            <p>
                Enter the movie information, set a release date,
                and upload an official trailer.
            </p>
        </div>
        <div class="movie-editor-header-badge" aria-hidden="true">
            <span>NEW</span>
            <strong>+</strong>
        </div>
    </section>

    @using (Html.BeginForm(
        "Create",
        "Movies",
        FormMethod.Post,
        new
        {
            enctype = "multipart/form-data",
            role = "form",
            id = "movieCreateForm",
            @class = "movie-editor-form"
        }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(
            true,
            "",
            new { @class = "validation-summary-errors movie-editor-validation" })

        <div class="movie-editor-layout">
            <div class="movie-editor-main">
                <section class="cinema-panel movie-editor-section">
                    <div class="movie-editor-section-heading">
                        <span class="movie-editor-step">01</span>
                        <div>
                            <h2>Basic Information</h2>
                            <p>
                                The essential details that will
                                appear in the movie catalog.
                            </p>
                        </div>
                    </div>

                    <div class="movie-editor-fields">
                        <div class="form-group movie-editor-field-full">
                            @Html.LabelFor(
                                m => m.Title,
                                "Title",
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                m => m.Title,
                                new
                                {
                                    @class = "form-control movie-editor-input",
                                    autocomplete = "off",
                                    placeholder = "For example: Midnight Horizon",
                                    required = "required",
                                    maxlength = "250"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Title,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(
                                m => m.Genre,
                                "Genre",
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                m => m.Genre,
                                new
                                {
                                    @class = "form-control",
                                    autocomplete = "off",
                                    placeholder = "Drama, Thriller...",
                                    required = "required"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Genre,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(
                                m => m.Language,
                                "Language / Country of Production",
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                m => m.Language,
                                new
                                {
                                    @class = "form-control",
                                    autocomplete = "off",
                                    placeholder = "English"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Language,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(
                                m => m.LengthInMinutes,
                                "Duration",
                                new { @class = "form-label" })

                            <div class="movie-editor-input-unit">
                                @Html.TextBoxFor(
                                    m => m.LengthInMinutes,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "1",
                                        max = "600",
                                        step = "1",
                                        placeholder = "120",
                                        required = "required"
                                    })
                                <span>min</span>
                            </div>

                            @Html.ValidationMessageFor(
                                m => m.LengthInMinutes,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(
                                m => m.Rating,
                                "Rating",
                                new { @class = "form-label" })

                            <div class="movie-editor-input-unit">
                                @Html.TextBoxFor(
                                    m => m.Rating,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "0",
                                        max = "10",
                                        step = "any",
                                        placeholder = "8.0",
                                        inputmode = "decimal"
                                    })
                                <span>/ 10</span>
                            </div>

                            @Html.ValidationMessageFor(
                                m => m.Rating,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group movie-editor-field-full">
                            @Html.LabelFor(
                                m => m.ReleaseDate,
                                "Release Date",
                                new { @class = "form-label" })

                            @Html.TextBox(
                                "ReleaseDate",
                                releaseDateValue,
                                new
                                {
                                    @class = "form-control",
                                    type = "date",
                                    required = "required"
                                })

                            <small class="movie-editor-help">
                                Movies with a future release date are automatically
                                displayed in the “Coming Soon” section.
                            </small>

                            @Html.ValidationMessageFor(
                                m => m.ReleaseDate,
                                "",
                                new { @class = "text-danger" })
                        </div>
                    </div>
                </section>

                <section class="cinema-panel movie-editor-section">
                    <div class="movie-editor-section-heading">
                        <span class="movie-editor-step">02</span>
                        <div>
                            <h2>Content</h2>
                            <p>
                                Description and cast details for
                                the movie details page.
                            </p>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(
                            m => m.Description,
                            "Description",
                            new { @class = "form-label" })

                        @Html.TextAreaFor(
                            m => m.Description,
                            7,
                            50,
                            new
                            {
                                @class = "form-control movie-editor-description",
                                placeholder = "A short summary of the story...",
                                required = "required"
                            })

                        @Html.ValidationMessageFor(
                            m => m.Description,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(
                            m => m.Actors,
                            "Cast",
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            m => m.Actors,
                            new
                            {
                                @class = "form-control",
                                autocomplete = "off",
                                placeholder = "Actor One, Actor Two, Actor Three"
                            })

                        <small class="movie-editor-help">
                            Separate names with commas.
                        </small>

                        @Html.ValidationMessageFor(
                            m => m.Actors,
                            "",
                            new { @class = "text-danger" })
                    </div>
                </section>

                <section class="cinema-panel movie-editor-section">
                    <div class="movie-editor-section-heading">
                        <span class="movie-editor-step">03</span>
                        <div>
                            <h2>Age Rating</h2>
                            <p>
                                Specify whether the movie is restricted
                                to viewers aged 18 and over.
                            </p>
                        </div>
                    </div>

                    <fieldset class="movie-age-selector">
                        <legend class="visually-hidden">
                            Age restriction
                        </legend>

                        <label class="movie-age-option" for="IsForAdultsFalse">
                            @Html.RadioButtonFor(
                                m => m.IsForAdults,
                                false,
                                new
                                {
                                    @class = "movie-age-radio",
                                    id = "IsForAdultsFalse",
                                    required = "required"
                                })

                            <span class="movie-age-visual">
                                <span class="movie-age-symbol">ALL</span>
                                <span class="movie-age-copy">
                                    <strong>No Age Restriction</strong>
                                    <small>Suitable for viewers of all ages.</small>
                                </span>
                            </span>
                        </label>

                        <label class="movie-age-option" for="IsForAdultsTrue">
                            @Html.RadioButtonFor(
                                m => m.IsForAdults,
                                true,
                                new
                                {
                                    @class = "movie-age-radio",
                                    id = "IsForAdultsTrue",
                                    required = "required"
                                })

                            <span class="movie-age-visual">
                                <span class="movie-age-symbol adult">18+</span>
                                <span class="movie-age-copy">
                                    <strong>Adults Only</strong>
                                    <small>
                                        Viewers must be at least 18 years old.
                                    </small>
                                </span>
                            </span>
                        </label>

                        <div class="movie-age-validation">
                            @Html.ValidationMessageFor(
                                m => m.IsForAdults,
                                "",
                                new { @class = "text-danger" })
                        </div>
                    </fieldset>
                </section>
            </div>

            <aside class="movie-editor-sidebar">
                <section class="cinema-panel movie-upload-panel">
                    <div class="movie-editor-section-heading compact">
                        <span class="movie-editor-step">04</span>
                        <div>
                            <h2>Trailer</h2>
                            <p>Video for the movie details page.</p>
                        </div>
                    </div>

                    <label for="videoFile"
                           class="movie-upload-dropzone"
                           id="videoDropzone">
                        <span class="movie-upload-icon" aria-hidden="true">▶</span>
                        <strong>Select a Trailer Video</strong>
                        <span>MP4, WebM or Ogg</span>
                        <small>Maximum 200 MB</small>
                        <span class="btn btn-outline-primary btn-sm movie-upload-button">
                            Choose File
                        </span>

                        <input type="file"
                               name="videoFile"
                               id="videoFile"
                               class="movie-upload-input"
                               accept=".mp4,.webm,.ogg,video/mp4,video/webm,video/ogg"
                               aria-describedby="videoClientError"
                               required />
                    </label>

                    <div id="videoFileInfo"
                         class="movie-upload-file-info"
                         aria-live="polite"
                         hidden>
                        <div class="movie-upload-file-icon" aria-hidden="true">
                            ▶
                        </div>
                        <div class="movie-upload-file-details">
                            <strong id="videoFileName"></strong>
                            <span id="videoFileSize"></span>
                        </div>
                    </div>

                    <div id="videoClientError"
                         class="text-danger movie-upload-client-error"
                         role="alert"
                         hidden>
                    </div>

                    @Html.ValidationMessage(
                        "videoFile",
                        "",
                        new { @class = "text-danger" })
                </section>

                <section class="cinema-panel movie-editor-summary">
                    <span class="movie-editor-summary-label">PUBLISHING</span>
                    <h3>Ready for the Catalog</h3>
                    <p>
                        After saving, the movie will automatically
                        appear in the appropriate section based
                        on its release date.
                    </p>
                    <div class="movie-editor-summary-line"></div>

                    <div class="movie-editor-summary-item">
                        <span>Status</span>
                        <strong>Automatic</strong>
                    </div>

                    <div class="movie-editor-summary-item">
                        <span>Trailer</span>
                        <strong>Required</strong>
                    </div>

                    <div class="movie-editor-summary-item">
                        <span>Maximum Upload</span>
                        <strong>200 MB</strong>
                    </div>
                </section>
            </aside>
        </div>

        <div class="movie-editor-actions">
            <a class="btn btn-outline-secondary"
               href="@Url.Action("ComingSoon", "Movies")">
                Cancel
            </a>

            <button type="submit"
                    id="movieSubmitButton"
                    class="btn btn-primary movie-editor-submit">
                <span id="movieSubmitButtonText">Add Movie</span>
                <span aria-hidden="true">→</span>
            </button>
        </div>
    }
</div>

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("movieCreateForm");
            var fileInput = document.getElementById("videoFile");
            var fileInfo = document.getElementById("videoFileInfo");
            var fileName = document.getElementById("videoFileName");
            var fileSize = document.getElementById("videoFileSize");
            var clientError = document.getElementById("videoClientError");
            var submitButton = document.getElementById("movieSubmitButton");
            var submitButtonText = document.getElementById("movieSubmitButtonText");
            var maxFileSize = 200 * 1024 * 1024;
            var submitting = false;

            function formatFileSize(bytes) {
                if (!bytes || bytes <= 0) {
                    return "0 MB";
                }

                return (bytes / (1024 * 1024)).toFixed(1) + " MB";
            }

            function clearClientError() {
                clientError.textContent = "";
                clientError.hidden = true;
                fileInput.removeAttribute("aria-invalid");
            }

            function showClientError(message) {
                clientError.textContent = message;
                clientError.hidden = false;
                fileInput.setAttribute("aria-invalid", "true");
            }

            function selectedFile() {
                if (!fileInput.files || fileInput.files.length === 0) {
                    return null;
                }

                return fileInput.files[0];
            }

            function validateVideo() {
                var file = selectedFile();
                clearClientError();

                if (!file) {
                    showClientError("You must select a trailer video.");
                    return false;
                }

                if (file.size <= 0) {
                    showClientError("The selected video file is empty.");
                    return false;
                }

                if (file.size > maxFileSize) {
                    showClientError(
                        "The trailer video must not be larger than 200 MB."
                    );
                    return false;
                }

                if (!/\.(mp4|webm|ogg)$/i.test(file.name)) {
                    showClientError(
                        "Only MP4, WebM, and Ogg video files are allowed."
                    );
                    return false;
                }

                return true;
            }

            function updateFileInfo() {
                var file = selectedFile();

                if (!file) {
                    fileName.textContent = "";
                    fileSize.textContent = "";
                    fileInfo.hidden = true;
                    clearClientError();
                    return;
                }

                fileName.textContent = file.name;
                fileSize.textContent = formatFileSize(file.size);
                fileInfo.hidden = false;
                validateVideo();
            }

            fileInput.addEventListener("change", function () {
                if (!submitting) {
                    updateFileInfo();
                }
            });

            form.addEventListener("submit", function (event) {
                if (submitting) {
                    event.preventDefault();
                    return;
                }

                if (!validateVideo()) {
                    event.preventDefault();
                    fileInput.focus();
                    return;
                }

                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.reportValidity();
                    return;
                }

                if (window.jQuery &&
                    jQuery.validator &&
                    typeof jQuery(form).valid === "function" &&
                    !jQuery(form).valid()) {
                    event.preventDefault();
                    return;
                }

                if (event.defaultPrevented) {
                    return;
                }

                submitting = true;
                submitButton.disabled = true;
                submitButtonText.textContent = "Saving...";
            });

            window.addEventListener("pageshow", function (event) {
                if (event.persisted && submitting) {
                    submitting = false;
                    submitButton.disabled = false;
                    submitButtonText.textContent = "Add Movie";
                }
            });

            updateFileInfo();
        })();
    </script>
}

<style>
    .movie-editor-page {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .movie-editor-header {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        padding: clamp(2rem, 5vw, 3.5rem);
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient(circle at 88% 15%, rgba(214, 168, 75, 0.13), transparent 28%), linear-gradient(135deg, rgba(20, 27, 39, 0.98), rgba(8, 11, 17, 0.99));
        box-shadow: var(--cinema-shadow);
    }

        .movie-editor-header::after {
            position: absolute;
            top: -150px;
            right: -90px;
            width: 340px;
            height: 340px;
            content: "";
            border: 1px solid rgba(214, 168, 75, 0.08);
            border-radius: 50%;
            pointer-events: none;
        }

    .movie-editor-header-content {
        position: relative;
        z-index: 1;
        max-width: 760px;
    }

    .movie-editor-header h1 {
        margin-bottom: 1rem;
    }

    .movie-editor-header p {
        max-width: 650px;
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 1.02rem;
    }

    .movie-editor-header-badge {
        position: relative;
        z-index: 1;
        display: grid;
        flex: 0 0 120px;
        place-items: center;
        width: 120px;
        height: 120px;
        border: 1px solid rgba(214, 168, 75, 0.22);
        border-radius: 28px;
        background: rgba(214, 168, 75, 0.06);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
    }

        .movie-editor-header-badge span {
            position: absolute;
            top: 1rem;
            color: var(--cinema-gold-light);
            font-size: 0.58rem;
            font-weight: 900;
            letter-spacing: 0.16em;
        }

        .movie-editor-header-badge strong {
            color: var(--cinema-gold-light);
            font-size: 3.4rem;
            font-weight: 300;
            line-height: 1;
        }

    .movie-editor-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .movie-editor-validation:empty {
        display: none;
    }

    .movie-editor-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        align-items: start;
        gap: 1.5rem;
    }

    .movie-editor-main {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 1.5rem;
    }

    .movie-editor-sidebar {
        position: sticky;
        top: 100px;
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 1.5rem;
    }

    .movie-editor-section {
        padding: clamp(1.4rem, 3vw, 2rem);
    }

    .movie-editor-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.8rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--cinema-border);
    }

        .movie-editor-section-heading.compact {
            margin-bottom: 1.4rem;
        }

    .movie-editor-step {
        display: grid;
        flex: 0 0 40px;
        place-items: center;
        width: 40px;
        height: 40px;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.2);
        border-radius: 12px;
        background: rgba(214, 168, 75, 0.07);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.07em;
    }

    .movie-editor-section-heading h2 {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
    }

    .movie-editor-section-heading p {
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 0.82rem;
    }

    .movie-editor-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 1rem;
    }

    .movie-editor-field-full {
        grid-column: 1 / -1;
    }

    .movie-editor-input {
        font-size: 1rem;
        font-weight: 600;
    }

    .movie-editor-description {
        min-height: 180px;
        line-height: 1.7;
        resize: vertical;
    }

    .movie-editor-help {
        display: block;
        margin-top: 0.45rem;
        color: var(--cinema-text-muted);
        font-size: 0.75rem;
    }

    .movie-editor-input-unit {
        position: relative;
    }

        .movie-editor-input-unit .form-control {
            padding-right: 4.5rem;
        }

        .movie-editor-input-unit > span {
            position: absolute;
            top: 50%;
            right: 0.9rem;
            color: var(--cinema-text-muted);
            font-size: 0.72rem;
            font-weight: 700;
            pointer-events: none;
            transform: translateY(-50%);
        }

    .movie-age-selector {
        margin: 0;
        padding: 0;
        border: 0;
    }

    .movie-age-option {
        display: block;
        margin: 0 0 0.75rem;
        cursor: pointer;
    }

        .movie-age-option:last-of-type {
            margin-bottom: 0;
        }

    .movie-age-radio {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
    }

    .movie-age-visual {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid var(--cinema-border);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.02);
        transition: border-color var(--cinema-transition), background-color var(--cinema-transition), transform var(--cinema-transition), box-shadow var(--cinema-transition);
    }

    .movie-age-option:hover .movie-age-visual {
        border-color: rgba(214, 168, 75, 0.22);
        background: rgba(214, 168, 75, 0.035);
        transform: translateY(-2px);
    }

    .movie-age-radio:checked + .movie-age-visual {
        border-color: rgba(214, 168, 75, 0.52);
        background: rgba(214, 168, 75, 0.07);
        box-shadow: 0 0 0 3px rgba(214, 168, 75, 0.07);
    }

    .movie-age-radio:focus-visible + .movie-age-visual {
        box-shadow: 0 0 0 4px rgba(214, 168, 75, 0.13);
    }

    .movie-age-symbol {
        display: grid;
        flex: 0 0 52px;
        place-items: center;
        width: 52px;
        height: 52px;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.2);
        border-radius: 50%;
        background: rgba(66, 199, 131, 0.07);
        font-size: 0.68rem;
        font-weight: 900;
    }

        .movie-age-symbol.adult {
            color: #ff9ba4;
            border-color: rgba(239, 102, 115, 0.22);
            background: rgba(239, 102, 115, 0.07);
        }

    .movie-age-copy {
        min-width: 0;
    }

        .movie-age-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 0.9rem;
        }

        .movie-age-copy small {
            display: block;
            margin-top: 0.2rem;
            color: var(--cinema-text-muted);
            font-size: 0.75rem;
        }

    .movie-age-validation {
        margin-top: 0.35rem;
    }

    .movie-upload-panel {
        overflow: hidden;
    }

    .movie-upload-dropzone {
        position: relative;
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        min-height: 260px;
        margin: 0;
        padding: 1.5rem;
        cursor: pointer;
        text-align: center;
        border: 1px dashed rgba(214, 168, 75, 0.3);
        border-radius: 18px;
        background: radial-gradient(circle at 50% 30%, rgba(214, 168, 75, 0.08), transparent 42%), rgba(255, 255, 255, 0.015);
        transition: border-color var(--cinema-transition), background-color var(--cinema-transition), transform var(--cinema-transition);
    }

        .movie-upload-dropzone:hover {
            border-color: rgba(214, 168, 75, 0.58);
            background: rgba(214, 168, 75, 0.035);
            transform: translateY(-2px);
        }

        .movie-upload-dropzone:focus-within {
            border-color: var(--cinema-gold-light);
            box-shadow: 0 0 0 3px rgba(214, 168, 75, 0.12);
        }

    .movie-upload-icon {
        display: grid;
        place-items: center;
        width: 62px;
        height: 62px;
        margin-bottom: 1rem;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.22);
        border-radius: 50%;
