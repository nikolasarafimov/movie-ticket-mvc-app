@{
    ViewBag.Title = "Провери го e-mail-от";
}

<main class="recovery-confirmation-page"
      aria-labelledby="recovery-confirmation-title">

    <section class="recovery-confirmation-shell">

        <a class="recovery-confirmation-brand"
           href="@Url.Action("Index", "Home")">

            <span></span>

            MOVIETICKET
        </a>


        <div class="recovery-confirmation-progress"
             aria-label="Процес за промена на лозинка">

            <div class="recovery-confirmation-step completed">

                <span aria-hidden="true">
                    ✓
                </span>

                <strong>
                    E-mail
                </strong>

            </div>

            <div class="recovery-confirmation-line active">
            </div>

            <div class="recovery-confirmation-step active">

                <span>
                    02
                </span>

                <strong>
                    Link
                </strong>

            </div>

            <div class="recovery-confirmation-line">
            </div>

            <div class="recovery-confirmation-step">

                <span>
                    03
                </span>

                <strong>
                    Reset
                </strong>

            </div>

        </div>


        <div class="recovery-confirmation-visual"
             aria-hidden="true">

            <div class="recovery-confirmation-orbit
                        recovery-confirmation-orbit-large">
            </div>

            <div class="recovery-confirmation-orbit
                        recovery-confirmation-orbit-small">
            </div>

            <div class="recovery-confirmation-envelope">

                <div class="recovery-confirmation-envelope-top">
                </div>

                <div class="recovery-confirmation-envelope-paper">

                    <span>
                        RESET
                    </span>

                    <strong>
                        ••••••••
                    </strong>

                </div>

            </div>

            <div class="recovery-confirmation-check">
                ✓
            </div>

        </div>


        <div class="recovery-confirmation-content">

            <div class="cinema-eyebrow">
                CHECK YOUR INBOX
            </div>

            <h1 id="recovery-confirmation-title">
                Провери го
                <span class="cinema-text-gradient">
                    e-mail-от
                </span>
            </h1>

            <p class="recovery-confirmation-description">
                Ако постои MovieTicket профил поврзан со внесената
                e-mail адреса, ќе добиеш порака со безбеден линк
                за поставување нова лозинка.
            </p>


            <div class="recovery-confirmation-info">

                <div class="recovery-confirmation-info-item">

                    <span class="recovery-confirmation-info-icon"
                          aria-hidden="true">
                        01
                    </span>

                    <div>

                        <strong>
                            Отвори ја пораката
                        </strong>

                        <p>
                            Провери го Inbox на e-mail адресата
                            што ја внесе.
                        </p>

                    </div>

                </div>


                <div class="recovery-confirmation-info-item">

                    <span class="recovery-confirmation-info-icon"
                          aria-hidden="true">
                        02
                    </span>

                    <div>

                        <strong>
                            Провери Spam / Junk
                        </strong>

                        <p>
                            Понекогаш автоматските пораки можат
                            да завршат во друга папка.
                        </p>

                    </div>

                </div>


                <div class="recovery-confirmation-info-item">

                    <span class="recovery-confirmation-info-icon"
                          aria-hidden="true">
                        03
                    </span>

                    <div>

                        <strong>
                            Отвори го reset link-от
                        </strong>

                        <p>
                            Следи го линкот од пораката и постави
                            нова безбедна лозинка.
                        </p>

                    </div>

                </div>

            </div>


            <div class="recovery-confirmation-actions">

                <a class="btn btn-primary"
                   href="@Url.Action(
                       "Login",
                       "Account")">
                    Назад кон најава
                </a>

                <a class="btn btn-outline-secondary"
                   href="@Url.Action(
                       "ForgotPassword",
                       "Account")">
                    Испрати повторно
                </a>

            </div>


            <div class="recovery-confirmation-security">

                <span aria-hidden="true">
                    i
                </span>

                <p>
                    Од безбедносни причини, оваа страница не
                    потврдува дали внесената e-mail адреса
                    е регистрирана во MovieTicket.
                </p>

            </div>

        </div>

    </section>

</main>


<style>
    .recovery-confirmation-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .recovery-confirmation-shell {
        position: relative;
        width: min(100%, 760px);
        padding: clamp(2rem, 6vw, 4rem);
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 50% 20%, rgba(214, 168, 75, 0.10), transparent 30% ), radial-gradient( circle at 0% 100%, rgba(61, 101, 166, 0.11), transparent 30% ), linear-gradient( 145deg, rgba(18, 25, 37, 0.99), rgba(7, 10, 15, 0.99) );
        box-shadow: var(--cinema-shadow-lg);
        isolation: isolate;
    }

        .recovery-confirmation-shell::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.25;
            background-image: linear-gradient( rgba(255, 255, 255, 0.02) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px );
            background-size: 48px 48px;
            mask-image: linear-gradient( 180deg, #000, transparent 75% );
        }


    /* BRAND */

    .recovery-confirmation-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.2rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .recovery-confirmation-brand:hover {
            color: var(--cinema-gold-light);
        }

        .recovery-confirmation-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* PROGRESS */

    .recovery-confirmation-progress {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2.8rem;
    }

    .recovery-confirmation-step {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        opacity: 0.32;
    }

        .recovery-confirmation-step.active,
        .recovery-confirmation-step.completed {
            opacity: 1;
        }

        .recovery-confirmation-step > span {
            display: grid;
            width: 30px;
            height: 30px;
            place-items: center;
            color: var(--cinema-text-muted);
            border: 1px solid var(--cinema-border-strong);
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.02);
            font-size: 0.53rem;
            font-weight: 900;
        }

        .recovery-confirmation-step.active > span {
            color: var(--cinema-gold-light);
            border-color: rgba(214, 168, 75, 0.32);
            background: rgba(214, 168, 75, 0.07);
        }

        .recovery-confirmation-step.completed > span {
            color: #9ae8bd;
            border-color: rgba(66, 199, 131, 0.25);
            background: rgba(66, 199, 131, 0.07);
        }

        .recovery-confirmation-step strong {
            color: var(--cinema-text-soft);
            font-size: 0.62rem;
        }

    .recovery-confirmation-line {
        width: 55px;
        height: 1px;
        margin: 0 0.65rem;
        background: var(--cinema-border-strong);
    }

        .recovery-confirmation-line.active {
            background: linear-gradient( 90deg, rgba(66, 199, 131, 0.55), rgba(214, 168, 75, 0.48) );
        }


    /* VISUAL */

    .recovery-confirmation-visual {
        position: relative;
        display: grid;
        width: 220px;
        height: 180px;
        margin: 0 auto 2.4rem;
        place-items: center;
    }

    .recovery-confirmation-envelope {
        position: relative;
        z-index: 3;
        width: 116px;
        height: 78px;
        overflow: hidden;
        border: 1px solid rgba(214, 168, 75, 0.28);
        border-radius: 10px;
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.13), rgba(214, 168, 75, 0.045) );
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.35), 0 0 35px rgba(214, 168, 75, 0.08);
    }

        .recovery-confirmation-envelope::before,
        .recovery-confirmation-envelope::after {
            position: absolute;
            bottom: -33px;
            width: 85px;
            height: 85px;
            content: "";
            border: 1px solid rgba(214, 168, 75, 0.18);
            background: rgba(214, 168, 75, 0.035);
            transform: rotate(45deg);
        }

        .recovery-confirmation-envelope::before {
            left: -43px;
        }

        .recovery-confirmation-envelope::after {
            right: -43px;
        }

    .recovery-confirmation-envelope-top {
        position: absolute;
        z-index: 4;
        top: -45px;
        left: 13px;
        width: 90px;
        height: 90px;
        border: 1px solid rgba(214, 168, 75, 0.19);
        background: rgba(214, 168, 75, 0.04);
        transform: rotate(45deg);
    }

    .recovery-confirmation-envelope-paper {
        position: absolute;
        z-index: 2;
        top: 12px;
        right: 15px;
        left: 15px;
        height: 52px;
        padding: 0.7rem;
        border-radius: 5px;
        background: #d9d2c2;
    }

        .recovery-confirmation-envelope-paper span {
            display: block;
            color: #615b50;
            font-size: 0.4rem;
            font-weight: 900;
            letter-spacing: 0.12em;
        }

        .recovery-confirmation-envelope-paper strong {
            display: block;
            margin-top: 0.35rem;
            color: #8b8375;
            font-size: 0.55rem;
            letter-spacing: 0.12em;
        }

    .recovery-confirmation-check {
        position: absolute;
        z-index: 5;
        right: 35px;
        bottom: 33px;
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        color: #a5e9c1;
        border: 1px solid rgba(66, 199, 131, 0.25);
        border-radius: 50%;
        background: #101b17;
        box-shadow: 0 0 25px rgba(66, 199, 131, 0.14);
        font-size: 0.9rem;
        font-weight: 900;
        animation: recovery-confirmation-check-enter 600ms cubic-bezier( 0.22, 1, 0.36, 1 );
    }


    /* ORBITS */

    .recovery-confirmation-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: recovery-confirmation-orbit 24s linear infinite;
    }

        .recovery-confirmation-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 15px rgba(214, 168, 75, 0.65);
        }

    .recovery-confirmation-orbit-large {
        width: 180px;
        height: 180px;
    }

    .recovery-confirmation-orbit-small {
        width: 135px;
        height: 135px;
        animation-direction: reverse;
        animation-duration: 17s;
    }


    /* CONTENT */

    .recovery-confirmation-content {
        position: relative;
        z-index: 3;
    }

        .recovery-confirmation-content h1 {
            margin-bottom: 1rem;
            font-size: clamp( 2.4rem, 6vw, 3.8rem );
            line-height: 1;
            letter-spacing: -0.05em;
        }

    .recovery-confirmation-description {
        max-width: 590px;
        margin: 0 auto 2rem;
        color: var(--cinema-text-muted);
        font-size: 0.88rem;
        line-height: 1.75;
    }


    /* INFO */

    .recovery-confirmation-info {
        display: grid;
        grid-template-columns: repeat( 3, minmax(0, 1fr) );
        gap: 0.8rem;
        margin-bottom: 2rem;
        text-align: left;
    }

    .recovery-confirmation-info-item {
        min-width: 0;
        padding: 1rem;
        border: 1px solid var(--cinema-border);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.018);
    }

    .recovery-confirmation-info-icon {
        display: grid;
        width: 32px;
        height: 32px;
        margin-bottom: 0.7rem;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.18);
        border-radius: 9px;
        background: rgba(214, 168, 75, 0.055);
        font-size: 0.53rem;
        font-weight: 900;
    }

    .recovery-confirmation-info-item strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.78rem;
    }

    .recovery-confirmation-info-item p {
        margin: 0.3rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.67rem;
        line-height: 1.55;
    }


    /* ACTIONS */

    .recovery-confirmation-actions {
        display: flex;
        justify-content: center;
        gap: 0.7rem;
    }


    /* SECURITY */

    .recovery-confirmation-security {
        display: flex;
        max-width: 600px;
        align-items: flex-start;
        gap: 0.6rem;
        margin: 2rem auto 0;
        padding-top: 1.2rem;
        text-align: left;
        border-top: 1px solid var(--cinema-border);
    }

        .recovery-confirmation-security > span {
            display: grid;
            flex: 0 0 25px;
            width: 25px;
            height: 25px;
            place-items: center;
            color: var(--cinema-gold-light);
            border: 1px solid rgba(214, 168, 75, 0.17);
            border-radius: 50%;
            background: rgba(214, 168, 75, 0.05);
            font-family: Georgia, serif;
            font-size: 0.68rem;
            font-weight: bold;
        }

        .recovery-confirmation-security p {
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.65rem;
            line-height: 1.55;
        }


    /* ANIMATION */

    @@keyframes recovery-confirmation-orbit {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes recovery-confirmation-check-enter {
        from {
            opacity: 0;
            transform: scale(0.5) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }


    /* RESPONSIVE */

    @@media (max-width: 700px) {
        .recovery-confirmation-info {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .recovery-confirmation-shell {
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg);
        }

        .recovery-confirmation-step strong {
            display: none;
        }

        .recovery-confirmation-line {
            flex: 1;
            width: auto;
            margin: 0 0.45rem;
        }

        .recovery-confirmation-content h1 {
            font-size: 2.3rem;
        }

        .recovery-confirmation-actions {
            align-items: stretch;
            flex-direction: column;
        }

            .recovery-confirmation-actions .btn {
                width: 100%;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .recovery-confirmation-orbit,
        .recovery-confirmation-check {
            animation: none;
        }
    }
</style>