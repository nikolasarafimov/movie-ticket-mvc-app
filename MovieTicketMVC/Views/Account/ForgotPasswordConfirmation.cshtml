@{
    ViewBag.Title = "Провери го e-mail-от";
}

<main class="recovery-confirmation-page" aria-labelledby="recovery-confirmation-title">
    <section class="recovery-confirmation-shell">
        <a class="recovery-confirmation-brand"
           href="@Url.Action("Index", "Home")"
           aria-label="MovieTicket – почетна страница">
            <span aria-hidden="true"></span>
            MOVIETICKET
        </a>

        <ol class="recovery-confirmation-progress"
            aria-label="Чекори за поставување нова лозинка">
            <li class="recovery-confirmation-step completed">
                <span aria-hidden="true">✓</span>
                <strong>Барање</strong>
            </li>
            <li class="recovery-confirmation-line active" aria-hidden="true"></li>
            <li class="recovery-confirmation-step active" aria-current="step">
                <span aria-hidden="true">02</span>
                <strong>Провери e-mail</strong>
            </li>
            <li class="recovery-confirmation-line" aria-hidden="true"></li>
            <li class="recovery-confirmation-step">
                <span aria-hidden="true">03</span>
                <strong>Нова лозинка</strong>
            </li>
        </ol>

        <div class="recovery-confirmation-visual" aria-hidden="true">
            <div class="recovery-confirmation-orbit recovery-confirmation-orbit-large"></div>
            <div class="recovery-confirmation-orbit recovery-confirmation-orbit-small"></div>

            <div class="recovery-confirmation-envelope">
                <div class="recovery-confirmation-envelope-top"></div>
                <div class="recovery-confirmation-envelope-paper">
                    <span>RESET</span>
                    <strong>••••••••</strong>
                </div>
            </div>

            <div class="recovery-confirmation-check">✓</div>
        </div>

        <div class="recovery-confirmation-content">
            <div class="cinema-eyebrow">ПРОВЕРИ ЈА ПОШТАТА</div>

            <h1 id="recovery-confirmation-title">
                Провери го
                <span class="cinema-text-gradient">e-mail-от</span>
            </h1>

            <p class="recovery-confirmation-description">
                Барањето за промена на лозинката е обработено.
                Ако внесената e-mail адреса е поврзана со MovieTicket профил
                и пораката може успешно да се испрати, ќе добиеш линк
                за поставување нова лозинка.
            </p>

            <div class="recovery-confirmation-info" aria-label="Следни чекори">
                <div class="recovery-confirmation-info-item">
                    <span class="recovery-confirmation-info-icon" aria-hidden="true">01</span>
                    <strong>Провери ја поштата</strong>
                    <p>Отвори го приемното сандаче на e-mail адресата што ја внесе.</p>
                </div>
                <div class="recovery-confirmation-info-item">
                    <span class="recovery-confirmation-info-icon" aria-hidden="true">02</span>
                    <strong>Провери и Spam / Junk</strong>
                    <p>Понекогаш автоматските пораки завршуваат во папките за несакана пошта.</p>
                </div>
                <div class="recovery-confirmation-info-item">
                    <span class="recovery-confirmation-info-icon" aria-hidden="true">03</span>
                    <strong>Постави нова лозинка</strong>
                    <p>Ако добиеш порака, отвори го линкот и следи ги чекорите за промена на лозинката.</p>
                </div>
            </div>

            <div class="recovery-confirmation-actions">
                <a class="btn btn-primary recovery-confirmation-primary"
                   href="@Url.Action("Login", "Account")">
                    <span>Назад кон најава</span>
                    <span aria-hidden="true">→</span>
                </a>
                <a class="btn btn-outline-secondary"
                   href="@Url.Action("ForgotPassword", "Account")">
                    Побарај нов линк
                </a>
            </div>

            <p class="recovery-confirmation-action-hint">
                За ново барање потребно е повторно да ја внесеш e-mail адресата.
            </p>

            <div class="recovery-confirmation-security">
                <span aria-hidden="true">i</span>
                <p>
                    Заради заштита на приватноста, оваа страница не открива
                    дали адресата е регистрирана и не потврдува дека e-mail пораката е доставена.
                    Ако ти треба дополнителна помош,
                    <a href="@Url.Action("Contact", "Home")">контактирај нè</a>.
                </p>
            </div>
        </div>
    </section>
</main>

<style>
    .recovery-confirmation-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .recovery-confirmation-shell {
        position: relative;
        isolation: isolate;
        width: min(100%, 780px);
        overflow: hidden;
        padding: clamp(1.75rem, 6vw, 4rem);
        border: 1px solid var(--cinema-border, rgba(255,255,255,.09));
        border-radius: var(--cinema-radius-xl, 32px);
        background: radial-gradient(circle at 50% 18%, rgba(214,168,75,.10), transparent 30%), radial-gradient(circle at 0% 100%, rgba(61,101,166,.11), transparent 30%), linear-gradient(145deg, rgba(18,25,37,.99), rgba(7,10,15,.99));
        box-shadow: var(--cinema-shadow-lg, 0 30px 80px rgba(0,0,0,.46));
        text-align: center;
    }

        .recovery-confirmation-shell::before {
            position: absolute;
            z-index: -1;
            inset: 0;
            content: "";
            opacity: .25;
            pointer-events: none;
            background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: linear-gradient(180deg, #000, transparent 75%);
        }

    .recovery-confirmation-brand {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        margin-bottom: 2.1rem;
        color: var(--cinema-text, #f5f7fb);
        font-size: .7rem;
        font-weight: 900;
        letter-spacing: .17em;
        text-decoration: none;
    }

        .recovery-confirmation-brand:hover {
            color: var(--cinema-gold-light, #f0cb76);
        }

        .recovery-confirmation-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold, #d6a84b);
            box-shadow: 0 0 0 5px rgba(214,168,75,.09), 0 0 18px rgba(214,168,75,.55);
        }

    .recovery-confirmation-progress {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        margin: 0 0 2.5rem;
        padding: 0;
        list-style: none;
    }

    .recovery-confirmation-step {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: .45rem;
        opacity: .45;
    }

        .recovery-confirmation-step.active,
        .recovery-confirmation-step.completed {
            opacity: 1;
        }

        .recovery-confirmation-step > span {
            display: grid;
            flex: 0 0 30px;
            width: 30px;
            height: 30px;
            place-items: center;
            border: 1px solid var(--cinema-border-strong, rgba(255,255,255,.16));
            border-radius: 9px;
            color: var(--cinema-text-muted, #848d9d);
            background: rgba(255,255,255,.02);
            font-size: .55rem;
            font-weight: 900;
        }

        .recovery-confirmation-step.active > span {
            color: var(--cinema-gold-light, #f0cb76);
            border-color: rgba(214,168,75,.32);
            background: rgba(214,168,75,.07);
        }

        .recovery-confirmation-step.completed > span {
            color: #9ae8bd;
            border-color: rgba(66,199,131,.25);
            background: rgba(66,199,131,.07);
        }

        .recovery-confirmation-step strong {
            color: var(--cinema-text-soft, #c4cad4);
            font-size: .65rem;
            white-space: nowrap;
        }

    .recovery-confirmation-line {
        flex: 0 1 52px;
        height: 1px;
        margin: 0 .7rem;
        background: var(--cinema-border-strong, rgba(255,255,255,.16));
    }

        .recovery-confirmation-line.active {
            background: linear-gradient(90deg, rgba(66,199,131,.55), rgba(214,168,75,.48));
        }

    .recovery-confirmation-visual {
        position: relative;
        display: grid;
        width: 220px;
        height: 180px;
        place-items: center;
        margin: 0 auto 2.2rem;
    }

    .recovery-confirmation-envelope {
        position: relative;
        z-index: 3;
        width: 116px;
        height: 78px;
        overflow: hidden;
        border: 1px solid rgba(214,168,75,.28);
        border-radius: 10px;
        background: linear-gradient(145deg, rgba(214,168,75,.13), rgba(214,168,75,.045));
        box-shadow: 0 15px 45px rgba(0,0,0,.35), 0 0 35px rgba(214,168,75,.08);
    }

        .recovery-confirmation-envelope::before,
        .recovery-confirmation-envelope::after {
            position: absolute;
            bottom: -33px;
            width: 85px;
            height: 85px;
            content: "";
            border: 1px solid rgba(214,168,75,.18);
            background: rgba(214,168,75,.035);
            transform: rotate(45deg);
        }

        .recovery-confirmation-envelope::before {
            left: -43px;
        }

        .recovery-confirmation-envelope::after {
            right: -43px;
        }

    .recovery-confirmation-envelope-top {
        position: absolute;
        z-index: 4;
        top: -45px;
        left: 13px;
        width: 90px;
        height: 90px;
        border: 1px solid rgba(214,168,75,.19);
        background: rgba(214,168,75,.04);
        transform: rotate(45deg);
    }

    .recovery-confirmation-envelope-paper {
        position: absolute;
        z-index: 2;
        top: 12px;
        right: 15px;
        left: 15px;
        height: 52px;
        padding: .7rem;
        border-radius: 5px;
        background: #d9d2c2;
        text-align: left;
    }

        .recovery-confirmation-envelope-paper span {
            display: block;
            color: #615b50;
            font-size: .4rem;
            font-weight: 900;
            letter-spacing: .12em;
        }

        .recovery-confirmation-envelope-paper strong {
            display: block;
            margin-top: .35rem;
            color: #8b8375;
            font-size: .55rem;
            letter-spacing: .12em;
        }

    .recovery-confirmation-check {
        position: absolute;
        z-index: 5;
        right: 35px;
        bottom: 33px;
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        color: #a5e9c1;
        border: 1px solid rgba(66,199,131,.25);
        border-radius: 50%;
        background: #101b17;
        box-shadow: 0 0 25px rgba(66,199,131,.14);
        font-size: .9rem;
        font-weight: 900;
        animation: recovery-confirmation-check-enter 600ms cubic-bezier(.22,1,.36,1) both;
    }

    .recovery-confirmation-orbit {
        position: absolute;
        border: 1px solid rgba(214,168,75,.09);
        border-radius: 50%;
        animation: recovery-confirmation-orbit 24s linear infinite;
    }

        .recovery-confirmation-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold, #d6a84b);
            box-shadow: 0 0 15px rgba(214,168,75,.65);
        }

    .recovery-confirmation-orbit-large {
        width: 180px;
        height: 180px;
    }

    .recovery-confirmation-orbit-small {
        width: 135px;
        height: 135px;
        animation-direction: reverse;
        animation-duration: 17s;
    }

    .recovery-confirmation-content {
        position: relative;
        z-index: 3;
    }

        .recovery-confirmation-content .cinema-eyebrow {
            margin-bottom: .65rem;
        }

        .recovery-confirmation-content h1 {
            max-width: 650px;
            margin: 0 auto 1rem;
            font-size: clamp(2.4rem, 6vw, 3.8rem);
            line-height: 1.08;
            letter-spacing: -.05em;
        }

    .recovery-confirmation-description {
        max-width: 600px;
        margin: 0 auto 2rem;
        color: var(--cinema-text-muted, #848d9d);
        font-size: .88rem;
        line-height: 1.75;
    }

    .recovery-confirmation-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: .8rem;
        margin-bottom: 2rem;
        text-align: left;
    }

    .recovery-confirmation-info-item {
        min-width: 0;
        padding: 1rem;
        border: 1px solid var(--cinema-border, rgba(255,255,255,.09));
        border-radius: 13px;
        background: rgba(255,255,255,.018);
    }

    .recovery-confirmation-info-icon {
        display: grid;
        width: 32px;
        height: 32px;
        margin-bottom: .7rem;
        place-items: center;
        color: var(--cinema-gold-light, #f0cb76);
        border: 1px solid rgba(214,168,75,.18);
        border-radius: 9px;
        background: rgba(214,168,75,.055);
        font-size: .53rem;
        font-weight: 900;
    }

    .recovery-confirmation-info-item strong {
        display: block;
        color: var(--cinema-text, #f5f7fb);
        font-size: .78rem;
    }

    .recovery-confirmation-info-item p {
        margin: .3rem 0 0;
        color: var(--cinema-text-muted, #848d9d);
        font-size: .67rem;
        line-height: 1.6;
    }

    .recovery-confirmation-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: .7rem;
    }

        .recovery-confirmation-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 1.2rem;
            min-height: 48px;
        }

    .recovery-confirmation-primary > span:last-child {
        transition: transform var(--cinema-transition, 220ms ease);
    }

    .recovery-confirmation-primary:hover > span:last-child {
        transform: translateX(4px);
    }

    .recovery-confirmation-action-hint {
        margin: 1rem 0 0;
        color: var(--cinema-text-muted, #848d9d);
        font-size: .68rem;
        line-height: 1.6;
    }

    .recovery-confirmation-security {
        display: flex;
        max-width: 620px;
        align-items: flex-start;
        gap: .65rem;
        margin: 2rem auto 0;
        padding-top: 1.2rem;
        border-top: 1px solid var(--cinema-border, rgba(255,255,255,.09));
        text-align: left;
    }

        .recovery-confirmation-security > span {
            display: grid;
            flex: 0 0 25px;
            width: 25px;
            height: 25px;
            place-items: center;
            color: var(--cinema-gold-light, #f0cb76);
            border: 1px solid rgba(214,168,75,.17);
            border-radius: 50%;
            background: rgba(214,168,75,.05);
            font-family: Georgia, serif;
            font-size: .68rem;
            font-weight: bold;
        }

        .recovery-confirmation-security p {
            margin: 0;
            color: var(--cinema-text-muted, #848d9d);
            font-size: .67rem;
            line-height: 1.65;
        }

        .recovery-confirmation-security a {
            color: var(--cinema-gold-light, #f0cb76);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

    .recovery-confirmation-shell a:focus-visible {
        outline: 2px solid var(--cinema-gold-light, #f0cb76);
        outline-offset: 4px;
    }

    @@keyframes recovery-confirmation-orbit {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes recovery-confirmation-check-enter {
        from {
            opacity: 0;
            transform: scale(.5) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }

    @@media (max-width: 700px) {
        .recovery-confirmation-info {
            grid-template-columns: 1fr;
            gap: .65rem;
        }

        .recovery-confirmation-info-item {
            display: grid;
            grid-template-columns: 32px minmax(0,1fr);
            column-gap: .8rem;
        }

        .recovery-confirmation-info-icon {
            grid-row: span 2;
            margin-bottom: 0;
        }

        .recovery-confirmation-info-item p {
            grid-column: 2;
        }
    }

    @@media (max-width: 575.98px) {
        .recovery-confirmation-shell {
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg, 24px);
        }

        .recovery-confirmation-brand {
            margin-bottom: 1.75rem;
        }

        .recovery-confirmation-step strong {
            display: none;
        }

        .recovery-confirmation-line {
            flex: 1;
            margin: 0 .55rem;
        }

        .recovery-confirmation-content h1 {
            font-size: clamp(2.15rem, 9vw, 2.45rem);
        }

        .recovery-confirmation-visual {
            margin-bottom: 1.7rem;
        }

        .recovery-confirmation-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .recovery-confirmation-actions .btn {
                width: 100%;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .recovery-confirmation-orbit,
        .recovery-confirmation-check {
            animation: none;
        }
    }
</style>