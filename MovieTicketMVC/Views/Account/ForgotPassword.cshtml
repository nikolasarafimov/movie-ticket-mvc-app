@model MovieTicketMVC.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "Заборавена лозинка";
}

<main class="recovery-page" aria-labelledby="recovery-title">
    <section class="recovery-shell">
        <div class="recovery-visual" aria-hidden="true">
            <div class="recovery-visual-grid"></div>
            <div class="recovery-orbit recovery-orbit-large"></div>
            <div class="recovery-orbit recovery-orbit-small"></div>
            <div class="recovery-visual-center">
                <div class="recovery-key-icon"><span></span></div>
                <span>ACCOUNT RECOVERY</span>
            </div>
            <div class="recovery-visual-copy">
                <span>SECURE ACCESS</span>
                <strong>Повторно до твојот профил</strong>
                <p>Побарај линк за промена на лозинката и продолжи со твоето кино искуство.</p>
            </div>
        </div>

        <div class="recovery-content">
            <a class="recovery-brand" href="@Url.Action("Index", "Home")" aria-label="MovieTicket – почетна страница">
                <span aria-hidden="true"></span>
                MOVIETICKET
            </a>

            <nav class="recovery-progress" aria-label="Чекори за промена на лозинката">
                <div class="recovery-progress-step active" aria-current="step">
                    <span>01</span>
                    <strong>E-mail</strong>
                </div>
                <div class="recovery-progress-line" aria-hidden="true"></div>
                <div class="recovery-progress-step">
                    <span>02</span>
                    <strong>Линк</strong>
                </div>
                <div class="recovery-progress-line" aria-hidden="true"></div>
                <div class="recovery-progress-step">
                    <span>03</span>
                    <strong>Нова лозинка</strong>
                </div>
            </nav>

            <header class="recovery-heading">
                <div class="cinema-eyebrow">PASSWORD RECOVERY</div>
                <h1 id="recovery-title">Ја заборави <span class="cinema-text-gradient">лозинката?</span></h1>
                <p>Внеси ја e-mail адресата на твојот MovieTicket профил. Ако адресата е поврзана со сметка и испраќањето е успешно, ќе добиеш линк за поставување нова лозинка.</p>
            </header>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post,
                new { role = "form", id = "forgotPasswordForm", @class = "recovery-form" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new
                {
                    @class = "validation-summary-errors recovery-validation",
                    role = "alert"
                })

                <div class="form-group recovery-form-group">
                    @Html.LabelFor(m => m.Email, "E-mail адреса", new { @class = "form-label" })
                    <div class="recovery-input-wrapper">
                        <span class="recovery-input-icon" aria-hidden="true">&#64;</span>
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control recovery-input",
                            type = "email",
                            autocomplete = "email",
                            inputmode = "email",
                            placeholder = "name@example.com",
                            required = "required",
                            aria_describedby = "recovery-email-help",
                            autofocus = "autofocus"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger recovery-field-error" })
                    <small id="recovery-email-help" class="recovery-input-help">Користи ја адресата со која си регистриран на MovieTicket.</small>
                </div>

                <button type="submit" id="recoveryButton" class="btn btn-primary recovery-submit">
                    <span id="recoveryButtonText">Побарај линк за ресетирање</span>
                    <span class="recovery-submit-arrow" aria-hidden="true">→</span>
                </button>
            }

            <aside class="recovery-info" aria-label="Информации за барањето">
                <span class="recovery-info-icon" aria-hidden="true">i</span>
                <p>По испраќањето, провери го и <strong>Spam/Junk</strong> фолдерот. Од безбедносни причини, MovieTicket не открива дали внесената адреса има регистриран профил.</p>
            </aside>

            <a class="recovery-back" href="@Url.Action("Login", "Account")">
                <span aria-hidden="true">←</span>
                Назад кон најава
            </a>
        </div>
    </section>
</main>

<style>
    .recovery-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .recovery-shell {
        display: grid;
        grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
        width: min(100%, 980px);
        min-height: 650px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }

    .recovery-visual {
        position: relative;
        display: grid;
        min-width: 0;
        overflow: hidden;
        place-items: center;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient(circle at 50% 45%, rgba(214, 168, 75, .12), transparent 36%), radial-gradient(circle at 0% 100%, rgba(61, 101, 166, .14), transparent 33%), linear-gradient(145deg, #151d29, #0a0f17 58%, #06090e);
        isolation: isolate;
    }

    .recovery-visual-grid {
        position: absolute;
        z-index: -2;
        inset: 0;
        opacity: .24;
        background-image: linear-gradient(rgba(255, 255, 255, .022) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .022) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: linear-gradient(to bottom, #000, transparent 88%);
    }

    .recovery-visual-center {
        position: relative;
        z-index: 3;
        margin-top: -80px;
        text-align: center;
    }

        .recovery-visual-center > span {
            display: block;
            margin-top: 1.45rem;
            color: var(--cinema-text-muted);
            font-size: .56rem;
            font-weight: 900;
            letter-spacing: .19em;
        }

    .recovery-key-icon {
        position: relative;
        width: 106px;
        height: 106px;
        margin: 0 auto;
        border: 1px solid rgba(214, 168, 75, .3);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(214, 168, 75, .15), rgba(214, 168, 75, .035));
        box-shadow: 0 0 70px rgba(214, 168, 75, .1), 0 20px 55px rgba(0, 0, 0, .2);
    }

        .recovery-key-icon::before {
            position: absolute;
            top: 32px;
            left: 29px;
            width: 28px;
            height: 28px;
            content: "";
            border: 4px solid var(--cinema-gold-light);
            border-radius: 50%;
            box-shadow: 0 0 18px rgba(214, 168, 75, .24);
        }

        .recovery-key-icon::after {
            position: absolute;
            top: 48px;
            left: 55px;
            width: 37px;
            height: 4px;
            content: "";
            border-radius: 99px;
            background: var(--cinema-gold-light);
            transform: rotate(-35deg);
            transform-origin: left center;
        }

        .recovery-key-icon > span {
            position: absolute;
            top: 63px;
            left: 79px;
            width: 4px;
            height: 11px;
            background: var(--cinema-gold-light);
            transform: rotate(-35deg);
        }

    .recovery-orbit {
        position: absolute;
        width: 330px;
        height: 330px;
        border: 1px solid rgba(214, 168, 75, .095);
        border-radius: 50%;
        animation: recovery-orbit-spin 25s linear infinite;
    }

        .recovery-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, .7);
        }

    .recovery-orbit-small {
        width: 220px;
        height: 220px;
        animation-direction: reverse;
        animation-duration: 18s;
    }

    .recovery-visual-copy {
        position: absolute;
        right: 1.8rem;
        bottom: 3.2rem;
        left: 1.8rem;
        z-index: 3;
        text-align: center;
    }

        .recovery-visual-copy > span {
            display: block;
            margin-bottom: .5rem;
            color: var(--cinema-gold-light);
            font-size: .55rem;
            font-weight: 900;
            letter-spacing: .16em;
        }

        .recovery-visual-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 1.3rem;
        }

        .recovery-visual-copy p {
            max-width: 310px;
            margin: .55rem auto 0;
            color: var(--cinema-text-muted);
            font-size: .72rem;
            line-height: 1.65;
        }

    .recovery-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 3.8rem);
        background: linear-gradient(180deg, rgba(14, 19, 28, .99), rgba(8, 11, 17, .99));
    }

    .recovery-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: .65rem;
        margin-bottom: 2.2rem;
        color: var(--cinema-text);
        font-size: .68rem;
        font-weight: 900;
        letter-spacing: .17em;
    }

        .recovery-brand:hover {
            color: var(--cinema-gold-light);
        }

        .recovery-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, .09), 0 0 18px rgba(214, 168, 75, .55);
        }

    .recovery-progress {
        display: flex;
        align-items: center;
        gap: .1rem;
        margin-bottom: 2rem;
    }

    .recovery-progress-step {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: .4rem;
        opacity: .48;
    }

        .recovery-progress-step.active {
            opacity: 1;
        }

        .recovery-progress-step > span {
            display: grid;
            flex: 0 0 29px;
            width: 29px;
            height: 29px;
            place-items: center;
            color: var(--cinema-text-muted);
            border: 1px solid var(--cinema-border-strong);
            border-radius: 8px;
            background: rgba(255, 255, 255, .02);
            font-size: .52rem;
            font-weight: 900;
        }

        .recovery-progress-step.active > span {
            color: var(--cinema-gold-light);
            border-color: rgba(214, 168, 75, .33);
            background: rgba(214, 168, 75, .08);
        }

        .recovery-progress-step strong {
            color: var(--cinema-text-soft);
            font-size: .64rem;
            white-space: nowrap;
        }

    .recovery-progress-line {
        flex: 1 1 14px;
        min-width: 8px;
        height: 1px;
        margin: 0 .4rem;
        background: var(--cinema-border-strong);
    }

    .recovery-heading {
        margin-bottom: 1.65rem;
    }

        .recovery-heading h1 {
            margin-bottom: .9rem;
            font-size: clamp(2.2rem, 5vw, 3.3rem);
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .recovery-heading p {
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: .84rem;
            line-height: 1.75;
        }

    .recovery-form {
        width: 100%;
    }

    .recovery-validation {
        margin-bottom: 1rem;
    }

        .recovery-validation.validation-summary-valid {
            display: none;
        }

        .recovery-validation.validation-summary-errors {
            padding: .8rem 1rem;
            border: 1px solid rgba(239, 102, 115, .25);
            border-radius: 11px;
            background: rgba(239, 102, 115, .065);
            color: #ff9ba5;
            font-size: .77rem;
        }

        .recovery-validation ul {
            margin: 0;
            padding-left: 1rem;
        }

    .recovery-form-group {
        margin-bottom: 1.25rem;
    }

    .recovery-input-wrapper {
        position: relative;
    }

    .recovery-input {
        min-height: 52px;
        padding-left: 3rem;
    }

        .recovery-input:focus {
            border-color: rgba(214, 168, 75, .65);
        }

    .recovery-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        color: var(--cinema-text-muted);
        font-size: .8rem;
        font-weight: 800;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .recovery-field-error {
        display: block;
        margin-top: .4rem;
        font-size: .72rem;
    }

        .recovery-field-error:empty {
            display: none;
        }

    .recovery-input-help {
        display: block;
        margin-top: .5rem;
        color: var(--cinema-text-muted);
        font-size: .66rem;
        line-height: 1.55;
    }

    .recovery-submit {
        display: flex;
        width: 100%;
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        padding-right: 1.1rem;
        padding-left: 1.1rem;
        text-align: left;
    }

    .recovery-submit-arrow {
        transition: transform var(--cinema-transition);
    }

    .recovery-submit:hover:not(:disabled) .recovery-submit-arrow {
        transform: translateX(5px);
    }

    .recovery-submit:disabled {
        cursor: wait;
        opacity: .7;
        transform: none;
    }

    .recovery-info {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        margin-top: 1.45rem;
        padding: .85rem;
        border: 1px solid var(--cinema-border);
        border-radius: 11px;
        background: rgba(255, 255, 255, .018);
    }

    .recovery-info-icon {
        display: grid;
        flex: 0 0 25px;
        width: 25px;
        height: 25px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, .18);
        border-radius: 50%;
        background: rgba(214, 168, 75, .06);
        font-family: Georgia, serif;
        font-size: .7rem;
        font-weight: bold;
    }

    .recovery-info p {
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: .68rem;
        line-height: 1.6;
    }

    .recovery-info strong {
        color: var(--cinema-text-soft);
    }

    .recovery-back {
        display: inline-flex;
        align-self: center;
        align-items: center;
        gap: .45rem;
        margin-top: 1.8rem;
        color: var(--cinema-text-soft);
        font-size: .75rem;
        font-weight: 700;
    }

        .recovery-back > span {
            transition: transform var(--cinema-transition);
        }

        .recovery-back:hover {
            color: var(--cinema-gold-light);
        }

            .recovery-back:hover > span {
                transform: translateX(-4px);
            }

    .recovery-page a:focus-visible,
    .recovery-page button:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 3px;
    }

    @@keyframes recovery-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 840px) {
        .recovery-shell {
            grid-template-columns: 1fr;
            min-height: 0;
        }

        .recovery-visual {
            display: none;
        }

        .recovery-content {
            min-height: 610px;
        }
    }

    @@media (max-width: 575.98px) {
        .recovery-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .recovery-content {
            min-height: 0;
            padding: 2rem 1.2rem;
        }

        .recovery-brand {
            margin-bottom: 1.8rem;
        }

        .recovery-progress-step strong {
            display: none;
        }

        .recovery-progress-line {
            margin: 0 .35rem;
        }

        .recovery-heading h1 {
            font-size: 2.3rem;
        }

        .recovery-submit {
            font-size: .77rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .recovery-orbit {
            animation: none;
        }

        .recovery-submit-arrow,
        .recovery-back > span {
            transition: none;
        }
    }
</style>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("forgotPasswordForm");
            var button = document.getElementById("recoveryButton");
            var buttonText = document.getElementById("recoveryButtonText");
            var submitting = false;

            if (!form || !button || !buttonText) {
                return;
            }

            form.addEventListener("submit", function (event) {
                if (submitting) {
                    event.preventDefault();
                    return;
                }

                if (!form.checkValidity()) {
                    return;
                }

                if (window.jQuery && jQuery.fn && typeof jQuery.fn.valid === "function" && !jQuery(form).valid()) {
                    return;
                }

                submitting = true;
                button.disabled = true;
                buttonText.textContent = "Се обработува барањето...";
                form.setAttribute("aria-busy", "true");
            });

            window.addEventListener("pageshow", function () {
                submitting = false;
                button.disabled = false;
                buttonText.textContent = "Побарај линк за ресетирање";
                form.removeAttribute("aria-busy");
            });
        })();
    </script>
}