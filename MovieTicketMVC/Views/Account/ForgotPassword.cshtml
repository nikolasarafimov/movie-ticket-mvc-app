@model MovieTicketMVC.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "Заборавена лозинка";
}

<main class="recovery-page"
      aria-labelledby="recovery-title">

    <section class="recovery-shell">

        <div class="recovery-visual"
             aria-hidden="true">

            <div class="recovery-orbit recovery-orbit-large">
            </div>

            <div class="recovery-orbit recovery-orbit-small">
            </div>

            <div class="recovery-visual-center">

                <div class="recovery-key-icon">
                    <span></span>
                </div>

                <span>
                    ACCOUNT RECOVERY
                </span>

            </div>

        </div>


        <div class="recovery-content">

            <a class="recovery-brand"
               href="@Url.Action("Index", "Home")">

                <span></span>

                MOVIETICKET
            </a>


            <div class="recovery-progress"
                 aria-label="Процес за промена на лозинка">

                <div class="recovery-progress-step active">

                    <span>
                        01
                    </span>

                    <strong>
                        E-mail
                    </strong>

                </div>

                <div class="recovery-progress-line">
                </div>

                <div class="recovery-progress-step">

                    <span>
                        02
                    </span>

                    <strong>
                        Link
                    </strong>

                </div>

                <div class="recovery-progress-line">
                </div>

                <div class="recovery-progress-step">

                    <span>
                        03
                    </span>

                    <strong>
                        Reset
                    </strong>

                </div>

            </div>


            <div class="recovery-heading">

                <div class="cinema-eyebrow">
                    PASSWORD RECOVERY
                </div>

                <h1 id="recovery-title">
                    Ја заборави
                    <span class="cinema-text-gradient">
                        лозинката?
                    </span>
                </h1>

                <p>
                    Внеси ја e-mail адресата поврзана со
                    твојот MovieTicket профил. Ќе добиеш
                    линк со кој можеш да поставиш нова лозинка.
                </p>

            </div>


            @using (Html.BeginForm(
                "ForgotPassword",
                "Account",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "forgotPasswordForm",
                    @class = "recovery-form"
                }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class =
                            "validation-summary-errors recovery-validation"
                    })


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.Email,
                        "E-mail адреса",
                        new
                        {
                            @class = "form-label"
                        })

                    <div class="recovery-input-wrapper">

                        <span class="recovery-input-icon"
                              aria-hidden="true">
                            &#64;
                        </span>

                        @Html.TextBoxFor(
                            m => m.Email,
                            new
                            {
                                @class =
                                    "form-control recovery-input",
                                type =
                                    "email",
                                autocomplete =
                                    "email",
                                placeholder =
                                    "name@example.com",
                                autofocus =
                                    "autofocus"
                            })

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.Email,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <button type="submit"
                        id="recoveryButton"
                        class="btn btn-primary recovery-submit">

                    <span id="recoveryButtonText">
                        Испрати reset link
                    </span>

                    <span aria-hidden="true">
                        →
                    </span>

                </button>
            }


            <div class="recovery-info">

                <span class="recovery-info-icon"
                      aria-hidden="true">
                    i
                </span>

                <p>
                    Провери ги и Inbox и Spam/Junk папките
                    откако ќе го испратиш барањето.
                </p>

            </div>


            <div class="recovery-back">

                <span aria-hidden="true">
                    ←
                </span>

                @Html.ActionLink(
                    "Назад кон најава",
                    "Login",
                    "Account")

            </div>

        </div>

    </section>

</main>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            var form =
                document.getElementById(
                    "forgotPasswordForm");

            var button =
                document.getElementById(
                    "recoveryButton");

            var buttonText =
                document.getElementById(
                    "recoveryButtonText");

            if (
                !form ||
                !button ||
                !buttonText
            ) {
                return;
            }

            form.addEventListener(
                "submit",
                function () {

                    if (
                        typeof $ !== "undefined" &&
                        $.validator &&
                        !$(form).valid()
                    ) {
                        return;
                    }

                    button.disabled =
                        true;

                    buttonText.textContent =
                        "Се испраќа...";
                });
        })();
    </script>
}


<style>
    .recovery-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .recovery-shell {
        position: relative;
        display: grid;
        grid-template-columns:
            minmax(300px, 0.8fr)
            minmax(430px, 1.2fr);
        width: min(100%, 980px);
        min-height: 630px;
        overflow: hidden;
        border:
            1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }


    /* =====================================================
       VISUAL
       ===================================================== */

    .recovery-visual {
        position: relative;
        display: grid;
        place-items: center;
        overflow: hidden;
        border-right:
            1px solid var(--cinema-border);
        background:
            radial-gradient(
                circle at 50% 50%,
                rgba(214, 168, 75, 0.10),
                transparent 34%
            ),
            radial-gradient(
                circle at 10% 100%,
                rgba(61, 101, 166, 0.14),
                transparent 32%
            ),
            linear-gradient(
                145deg,
                #151d29,
                #0a0f17 58%,
                #06090e
            );
        isolation: isolate;
    }

    .recovery-visual::before {
        position: absolute;
        z-index: -2;
        inset: 0;
        content: "";
        opacity: 0.25;
        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.022) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.022) 1px,
                transparent 1px
            );
        background-size:
            42px 42px;
    }

    .recovery-visual-center {
        position: relative;
        z-index: 3;
        text-align: center;
    }

    .recovery-visual-center > span {
        display: block;
        margin-top: 1.3rem;
        color: var(--cinema-text-muted);
        font-size: 0.57rem;
        font-weight: 900;
        letter-spacing: 0.2em;
    }


    /* Key illustration */

    .recovery-key-icon {
        position: relative;
        width: 92px;
        height: 92px;
        margin: 0 auto;
        border:
            1px solid rgba(214, 168, 75, 0.27);
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                rgba(214, 168, 75, 0.14),
                rgba(214, 168, 75, 0.035)
            );
        box-shadow:
            0 0 60px
            rgba(214, 168, 75, 0.09);
    }

    .recovery-key-icon::before {
        position: absolute;
        top: 31px;
        left: 28px;
        width: 25px;
        height: 25px;
        content: "";
        border:
            4px solid var(--cinema-gold-light);
        border-radius: 50%;
        box-shadow:
            0 0 18px
            rgba(214, 168, 75, 0.28);
    }

    .recovery-key-icon::after {
        position: absolute;
        top: 43px;
        left: 51px;
        width: 35px;
        height: 4px;
        content: "";
        border-radius: 99px;
        background:
            var(--cinema-gold-light);
        transform:
            rotate(-35deg);
        transform-origin:
            left center;
        box-shadow:
            0 0 15px
            rgba(214, 168, 75, 0.22);
    }

    .recovery-key-icon > span {
        position: absolute;
        z-index: 3;
        top: 57px;
        left: 72px;
        width: 4px;
        height: 11px;
        background:
            var(--cinema-gold-light);
        transform:
            rotate(-35deg);
    }


    /* Orbits */

    .recovery-orbit {
        position: absolute;
        border:
            1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation:
            recovery-orbit-spin
            25s
            linear
            infinite;
    }

    .recovery-orbit::after {
        position: absolute;
        top: -5px;
        left: 50%;
        width: 9px;
        height: 9px;
        content: "";
        border-radius: 50%;
        background:
            var(--cinema-gold);
        box-shadow:
            0 0 18px
            rgba(214, 168, 75, 0.72);
    }

    .recovery-orbit-large {
        width: 330px;
        height: 330px;
    }

    .recovery-orbit-small {
        width: 220px;
        height: 220px;
        animation-direction: reverse;
        animation-duration: 18s;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .recovery-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding:
            clamp(2rem, 6vw, 4rem);
        background:
            linear-gradient(
                180deg,
                rgba(14, 19, 28, 0.99),
                rgba(8, 11, 17, 0.99)
            );
    }

    .recovery-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.5rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

    .recovery-brand:hover {
        color: var(--cinema-gold-light);
    }

    .recovery-brand > span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background:
            var(--cinema-gold);
        box-shadow:
            0 0 0 5px
            rgba(214, 168, 75, 0.09),
            0 0 18px
            rgba(214, 168, 75, 0.55);
    }


    /* =====================================================
       PROGRESS
       ===================================================== */

    .recovery-progress {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
    }

    .recovery-progress-step {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        opacity: 0.35;
    }

    .recovery-progress-step.active {
        opacity: 1;
    }

    .recovery-progress-step > span {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        color: var(--cinema-text-muted);
        border:
            1px solid var(--cinema-border-strong);
        border-radius: 8px;
        background:
            rgba(255, 255, 255, 0.02);
        font-size: 0.52rem;
        font-weight: 900;
    }

    .recovery-progress-step.active > span {
        color: var(--cinema-gold-light);
        border-color:
            rgba(214, 168, 75, 0.3);
        background:
            rgba(214, 168, 75, 0.07);
    }

    .recovery-progress-step strong {
        color: var(--cinema-text-soft);
        font-size: 0.62rem;
    }

    .recovery-progress-line {
        width: 35px;
        height: 1px;
        margin: 0 0.55rem;
        background:
            var(--cinema-border-strong);
    }


    /* =====================================================
       HEADING
       ===================================================== */

    .recovery-heading {
        margin-bottom: 1.8rem;
    }

    .recovery-heading h1 {
        margin-bottom: 0.9rem;
        font-size:
            clamp(
                2.2rem,
                5vw,
                3.3rem
            );
        line-height: 1.02;
        letter-spacing: -0.045em;
    }

    .recovery-heading p {
        max-width: 510px;
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 0.85rem;
        line-height: 1.75;
    }


    /* =====================================================
       FORM
       ===================================================== */

    .recovery-form {
        width: 100%;
    }

    .recovery-validation {
        margin-bottom: 1.1rem;
    }

    .recovery-validation:empty {
        display: none;
    }

    .recovery-input-wrapper {
        position: relative;
    }

    .recovery-input {
        min-height: 52px;
        padding-left: 3rem;
    }

    .recovery-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        color: var(--cinema-text-muted);
        font-size: 0.73rem;
        font-weight: 800;
        pointer-events: none;
        transform:
            translateY(-50%);
    }

    .recovery-submit {
        display: flex;
        width: 100%;
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.5rem;
        padding-right: 1.1rem;
        padding-left: 1.1rem;
    }

    .recovery-submit > span:last-child {
        transition:
            transform var(--cinema-transition);
    }

    .recovery-submit:hover
    > span:last-child {
        transform:
            translateX(5px);
    }


    /* =====================================================
       INFO
       ===================================================== */

    .recovery-info {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        margin-top: 1.4rem;
        padding: 0.8rem;
        border:
            1px solid var(--cinema-border);
        border-radius: 11px;
        background:
            rgba(255, 255, 255, 0.018);
    }

    .recovery-info-icon {
        display: grid;
        flex: 0 0 25px;
        width: 25px;
        height: 25px;
        place-items: center;
        color: var(--cinema-gold-light);
        border:
            1px solid rgba(214, 168, 75, 0.18);
        border-radius: 50%;
        background:
            rgba(214, 168, 75, 0.06);
        font-family: Georgia, serif;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .recovery-info p {
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 0.68rem;
        line-height: 1.55;
    }


    /* =====================================================
       BACK
       ===================================================== */

    .recovery-back {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        margin-top: 1.7rem;
        color: var(--cinema-text-muted);
        font-size: 0.75rem;
    }

    .recovery-back > span {
        transition:
            transform var(--cinema-transition);
    }

    .recovery-back a {
        color: var(--cinema-text-soft);
        font-weight: 700;
    }

    .recovery-back:hover > span {
        transform:
            translateX(-4px);
    }

    .recovery-back a:hover {
        color: var(--cinema-gold-light);
    }


    /* =====================================================
       ANIMATION
       ===================================================== */

    @@keyframes recovery-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 800px) {
        .recovery-shell {
            grid-template-columns: 1fr;
            min-height: 0;
        }

        .recovery-visual {
            display: none;
        }

        .recovery-content {
            min-height: 620px;
        }
    }

    @@media (max-width: 575.98px) {
        .recovery-shell {
            border-radius:
                var(--cinema-radius-lg);
        }

        .recovery-content {
            min-height: 0;
            padding:
                2rem 1.2rem;
        }

        .recovery-progress-step strong {
            display: none;
        }

        .recovery-progress-line {
            flex: 1;
        }

        .recovery-heading h1 {
            font-size: 2.2rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .recovery-orbit {
            animation: none;
        }
    }
</style>