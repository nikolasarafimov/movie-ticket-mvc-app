@model MovieTicketMVC.Models.RegisterViewModel

@{
    ViewBag.Title = "Register";
}

<main class="register-page" aria-labelledby="register-title">
    <section class="register-shell">
        <div class="register-showcase">
            <div class="register-showcase-glow register-showcase-glow-gold" aria-hidden="true"></div>
            <div class="register-showcase-glow register-showcase-glow-blue" aria-hidden="true"></div>

            <div class="register-showcase-content">
                <a class="register-brand" href="@Url.Action("Index", "Home")" aria-label="MovieTicket home page">
                    <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                         alt="MovieTicket"
                         width="174"
                         height="48"
                         decoding="async" />
                </a>

                <div class="register-showcase-copy">
                    <div class="cinema-eyebrow">YOUR NEXT MOVIE MOMENT</div>
                    <h2>
                        Your next
                        <span class="cinema-text-gradient">movie</span>
                        is just a few clicks away.
                    </h2>
                    <p>
                        Create a MovieTicket account, choose your seats,
                        and keep all your tickets in one place.
                    </p>
                </div>
            </div>

            <div class="register-ticket-art" aria-hidden="true">
                <div class="register-ticket-top">
                    <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                         alt=""
                         width="105"
                         height="30"
                         decoding="async" />
                    <span>MOVIE TICKET</span>
                </div>

                <div class="register-ticket-title">
                    <small>YOUR CINEMA EXPERIENCE</small>
                    <strong>Your next<br />movie night</strong>
                </div>

                <div class="register-ticket-divider"></div>

                <div class="register-ticket-lines">
                    <span></span><span></span><span></span><span></span><span></span>
                    <span></span><span></span><span></span><span></span><span></span>
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
            </div>
        </div>

        <div class="register-form-side">
            <div class="register-form-wrapper">
                <div class="register-heading">
                    <span class="register-heading-label">JOIN MOVIETICKET</span>
                    <h1 id="register-title">Create an account</h1>
                    <p>
                        Enter your email address and create a password. Once
                        registration is complete, you will be signed in automatically.
                    </p>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new
                {
                    id = "registerForm",
                    @class = "register-form",
                    role = "form",
                    aria_label = "Registration form"
                }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "Registration failed", new
                    {
                        @class = "register-validation",
                        role = "alert"
                    })

                    <div id="registerClientError"
                         class="register-client-error"
                         role="alert"
                         hidden></div>

                    <div class="register-field">
                        @Html.LabelFor(m => m.Email, "Email address", new { @class = "form-label" })

                        <div class="register-input-wrapper">
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control register-input",
                                type = "email",
                                autocomplete = "email",
                                inputmode = "email",
                                autocapitalize = "none",
                                spellcheck = "false",
                                placeholder = "name@example.com",
                                required = "required",
                                aria_required = "true",
                                aria_describedby = "registerEmailError",
                                autofocus = "autofocus"
                            })
                        </div>

                        @Html.ValidationMessageFor(m => m.Email, "", new
                        {
                            @class = "register-field-error",
                            id = "registerEmailError"
                        })
                    </div>

                    <div class="register-field">
                        @Html.LabelFor(m => m.Password, "Password", new { @class = "form-label" })

                        <div class="register-input-wrapper">
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control register-input register-password-input",
                                id = "Password",
                                autocomplete = "new-password",
                                placeholder = "Create a password",
                                minlength = "8",
                                maxlength = "100",
                                required = "required",
                                aria_required = "true",
                                aria_describedby = "registerPasswordError registerPasswordRules"
                            })

                            <button type="button"
                                    class="register-password-toggle"
                                    data-password-target="Password"
                                    aria-label="Show password"
                                    aria-controls="Password"
                                    aria-pressed="false">
                                Show
                            </button>
                        </div>

                        @Html.ValidationMessageFor(m => m.Password, "", new
                        {
                            @class = "register-field-error",
                            id = "registerPasswordError"
                        })

                        <div class="register-password-strength">
                            <div class="register-strength-header">
                                <span>Password requirements met</span>
                                <strong id="passwordStrengthText" aria-live="polite">—</strong>
                            </div>

                            <div class="register-strength-track" aria-hidden="true">
                                <span id="passwordStrengthBar"></span>
                            </div>
                        </div>

                        <div id="registerPasswordRules"
                             class="register-requirements"
                             aria-label="Password requirements">

                            <div class="register-requirement" id="requirementLength">
                                <span aria-hidden="true">✓</span>
                                8 to 100 characters
                            </div>

                            <div class="register-requirement" id="requirementUpper">
                                <span aria-hidden="true">✓</span>
                                Uppercase letter
                            </div>

                            <div class="register-requirement" id="requirementLower">
                                <span aria-hidden="true">✓</span>
                                Lowercase letter
                            </div>

                            <div class="register-requirement" id="requirementNumber">
                                <span aria-hidden="true">✓</span>
                                Number
                            </div>

                            <div class="register-requirement" id="requirementSpecial">
                                <span aria-hidden="true">✓</span>
                                Special character
                            </div>
                        </div>
                    </div>

                    <div class="register-field register-confirm-field">
                        @Html.LabelFor(m => m.ConfirmPassword, "Confirm password", new { @class = "form-label" })

                        <div class="register-input-wrapper">
                            @Html.PasswordFor(m => m.ConfirmPassword, new
                            {
                                @class = "form-control register-input register-password-input",
                                id = "ConfirmPassword",
                                autocomplete = "new-password",
                                placeholder = "Re-enter your password",
                                maxlength = "100",
                                required = "required",
                                aria_required = "true",
                                aria_describedby = "registerConfirmError passwordMatchIndicator"
                            })

                            <button type="button"
                                    class="register-password-toggle"
                                    data-password-target="ConfirmPassword"
                                    aria-label="Show password"
                                    aria-controls="ConfirmPassword"
                                    aria-pressed="false">
                                Show
                            </button>
                        </div>

                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new
                        {
                            @class = "register-field-error",
                            id = "registerConfirmError"
                        })

                        <div id="passwordMatchIndicator"
                             class="register-match-indicator"
                             aria-live="polite"></div>
                    </div>

                    <button type="submit"
                            id="registerButton"
                            class="btn btn-primary register-submit">
                        <span id="registerButtonText">Create Account</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <div class="register-login-link">
                        <span>Already have an account?</span>
                        @Html.ActionLink("Sign In", "Login", "Account")
                    </div>
                }

                <div class="register-security-note">
                    <span class="register-security-icon" aria-hidden="true">✓</span>
                    <p>
                        Choose a unique password with uppercase and lowercase letters,
                        a number, and a special character. Do not reuse passwords from other accounts.
                    </p>
                </div>
            </div>
        </div>
    </section>
</main>

<style>
    .register-page {
        width: 100%;
        min-width: 0;
    }

        .register-page .register-shell {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(410px, .95fr);
            min-height: 760px;
            overflow: hidden;
            border: 1px solid var(--cinema-border);
            border-radius: var(--cinema-radius-xl);
            background: #090d13;
            box-shadow: var(--cinema-shadow-lg);
        }

    .register-showcase {
        position: relative;
        min-width: 0;
        overflow: hidden;
        padding: clamp(2rem, 4.3vw, 4rem);
        isolation: isolate;
        background: radial-gradient( circle at 16% 20%, rgba(214, 168, 75, .13), transparent 32% ), radial-gradient( circle at 88% 90%, rgba(63, 103, 166, .18), transparent 35% ), linear-gradient( 145deg, #141c29, #090e16 57%, #070a10 );
    }

        .register-showcase::before {
            position: absolute;
            z-index: -1;
            inset: 0;
            content: "";
            opacity: .2;
            pointer-events: none;
            background-image: linear-gradient( rgba(255, 255, 255, .035) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, .035) 1px, transparent 1px );
            background-size: 48px 48px;
            -webkit-mask-image: linear-gradient(140deg, #000, transparent 80%);
            mask-image: linear-gradient(140deg, #000, transparent 80%);
        }

    .register-showcase-glow {
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(24px);
        pointer-events: none;
    }

    .register-showcase-glow-gold {
        top: -130px;
        left: -140px;
        width: 340px;
        height: 340px;
        background: rgba(214, 168, 75, .075);
    }

    .register-showcase-glow-blue {
        right: -130px;
        bottom: -180px;
        width: 420px;
        height: 420px;
        background: rgba(63, 103, 166, .11);
    }

    .register-showcase-content {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-width: 0;
    }

    .register-brand {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        border-radius: 8px;
        text-decoration: none;
    }

        .register-brand img {
            display: block;
            width: 174px;
            max-width: 100%;
            height: 48px;
            object-fit: contain;
            object-position: left center;
        }

    .register-showcase-copy {
        position: relative;
        z-index: 2;
        max-width: 600px;
        margin-top: auto;
        padding-top: 6rem;
    }

        .register-showcase-copy h2 {
            margin-bottom: 1.25rem;
            font-size: clamp(2.7rem, 5vw, 4.85rem);
            font-weight: 800;
            line-height: 1.08;
            letter-spacing: -.055em;
            overflow-wrap: break-word;
        }

        .register-showcase-copy p {
            max-width: 520px;
            margin-bottom: 0;
            color: #c9d0da;
            font-size: 1rem;
            line-height: 1.8;
        }

    .register-ticket-art {
        position: absolute;
        z-index: 1;
        top: 12%;
        right: 30px;
        width: 220px;
        padding: 1.15rem;
        border: 1px solid rgba(255, 255, 255, .14);
        border-radius: 20px;
        background: linear-gradient(145deg, #1a2331, #0b101a);
        box-shadow: 0 32px 70px rgba(0, 0, 0, .4);
        opacity: .77;
        transform: rotate(5deg);
        animation: register-ticket-float 7s ease-in-out infinite;
        pointer-events: none;
    }

    .register-ticket-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
    }

        .register-ticket-top img {
            display: block;
            width: 96px;
            min-width: 0;
            height: 30px;
            object-fit: contain;
        }

        .register-ticket-top > span {
            color: #f0cb76;
            padding: .27rem .34rem;
            border: 1px solid rgba(214, 168, 75, .26);
            border-radius: 999px;
            white-space: nowrap;
            font-size: .49rem;
            font-weight: 800;
        }

    .register-ticket-title {
        padding: 2.8rem 0 2.1rem;
    }

        .register-ticket-title small {
            display: block;
            margin-bottom: .55rem;
            color: #e6b956;
            font-size: .55rem;
            font-weight: 850;
            letter-spacing: .06em;
        }

        .register-ticket-title strong {
            display: block;
            color: #f5f7fb;
            font-size: 1.52rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

    .register-ticket-divider {
        height: 1px;
        background: repeating-linear-gradient( 90deg, rgba(255, 255, 255, .19) 0 7px, transparent 7px 14px );
    }

    .register-ticket-lines {
        display: flex;
        justify-content: center;
        gap: 4px;
        height: 35px;
        margin-top: 1.3rem;
        opacity: .74;
    }

        .register-ticket-lines span {
            display: block;
            width: 3px;
            height: 100%;
            background: #c1cad6;
        }

            .register-ticket-lines span:nth-child(2n) {
                width: 1px;
            }

            .register-ticket-lines span:nth-child(3n) {
                width: 5px;
            }

    .register-form-side {
        display: grid;
        place-items: center;
        min-width: 0;
        padding: clamp(2rem, 4.4vw, 4rem);
        background: linear-gradient( 180deg, rgba(13, 18, 27, .99), rgba(8, 11, 17, .99) );
    }

    .register-form-wrapper {
        width: min(100%, 450px);
        min-width: 0;
    }

    .register-heading {
        margin-bottom: 1.7rem;
    }

    .register-heading-label {
        display: block;
        margin-bottom: .6rem;
        color: var(--cinema-gold-light);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .09em;
    }

    .register-heading h1 {
        margin: 0 0 .7rem;
        font-size: clamp(2.05rem, 4vw, 2.75rem);
        line-height: 1.2;
    }

    .register-heading p {
        margin: 0;
        max-width: 400px;
        color: #adb8c8;
        font-size: .91rem;
        line-height: 1.7;
    }

    .register-form {
        width: 100%;
    }

        .register-form .register-field {
            margin-bottom: 1.25rem;
        }

        .register-form .form-label {
            display: inline-block;
            margin-bottom: .55rem;
            color: #dfe4ed;
            font-size: .86rem;
            font-weight: 650;
        }

    .register-page .register-input-wrapper {
        position: relative;
        width: 100%;
    }

    .register-page .register-form .register-input-wrapper .register-input {
        display: block;
        width: 100%;
        min-height: 52px;
        padding: .82rem 1rem;
        border: 1px solid rgba(255, 255, 255, .16);
        border-radius: 12px;
        background: #121925;
        color: #f5f7fb;
        font-size: .91rem;
        line-height: 1.5;
        transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    }

    .register-page .register-form .register-input-wrapper .register-password-input {
        padding-right: 6.7rem;
    }

    .register-page .register-input::placeholder {
        color: #97a2b3;
        opacity: 1;
    }

    .register-page .register-input:-webkit-autofill,
    .register-page .register-input:-webkit-autofill:hover,
    .register-page .register-input:-webkit-autofill:focus {
        -webkit-text-fill-color: #f5f7fb;
        -webkit-box-shadow: 0 0 0 1000px #121925 inset;
        caret-color: #f5f7fb;
    }

    .register-page .register-password-toggle {
        position: absolute;
        z-index: 2;
        top: 50%;
        right: .7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: .35rem .65rem;
        color: #cbd3df;
        border: 0;
        border-radius: 7px;
        background: transparent;
        font-size: .76rem;
        font-weight: 700;
        cursor: pointer;
        transform: translateY(-50%);
    }

        .register-page .register-password-toggle:hover {
            color: var(--cinema-gold-light);
            background: rgba(255, 255, 255, .055);
        }

    .register-page .register-form .register-input-wrapper .register-input:focus {
        border-color: var(--cinema-gold);
        background: #141d2b;
        outline: none;
        box-shadow: 0 0 0 3px rgba(214, 168, 75, .13);
    }

    .register-page .register-form .register-input-wrapper .input-validation-error,
    .register-page .register-form .register-input-wrapper .register-input[aria-invalid="true"] {
        border-color: rgba(239, 102, 115, .8);
    }

    .register-page .register-validation,
    .register-page .register-client-error {
        margin-bottom: 1.25rem;
        padding: .85rem 1rem;
        border: 1px solid rgba(239, 102, 115, .35);
        border-radius: 12px;
        background: rgba(239, 102, 115, .085);
        color: #ffc1c7;
        font-size: .82rem;
        line-height: 1.6;
    }

        .register-page .register-validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

        .register-page .validation-summary-valid.register-validation,
        .register-page .register-client-error[hidden],
        .register-page .register-validation:empty {
            display: none;
        }

    .register-page .register-field-error {
        display: block;
        margin-top: .4rem;
        color: #ffacb4;
        font-size: .75rem;
        line-height: 1.45;
    }

        .register-page .register-field-error:empty {
            display: none;
        }

    .register-password-strength {
        margin-top: .8rem;
    }

    .register-strength-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .48rem;
        color: #aab5c4;
        font-size: .73rem;
    }

        .register-strength-header strong {
            color: #d2d9e4;
            font-size: .73rem;
            font-weight: 750;
            text-align: right;
        }

    .register-strength-track {
        height: 5px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255, 255, 255, .09);
    }

    #passwordStrengthBar {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        transition: width 250ms ease, background-color 250ms ease;
    }

        #passwordStrengthBar.weak {
            background: var(--cinema-danger);
        }

        #passwordStrengthBar.medium {
            background: var(--cinema-warning);
        }

        #passwordStrengthBar.strong {
            background: var(--cinema-success);
        }

    .register-requirements {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .45rem .75rem;
        margin-top: .85rem;
    }

    .register-requirement {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: .45rem;
        color: #9ca8b9;
        font-size: .74rem;
        line-height: 1.4;
        transition: color 180ms ease;
    }

        .register-requirement > span {
            display: grid;
            flex: 0 0 17px;
            place-items: center;
            width: 17px;
            height: 17px;
            color: #828d9b;
            border: 1px solid rgba(255, 255, 255, .14);
            border-radius: 50%;
            font-size: .59rem;
        }

        .register-requirement.valid {
            color: #a1e5bd;
        }

            .register-requirement.valid > span {
                color: #9ae8bd;
                border-color: rgba(66, 199, 131, .35);
                background: rgba(66, 199, 131, .09);
            }

    .register-confirm-field {
        margin-top: .25rem;
    }

    .register-match-indicator {
        margin-top: .45rem;
        color: #aab5c4;
        font-size: .76rem;
        line-height: 1.4;
    }

        .register-match-indicator:empty {
            display: none;
        }

        .register-match-indicator.valid {
            color: #9ae8bd;
        }

        .register-match-indicator.invalid {
            color: #ffacb4;
        }

    .register-submit {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        min-height: 52px;
        padding: .75rem 1.1rem;
        font-size: .89rem;
        font-weight: 800;
    }

        .register-submit:disabled {
            opacity: .8;
            cursor: progress;
        }

    .register-login-link {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: .4rem;
        margin-top: 1.3rem;
        color: #a5afbe;
        font-size: .84rem;
        text-align: center;
    }

        .register-login-link a {
            color: var(--cinema-gold-light);
            font-weight: 750;
        }

            .register-login-link a:hover {
                color: #ffe0a0;
            }

    .register-security-note {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        margin-top: 1.75rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--cinema-border);
    }

    .register-security-icon {
        display: grid;
        flex: 0 0 24px;
        place-items: center;
        width: 24px;
        height: 24px;
        border: 1px solid rgba(66, 199, 131, .25);
        border-radius: 50%;
        background: rgba(66, 199, 131, .07);
        color: #95e8b5;
        font-size: .74rem;
        font-weight: 800;
    }

    .register-security-note p {
        margin: 0;
        color: #a7b1c0;
        font-size: .76rem;
        line-height: 1.65;
    }

    .register-page a:focus-visible,
    .register-page button:focus-visible,
    .register-page input:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 3px;
    }

    @@keyframes register-ticket-float {
        0%, 100% {
            transform: rotate(5deg) translateY(0);
        }

        50% {
            transform: rotate(3deg) translateY(-10px);
        }
    }

    @@media (max-width: 1150px) {
        .register-ticket-art {
            display: none;
        }

        .register-showcase-copy {
            padding-top: 3rem;
        }
    }

    @@media (max-width: 900px) {
        .register-page .register-shell {
            grid-template-columns: minmax(0, 1fr);
            min-height: 0;
        }

        .register-showcase {
            display: none;
        }

        .register-form-side {
            padding: clamp(2rem, 6vw, 3.5rem);
        }
    }

    @@media (max-width: 575.98px) {
        .register-page .register-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .register-form-side {
            padding: 2rem 1.15rem;
        }

        .register-heading h1 {
            font-size: 2rem;
        }

        .register-requirements {
            grid-template-columns: minmax(0, 1fr);
        }

        .register-page .register-form .register-input-wrapper .register-input {
            min-height: 50px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .register-ticket-art {
            animation: none;
        }

        #passwordStrengthBar,
        .register-page .register-input,
        .register-requirement {
            transition: none;
        }
    }


    .register-page .register-validation.validation-summary-errors {
        position: relative;
        display: block;
        margin-bottom: 0.7rem;
        padding: 1rem 1.1rem 1rem 3.5rem;
        border: 1px solid rgba(214, 168, 75, 0.28);
        border-radius: 13px;
        background: rgba(214, 168, 75, 0.055);
        color: #d9dfe8;
        font-size: 0.83rem;
        line-height: 1.65;
    }

        .register-page .register-validation.validation-summary-errors::before {
            position: absolute;
            top: 1rem;
            left: 1rem;
            display: grid;
            place-items: center;
            width: 25px;
            height: 25px;
            content: "!";
            border: 1px solid rgba(214, 168, 75, 0.3);
            border-radius: 50%;
            background: rgba(214, 168, 75, 0.12);
            color: #f0cb76;
            font-weight: 800;
        }

    .register-page .register-validation > span {
        display: block;
        margin-bottom: 0.3rem;
        color: #f0cb76;
        font-size: 0.9rem;
        font-weight: 800;
    }

    .register-page .register-validation ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .register-page .register-validation li {
        margin: 0;
        padding: 0;
        color: #d9dfe8;
    }

        .register-page .register-validation li + li {
            margin-top: 0.4rem;
        }

    .register-page .register-error-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.7rem 1.4rem;
        margin-bottom: 1.25rem;
        padding-left: 0.25rem;
    }

        .register-page .register-error-actions a {
            color: #f0cb76;
            font-size: 0.8rem;
