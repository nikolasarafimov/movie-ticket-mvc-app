            .register-page .register-error-actions a:hover {
                color: #ffe0a0;
                text-decoration: underline;
            }
</style>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("registerForm");
            var password = document.getElementById("Password");
            var confirmation = document.getElementById("ConfirmPassword");
            var button = document.getElementById("registerButton");
            var buttonText = document.getElementById("registerButtonText");
            var strengthBar = document.getElementById("passwordStrengthBar");
            var strengthText = document.getElementById("passwordStrengthText");
            var matchIndicator = document.getElementById("passwordMatchIndicator");
            var clientError = document.getElementById("registerClientError");

            var requirements = {
                length: document.getElementById("requirementLength"),
                upper: document.getElementById("requirementUpper"),
                lower: document.getElementById("requirementLower"),
                number: document.getElementById("requirementNumber"),
                special: document.getElementById("requirementSpecial")
            };

            var submitting = false;

            if (!form || !password || !confirmation || !button) {
                return;
            }

            function unicodeTest(property, value, fallback) {
                try {
                    return new RegExp("\\p{" + property + "}", "u").test(value);
                } catch (error) {
                    return fallback.test(value);
                }
            }

            function hasSpecialCharacter(value) {
                try {
                    return new RegExp("[^\\p{L}\\p{Nd}]", "u").test(value);
                } catch (error) {
                    return /[^A-Za-z0-9\u0400-\u052F]/.test(value);
                }
            }

            function getChecks(value) {
                return {
                    length: value.length >= 8 && value.length <= 100,
                    upper: unicodeTest("Lu", value, /[A-Z\u0400-\u042F]/),
                    lower: unicodeTest("Ll", value, /[a-z\u0430-\u045F]/),
                    number: unicodeTest("Nd", value, /[0-9]/),
                    special: hasSpecialCharacter(value)
                };
            }

            function setClientError(message) {
                if (!clientError) {
                    return;
                }

                clientError.textContent = message || "";
                clientError.hidden = !message;
            }

            function updateMatch() {
                if (!matchIndicator) {
                    return;
                }

                matchIndicator.classList.remove("valid", "invalid");

                if (!confirmation.value) {
                    matchIndicator.textContent = "";
                    confirmation.removeAttribute("aria-invalid");
                } else if (password.value === confirmation.value) {
                    matchIndicator.classList.add("valid");
                    matchIndicator.textContent = "Passwords match.";
                    confirmation.setAttribute("aria-invalid", "false");
                } else {
                    matchIndicator.classList.add("invalid");
                    matchIndicator.textContent = "Passwords do not match.";
                    confirmation.setAttribute("aria-invalid", "true");
                }
            }

            function updatePassword() {
                var value = password.value || "";
                var checks = getChecks(value);
                var score = 0;

                Object.keys(checks).forEach(function (key) {
                    if (checks[key]) {
                        score++;
                    }

                    if (requirements[key]) {
                        requirements[key].classList.toggle("valid", checks[key]);
                    }
                });

                if (strengthBar && strengthText) {
                    strengthBar.className = "";
                    strengthBar.style.width = value ? (score * 20) + "%" : "0%";

                    if (!value) {
                        strengthText.textContent = "—";
                    } else if (score <= 2) {
                        strengthBar.classList.add("weak");
                        strengthText.textContent = score + " of 5 requirements met";
                    } else if (score <= 4) {
                        strengthBar.classList.add("medium");
                        strengthText.textContent = score + " of 5 requirements met";
                    } else {
                        strengthBar.classList.add("strong");
                        strengthText.textContent = "All requirements met";
                    }
                }

                updateMatch();
                return score === 5;
            }

            Array.prototype.forEach.call(
                document.querySelectorAll(".register-password-toggle"),
                function (toggle) {
                    toggle.addEventListener("click", function () {
                        var target = document.getElementById(
                            toggle.getAttribute("data-password-target")
                        );

                        if (!target) {
                            return;
                        }

                        var show = target.type === "password";

                        target.type = show ? "text" : "password";
                        toggle.textContent = show ? "Hide" : "Show";

                        toggle.setAttribute(
                            "aria-pressed",
                            show ? "true" : "false"
                        );

                        toggle.setAttribute(
                            "aria-label",
                            show ? "Hide password" : "Show password"
                        );
                    });
                }
            );

            password.addEventListener("input", function () {
                updatePassword();
                setClientError("");
            });

            confirmation.addEventListener("input", function () {
                updateMatch();
                setClientError("");
            });

            form.addEventListener("submit", function (event) {
                if (submitting) {
                    event.preventDefault();
                    return;
                }

                if (!form.checkValidity()) {
                    return;
                }

                if (
                    window.jQuery &&
                    window.jQuery.fn &&
                    typeof window.jQuery.fn.valid === "function" &&
                    !window.jQuery(form).valid()
                ) {
                    return;
                }

                if (!updatePassword()) {
                    event.preventDefault();
                    setClientError(
                        "Your password must meet all the listed requirements."
                    );
                    password.focus();
                    return;
                }

                if (confirmation.value !== password.value) {
                    event.preventDefault();
                    setClientError(
                        "The password confirmation must match your password."
                    );
                    confirmation.focus();
                    return;
                }

                submitting = true;
                form.setAttribute("aria-busy", "true");
                button.disabled = true;
                setClientError("");

                if (buttonText) {
                    buttonText.textContent = "Creating your account...";
                }
            });

            window.addEventListener("pageshow", function (event) {
                if (event.persisted || submitting) {
                    submitting = false;
                    button.disabled = false;
                    form.removeAttribute("aria-busy");

                    if (buttonText) {
                        buttonText.textContent = "Create Account";
                    }
                }
            });

            updatePassword();
        })();
    </script>
}