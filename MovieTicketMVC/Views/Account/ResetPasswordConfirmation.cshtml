@{
    ViewBag.Title = "Password Reset Request Processed";
}

<main class="reset-success-page" aria-labelledby="reset-success-title">
    <section class="reset-success-shell" aria-describedby="reset-success-description">
        <div class="reset-success-grid" aria-hidden="true"></div>
        <div class="reset-success-glow reset-success-glow-one" aria-hidden="true"></div>
        <div class="reset-success-glow reset-success-glow-two" aria-hidden="true"></div>

        <a class="reset-success-brand" href="@Url.Action("Index", "Home")" aria-label="MovieTicket home page">
            <span aria-hidden="true"></span>
            MOVIETICKET
        </a>

        <div class="reset-success-progress" role="list" aria-label="Password reset steps">
            <div class="reset-success-step completed" role="listitem">
                <span aria-hidden="true">✓</span>
                <strong>E-mail</strong>
            </div>
            <div class="reset-success-line completed" aria-hidden="true"></div>
            <div class="reset-success-step completed" role="listitem">
                <span aria-hidden="true">✓</span>
                <strong>Link</strong>
            </div>
            <div class="reset-success-line completed" aria-hidden="true"></div>
            <div class="reset-success-step completed" role="listitem">
                <span aria-hidden="true">✓</span>
                <strong>Request</strong>
            </div>
        </div>

        <div class="reset-success-visual" aria-hidden="true">
            <div class="reset-success-orbit reset-success-orbit-large"></div>
            <div class="reset-success-orbit reset-success-orbit-small"></div>
            <div class="reset-success-check">✓</div>
            <div class="reset-success-spark reset-success-spark-one"></div>
            <div class="reset-success-spark reset-success-spark-two"></div>
            <div class="reset-success-spark reset-success-spark-three"></div>
        </div>

        <div class="reset-success-content">
            <div class="cinema-eyebrow reset-success-eyebrow">PASSWORD RESET REQUEST</div>

            <h1 id="reset-success-title">
                Your request has been
                <span class="cinema-text-gradient reset-success-accent">processed.</span>
            </h1>

            <p id="reset-success-description" class="reset-success-description">
                Your password reset request has been processed. If the email address
                belongs to an existing MovieTicket account and the reset link was valid,
                you can try signing in with your new password.
            </p>

            <div class="reset-success-card" role="status">
                <span class="reset-success-card-icon" aria-hidden="true">✓</span>
                <div class="reset-success-card-copy">
                    <span>NEXT STEP</span>
                    <strong>Continue to Sign In</strong>
                    <p>
                        Try signing in with your email address and the password you entered.
                        If you cannot sign in, you can request another password reset link.
                    </p>
                </div>
            </div>

            <div class="reset-success-actions">
                <a id="loginLink" class="btn btn-primary reset-success-login" href="@Url.Action("Login", "Account")">
                    <span>Continue to Sign In</span>
                    <span class="reset-success-action-arrow" aria-hidden="true">→</span>
                </a>
                <a class="btn btn-outline-secondary reset-success-retry" href="@Url.Action("ForgotPassword", "Account")">
                    Request Another Link
                </a>
            </div>

            <a class="reset-success-home" href="@Url.Action("Index", "Home")">
                <span aria-hidden="true">←</span>
                Back to Home
            </a>

            <p class="reset-success-note">
                For security and privacy, this page does not confirm whether
                an email address is registered with MovieTicket.
            </p>
        </div>
    </section>
</main>

<style>
    .reset-success-page {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 0 0 0.5rem;
    }

    .reset-success-shell {
        position: relative;
        isolation: isolate;
        width: min(100%, 760px);
        padding: clamp(2rem, 6vw, 4rem);
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient(circle at 50% 18%, rgba(66, 199, 131, 0.10), transparent 31%), radial-gradient(circle at 0% 100%, rgba(61, 101, 166, 0.10), transparent 32%), linear-gradient(145deg, #121925, #070a0f);
        box-shadow: var(--cinema-shadow-lg);
    }

    .reset-success-grid {
        position: absolute;
        z-index: -3;
        inset: 0;
        opacity: 0.24;
        pointer-events: none;
        background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 48px 48px;
        -webkit-mask-image: linear-gradient(180deg, #000, transparent 78%);
        mask-image: linear-gradient(180deg, #000, transparent 78%);
    }

    .reset-success-glow {
        position: absolute;
        z-index: -2;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(32px);
    }

    .reset-success-glow-one {
        top: -190px;
        right: -110px;
        background: rgba(66, 199, 131, 0.065);
    }

    .reset-success-glow-two {
        bottom: -190px;
        left: -150px;
        background: rgba(61, 101, 166, 0.065);
    }

    .reset-success-brand {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
        text-decoration: none;
        transition: color var(--cinema-transition);
    }

        .reset-success-brand:hover {
            color: var(--cinema-gold-light);
        }

        .reset-success-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }

    .reset-success-progress {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        margin-bottom: 2.1rem;
    }

    .reset-success-step {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }

        .reset-success-step > span {
            display: grid;
            flex: 0 0 30px;
            width: 30px;
            height: 30px;
            place-items: center;
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.26);
            border-radius: 9px;
            background: rgba(66, 199, 131, 0.07);
            box-shadow: 0 0 16px rgba(66, 199, 131, 0.06);
            font-size: 0.55rem;
            font-weight: 900;
        }

        .reset-success-step strong {
            color: var(--cinema-text-soft);
            font-size: 0.65rem;
        }

    .reset-success-line {
        flex: 0 1 55px;
        height: 1px;
        margin: 0 0.65rem;
        background: linear-gradient(90deg, rgba(66, 199, 131, 0.3), rgba(66, 199, 131, 0.65), rgba(66, 199, 131, 0.3));
    }

    .reset-success-visual {
        position: relative;
        display: grid;
        width: 220px;
        height: 180px;
        margin: 0 auto 2rem;
        place-items: center;
    }

    .reset-success-check {
        position: relative;
        z-index: 5;
        display: grid;
        width: 92px;
        height: 92px;
        place-items: center;
        color: #b0efca;
        border: 1px solid rgba(66, 199, 131, 0.34);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(66, 199, 131, 0.15), rgba(66, 199, 131, 0.045));
        box-shadow: 0 0 0 12px rgba(66, 199, 131, 0.025), 0 0 60px rgba(66, 199, 131, 0.13);
        font-size: 2rem;
        font-weight: 700;
        animation: reset-success-check-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .reset-success-orbit {
        position: absolute;
        border: 1px solid rgba(66, 199, 131, 0.10);
        border-radius: 50%;
        animation: reset-success-orbit-spin 24s linear infinite;
    }

        .reset-success-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-success);
            box-shadow: 0 0 16px rgba(66, 199, 131, 0.7);
        }

    .reset-success-orbit-large {
        width: 180px;
        height: 180px;
    }

    .reset-success-orbit-small {
        width: 135px;
        height: 135px;
        animation-direction: reverse;
        animation-duration: 17s;
    }

    .reset-success-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cinema-gold-light);
        box-shadow: 0 0 12px rgba(214, 168, 75, 0.65);
        animation: reset-success-spark 3s ease-in-out infinite;
    }

    .reset-success-spark-one {
        top: 35px;
        left: 28px;
    }

    .reset-success-spark-two {
        top: 22px;
        right: 40px;
        animation-delay: 0.7s;
    }

    .reset-success-spark-three {
        right: 22px;
        bottom: 35px;
        animation-delay: 1.4s;
    }

    .reset-success-content {
        position: relative;
        z-index: 3;
    }

    .reset-success-eyebrow {
        color: #a4e7bf;
    }

    .reset-success-content h1 {
        max-width: 650px;
        margin: 0 auto 1rem;
        font-size: clamp(2.25rem, 6vw, 3.8rem);
        line-height: 1.06;
        letter-spacing: -0.05em;
        text-wrap: balance;
    }

    .reset-success-accent {
        background: linear-gradient(135deg, #c0f5d6, #69d39a);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .reset-success-description {
        max-width: 570px;
        margin: 0 auto 1.8rem;
        color: var(--cinema-text-muted);
        font-size: 0.91rem;
        line-height: 1.8;
    }

    .reset-success-card {
        display: flex;
        max-width: 550px;
        align-items: flex-start;
        gap: 0.9rem;
        margin: 0 auto 1.5rem;
        padding: 1rem;
        text-align: left;
        border: 1px solid rgba(66, 199, 131, 0.17);
        border-radius: 14px;
        background: rgba(66, 199, 131, 0.04);
    }

    .reset-success-card-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.22);
        border-radius: 12px;
        background: rgba(66, 199, 131, 0.07);
        font-size: 0.8rem;
        font-weight: 900;
    }

    .reset-success-card-copy {
        min-width: 0;
        flex: 1;
    }

        .reset-success-card-copy > span {
            display: block;
            margin-bottom: 0.25rem;
            color: #8fd8ad;
            font-size: 0.54rem;
            font-weight: 900;
            letter-spacing: 0.11em;
        }

        .reset-success-card-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 0.86rem;
        }

        .reset-success-card-copy p {
            margin: 0.3rem 0 0;
            color: var(--cinema-text-muted);
            font-size: 0.71rem;
            line-height: 1.65;
        }

    .reset-success-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: center;
        gap: 0.75rem;
        max-width: 550px;
        margin: 0 auto;
    }

    .reset-success-login {
        display: inline-flex;
        flex: 1 1 250px;
        min-width: 0;
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-inline: 1.15rem;
    }

    .reset-success-retry {
        display: inline-flex;
        flex: 0 1 auto;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        padding-inline: 1.15rem;
    }

    .reset-success-action-arrow {
        transition: transform var(--cinema-transition);
    }

    .reset-success-login:hover .reset-success-action-arrow {
        transform: translateX(5px);
    }

    .reset-success-home {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.4rem;
        color: var(--cinema-text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: color var(--cinema-transition);
    }

        .reset-success-home > span {
            transition: transform var(--cinema-transition);
        }

        .reset-success-home:hover {
            color: var(--cinema-gold-light);
        }

            .reset-success-home:hover > span {
                transform: translateX(-4px);
            }

    .reset-success-note {
        max-width: 550px;
        margin: 1.5rem auto 0;
        padding-top: 1.05rem;
        border-top: 1px solid var(--cinema-border);
        color: var(--cinema-text-muted);
        font-size: 0.68rem;
        line-height: 1.65;
    }

    .reset-success-brand:focus-visible,
    .reset-success-home:focus-visible,
    .reset-success-actions .btn:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 4px;
    }

    @@keyframes reset-success-check-enter {
        from {
            opacity: 0;
            transform: scale(0.45) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }

    @@keyframes reset-success-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes reset-success-spark {
        0%, 100% {
            opacity: 0.3;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }

    @@media (max-width: 575.98px) {
        .reset-success-shell {
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg);
        }

        .reset-success-step strong {
            display: none;
        }

        .reset-success-line {
            flex: 1;
            min-width: 16px;
            margin-inline: 0.5rem;
        }

        .reset-success-content h1 {
            font-size: clamp(2rem, 9vw, 2.45rem);
        }

        .reset-success-description {
            font-size: 0.84rem;
        }

        .reset-success-actions {
            flex-direction: column;
        }

        .reset-success-login,
        .reset-success-retry {
            flex: 0 0 auto;
            width: 100%;
        }
    }

    @@media (max-width: 365px) {
        .reset-success-visual {
            width: 190px;
            height: 165px;
        }

        .reset-success-orbit-large {
            width: 165px;
            height: 165px;
        }

        .reset-success-orbit-small {
            width: 125px;
            height: 125px;
        }

        .reset-success-card {
            gap: 0.65rem;
            padding: 0.85rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .reset-success-check,
        .reset-success-orbit,
        .reset-success-spark {
            animation: none;
        }

        .reset-success-action-arrow,
        .reset-success-home > span {
            transition: none;
        }
    }
</style>