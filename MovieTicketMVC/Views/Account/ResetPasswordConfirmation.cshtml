@{
    ViewBag.Title = "Лозинката е променета";
}

<main class="reset-success-page"
      aria-labelledby="reset-success-title">

    <section class="reset-success-shell">

        <a class="reset-success-brand"
           href="@Url.Action("Index", "Home")">

            <span></span>

            MOVIETICKET
        </a>


        <div class="reset-success-progress"
             aria-label="Процес за промена на лозинка">

            <div class="reset-success-step completed">

                <span aria-hidden="true">
                    ✓
                </span>

                <strong>
                    E-mail
                </strong>

            </div>

            <div class="reset-success-line completed">
            </div>

            <div class="reset-success-step completed">

                <span aria-hidden="true">
                    ✓
                </span>

                <strong>
                    Link
                </strong>

            </div>

            <div class="reset-success-line completed">
            </div>

            <div class="reset-success-step completed">

                <span aria-hidden="true">
                    ✓
                </span>

                <strong>
                    Reset
                </strong>

            </div>

        </div>


        <div class="reset-success-visual"
             aria-hidden="true">

            <div class="reset-success-orbit
                        reset-success-orbit-large">
            </div>

            <div class="reset-success-orbit
                        reset-success-orbit-small">
            </div>

            <div class="reset-success-check">
                ✓
            </div>

            <div class="reset-success-spark
                        reset-success-spark-one">
            </div>

            <div class="reset-success-spark
                        reset-success-spark-two">
            </div>

            <div class="reset-success-spark
                        reset-success-spark-three">
            </div>

        </div>


        <div class="reset-success-content">

            <div class="cinema-eyebrow">
                PASSWORD UPDATED
            </div>

            <h1 id="reset-success-title">
                Лозинката е
                <span class="cinema-text-gradient">
                    успешно променета
                </span>
            </h1>

            <p class="reset-success-description">
                Твојот MovieTicket профил сега е заштитен
                со новата лозинка. Можеш веднаш да продолжиш
                кон најавата.
            </p>


            <div class="reset-success-card">

                <div class="reset-success-card-icon"
                     aria-hidden="true">
                    ✓
                </div>

                <div>

                    <span>
                        ACCOUNT SECURITY
                    </span>

                    <strong>
                        Новата лозинка е активна
                    </strong>

                    <p>
                        Користи ја новата лозинка при следното
                        најавување на профилот.
                    </p>

                </div>

            </div>


            <a id="loginLink"
               class="btn btn-primary reset-success-login"
               href="@Url.Action(
                   "Login",
                   "Account")">

                <span>
                    Продолжи кон најава
                </span>

                <span aria-hidden="true">
                    →
                </span>

            </a>


            <a class="reset-success-home"
               href="@Url.Action(
                   "Index",
                   "Home")">

                <span aria-hidden="true">
                    ←
                </span>

                Назад кон почетна

            </a>

        </div>

    </section>

</main>


<style>
    .reset-success-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .reset-success-shell {
        position: relative;
        width: min(100%, 760px);
        padding: clamp(2rem, 6vw, 4rem);
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 50% 18%, rgba(66, 199, 131, 0.10), transparent 30% ), radial-gradient( circle at 0% 100%, rgba(61, 101, 166, 0.10), transparent 30% ), linear-gradient( 145deg, rgba(18, 25, 37, 0.99), rgba(7, 10, 15, 0.99) );
        box-shadow: var(--cinema-shadow-lg);
        isolation: isolate;
    }

        .reset-success-shell::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.24;
            background-image: linear-gradient( rgba(255, 255, 255, 0.02) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px );
            background-size: 48px 48px;
            mask-image: linear-gradient( 180deg, #000, transparent 78% );
        }


    /* =====================================================
       BRAND
       ===================================================== */

    .reset-success-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.2rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .reset-success-brand:hover {
            color: var(--cinema-gold-light);
        }

        .reset-success-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       PROGRESS
       ===================================================== */

    .reset-success-progress {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2.7rem;
    }

    .reset-success-step {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .reset-success-step > span {
            display: grid;
            width: 30px;
            height: 30px;
            place-items: center;
            border-radius: 9px;
            font-size: 0.55rem;
            font-weight: 900;
        }

        .reset-success-step.completed > span {
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.26);
            background: rgba(66, 199, 131, 0.07);
            box-shadow: 0 0 16px rgba(66, 199, 131, 0.06);
        }

        .reset-success-step strong {
            color: var(--cinema-text-soft);
            font-size: 0.62rem;
        }

    .reset-success-line {
        width: 55px;
        height: 1px;
        margin: 0 0.65rem;
    }

        .reset-success-line.completed {
            background: linear-gradient( 90deg, rgba(66, 199, 131, 0.30), rgba(66, 199, 131, 0.65), rgba(66, 199, 131, 0.30) );
        }


    /* =====================================================
       SUCCESS VISUAL
       ===================================================== */

    .reset-success-visual {
        position: relative;
        display: grid;
        width: 220px;
        height: 180px;
        margin: 0 auto 2rem;
        place-items: center;
    }

    .reset-success-check {
        position: relative;
        z-index: 5;
        display: grid;
        width: 92px;
        height: 92px;
        place-items: center;
        color: #b0efca;
        border: 1px solid rgba(66, 199, 131, 0.34);
        border-radius: 50%;
        background: radial-gradient( circle, rgba(66, 199, 131, 0.15), rgba(66, 199, 131, 0.045) );
        box-shadow: 0 0 0 12px rgba(66, 199, 131, 0.025), 0 0 60px rgba(66, 199, 131, 0.13);
        font-size: 2rem;
        font-weight: 700;
        animation: reset-success-check-enter 650ms cubic-bezier( 0.22, 1, 0.36, 1 );
    }


    /* =====================================================
       ORBITS
       ===================================================== */

    .reset-success-orbit {
        position: absolute;
        border: 1px solid rgba(66, 199, 131, 0.10);
        border-radius: 50%;
        animation: reset-success-orbit-spin 24s linear infinite;
    }

        .reset-success-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-success);
            box-shadow: 0 0 16px rgba(66, 199, 131, 0.7);
        }

    .reset-success-orbit-large {
        width: 180px;
        height: 180px;
    }

    .reset-success-orbit-small {
        width: 135px;
        height: 135px;
        animation-direction: reverse;
        animation-duration: 17s;
    }


    /* =====================================================
       SPARKS
       ===================================================== */

    .reset-success-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cinema-gold-light);
        box-shadow: 0 0 12px rgba(214, 168, 75, 0.65);
        animation: reset-success-spark 3s ease-in-out infinite;
    }

    .reset-success-spark-one {
        top: 35px;
        left: 28px;
    }

    .reset-success-spark-two {
        top: 22px;
        right: 40px;
        animation-delay: 0.7s;
    }

    .reset-success-spark-three {
        right: 22px;
        bottom: 35px;
        animation-delay: 1.4s;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .reset-success-content {
        position: relative;
        z-index: 3;
    }

        .reset-success-content h1 {
            max-width: 650px;
            margin: 0 auto 1rem;
            font-size: clamp( 2.4rem, 6vw, 3.8rem );
            line-height: 1;
            letter-spacing: -0.05em;
        }

    .reset-success-description {
        max-width: 560px;
        margin: 0 auto 2rem;
        color: var(--cinema-text-muted);
        font-size: 0.88rem;
        line-height: 1.75;
    }


    /* =====================================================
       SECURITY CARD
       ===================================================== */

    .reset-success-card {
        display: flex;
        max-width: 540px;
        align-items: flex-start;
        gap: 0.9rem;
        margin: 0 auto 1.5rem;
        padding: 1rem;
        text-align: left;
        border: 1px solid rgba(66, 199, 131, 0.17);
        border-radius: 14px;
        background: rgba(66, 199, 131, 0.04);
    }

    .reset-success-card-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.22);
        border-radius: 12px;
        background: rgba(66, 199, 131, 0.07);
        font-size: 0.8rem;
        font-weight: 900;
    }

    .reset-success-card div > span {
        display: block;
        margin-bottom: 0.2rem;
        color: #8fd8ad;
        font-size: 0.52rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .reset-success-card strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.82rem;
    }

    .reset-success-card p {
        margin: 0.25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.68rem;
        line-height: 1.55;
    }


    /* =====================================================
       ACTIONS
       ===================================================== */

    .reset-success-login {
        display: flex;
        width: min(100%, 330px);
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        margin: 0 auto;
        padding-right: 1.1rem;
        padding-left: 1.1rem;
    }

        .reset-success-login > span:last-child {
            transition: transform var(--cinema-transition);
        }

        .reset-success-login:hover > span:last-child {
            transform: translateX(5px);
        }

    .reset-success-home {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.4rem;
        color: var(--cinema-text-muted);
        font-size: 0.74rem;
        font-weight: 600;
    }

        .reset-success-home > span {
            transition: transform var(--cinema-transition);
        }

        .reset-success-home:hover {
            color: var(--cinema-gold-light);
        }

            .reset-success-home:hover > span {
                transform: translateX(-4px);
            }


    /* =====================================================
       ANIMATIONS
       ===================================================== */

    @@keyframes reset-success-check-enter {
        from {
            opacity: 0;
            transform: scale(0.45) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }

    @@keyframes reset-success-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes reset-success-spark {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 575.98px) {
        .reset-success-shell {
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg);
        }

        .reset-success-step strong {
            display: none;
        }

        .reset-success-line {
            flex: 1;
            width: auto;
            margin: 0 0.45rem;
        }

        .reset-success-content h1 {
            font-size: 2.3rem;
        }

        .reset-success-card {
            align-items: flex-start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .reset-success-check,
        .reset-success-orbit,
        .reset-success-spark {
            animation: none;
        }
    }
</style>