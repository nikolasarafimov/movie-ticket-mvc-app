@{
    ViewBag.Title = "Email Verified";

    var isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;
}

<main class="email-confirm-page"
      aria-labelledby="email-confirm-title">

    <section class="email-confirm-shell"
             aria-label="Email verification successful">

        <div class="email-confirm-ambient email-confirm-ambient-one"
             aria-hidden="true"></div>

        <div class="email-confirm-ambient email-confirm-ambient-two"
             aria-hidden="true"></div>

        <a class="email-confirm-brand"
           href="@Url.Action("Index", "Home")"
           aria-label="MovieTicket home page">
            <span aria-hidden="true"></span>
            MOVIETICKET
        </a>

        <div class="email-confirm-visual"
             aria-hidden="true">

            <div class="email-confirm-orbit email-confirm-orbit-large"></div>
            <div class="email-confirm-orbit email-confirm-orbit-small"></div>

            <div class="email-confirm-envelope">
                <div class="email-confirm-envelope-paper">
                    <span>VERIFIED</span>
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            </div>

            <div class="email-confirm-check">✓</div>

            <div class="email-confirm-spark email-confirm-spark-one"></div>
            <div class="email-confirm-spark email-confirm-spark-two"></div>
            <div class="email-confirm-spark email-confirm-spark-three"></div>
        </div>

        <div class="email-confirm-content">
            <div class="cinema-eyebrow email-confirm-eyebrow">
                EMAIL VERIFIED
            </div>

            <h1 id="email-confirm-title">
                Your email address is
                <span class="cinema-text-gradient">
                    verified.
                </span>
            </h1>

            <p class="email-confirm-description">
                You've successfully verified the email address associated
                with your MovieTicket account. You can now continue using
                the platform.
            </p>

            <div class="email-confirm-status"
                 role="status"
                 aria-label="Email verification status">

                <div class="email-confirm-status-icon"
                     aria-hidden="true">✓</div>

                <div class="email-confirm-status-copy">
                    <span>ACCOUNT VERIFIED</span>

                    <strong>
                        Email verification completed successfully
                    </strong>

                    <p>
                        Your email address is verified. You can access
                        your account or sign in to MovieTicket.
                    </p>
                </div>
            </div>

            <div class="email-confirm-actions">
                @if (isAuthenticated)
                {
                    <a id="accountLink"
                       class="btn btn-primary email-confirm-primary-action"
                       href="@Url.Action("Index", "Manage")">
                        <span>Go to My Account</span>
                        <span aria-hidden="true">→</span>
                    </a>
                }
                else
                {
                    <a id="loginLink"
                       class="btn btn-primary email-confirm-primary-action"
                       href="@Url.Action("Login", "Account")">
                        <span>Continue to Sign In</span>
                        <span aria-hidden="true">→</span>
                    </a>
                }

                <a class="email-confirm-home"
                   href="@Url.Action("Index", "Home")">
                    <span aria-hidden="true">←</span>
                    Back to Home
                </a>
            </div>
        </div>
    </section>
</main>

<style>
    .email-confirm-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .email-confirm-shell {
        position: relative;
        isolation: isolate;
        width: min(100%, 760px);
        padding: clamp(2rem, 6vw, 4rem);
        overflow: hidden;
        border: 1px solid var(--cinema-border, rgba(255, 255, 255, 0.09));
        border-radius: var(--cinema-radius-xl, 32px);
        background: radial-gradient(circle at 50% 18%, rgba(66, 199, 131, 0.10), transparent 31%), radial-gradient(circle at 0% 100%, rgba(61, 101, 166, 0.10), transparent 32%), linear-gradient(145deg, #121925, #070a0f);
        box-shadow: var(--cinema-shadow-lg, 0 30px 80px rgba(0, 0, 0, 0.46));
        text-align: center;
    }

        .email-confirm-shell::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.24;
            background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 48px 48px;
            -webkit-mask-image: linear-gradient(180deg, #000, transparent 78%);
            mask-image: linear-gradient(180deg, #000, transparent 78%);
            pointer-events: none;
        }

    .email-confirm-ambient {
        position: absolute;
        z-index: -1;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        filter: blur(50px);
        pointer-events: none;
    }

    .email-confirm-ambient-one {
        top: -180px;
        right: -95px;
        background: rgba(66, 199, 131, 0.10);
    }

    .email-confirm-ambient-two {
        bottom: -185px;
        left: -95px;
        background: rgba(61, 101, 166, 0.10);
    }

    .email-confirm-brand {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        margin-bottom: 2.4rem;
        color: var(--cinema-text, #f5f7fb);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
        transition: color var(--cinema-transition, 220ms ease);
    }

        .email-confirm-brand:hover {
            color: var(--cinema-gold-light, #f0cb76);
        }

        .email-confirm-brand > span {
            flex: 0 0 8px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold, #d6a84b);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }

    .email-confirm-visual {
        position: relative;
        display: grid;
        width: 230px;
        height: 190px;
        margin: 0 auto 2rem;
        place-items: center;
    }

    .email-confirm-envelope {
        position: relative;
        z-index: 4;
        width: 118px;
        height: 82px;
        overflow: hidden;
        border: 1px solid rgba(214, 168, 75, 0.28);
        border-radius: 11px;
        background: linear-gradient(145deg, rgba(214, 168, 75, 0.14), rgba(214, 168, 75, 0.04));
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.32), 0 0 40px rgba(214, 168, 75, 0.07);
        animation: email-confirm-envelope-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

        .email-confirm-envelope::before,
        .email-confirm-envelope::after {
            position: absolute;
            bottom: -38px;
            width: 90px;
            height: 90px;
            content: "";
            border: 1px solid rgba(214, 168, 75, 0.17);
            background: rgba(214, 168, 75, 0.03);
            transform: rotate(45deg);
        }

        .email-confirm-envelope::before {
            left: -46px;
        }

        .email-confirm-envelope::after {
            right: -46px;
        }

    .email-confirm-envelope-paper {
        position: absolute;
        z-index: 2;
        top: 10px;
        right: 14px;
        left: 14px;
        height: 58px;
        padding: 0.7rem 0.75rem;
        border-radius: 6px;
        background: linear-gradient(180deg, #e1dacb, #cfc6b4);
    }

        .email-confirm-envelope-paper > span {
            display: block;
            margin-bottom: 0.5rem;
            color: #5f594f;
            font-size: 0.4rem;
            font-weight: 900;
            letter-spacing: 0.14em;
        }

        .email-confirm-envelope-paper > div {
            height: 3px;
            margin-top: 4px;
            border-radius: 99px;
            background: rgba(78, 73, 65, 0.18);
        }

            .email-confirm-envelope-paper > div:nth-of-type(1) {
                width: 82%;
            }

            .email-confirm-envelope-paper > div:nth-of-type(2) {
                width: 64%;
            }

            .email-confirm-envelope-paper > div:nth-of-type(3) {
                width: 72%;
            }

    .email-confirm-check {
        position: absolute;
        z-index: 6;
        right: 37px;
        bottom: 34px;
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border: 1px solid rgba(66, 199, 131, 0.28);
        border-radius: 50%;
        color: #a9ebc5;
        background: #101b17;
        box-shadow: 0 0 30px rgba(66, 199, 131, 0.15);
        font-size: 0.95rem;
        font-weight: 900;
        animation: email-confirm-check-enter 650ms 250ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .email-confirm-orbit {
        position: absolute;
        border: 1px solid rgba(66, 199, 131, 0.09);
        border-radius: 50%;
        animation: email-confirm-orbit-spin 24s linear infinite;
    }

        .email-confirm-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-success, #42c783);
            box-shadow: 0 0 16px rgba(66, 199, 131, 0.65);
        }

    .email-confirm-orbit-large {
        width: 190px;
        height: 190px;
    }

    .email-confirm-orbit-small {
        width: 140px;
        height: 140px;
        animation-direction: reverse;
        animation-duration: 17s;
    }

    .email-confirm-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cinema-gold-light, #f0cb76);
        box-shadow: 0 0 12px rgba(214, 168, 75, 0.6);
        animation: email-confirm-spark-pulse 3s ease-in-out infinite;
    }

    .email-confirm-spark-one {
        top: 28px;
        left: 31px;
    }

    .email-confirm-spark-two {
        top: 38px;
        right: 27px;
        animation-delay: 0.8s;
    }

    .email-confirm-spark-three {
        bottom: 24px;
        left: 55px;
        animation-delay: 1.5s;
    }

    .email-confirm-content {
        position: relative;
        z-index: 2;
    }

    .email-confirm-eyebrow {
        color: #a5e9c1;
    }

    .email-confirm-content h1 {
        max-width: 640px;
        margin: 0 auto 1rem;
        font-size: clamp(2.4rem, 6vw, 3.8rem);
        line-height: 1.05;
        letter-spacing: -0.05em;
        overflow-wrap: break-word;
    }

    .email-confirm-description {
        max-width: 560px;
        margin: 0 auto 2rem;
        color: var(--cinema-text-soft, #c4cad4);
        font-size: 0.88rem;
        line-height: 1.75;
    }

    .email-confirm-status {
        display: flex;
        max-width: 550px;
        align-items: flex-start;
        gap: 0.9rem;
        margin: 0 auto 1.7rem;
        padding: 1.1rem;
        border: 1px solid rgba(66, 199, 131, 0.17);
        border-radius: 14px;
        background: rgba(66, 199, 131, 0.04);
        text-align: left;
    }

    .email-confirm-status-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        border: 1px solid rgba(66, 199, 131, 0.22);
        border-radius: 12px;
        color: #9ae8bd;
        background: rgba(66, 199, 131, 0.07);
        font-size: 0.78rem;
        font-weight: 900;
    }

    .email-confirm-status-copy {
        min-width: 0;
    }

        .email-confirm-status-copy > span {
            display: block;
            margin-bottom: 0.2rem;
            color: #8fd8ad;
            font-size: 0.51rem;
            font-weight: 900;
            letter-spacing: 0.11em;
        }

        .email-confirm-status-copy > strong {
            display: block;
            color: var(--cinema-text, #f5f7fb);
            font-size: 0.82rem;
        }

        .email-confirm-status-copy > p {
            margin: 0.25rem 0 0;
            color: var(--cinema-text-muted, #848d9d);
            font-size: 0.7rem;
            line-height: 1.6;
        }

    .email-confirm-actions {
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: 1.3rem;
    }

    .email-confirm-primary-action {
        display: inline-flex;
        width: min(100%, 330px);
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-right: 1.1rem;
        padding-left: 1.1rem;
    }

        .email-confirm-primary-action > span:last-child,
        .email-confirm-home > span {
            transition: transform var(--cinema-transition, 220ms ease);
        }

        .email-confirm-primary-action:hover > span:last-child {
            transform: translateX(5px);
        }

    .email-confirm-home {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--cinema-text-muted, #848d9d);
        font-size: 0.74rem;
        font-weight: 600;
    }

        .email-confirm-home:hover {
            color: var(--cinema-gold-light, #f0cb76);
        }

            .email-confirm-home:hover > span {
                transform: translateX(-4px);
            }

        .email-confirm-brand:focus-visible,
        .email-confirm-home:focus-visible,
        .email-confirm-primary-action:focus-visible {
            outline: 2px solid var(--cinema-gold-light, #f0cb76);
            outline-offset: 4px;
        }

    @@keyframes email-confirm-envelope-enter {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.85);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes email-confirm-check-enter {
        from {
            opacity: 0;
            transform: scale(0.45) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }

    @@keyframes email-confirm-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes email-confirm-spark-pulse {
        0%,
        100% {
            opacity: 0.25;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }

    @@media (max-width: 575.98px) {
        .email-confirm-shell {
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg, 24px);
        }

        .email-confirm-brand {
            margin-bottom: 2rem;
        }

        .email-confirm-content h1 {
            font-size: clamp(2rem, 9vw, 2.5rem);
        }

        .email-confirm-description {
            margin-bottom: 1.6rem;
            font-size: 0.83rem;
        }

        .email-confirm-visual {
            width: 200px;
            height: 175px;
            margin-bottom: 1.7rem;
        }

        .email-confirm-orbit-large {
            width: 175px;
            height: 175px;
        }

        .email-confirm-orbit-small {
            width: 130px;
            height: 130px;
        }

        .email-confirm-status {
            gap: 0.7rem;
            padding: 0.85rem;
        }

        .email-confirm-status-icon {
            flex-basis: 36px;
            width: 36px;
            height: 36px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .email-confirm-envelope,
        .email-confirm-check,
        .email-confirm-orbit,
        .email-confirm-spark {
            animation: none;
        }

        .email-confirm-primary-action > span:last-child,
        .email-confirm-home > span {
            transition: none;
        }
    }
</style>