@{
    ViewBag.Title = "E-mail потврден";
}

<main class="email-confirm-page"
      aria-labelledby="email-confirm-title">

    <section class="email-confirm-shell">

        <a class="email-confirm-brand"
           href="@Url.Action("Index", "Home")">

            <span></span>

            MOVIETICKET
        </a>


        <div class="email-confirm-visual"
             aria-hidden="true">

            <div class="email-confirm-orbit
                        email-confirm-orbit-large">
            </div>

            <div class="email-confirm-orbit
                        email-confirm-orbit-small">
            </div>


            <div class="email-confirm-envelope">

                <div class="email-confirm-envelope-paper">

                    <span>
                        VERIFIED
                    </span>

                    <div></div>
                    <div></div>
                    <div></div>

                </div>

            </div>


            <div class="email-confirm-check">
                ✓
            </div>


            <div class="email-confirm-spark
                        email-confirm-spark-one">
            </div>

            <div class="email-confirm-spark
                        email-confirm-spark-two">
            </div>

            <div class="email-confirm-spark
                        email-confirm-spark-three">
            </div>

        </div>


        <div class="email-confirm-content">

            <div class="cinema-eyebrow">
                EMAIL VERIFIED
            </div>

            <h1 id="email-confirm-title">
                E-mail адресата е
                <span class="cinema-text-gradient">
                    потврдена
                </span>
            </h1>

            <p class="email-confirm-description">
                Потврдата е успешно завршена.
                Твојот MovieTicket профил сега може
                да ја користи потврдената e-mail адреса.
            </p>


            <div class="email-confirm-status">

                <div class="email-confirm-status-icon"
                     aria-hidden="true">
                    ✓
                </div>

                <div>

                    <span>
                        ACCOUNT STATUS
                    </span>

                    <strong>
                        E-mail verification completed
                    </strong>

                    <p>
                        Можеш да продолжиш кон страницата
                        за најава и да пристапиш до профилот.
                    </p>

                </div>

            </div>


            <a id="loginLink"
               class="btn btn-primary email-confirm-login"
               href="@Url.Action(
                   "Login",
                   "Account")">

                <span>
                    Продолжи кон најава
                </span>

                <span aria-hidden="true">
                    →
                </span>

            </a>


            <a class="email-confirm-home"
               href="@Url.Action(
                   "Index",
                   "Home")">

                <span aria-hidden="true">
                    ←
                </span>

                Назад кон почетна

            </a>

        </div>

    </section>

</main>


<style>
    .email-confirm-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .email-confirm-shell {
        position: relative;
        width: min(100%, 760px);
        padding: clamp(2rem, 6vw, 4rem);
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 50% 18%, rgba(66, 199, 131, 0.10), transparent 30% ), radial-gradient( circle at 0% 100%, rgba(61, 101, 166, 0.10), transparent 30% ), linear-gradient( 145deg, rgba(18, 25, 37, 0.99), rgba(7, 10, 15, 0.99) );
        box-shadow: var(--cinema-shadow-lg);
        isolation: isolate;
    }

        .email-confirm-shell::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.24;
            background-image: linear-gradient( rgba(255, 255, 255, 0.02) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px );
            background-size: 48px 48px;
            mask-image: linear-gradient( 180deg, #000, transparent 78% );
        }


    /* =====================================================
       BRAND
       ===================================================== */

    .email-confirm-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.4rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .email-confirm-brand:hover {
            color: var(--cinema-gold-light);
        }

        .email-confirm-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       VISUAL
       ===================================================== */

    .email-confirm-visual {
        position: relative;
        display: grid;
        width: 230px;
        height: 190px;
        margin: 0 auto 2rem;
        place-items: center;
    }


    /* =====================================================
       ENVELOPE
       ===================================================== */

    .email-confirm-envelope {
        position: relative;
        z-index: 4;
        width: 118px;
        height: 82px;
        overflow: hidden;
        border: 1px solid rgba(214, 168, 75, 0.28);
        border-radius: 11px;
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.14), rgba(214, 168, 75, 0.04) );
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.32), 0 0 40px rgba(214, 168, 75, 0.07);
        animation: email-confirm-envelope-enter 650ms cubic-bezier( 0.22, 1, 0.36, 1 );
    }

        .email-confirm-envelope::before,
        .email-confirm-envelope::after {
            position: absolute;
            bottom: -38px;
            width: 90px;
            height: 90px;
            content: "";
            border: 1px solid rgba(214, 168, 75, 0.17);
            background: rgba(214, 168, 75, 0.03);
            transform: rotate(45deg);
        }

        .email-confirm-envelope::before {
            left: -46px;
        }

        .email-confirm-envelope::after {
            right: -46px;
        }


    .email-confirm-envelope-paper {
        position: absolute;
        z-index: 2;
        top: 10px;
        right: 14px;
        left: 14px;
        height: 58px;
        padding: 0.7rem 0.75rem;
        border-radius: 6px;
        background: linear-gradient( 180deg, #e1dacb, #cfc6b4 );
    }

        .email-confirm-envelope-paper > span {
            display: block;
            margin-bottom: 0.5rem;
            color: #5f594f;
            font-size: 0.4rem;
            font-weight: 900;
            letter-spacing: 0.14em;
        }

        .email-confirm-envelope-paper > div {
            height: 3px;
            margin-top: 4px;
            border-radius: 99px;
            background: rgba(78, 73, 65, 0.18);
        }

            .email-confirm-envelope-paper > div:nth-of-type(1) {
                width: 82%;
            }

            .email-confirm-envelope-paper > div:nth-of-type(2) {
                width: 64%;
            }

            .email-confirm-envelope-paper > div:nth-of-type(3) {
                width: 72%;
            }


    /* =====================================================
       CHECK
       ===================================================== */

    .email-confirm-check {
        position: absolute;
        z-index: 6;
        right: 37px;
        bottom: 34px;
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #a9ebc5;
        border: 1px solid rgba(66, 199, 131, 0.28);
        border-radius: 50%;
        background: #101b17;
        box-shadow: 0 0 30px rgba(66, 199, 131, 0.15);
        font-size: 0.95rem;
        font-weight: 900;
        animation: email-confirm-check-enter 650ms 250ms cubic-bezier( 0.22, 1, 0.36, 1 ) both;
    }


    /* =====================================================
       ORBITS
       ===================================================== */

    .email-confirm-orbit {
        position: absolute;
        border: 1px solid rgba(66, 199, 131, 0.09);
        border-radius: 50%;
        animation: email-confirm-orbit-spin 24s linear infinite;
    }

        .email-confirm-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-success);
            box-shadow: 0 0 16px rgba(66, 199, 131, 0.65);
        }

    .email-confirm-orbit-large {
        width: 190px;
        height: 190px;
    }

    .email-confirm-orbit-small {
        width: 140px;
        height: 140px;
        animation-direction: reverse;
        animation-duration: 17s;
    }


    /* =====================================================
       SPARKS
       ===================================================== */

    .email-confirm-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cinema-gold-light);
        box-shadow: 0 0 12px rgba(214, 168, 75, 0.6);
        animation: email-confirm-spark-pulse 3s ease-in-out infinite;
    }

    .email-confirm-spark-one {
        top: 28px;
        left: 31px;
    }

    .email-confirm-spark-two {
        top: 38px;
        right: 27px;
        animation-delay: 0.8s;
    }

    .email-confirm-spark-three {
        bottom: 24px;
        left: 55px;
        animation-delay: 1.5s;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .email-confirm-content {
        position: relative;
        z-index: 3;
    }

        .email-confirm-content h1 {
            max-width: 640px;
            margin: 0 auto 1rem;
            font-size: clamp( 2.4rem, 6vw, 3.8rem );
            line-height: 1;
            letter-spacing: -0.05em;
        }

    .email-confirm-description {
        max-width: 560px;
        margin: 0 auto 2rem;
        color: var(--cinema-text-muted);
        font-size: 0.88rem;
        line-height: 1.75;
    }


    /* =====================================================
       STATUS
       ===================================================== */

    .email-confirm-status {
        display: flex;
        max-width: 550px;
        align-items: flex-start;
        gap: 0.9rem;
        margin: 0 auto 1.6rem;
        padding: 1rem;
        text-align: left;
        border: 1px solid rgba(66, 199, 131, 0.17);
        border-radius: 14px;
        background: rgba(66, 199, 131, 0.04);
    }

    .email-confirm-status-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.22);
        border-radius: 12px;
        background: rgba(66, 199, 131, 0.07);
        font-size: 0.78rem;
        font-weight: 900;
    }

    .email-confirm-status
    div:last-child > span {
        display: block;
        margin-bottom: 0.2rem;
        color: #8fd8ad;
        font-size: 0.51rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .email-confirm-status strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.82rem;
    }

    .email-confirm-status p {
        margin: 0.25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.68rem;
        line-height: 1.55;
    }


    /* =====================================================
       ACTIONS
       ===================================================== */

    .email-confirm-login {
        display: flex;
        width: min(100%, 330px);
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        margin: 0 auto;
        padding-right: 1.1rem;
        padding-left: 1.1rem;
    }

        .email-confirm-login > span:last-child {
            transition: transform var(--cinema-transition);
        }

        .email-confirm-login:hover > span:last-child {
            transform: translateX(5px);
        }

    .email-confirm-home {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.4rem;
        color: var(--cinema-text-muted);
        font-size: 0.74rem;
        font-weight: 600;
    }

        .email-confirm-home > span {
            transition: transform var(--cinema-transition);
        }

        .email-confirm-home:hover {
            color: var(--cinema-gold-light);
        }

            .email-confirm-home:hover > span {
                transform: translateX(-4px);
            }


    /* =====================================================
       ANIMATIONS
       ===================================================== */

    @@keyframes email-confirm-envelope-enter {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.85);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes email-confirm-check-enter {
        from {
            opacity: 0;
            transform: scale(0.45) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }

    @@keyframes email-confirm-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes email-confirm-spark-pulse {
        0%,
        100% {
            opacity: 0.25;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 575.98px) {
        .email-confirm-shell {
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg);
        }

        .email-confirm-content h1 {
            font-size: 2.3rem;
        }

        .email-confirm-visual {
            width: 200px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .email-confirm-envelope,
        .email-confirm-check,
        .email-confirm-orbit,
        .email-confirm-spark {
            animation: none;
        }
    }
</style>