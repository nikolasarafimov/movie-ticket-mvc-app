@using System.Linq
@using System.Web.Mvc
@model MovieTicketMVC.Models.SendCodeViewModel

@{
    ViewBag.Title = "Двофакторска автентикација";
    var availableProviders = Model != null && Model.Providers != null
        ? Model.Providers
        : Enumerable.Empty<SelectListItem>();
}

<main class="two-factor-page" aria-labelledby="two-factor-title">
    <section class="two-factor-shell" aria-label="Проверка на идентитет">
        <aside class="two-factor-visual" aria-hidden="true">
            <div class="two-factor-grid"></div>
            <div class="two-factor-glow two-factor-glow-one"></div>
            <div class="two-factor-glow two-factor-glow-two"></div>

            <div class="two-factor-art">
                <div class="two-factor-orbit two-factor-orbit-large"></div>
                <div class="two-factor-orbit two-factor-orbit-small"></div>
                <div class="two-factor-signal two-factor-signal-one"></div>
                <div class="two-factor-signal two-factor-signal-two"></div>
                <div class="two-factor-shield">
                    <div class="two-factor-shield-inner">
                        <div class="two-factor-lock">
                            <span></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="two-factor-visual-copy">
                <span>ДОПОЛНИТЕЛНА ЗАШТИТА</span>
                <strong>Твојот профил.<br />Твоја безбедност.</strong>
                <p>
                    Дополнителната проверка помага да се заштити
                    пристапот до твојот MovieTicket профил.
                </p>
                <div class="two-factor-visual-footnote">
                    <span class="two-factor-status-dot"></span>
                    СИГУРЕН ПРИСТАП
                </div>
            </div>
        </aside>

        <div class="two-factor-content">
            <a class="two-factor-brand" href="@Url.Action("Index", "Home")" aria-label="MovieTicket — почетна страница">
                <span aria-hidden="true"></span>
                MOVIETICKET
            </a>

            <div class="two-factor-progress" aria-label="Двофакторска автентикација, чекор 1 од 2">
                <div class="two-factor-progress-step active" aria-current="step">
                    <span aria-hidden="true">01</span>
                    <div>
                        <strong>Метод</strong>
                        <small>Избор на начин</small>
                    </div>
                </div>
                <div class="two-factor-progress-line" aria-hidden="true"></div>
                <div class="two-factor-progress-step">
                    <span aria-hidden="true">02</span>
                    <div>
                        <strong>Код</strong>
                        <small>Потврда на најава</small>
                    </div>
                </div>
            </div>

            <header class="two-factor-heading">
                <div class="cinema-eyebrow">БЕЗБЕДНОСНА ПРОВЕРКА</div>
                <h1 id="two-factor-title">
                    Потврди го <span class="cinema-text-gradient">идентитетот</span>
                </h1>
                <p>
                    За да ја продолжиш најавата, избери еден од методите
                    за добивање безбедносен код што се достапни за твојот профил.
                </p>
            </header>

            @using (Html.BeginForm(
                "SendCode",
                "Account",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "sendCodeForm",
                    @class = "two-factor-form"
                }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.HiddenFor(m => m.RememberMe)

                @Html.ValidationSummary(
                         true,
                         "",
                         new
                         {
                             @class = "validation-summary-errors two-factor-validation",
                             role = "alert"
                         })

                <div id="twoFactorClientError" class="two-factor-client-error" role="alert" hidden></div>

                <div class="two-factor-field">
                    @Html.LabelFor(
                             m => m.SelectedProvider,
                             "Метод за потврда",
                             new { @class = "form-label two-factor-label" })

                    <div class="two-factor-select-wrapper">
                        <span class="two-factor-select-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </span>

                        @Html.DropDownListFor(
                                 m => m.SelectedProvider,
                                 availableProviders,
                                 "Избери метод за потврда",
                                 new
                                 {
                                     @class = "form-select two-factor-select",
                                     required = "required",
                                     aria_describedby = "twoFactorProviderHelp"
                                 })
                    </div>

                    @Html.ValidationMessageFor(
                             m => m.SelectedProvider,
                             "",
                             new { @class = "text-danger two-factor-field-error" })
                </div>

                <div class="two-factor-provider-info" id="twoFactorProviderHelp">
                    <div class="two-factor-provider-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m3 7 9 6 9-6" />
                        </svg>
                    </div>
                    <div>
                        <span>ЕДНОКРАТЕН БЕЗБЕДНОСЕН КОД</span>
                        <strong id="twoFactorProviderTitle">Избери начин за добивање код</strong>
                        <p id="twoFactorProviderDescription">
                            По изборот на достапен метод, системот ќе се обиде
                            да ти испрати код за проверка на идентитетот.
                        </p>
                    </div>
                </div>

                <button type="submit" id="sendCodeButton" class="btn btn-primary two-factor-submit">
                    <span class="two-factor-submit-main">
                        <span id="sendCodeButtonText">Продолжи и испрати код</span>
                        <span class="two-factor-submit-spinner" aria-hidden="true"></span>
                    </span>
                    <span class="two-factor-submit-arrow" aria-hidden="true">→</span>
                </button>
            }

            <div class="two-factor-security">
                <span class="two-factor-security-icon" aria-hidden="true">✓</span>
                <p>
                    Не го споделувај безбедносниот код со никого.
                    Ќе можеш да го внесеш во следниот чекор откако ќе биде испратен.
                </p>
            </div>

            <a class="two-factor-back" href="@Url.Action("Login", "Account")">
                <span aria-hidden="true">←</span>
                Назад кон најава
            </a>
        </div>
    </section>
</main>

<style>
    .two-factor-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .two-factor-shell {
        display: grid;
        grid-template-columns: minmax(290px, 0.85fr) minmax(0, 1.15fr);
        width: min(100%, 980px);
        min-height: 650px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }

    .two-factor-visual {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient(circle at 50% 33%, rgba(214, 168, 75, 0.12), transparent 33%), radial-gradient(circle at 0% 100%, rgba(61, 101, 166, 0.15), transparent 37%), linear-gradient(145deg, #151e2b 0%, #0a0f17 60%, #06090e 100%);
        isolation: isolate;
    }

    .two-factor-grid {
        position: absolute;
        inset: 0;
        z-index: -1;
        opacity: 0.32;
        background-image: linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: linear-gradient(180deg, #000, transparent 90%);
    }

    .two-factor-glow {
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(32px);
        pointer-events: none;
    }

    .two-factor-glow-one {
        top: -120px;
        right: -150px;
        width: 350px;
        height: 350px;
        background: rgba(214, 168, 75, 0.075);
    }

    .two-factor-glow-two {
        bottom: -160px;
        left: -150px;
        width: 350px;
        height: 350px;
        background: rgba(76, 125, 193, 0.09);
    }

    .two-factor-art {
        position: absolute;
        top: 2.3rem;
        right: 0;
        left: 0;
        display: grid;
        height: 360px;
        place-items: center;
    }

    .two-factor-shield {
        position: relative;
        z-index: 4;
        display: grid;
        width: 124px;
        height: 146px;
        place-items: center;
        border: 1px solid rgba(214, 168, 75, 0.36);
        background: linear-gradient(145deg, rgba(214, 168, 75, 0.20), rgba(214, 168, 75, 0.035));
        clip-path: polygon(50% 0, 95% 16%, 89% 67%, 50% 100%, 11% 67%, 5% 16%);
        filter: drop-shadow(0 24px 42px rgba(0, 0, 0, 0.30));
        animation: two-factor-shield-enter 750ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .two-factor-shield-inner {
        display: grid;
        width: 91px;
        height: 111px;
        place-items: center;
        background: rgba(7, 11, 17, 0.77);
        clip-path: polygon(50% 0, 94% 16%, 88% 67%, 50% 100%, 12% 67%, 6% 16%);
    }

    .two-factor-lock {
        position: relative;
        width: 36px;
        height: 31px;
        margin-top: 15px;
        border: 2px solid var(--cinema-gold-light);
        border-radius: 7px;
        box-shadow: 0 0 16px rgba(214, 168, 75, 0.12);
    }

        .two-factor-lock::before {
            position: absolute;
            top: -23px;
            left: 7px;
            width: 18px;
            height: 22px;
            content: "";
            border: 2px solid var(--cinema-gold-light);
            border-bottom: 0;
            border-radius: 12px 12px 0 0;
        }

        .two-factor-lock > span {
            position: absolute;
            top: 9px;
            left: 50%;
            width: 4px;
            height: 9px;
            border-radius: 4px;
            background: var(--cinema-gold-light);
            transform: translateX(-50%);
        }

    .two-factor-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.11);
        border-radius: 50%;
        animation: two-factor-orbit-spin 26s linear infinite;
    }

        .two-factor-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.67);
        }

    .two-factor-orbit-large {
        width: 305px;
        height: 305px;
    }

    .two-factor-orbit-small {
        width: 220px;
        height: 220px;
        animation-direction: reverse;
        animation-duration: 18s;
    }

    .two-factor-signal {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cinema-gold-light);
        box-shadow: 0 0 15px rgba(214, 168, 75, 0.65);
        animation: two-factor-pulse 3s ease-in-out infinite;
    }

    .two-factor-signal-one {
        top: 44px;
        left: 36px;
    }

    .two-factor-signal-two {
        bottom: 45px;
        right: 42px;
        animation-delay: 1.1s;
    }

    .two-factor-visual-copy {
        position: absolute;
        right: 2.1rem;
        bottom: 2.8rem;
        left: 2.1rem;
        text-align: center;
    }

        .two-factor-visual-copy > span {
            display: block;
            margin-bottom: 0.65rem;
            color: var(--cinema-gold-light);
            font-size: 0.57rem;
            font-weight: 900;
            letter-spacing: 0.15em;
        }

        .two-factor-visual-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: clamp(1.15rem, 2.3vw, 1.65rem);
            line-height: 1.24;
        }

        .two-factor-visual-copy p {
            max-width: 300px;
            margin: 0.75rem auto 0;
            color: var(--cinema-text-muted);
            font-size: 0.76rem;
            line-height: 1.7;
        }

    .two-factor-visual-footnote {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.9rem;
        padding: 0.5rem 0.75rem;
        color: var(--cinema-text-soft);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.028);
        font-size: 0.52rem;
        font-weight: 800;
        letter-spacing: 0.1em;
    }

    .two-factor-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--cinema-success);
        box-shadow: 0 0 10px rgba(66, 199, 131, 0.5);
    }

    .two-factor-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 3.8rem);
        background: linear-gradient(180deg, rgba(14, 19, 28, 0.99), rgba(8, 11, 17, 0.99));
    }

    .two-factor-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.5rem;
        color: var(--cinema-text);
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        text-decoration: none;
    }

        .two-factor-brand:hover {
            color: var(--cinema-gold-light);
        }

        .two-factor-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }

    .two-factor-progress {
        display: flex;
        align-items: center;
        margin-bottom: 2.25rem;
    }

    .two-factor-progress-step {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        opacity: 0.45;
    }

        .two-factor-progress-step.active {
            opacity: 1;
        }

        .two-factor-progress-step > span {
            display: grid;
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            place-items: center;
            color: var(--cinema-text-muted);
            border: 1px solid var(--cinema-border-strong);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.025);
            font-size: 0.55rem;
            font-weight: 900;
        }

        .two-factor-progress-step.active > span {
            color: var(--cinema-gold-light);
            border-color: rgba(214, 168, 75, 0.32);
            background: rgba(214, 168, 75, 0.075);
        }

        .two-factor-progress-step strong {
            display: block;
            color: var(--cinema-text-soft);
            font-size: 0.72rem;
        }

        .two-factor-progress-step small {
            display: block;
            margin-top: 0.06rem;
            color: var(--cinema-text-muted);
            font-size: 0.6rem;
        }

    .two-factor-progress-line {
        flex: 0 0 44px;
        height: 1px;
        margin: 0 1rem;
        background: var(--cinema-border-strong);
    }

    .two-factor-heading {
        margin-bottom: 2rem;
    }

        .two-factor-heading h1 {
            margin-bottom: 0.85rem;
            font-size: clamp(2.15rem, 5vw, 3.25rem);
            line-height: 1.03;
            letter-spacing: -0.045em;
        }

        .two-factor-heading p {
            max-width: 475px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.89rem;
            line-height: 1.75;
        }

    .two-factor-form {
        width: 100%;
    }

    .two-factor-validation {
        margin-bottom: 1.2rem;
        padding: 0.1rem 0.1rem 0.1rem 0.5rem;
        border-left: 3px solid var(--cinema-danger);
        color: #ffb0b9;
        font-size: 0.77rem;
    }

        .two-factor-validation:empty,
        .two-factor-validation.validation-summary-valid {
            display: none;
        }

        .two-factor-validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .two-factor-client-error {
        margin-bottom: 1.1rem;
        padding: 0.85rem 1rem;
        border: 1px solid rgba(239, 102, 115, 0.28);
        border-radius: 11px;
        color: #ffb9c0;
        background: rgba(239, 102, 115, 0.07);
        font-size: 0.77rem;
    }

        .two-factor-client-error[hidden] {
            display: none;
        }

    .two-factor-field {
        margin-bottom: 1.3rem;
    }

    .two-factor-label {
        margin-bottom: 0.55rem;
    }

    .two-factor-select-wrapper {
        position: relative;
    }

    .two-factor-select {
        width: 100%;
        min-height: 54px;
        padding-left: 3.2rem;
        padding-right: 2.9rem;
        border-color: var(--cinema-border-strong);
        cursor: pointer;
    }

    .two-factor-select-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 22px;
        height: 22px;
        place-items: center;
        color: var(--cinema-gold-light);
        pointer-events: none;
        transform: translateY(-50%);
    }

    .two-factor-select:focus-visible,
    .two-factor-submit:focus-visible,
    .two-factor-brand:focus-visible,
    .two-factor-back:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 3px;
    }

    .two-factor-field-error {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.72rem;
    }

        .two-factor-field-error:empty {
            display: none;
        }

    .two-factor-provider-info {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        margin-bottom: 1.6rem;
        padding: 1rem;
        border: 1px solid var(--cinema-border);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.023);
        text-align: left;
    }

    .two-factor-provider-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.20);
        border-radius: 12px;
        background: rgba(214, 168, 75, 0.065);
    }

    .two-factor-provider-info > div:last-child {
        min-width: 0;
    }

        .two-factor-provider-info > div:last-child > span {
            display: block;
            margin-bottom: 0.28rem;
            color: var(--cinema-gold-light);
            font-size: 0.55rem;
            font-weight: 900;
            letter-spacing: 0.09em;
        }

    .two-factor-provider-info strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .two-factor-provider-info p {
        margin: 0.32rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.74rem;
        line-height: 1.62;
    }

    .two-factor-submit {
        display: flex;
        width: 100%;
        min-height: 54px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-right: 1.15rem;
        padding-left: 1.15rem;
        text-align: left;
    }

    .two-factor-submit-main {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
    }

    .two-factor-submit-arrow {
        font-size: 1.15rem;
        transition: transform var(--cinema-transition);
    }

    .two-factor-submit:not(:disabled):hover .two-factor-submit-arrow {
        transform: translateX(5px);
    }

    .two-factor-submit-spinner {
        display: none;
    }

    .two-factor-submit.is-submitting .two-factor-submit-spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(15, 15, 18, 0.25);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: two-factor-spinner 700ms linear infinite;
    }

    .two-factor-security {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        margin-top: 1.5rem;
        padding: 0.85rem;
        border: 1px solid rgba(66, 199, 131, 0.17);
        border-radius: 11px;
        background: rgba(66, 199, 131, 0.035);
    }

    .two-factor-security-icon {
        display: grid;
        flex: 0 0 26px;
        width: 26px;
        height: 26px;
        place-items: center;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.2);
        border-radius: 50%;
        background: rgba(66, 199, 131, 0.065);
        font-size: 0.67rem;
        font-weight: 900;
    }

    .two-factor-security p {
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 0.73rem;
        line-height: 1.6;
    }

    .two-factor-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        align-self: center;
        margin-top: 1.8rem;
        color: var(--cinema-text-muted);
        font-size: 0.79rem;
        font-weight: 700;
        text-decoration: none;
    }

        .two-factor-back > span {
            transition: transform var(--cinema-transition);
        }

        .two-factor-back:hover {
            color: var(--cinema-gold-light);
        }

            .two-factor-back:hover > span {
                transform: translateX(-4px);
            }

    @@keyframes two-factor-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes two-factor-shield-enter {
        from {
            opacity: 0;
            transform: scale(0.78) translateY(18px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes two-factor-pulse {
        0%, 100% {
            opacity: 0.3;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }

    @@keyframes two-factor-spinner {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 900px) {
        .two-factor-shell {
            grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
        }

        .two-factor-content {
            padding: 2.5rem 2rem;
        }

        .two-factor-progress-step small {
            display: none;
        }

        .two-factor-progress-line {
            flex-basis: 28px;
            margin: 0 0.65rem;
        }
    }

    @@media (max-width: 760px) {
        .two-factor-shell {
            grid-template-columns: minmax(0, 1fr);
            min-height: 0;
        }

        .two-factor-visual {
            display: none;
        }

        .two-factor-content {
            padding: clamp(2rem, 6vw, 3rem);
        }
    }

    @@media (max-width: 575.98px) {
        .two-factor-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .two-factor-content {
            padding: 2rem 1.15rem;
        }

        .two-factor-brand {
            margin-bottom: 2rem;
        }

        .two-factor-heading h1 {
            font-size: clamp(2rem, 9vw, 2.35rem);
        }

        .two-factor-progress-step > div {
            display: none;
        }

        .two-factor-progress-line {
            flex: 1;
            margin: 0 0.75rem;
        }

        .two-factor-provider-info {
