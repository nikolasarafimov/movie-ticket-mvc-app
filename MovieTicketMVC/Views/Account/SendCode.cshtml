@model MovieTicketMVC.Models.SendCodeViewModel

@{
    ViewBag.Title = "Двофакторска автентикација";
}

<main class="two-factor-page"
      aria-labelledby="two-factor-title">

    <section class="two-factor-shell">

        <div class="two-factor-visual"
             aria-hidden="true">

            <div class="two-factor-grid">
            </div>

            <div class="two-factor-orbit
                        two-factor-orbit-large">
            </div>

            <div class="two-factor-orbit
                        two-factor-orbit-small">
            </div>


            <div class="two-factor-shield">

                <div class="two-factor-shield-inner">

                    <span class="two-factor-shield-lock">
                    </span>

                </div>

            </div>


            <div class="two-factor-visual-copy">

                <span>
                    TWO-FACTOR AUTHENTICATION
                </span>

                <strong>
                    Дополнителен слој
                    на безбедност
                </strong>

                <p>
                    Потврди го пристапот до профилот
                    преку достапниот verification provider.
                </p>

            </div>

        </div>


        <div class="two-factor-content">

            <a class="two-factor-brand"
               href="@Url.Action("Index", "Home")">

                <span></span>

                MOVIETICKET
            </a>


            <div class="two-factor-progress"
                 aria-label="Процес за двофакторска автентикација">

                <div class="two-factor-progress-step active">

                    <span>
                        01
                    </span>

                    <div>
                        <strong>
                            Метод
                        </strong>

                        <small>
                            Избери provider
                        </small>
                    </div>

                </div>


                <div class="two-factor-progress-line">
                </div>


                <div class="two-factor-progress-step">

                    <span>
                        02
                    </span>

                    <div>
                        <strong>
                            Код
                        </strong>

                        <small>
                            Потврди пристап
                        </small>
                    </div>

                </div>

            </div>


            <div class="two-factor-heading">

                <div class="cinema-eyebrow">
                    SECURITY CHECK
                </div>

                <h1 id="two-factor-title">
                    Потврди го
                    <span class="cinema-text-gradient">
                        идентитетот
                    </span>
                </h1>

                <p>
                    Избери каде да биде испратен
                    verification кодот за да продолжиш
                    со најавувањето.
                </p>

            </div>


            @using (Html.BeginForm(
                "SendCode",
                "Account",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "sendCodeForm",
                    @class = "two-factor-form"
                }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(
                    m => m.ReturnUrl)

                @Html.HiddenFor(
                    m => m.RememberMe)


                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class =
                            "validation-summary-errors two-factor-validation"
                    })


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.SelectedProvider,
                        "Метод за потврда",
                        new
                        {
                            @class =
                                "form-label"
                        })


                    <div class="two-factor-select-wrapper">

                        <span class="two-factor-select-icon"
                              aria-hidden="true">
                            ✓
                        </span>

                        @Html.DropDownListFor(
                            m => m.SelectedProvider,
                            Model.Providers,
                            "Избери метод",
                            new
                            {
                                @class =
                                    "form-select two-factor-select"
                            })

                    </div>


                    @Html.ValidationMessageFor(
                        m => m.SelectedProvider,
                        "",
                        new
                        {
                            @class =
                                "text-danger"
                        });

                </div>


                <div class="two-factor-provider-info">

                    <div class="two-factor-provider-icon"
                         aria-hidden="true">
                        @
                    </div>

                    <div>

                        <span>
                            VERIFICATION CODE
                        </span>

                        <strong>
                            Ќе добиеш еднократен код
                        </strong>

                        <p>
                            Откако ќе го избереш достапниот
                            метод, системот ќе испрати код
                            што ќе го внесеш во следниот чекор.
                        </p>

                    </div>

                </div>


                <button type="submit"
                        id="sendCodeButton"
                        class="btn btn-primary two-factor-submit">

                    <span id="sendCodeButtonText">
                        Испрати код
                    </span>

                    <span aria-hidden="true">
                        →
                    </span>

                </button>
            }


            <div class="two-factor-security">

                <span aria-hidden="true">
                    ✓
                </span>

                <p>
                    Verification кодот е дополнителна проверка
                    пред да биде дозволен пристап до профилот.
                </p>

            </div>


            <div class="two-factor-back">

                <span aria-hidden="true">
                    ←
                </span>

                @Html.ActionLink(
                    "Назад кон најава",
                    "Login",
                    "Account")

            </div>

        </div>

    </section>

</main>


@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            var form =
                document.getElementById(
                    "sendCodeForm");

            var button =
                document.getElementById(
                    "sendCodeButton");

            var buttonText =
                document.getElementById(
                    "sendCodeButtonText");

            if (
                !form ||
                !button ||
                !buttonText
            ) {
                return;
            }

            form.addEventListener(
                "submit",
                function () {

                    if (
                        typeof $ !== "undefined" &&
                        $.validator &&
                        !$(form).valid()
                    ) {
                        return;
                    }

                    button.disabled =
                        true;

                    buttonText.textContent =
                        "Се испраќа...";
                });
        })();
    </script>
}


<style>
    .two-factor-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .two-factor-shell {
        display: grid;
        grid-template-columns: minmax(300px, 0.85fr) minmax(430px, 1.15fr);
        width: min(100%, 980px);
        min-height: 650px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }


    /* =====================================================
       VISUAL
       ===================================================== */

    .two-factor-visual {
        position: relative;
        display: grid;
        min-width: 0;
        place-items: center;
        overflow: hidden;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient( circle at 50% 40%, rgba(214, 168, 75, 0.12), transparent 30% ), radial-gradient( circle at 5% 100%, rgba(58, 100, 168, 0.15), transparent 32% ), linear-gradient( 145deg, #151e2b, #0a0f17 58%, #06090e );
        isolation: isolate;
    }

    .two-factor-grid {
        position: absolute;
        z-index: -2;
        inset: 0;
        opacity: 0.25;
        background-image: linear-gradient( rgba(255, 255, 255, 0.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px );
        background-size: 44px 44px;
    }


    /* SHIELD */

    .two-factor-shield {
        position: absolute;
        top: 135px;
        left: 50%;
        z-index: 4;
        width: 115px;
        height: 135px;
        border: 1px solid rgba(214, 168, 75, 0.32);
        border-radius: 52px 52px 60px 60px;
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.15), rgba(214, 168, 75, 0.04) );
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35), 0 0 45px rgba(214, 168, 75, 0.09);
        clip-path: polygon( 50% 0, 95% 17%, 89% 67%, 50% 100%, 11% 67%, 5% 17% );
        transform: translateX(-50%);
    }

    .two-factor-shield-inner {
        position: absolute;
        inset: 18px;
        display: grid;
        place-items: center;
        clip-path: polygon( 50% 0, 95% 17%, 89% 67%, 50% 100%, 11% 67%, 5% 17% );
        background: rgba(8, 12, 18, 0.74);
    }


    /* LOCK */

    .two-factor-shield-lock {
        position: relative;
        display: block;
        width: 35px;
        height: 31px;
        margin-top: 12px;
        border: 2px solid var(--cinema-gold-light);
        border-radius: 8px;
        box-shadow: 0 0 18px rgba(214, 168, 75, 0.18);
    }

        .two-factor-shield-lock::before {
            position: absolute;
            top: -22px;
            left: 7px;
            width: 17px;
            height: 22px;
            content: "";
            border: 2px solid var(--cinema-gold-light);
            border-bottom: 0;
            border-radius: 12px 12px 0 0;
        }

        .two-factor-shield-lock::after {
            position: absolute;
            top: 10px;
            left: 50%;
            width: 4px;
            height: 9px;
            content: "";
            border-radius: 3px;
            background: var(--cinema-gold-light);
            transform: translateX(-50%);
        }


    /* VISUAL COPY */

    .two-factor-visual-copy {
        position: absolute;
        right: 2rem;
        bottom: 3rem;
        left: 2rem;
        z-index: 4;
        text-align: center;
    }

        .two-factor-visual-copy > span {
            display: block;
            margin-bottom: 0.45rem;
            color: var(--cinema-gold-light);
            font-size: 0.55rem;
            font-weight: 900;
            letter-spacing: 0.16em;
        }

        .two-factor-visual-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 1.3rem;
            line-height: 1.2;
        }

        .two-factor-visual-copy p {
            max-width: 280px;
            margin: 0.55rem auto 0;
            color: var(--cinema-text-muted);
            font-size: 0.72rem;
            line-height: 1.6;
        }


    /* ORBITS */

    .two-factor-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: two-factor-orbit-spin 26s linear infinite;
    }

        .two-factor-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.70);
        }

    .two-factor-orbit-large {
        top: 75px;
        left: 50%;
        width: 310px;
        height: 310px;
        transform: translateX(-50%);
    }

    .two-factor-orbit-small {
        top: 120px;
        left: 50%;
        width: 220px;
        height: 220px;
        animation-direction: reverse;
        animation-duration: 18s;
        transform: translateX(-50%);
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .two-factor-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 6vw, 4rem);
        background: linear-gradient( 180deg, rgba(14, 19, 28, 0.99), rgba(8, 11, 17, 0.99) );
    }


    /* BRAND */

    .two-factor-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.3rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .two-factor-brand:hover {
            color: var(--cinema-gold-light);
        }

        .two-factor-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       PROGRESS
       ===================================================== */

    .two-factor-progress {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
    }

    .two-factor-progress-step {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        opacity: 0.35;
    }

        .two-factor-progress-step.active {
            opacity: 1;
        }

        .two-factor-progress-step > span {
            display: grid;
            flex: 0 0 32px;
            width: 32px;
            height: 32px;
            place-items: center;
            color: var(--cinema-text-muted);
            border: 1px solid var(--cinema-border-strong);
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.02);
            font-size: 0.54rem;
            font-weight: 900;
        }

        .two-factor-progress-step.active > span {
            color: var(--cinema-gold-light);
            border-color: rgba(214, 168, 75, 0.3);
            background: rgba(214, 168, 75, 0.07);
        }

        .two-factor-progress-step strong {
            display: block;
            color: var(--cinema-text-soft);
            font-size: 0.68rem;
        }

        .two-factor-progress-step small {
            display: block;
            margin-top: 0.05rem;
            color: var(--cinema-text-muted);
            font-size: 0.57rem;
        }

    .two-factor-progress-line {
        width: 55px;
        height: 1px;
        margin: 0 0.8rem;
        background: var(--cinema-border-strong);
    }


    /* =====================================================
       HEADING
       ===================================================== */

    .two-factor-heading {
        margin-bottom: 1.8rem;
    }

        .two-factor-heading h1 {
            margin-bottom: 0.9rem;
            font-size: clamp( 2.3rem, 5vw, 3.4rem );
            line-height: 1.02;
            letter-spacing: -0.05em;
        }

        .two-factor-heading p {
            max-width: 500px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.84rem;
            line-height: 1.7;
        }


    /* =====================================================
       FORM
       ===================================================== */

    .two-factor-validation {
        margin-bottom: 1.1rem;
    }

        .two-factor-validation:empty {
            display: none;
        }

    .two-factor-select-wrapper {
        position: relative;
    }

    .two-factor-select {
        min-height: 52px;
        padding-left: 3rem;
    }

    .two-factor-select-icon {
        position: absolute;
        z-index: 3;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.18);
        border-radius: 50%;
        background: rgba(214, 168, 75, 0.05);
        font-size: 0.48rem;
        pointer-events: none;
        transform: translateY(-50%);
    }


    /* =====================================================
       PROVIDER INFO
       ===================================================== */

    .two-factor-provider-info {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        margin: 0.3rem 0 1.5rem;
        padding: 1rem;
        border: 1px solid var(--cinema-border);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.018);
    }

    .two-factor-provider-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.19);
        border-radius: 12px;
        background: rgba(214, 168, 75, 0.055);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .two-factor-provider-info
    div:last-child > span {
        display: block;
        margin-bottom: 0.2rem;
        color: var(--cinema-gold-light);
        font-size: 0.52rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .two-factor-provider-info strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.8rem;
    }

    .two-factor-provider-info p {
        margin: 0.25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.68rem;
        line-height: 1.55;
    }


    /* =====================================================
       SUBMIT
       ===================================================== */

    .two-factor-submit {
        display: flex;
        width: 100%;
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        padding-right: 1.1rem;
        padding-left: 1.1rem;
    }

        .two-factor-submit > span:last-child {
            transition: transform var(--cinema-transition);
        }

        .two-factor-submit:hover > span:last-child {
            transform: translateX(5px);
        }


    /* =====================================================
       SECURITY
       ===================================================== */

    .two-factor-security {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-top: 1.5rem;
        padding: 0.8rem;
        border: 1px solid rgba(66, 199, 131, 0.14);
        border-radius: 11px;
        background: rgba(66, 199, 131, 0.035);
    }

        .two-factor-security > span {
            display: grid;
            flex: 0 0 25px;
            width: 25px;
            height: 25px;
            place-items: center;
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.18);
            border-radius: 50%;
            background: rgba(66, 199, 131, 0.06);
            font-size: 0.58rem;
            font-weight: 900;
        }

        .two-factor-security p {
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.67rem;
            line-height: 1.55;
        }


    /* =====================================================
       BACK
       ===================================================== */

    .two-factor-back {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        margin-top: 1.5rem;
        color: var(--cinema-text-muted);
        font-size: 0.75rem;
    }

        .two-factor-back > span {
            transition: transform var(--cinema-transition);
        }

        .two-factor-back a {
            color: var(--cinema-text-soft);
            font-weight: 700;
        }

        .two-factor-back:hover > span {
            transform: translateX(-4px);
        }

        .two-factor-back a:hover {
            color: var(--cinema-gold-light);
        }


    /* =====================================================
       ANIMATION
       ===================================================== */

    @@keyframes two-factor-orbit-spin {
        from {
            transform: translateX(-50%) rotate(0deg);
        }

        to {
            transform: translateX(-50%) rotate(360deg);
        }
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 820px) {
        .two-factor-shell {
            grid-template-columns: 1fr;
            min-height: 0;
        }

        .two-factor-visual {
            display: none;
        }

        .two-factor-content {
            min-height: 640px;
        }
    }

    @@media (max-width: 575.98px) {
        .two-factor-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .two-factor-content {
            min-height: 0;
            padding: 2rem 1.2rem;
        }

        .two-factor-progress-step
        div {
            display: none;
        }

        .two-factor-progress-line {
            flex: 1;
            width: auto;
            margin: 0 0.6rem;
        }

        .two-factor-heading h1 {
            font-size: 2.2rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .two-factor-orbit {
            animation: none;
        }
    }
</style>