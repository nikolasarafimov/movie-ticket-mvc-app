        }

        .two-factor-submit-arrow,
        .two-factor-back > span {
            transition: none;
        }
    }
</style>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("sendCodeForm");
            var providerSelect = document.getElementById("SelectedProvider");
            var submitButton = document.getElementById("sendCodeButton");
            var submitText = document.getElementById("sendCodeButtonText");
            var providerTitle = document.getElementById("twoFactorProviderTitle");
            var providerDescription = document.getElementById("twoFactorProviderDescription");
            var error = document.getElementById("twoFactorClientError");
            var submitting = false;

            if (!form || !providerSelect || !submitButton) {
                return;
            }

            function setError(message) {
                if (!error) {
                    return;
                }
                error.textContent = message || "";
                error.hidden = !message;
            }

            function updateProviderDetails() {
                var selected = providerSelect.options[providerSelect.selectedIndex];
                var value = providerSelect.value;

                if (!value) {
                    if (providerTitle) {
                        providerTitle.textContent = "Избери начин за добивање код";
                    }
                    if (providerDescription) {
                        providerDescription.textContent = "По изборот на достапен метод, системот ќе се обиде да ти испрати код за проверка на идентитетот.";
                    }
                    return;
                }

                var name = selected ? selected.textContent.trim() : value;
                var isEmail = /email|e-mail|е-пошта|пошта/i.test(name + " " + value);

                if (providerTitle) {
                    providerTitle.textContent = "Избран метод: " + name;
                }
                if (providerDescription) {
                    providerDescription.textContent = isEmail
                        ? "По потврдување на изборот, системот ќе се обиде да испрати еднократен код на e-mail адресата поврзана со твојот профил."
                        : "По потврдување на изборот, системот ќе се обиде да го испрати кодот преку избраниот метод.";
                }
            }

            providerSelect.addEventListener("change", function () {
                setError("");
                updateProviderDetails();
            });

            form.addEventListener("submit", function (event) {
                if (submitting) {
                    event.preventDefault();
                    return;
                }

                if (!providerSelect.value) {
                    event.preventDefault();
                    setError("Избери метод за потврда пред да продолжиш.");
                    providerSelect.focus();
                    return;
                }

                if (typeof window.jQuery !== "undefined" &&
                    window.jQuery.validator &&
                    !window.jQuery(form).valid()) {
                    event.preventDefault();
                    return;
                }

                setError("");
                submitting = true;
                submitButton.disabled = true;
                submitButton.classList.add("is-submitting");

                if (submitText) {
                    submitText.textContent = "Се обработува барањето...";
                }
            });

            window.addEventListener("pageshow", function (event) {
                if (event.persisted) {
                    submitting = false;
                    submitButton.disabled = false;
                    submitButton.classList.remove("is-submitting");
                    if (submitText) {
                        submitText.textContent = "Продолжи и испрати код";
                    }
                }
            });

            updateProviderDetails();
        })();
    </script>
}