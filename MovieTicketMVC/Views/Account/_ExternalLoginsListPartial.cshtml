@model MovieTicketMVC.Models.ExternalLoginListViewModel
@using System.Linq
@using Microsoft.Owin.Security

@{
    var loginProviders = Context
        .GetOwinContext()
        .Authentication
        .GetExternalAuthenticationTypes()
        .ToList();
}

@if (loginProviders.Any())
{
    <div class="external-login-section">
        <h4>Use another service to log in.</h4>
        <hr />

        @using (Html.BeginForm(
            "ExternalLogin",
            "Account",
            new { ReturnUrl = Model?.ReturnUrl },
            FormMethod.Post,
            new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            <div id="socialLoginList">
                @foreach (AuthenticationDescription provider in loginProviders)
                {
                    <button type="submit"
                            class="btn btn-outline-dark"
                            name="provider"
                            value="@provider.AuthenticationType"
                            title="Log in using your @provider.Caption account">
                        @provider.Caption
                    </button>
                }
            </div>
        }
    </div>
}