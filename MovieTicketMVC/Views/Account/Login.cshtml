@using MovieTicketMVC.Models
@model LoginViewModel

@{
    ViewBag.Title = "Најава";
}

<div class="login-page" aria-labelledby="login-title">
    <section class="login-shell">
        <div class="login-showcase">
            <div class="login-showcase-glow login-showcase-glow-gold" aria-hidden="true"></div>
            <div class="login-showcase-glow login-showcase-glow-blue" aria-hidden="true"></div>

            <div class="login-showcase-content">
                <a class="login-brand" href="@Url.Action("Index", "Home")" aria-label="MovieTicket — Почетна">
                    <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                         alt="MovieTicket"
                         width="174"
                         height="48"
                         decoding="async" />
                </a>

                <div class="login-showcase-copy">
                    <div class="cinema-eyebrow">ТВОЕТО КИНО ИСКУСТВО</div>
                    <h2>Филмот започнува <span class="cinema-text-gradient">тука.</span></h2>
                    <p>
                        Најави се и продолжи кон следната кино вечер.
                        Избери филм, резервирај седиште и пронајди ги своите билети на едно место.
                    </p>
                </div>
            </div>

            <div class="login-ticket-art" aria-hidden="true">
                <div class="login-ticket-art-top">
                    <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                         alt=""
                         width="105"
                         height="32"
                         decoding="async" />
                    <span class="login-ticket-badge">КИНО БИЛЕТ</span>
                </div>

                <div class="login-ticket-art-title">
                    <span>КИНО</span>
                    <strong>Твојата<br />кино вечер</strong>
                </div>

                <div class="login-ticket-art-divider"></div>

                <div class="login-ticket-art-meta">
                    <div>
                        <span>ТЕРМИН</span>
                        <strong>21:00</strong>
                    </div>

                    <div>
                        <span>РЕД</span>
                        <strong>05</strong>
                    </div>

                    <div>
                        <span>СЕДИШТЕ</span>
                        <strong>07</strong>
                    </div>
                </div>

                <div class="login-barcode">
                    @for (var i = 0; i < 18; i++)
                    {
                        <span></span>
                    }
                </div>
            </div>
        </div>

        <div class="login-form-side">
            <div class="login-form-wrapper">
                <div class="login-heading">
                    <span class="login-heading-label">ДОБРЕДОЈДЕ НАЗАД</span>
                    <h1 id="login-title">Најави се</h1>
                    <p>Внеси ги податоците од твојот профил за да продолжиш.</p>
                </div>

                @using (Html.BeginForm(
                    "Login",
                    "Account",
                    new { ReturnUrl = ViewBag.ReturnUrl },
                    FormMethod.Post,
                    new
                    {
                        role = "form",
                        id = "loginForm",
                        @class = "login-form",
                        aria_label = "Форма за најава"
                    }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new
                    {
                        @class = "login-validation",
                        role = "alert",
                        aria_live = "assertive"
                    })

                    <div class="login-field">
                        @Html.LabelFor(m => m.Email, "Е-пошта", new { @class = "form-label" })

                        <div class="login-input-wrapper">
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control login-input",
                                type = "email",
                                autocomplete = "email",
                                inputmode = "email",
                                autocapitalize = "none",
                                spellcheck = "false",
                                required = "required",
                                aria_required = "true",
                                aria_describedby = "loginEmailError",
                                placeholder = "ime@primer.com",
                                autofocus = "autofocus"
                            })
                        </div>

                        @Html.ValidationMessageFor(m => m.Email, "", new
                        {
                            @class = "text-danger login-field-error",
                            id = "loginEmailError"
                        })
                    </div>

                    <div class="login-field">
                        <div class="login-label-row">
                            @Html.LabelFor(m => m.Password, "Лозинка", new { @class = "form-label" })

                            <a class="login-forgot-link"
                               href="@Url.Action("ForgotPassword", "Account")">
                                Ја заборави лозинката?
                            </a>
                        </div>

                        <div class="login-input-wrapper">
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control login-input login-password-input",
                                id = "Password",
                                autocomplete = "current-password",
                                required = "required",
                                aria_required = "true",
                                aria_describedby = "loginPasswordError",
                                placeholder = "Внеси ја лозинката"
                            })

                            <button type="button"
                                    id="togglePassword"
                                    class="login-password-toggle"
                                    aria-label="Прикажи лозинка"
                                    aria-controls="Password"
                                    aria-pressed="false">
                                <span id="passwordToggleText">Прикажи</span>
                            </button>
                        </div>

                        @Html.ValidationMessageFor(m => m.Password, "", new
                        {
                            @class = "text-danger login-field-error",
                            id = "loginPasswordError"
                        })
                    </div>

                    <div class="login-options">
                        <label class="login-remember" for="RememberMe">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            <span>Запомни ме</span>
                        </label>
                    </div>

                    <button type="submit"
                            id="loginButton"
                            class="btn btn-primary login-submit">
                        <span id="loginButtonText">Најави се</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <div class="login-register">
                        <span>Немаш профил?</span>

                        @Html.ActionLink(
                                 "Креирај сметка",
                                 "Register",
                                 "Account",
                                 new { ReturnUrl = ViewBag.ReturnUrl },
                                 null)
                    </div>
                }

                <div class="login-external">
                    @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel
                    {
                        ReturnUrl = ViewBag.ReturnUrl
                    })
                </div>

                <div class="login-security-note">
                    <span class="login-security-icon" aria-hidden="true">✓</span>

                    <p>
                        На јавен или споделен уред не ја избирај опцијата „Запомни ме“.
                        Никогаш не ја споделувај својата лозинка.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .login-page {
        width: 100%;
        min-width: 0;
    }

    .login-shell {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(380px, .9fr);
        min-height: 680px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }

    .login-showcase {
        position: relative;
        min-width: 0;
        overflow: hidden;
        padding: clamp(2rem, 4.3vw, 4rem);
        isolation: isolate;
        background: radial-gradient(circle at 16% 20%, rgba(214, 168, 75, .13), transparent 32%), radial-gradient(circle at 88% 90%, rgba(63, 103, 166, .18), transparent 35%), linear-gradient(145deg, #141c29, #090e16 57%, #070a10);
    }

        .login-showcase::before {
            position: absolute;
            z-index: -1;
            inset: 0;
            content: "";
            opacity: .2;
            pointer-events: none;
            background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
            background-size: 48px 48px;
            -webkit-mask-image: linear-gradient(140deg, #000, transparent 80%);
            mask-image: linear-gradient(140deg, #000, transparent 80%);
        }

    .login-showcase-content {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        min-width: 0;
        height: 100%;
    }

    .login-brand {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        border-radius: 8px;
        text-decoration: none;
    }

        .login-brand img {
            display: block;
            width: 174px;
            max-width: 100%;
            height: 48px;
            object-fit: contain;
            object-position: left center;
        }

    .login-showcase-copy {
        max-width: 600px;
        margin-top: auto;
        padding-top: 7rem;
    }

        .login-showcase-copy h2 {
            margin-bottom: 1.25rem;
            font-size: clamp(2.8rem, 5.3vw, 5.15rem);
            font-weight: 800;
            line-height: 1.05;
            letter-spacing: -.06em;
            overflow-wrap: break-word;
        }

        .login-showcase-copy p {
            max-width: 520px;
            margin-bottom: 0;
            color: #c9d0da;
            font-size: 1rem;
            line-height: 1.85;
        }

    .login-showcase-glow {
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(24px);
        pointer-events: none;
    }

    .login-showcase-glow-gold {
        top: -130px;
        left: -140px;
        width: 340px;
        height: 340px;
        background: rgba(214, 168, 75, .075);
    }

    .login-showcase-glow-blue {
        right: -130px;
        bottom: -180px;
        width: 420px;
        height: 420px;
        background: rgba(63, 103, 166, .11);
    }

    .login-ticket-art {
        position: absolute;
        z-index: 1;
        top: 12%;
        right: 32px;
        width: 230px;
        padding: 1.12rem;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 21px;
        background: linear-gradient(145deg, #1a2331, #0b101a);
        box-shadow: 0 32px 70px rgba(0,0,0,.44);
        opacity: .75;
        transform: rotate(5deg);
        animation: login-ticket-float 7s ease-in-out infinite;
        pointer-events: none;
    }

        .login-ticket-art::before,
        .login-ticket-art::after {
            position: absolute;
            top: 56%;
            width: 20px;
            height: 20px;
            content: "";
            border-radius: 50%;
            background: #0c1119;
            transform: translateY(-50%);
        }

        .login-ticket-art::before {
            left: -11px;
        }

        .login-ticket-art::after {
            right: -11px;
        }

    .login-ticket-art-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .45rem;
    }

        .login-ticket-art-top img {
            display: block;
            flex: 1 1 auto;
            width: 100px;
            min-width: 0;
            height: 30px;
            object-fit: contain;
            object-position: left center;
        }

    .login-ticket-badge {
        padding: .28rem .38rem;
        border: 1px solid rgba(214,168,75,.28);
        border-radius: 999px;
        color: #f0cb76;
        font-size: .49rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .login-ticket-art-title {
        padding: 3rem 0 2rem;
    }

        .login-ticket-art-title > span {
            display: block;
            margin-bottom: .55rem;
            color: #e6b956;
            font-size: .62rem;
            font-weight: 900;
            letter-spacing: .12em;
        }

        .login-ticket-art-title strong {
            display: block;
            color: #f5f7fb;
            font-size: 1.56rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

    .login-ticket-art-divider {
        height: 1px;
        background: repeating-linear-gradient(90deg,rgba(255,255,255,.19) 0 7px,transparent 7px 14px);
    }

    .login-ticket-art-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: .5rem;
        padding: 1.12rem 0;
    }

        .login-ticket-art-meta span {
            display: block;
            margin-bottom: .2rem;
            color: #aeb8c6;
            font-size: .53rem;
            font-weight: 800;
        }

        .login-ticket-art-meta strong {
            color: #f5f7fb;
            font-size: .78rem;
        }

    .login-barcode {
        display: flex;
        justify-content: center;
        gap: 3px;
        height: 30px;
        opacity: .72;
    }

        .login-barcode span {
            width: 2px;
            background: #c1cad6;
        }

            .login-barcode span:nth-child(2n) {
                width: 1px;
            }

            .login-barcode span:nth-child(3n) {
                width: 4px;
            }

    .login-form-side {
        display: grid;
        place-items: center;
        min-width: 0;
        padding: clamp(2rem, 4.4vw, 4rem);
        background: linear-gradient(180deg, rgba(13,18,27,.99), rgba(8,11,17,.99));
    }

    .login-form-wrapper {
        width: min(100%,430px);
        min-width: 0;
    }

    .login-heading {
        margin-bottom: 1.9rem;
    }

    .login-heading-label {
        display: block;
        margin-bottom: .6rem;
        color: var(--cinema-gold-light);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .11em;
    }

    .login-heading h1 {
        margin: 0 0 .7rem;
        font-size: clamp(2.05rem,4vw,2.75rem);
        line-height: 1.2;
    }

    .login-heading p {
        max-width: 380px;
        margin: 0;
        color: #aeb8c6;
        font-size: .91rem;
        line-height: 1.75;
    }

    .login-form {
        width: 100%;
    }

        .login-form .login-field {
            margin-bottom: 1.35rem;
        }

        .login-form .form-label {
            display: inline-block;
            margin-bottom: .55rem;
            color: #dfe4ed;
            font-size: .86rem;
            font-weight: 650;
        }

    .login-label-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .25rem 1rem;
    }

    .login-forgot-link {
        margin-bottom: .5rem;
        color: #b1bac9;
        font-size: .76rem;
        font-weight: 600;
        text-decoration: none;
    }

        .login-forgot-link:hover {
            color: var(--cinema-gold-light);
        }

    .login-input-wrapper {
        position: relative;
        width: 100%;
    }

    .login-page .login-form .login-input-wrapper .login-input {
        display: block;
        width: 100%;
        min-height: 52px;
        padding: .82rem 1rem;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 12px;
        background: #121925;
        color: #f5f7fb;
        font-size: .91rem;
        line-height: 1.5;
        transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    }

    .login-page .login-form .login-input-wrapper .login-password-input {
        padding-right: 6.7rem;
    }

    .login-page .login-input::placeholder {
        color: #97a2b3;
        opacity: 1;
    }

    .login-page .login-input::-webkit-input-placeholder {
        color: #97a2b3;
    }

    .login-page .login-input:-webkit-autofill,
    .login-page .login-input:-webkit-autofill:hover,
    .login-page .login-input:-webkit-autofill:focus {
        -webkit-text-fill-color: #f5f7fb;
        -webkit-box-shadow: 0 0 0 1000px #121925 inset;
        caret-color: #f5f7fb;
    }

    .login-password-toggle {
        position: absolute;
        z-index: 3;
        top: 50%;
        right: .7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: .35rem .65rem;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: #cbd3df;
        font-size: .76rem;
        font-weight: 700;
        cursor: pointer;
        transform: translateY(-50%);
    }

        .login-password-toggle:hover {
            color: var(--cinema-gold-light);
            background: rgba(255,255,255,.055);
        }

    .login-page .login-form .login-input-wrapper .login-input:focus {
        border-color: var(--cinema-gold);
        background: #141d2b;
        box-shadow: 0 0 0 3px rgba(214,168,75,.13);
        outline: none;
    }

    .login-page .login-form .login-input-wrapper .input-validation-error {
        border-color: rgba(239,102,115,.75);
    }

    .login-validation {
        margin-bottom: 1.3rem;
        padding: .9rem 1rem;
        border: 1px solid rgba(239,102,115,.35);
        border-radius: 12px;
        background: rgba(239,102,115,.085);
        color: #ffc1c7;
        font-size: .82rem;
        line-height: 1.6;
    }

        .login-validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

        .validation-summary-valid.login-validation,
        .login-validation:empty {
            display: none;
        }

    .login-field-error {
        display: block;
        margin-top: .4rem;
        font-size: .75rem;
        line-height: 1.5;
    }

        .login-field-error:empty {
            display: none;
        }

    .login-options {
        margin: .2rem 0 1.5rem;
    }

    .login-remember {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        margin: 0;
        color: #cbd3dd;
        font-size: .85rem;
        cursor: pointer;
    }

        .login-remember .form-check-input {
            margin: 0;
            cursor: pointer;
        }

    .login-submit {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        min-height: 52px;
        padding: .75rem 1.1rem;
        font-weight: 800;
    }

        .login-submit:disabled,
        .login-submit.is-submitting {
            cursor: progress;
            opacity: .8;
        }

    .login-register {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: .4rem;
        margin-top: 1.35rem;
        color: #a5afbe;
        font-size: .84rem;
        text-align: center;
    }

        .login-register a {
            color: var(--cinema-gold-light);
            font-weight: 750;
        }

            .login-register a:hover {
                color: #ffe0a0;
            }

    .login-external {
        margin-top: 1.5rem;
    }

        .login-external:empty {
            display: none;
        }

    .login-security-note {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        margin-top: 1.9rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--cinema-border);
    }

    .login-security-icon {
        display: grid;
        flex: 0 0 24px;
        place-items: center;
        width: 24px;
        height: 24px;
        border: 1px solid rgba(66,199,131,.25);
        border-radius: 50%;
        background: rgba(66,199,131,.07);
        color: #95e8b5;
        font-size: .74rem;
        font-weight: 800;
    }

    .login-security-note p {
        margin: 0;
        color: #a7b1c0;
        font-size: .76rem;
        line-height: 1.65;
    }

    .login-page a:focus-visible,
    .login-page button:focus-visible,
    .login-page input:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 3px;
    }

    @@keyframes login-ticket-float {
        0%, 100% {
            transform: rotate(5deg) translateY(0);
        }

        50% {
            transform: rotate(3deg) translateY(-10px);
        }
    }

    @@media (max-width: 1170px) {
        .login-ticket-art {
            display: none;
        }

        .login-showcase-copy {
            padding-top: 3rem;
        }
    }

    @@media (max-width: 880px) {
        .login-shell {
            grid-template-columns: minmax(0,1fr);
            min-height: 0;
        }

        .login-showcase {
            display: none;
        }

        .login-form-side {
            padding: clamp(2rem,6vw,3.5rem);
        }
    }

    @@media (max-width: 575.98px) {
        .login-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .login-form-side {
            padding: 2rem 1.15rem;
        }

        .login-heading h1 {
            font-size: 2rem;
        }

        .login-label-row {
            align-items: flex-start;
        }

        .login-forgot-link {
            font-size: .75rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .login-ticket-art {
            animation: none;
        }

        .login-password-toggle,
        .login-submit {
            transition: none;
        }
    }
</style>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("loginForm");
            var submitButton = document.getElementById("loginButton");
            var submitText = document.getElementById("loginButtonText");
            var passwordInput = document.getElementById("Password");
            var toggleButton = document.getElementById("togglePassword");
            var toggleText = document.getElementById("passwordToggleText");
            var submitting = false;

            if (passwordInput && toggleButton && toggleText) {
                toggleButton.addEventListener("click", function () {
                    var showPassword = passwordInput.type === "password";

                    passwordInput.type = showPassword ? "text" : "password";

                    toggleText.textContent = showPassword
                        ? "Сокриј"
                        : "Прикажи";

                    toggleButton.setAttribute(
                        "aria-pressed",
                        showPassword ? "true" : "false"
                    );

                    toggleButton.setAttribute(
                        "aria-label",
                        showPassword
                            ? "Сокриј лозинка"
                            : "Прикажи лозинка"
                    );
                });
            }

            function resetFormState() {
                submitting = false;

                if (form) {
                    form.removeAttribute("aria-busy");
                }

                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.classList.remove("is-submitting");
                }

                if (submitText) {
                    submitText.textContent = "Најави се";
                }
            }

            if (form && submitButton && submitText) {
                form.addEventListener("submit", function (event) {
                    if (submitting) {
                        event.preventDefault();
                        return;
                    }

                    if (!form.checkValidity()) {
                        return;
                    }

                    if (window.jQuery &&
                        window.jQuery.fn &&
                        typeof window.jQuery.fn.valid === "function" &&
                        !window.jQuery(form).valid()) {
                        return;
                    }

                    submitting = true;
                    form.setAttribute("aria-busy", "true");
                    submitButton.disabled = true;
                    submitButton.classList.add("is-submitting");
                    submitText.textContent = "Се најавува...";
                });

                window.addEventListener("pageshow", function (event) {
                    if (event.persisted || submitting) {
                        resetFormState();
                    }
                });
            }
        })();
    </script>
}