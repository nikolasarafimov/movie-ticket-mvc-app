@model MovieTicketMVC.Models.ResetPasswordViewModel

@{
    ViewBag.Title = "Постави нова лозинка";
}

<main class="reset-page"
      aria-labelledby="reset-title">

    <section class="reset-shell">

        <div class="reset-visual"
             aria-hidden="true">

            <div class="reset-orbit reset-orbit-large">
            </div>

            <div class="reset-orbit reset-orbit-small">
            </div>


            <div class="reset-visual-content">

                <div class="reset-lock">

                    <div class="reset-lock-shackle">
                    </div>

                    <div class="reset-lock-body">

                        <span></span>

                    </div>

                </div>

                <span class="reset-visual-label">
                    SECURE PASSWORD RESET
                </span>

                <strong>
                    Последен чекор
                </strong>

                <p>
                    Креирај нова безбедна лозинка
                    за твојот MovieTicket профил.
                </p>

            </div>

        </div>


        <div class="reset-content">

            <a class="reset-brand"
               href="@Url.Action("Index", "Home")">

                <span></span>

                MOVIETICKET
            </a>


            <div class="reset-progress"
                 aria-label="Процес за промена на лозинка">

                <div class="reset-progress-step completed">

                    <span aria-hidden="true">
                        ✓
                    </span>

                    <strong>
                        E-mail
                    </strong>

                </div>

                <div class="reset-progress-line completed">
                </div>

                <div class="reset-progress-step completed">

                    <span aria-hidden="true">
                        ✓
                    </span>

                    <strong>
                        Link
                    </strong>

                </div>

                <div class="reset-progress-line active">
                </div>

                <div class="reset-progress-step active">

                    <span>
                        03
                    </span>

                    <strong>
                        Reset
                    </strong>

                </div>

            </div>


            <div class="reset-heading">

                <div class="cinema-eyebrow">
                    NEW PASSWORD
                </div>

                <h1 id="reset-title">
                    Постави нова
                    <span class="cinema-text-gradient">
                        лозинка
                    </span>
                </h1>

                <p>
                    Избери силна лозинка што не ја користиш
                    на други сервиси.
                </p>

            </div>


            @using (Html.BeginForm(
                "ResetPassword",
                "Account",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "resetPasswordForm",
                    @class = "reset-form"
                }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class =
                            "validation-summary-errors reset-validation"
                    })

                @Html.HiddenFor(
                    m => m.Code)

                @Html.ValidationMessageFor(
                    m => m.Code,
                    "",
                    new
                    {
                        @class =
                            "text-danger reset-code-error"
                    })


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.Email,
                        "E-mail адреса",
                        new
                        {
                            @class =
                                "form-label"
                        })

                    <div class="reset-input-wrapper">

                        <span class="reset-input-icon"
                              aria-hidden="true">
                            &#64;
                        </span>

                        @Html.TextBoxFor(
                            m => m.Email,
                            new
                            {
                                @class =
                                    "form-control reset-input",
                                type =
                                    "email",
                                autocomplete =
                                    "email",
                                placeholder =
                                    "name@example.com"
                            })

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.Email,
                        "",
                        new
                        {
                            @class =
                                "text-danger"
                        })

                </div>


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.Password,
                        "Нова лозинка",
                        new
                        {
                            @class =
                                "form-label"
                        })

                    <div class="reset-input-wrapper">

                        <span class="reset-input-icon reset-password-icon"
                              aria-hidden="true">
                            •
                        </span>

                        @Html.PasswordFor(
                            m => m.Password,
                            new
                            {
                                @class =
                                    "form-control reset-input reset-password-field",
                                autocomplete =
                                    "new-password",
                                placeholder =
                                    "Внеси нова лозинка",
                                id =
                                    "Password",
                                autofocus =
                                    "autofocus"
                            })

                        <button type="button"
                                class="reset-password-toggle"
                                data-password-target="Password"
                                aria-label="Прикажи лозинка"
                                aria-pressed="false">
                            SHOW
                        </button>

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.Password,
                        "",
                        new
                        {
                            @class =
                                "text-danger"
                        })


                    <div class="reset-strength">

                        <div class="reset-strength-header">

                            <span>
                                Сигурност на лозинката
                            </span>

                            <strong id="passwordStrengthText">
                                —
                            </strong>

                        </div>

                        <div class="reset-strength-track">

                            <span id="passwordStrengthBar">
                            </span>

                        </div>

                    </div>


                    <div class="reset-requirements">

                        <div class="reset-requirement"
                             id="requirementLength">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Најмалку 8 карактери

                        </div>

                        <div class="reset-requirement"
                             id="requirementUpper">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Голема буква

                        </div>

                        <div class="reset-requirement"
                             id="requirementLower">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Мала буква

                        </div>

                        <div class="reset-requirement"
                             id="requirementNumber">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Број

                        </div>

                        <div class="reset-requirement"
                             id="requirementSpecial">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Специјален карактер

                        </div>

                    </div>

                </div>


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.ConfirmPassword,
                        "Потврди нова лозинка",
                        new
                        {
                            @class =
                                "form-label"
                        })

                    <div class="reset-input-wrapper">

                        <span class="reset-input-icon reset-password-icon"
                              aria-hidden="true">
                            •
                        </span>

                        @Html.PasswordFor(
                            m => m.ConfirmPassword,
                            new
                            {
                                @class =
                                    "form-control reset-input reset-password-field",
                                autocomplete =
                                    "new-password",
                                placeholder =
                                    "Повтори ја новата лозинка",
                                id =
                                    "ConfirmPassword"
                            })

                        <button type="button"
                                class="reset-password-toggle"
                                data-password-target="ConfirmPassword"
                                aria-label="Прикажи лозинка"
                                aria-pressed="false">
                            SHOW
                        </button>

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.ConfirmPassword,
                        "",
                        new
                        {
                            @class =
                                "text-danger"
                        })

                    <div id="passwordMatchIndicator"
                         class="reset-match-indicator"
                         aria-live="polite">
                    </div>

                </div>


                <button type="submit"
                        id="resetPasswordButton"
                        class="btn btn-primary reset-submit">

                    <span id="resetPasswordButtonText">
                        Постави нова лозинка
                    </span>

                    <span aria-hidden="true">
                        →
                    </span>

                </button>
            }


            <div class="reset-security-note">

                <span aria-hidden="true">
                    ✓
                </span>

                <p>
                    По успешната промена ќе можеш да се
                    најавиш со новата лозинка.
                </p>

            </div>


            <div class="reset-back">

                <span aria-hidden="true">
                    ←
                </span>

                @Html.ActionLink(
                    "Назад кон најава",
                    "Login",
                    "Account")

            </div>

        </div>

    </section>

</main>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            var form =
                document.getElementById(
                    "resetPasswordForm");

            var password =
                document.getElementById(
                    "Password");

            var confirmPassword =
                document.getElementById(
                    "ConfirmPassword");

            var submitButton =
                document.getElementById(
                    "resetPasswordButton");

            var submitButtonText =
                document.getElementById(
                    "resetPasswordButtonText");

            var strengthBar =
                document.getElementById(
                    "passwordStrengthBar");

            var strengthText =
                document.getElementById(
                    "passwordStrengthText");

            var matchIndicator =
                document.getElementById(
                    "passwordMatchIndicator");

            var requirements =
                {
                    length:
                        document.getElementById(
                            "requirementLength"),

                    upper:
                        document.getElementById(
                            "requirementUpper"),

                    lower:
                        document.getElementById(
                            "requirementLower"),

                    number:
                        document.getElementById(
                            "requirementNumber"),

                    special:
                        document.getElementById(
                            "requirementSpecial")
                };


            function setRequirement(
                element,
                valid) {

                if (!element) {
                    return;
                }

                element.classList.toggle(
                    "valid",
                    valid);
            }


            function evaluatePassword() {
                if (!password) {
                    return;
                }

                var value =
                    password.value || "";

                var checks =
                    {
                        length:
                            value.length >= 8,

                        upper:
                            /[A-Z]/.test(
                                value),

                        lower:
                            /[a-z]/.test(
                                value),

                        number:
                            /\d/.test(
                                value),

                        special:
                            /[^A-Za-z0-9]/.test(
                                value)
                    };

                setRequirement(
                    requirements.length,
                    checks.length);

                setRequirement(
                    requirements.upper,
                    checks.upper);

                setRequirement(
                    requirements.lower,
                    checks.lower);

                setRequirement(
                    requirements.number,
                    checks.number);

                setRequirement(
                    requirements.special,
                    checks.special);

                var score =
                    Object.keys(
                        checks)
                        .filter(
                            function (key) {
                                return checks[key];
                            })
                        .length;

                strengthBar.className =
                    "";

                if (!value) {
                    strengthBar.style.width =
                        "0%";

                    strengthText.textContent =
                        "—";
                }
                else if (score <= 2) {
                    strengthBar.style.width =
                        "35%";

                    strengthBar.classList.add(
                        "weak");

                    strengthText.textContent =
                        "Слаба";
                }
                else if (score <= 4) {
                    strengthBar.style.width =
                        "68%";

                    strengthBar.classList.add(
                        "medium");

                    strengthText.textContent =
                        "Добра";
                }
                else {
                    strengthBar.style.width =
                        "100%";

                    strengthBar.classList.add(
                        "strong");

                    strengthText.textContent =
                        "Силна";
                }

                evaluatePasswordMatch();
            }


            function evaluatePasswordMatch() {
                if (
                    !password ||
                    !confirmPassword ||
                    !matchIndicator
                ) {
                    return;
                }

                var confirmation =
                    confirmPassword.value || "";

                matchIndicator.classList.remove(
                    "valid",
                    "invalid");

                if (!confirmation) {
                    matchIndicator.textContent =
                        "";

                    return;
                }

                if (
                    password.value ===
                    confirmation
                ) {
                    matchIndicator.classList.add(
                        "valid");

                    matchIndicator.textContent =
                        "Лозинките се совпаѓаат.";
                }
                else {
                    matchIndicator.classList.add(
                        "invalid");

                    matchIndicator.textContent =
                        "Лозинките не се совпаѓаат.";
                }
            }


            var toggleButtons =
                document.querySelectorAll(
                    ".reset-password-toggle");

            Array.prototype.forEach.call(
                toggleButtons,
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            var targetId =
                                button.getAttribute(
                                    "data-password-target");

                            var input =
                                document.getElementById(
                                    targetId);

                            if (!input) {
                                return;
                            }

                            var isHidden =
                                input.type ===
                                "password";

                            input.type =
                                isHidden
                                    ? "text"
                                    : "password";

                            button.textContent =
                                isHidden
                                    ? "HIDE"
                                    : "SHOW";

                            button.setAttribute(
                                "aria-pressed",
                                isHidden
                                    ? "true"
                                    : "false");

                            button.setAttribute(
                                "aria-label",
                                isHidden
                                    ? "Сокриј лозинка"
                                    : "Прикажи лозинка");
                        });
                });


            if (password) {
                password.addEventListener(
                    "input",
                    evaluatePassword);
            }

            if (confirmPassword) {
                confirmPassword.addEventListener(
                    "input",
                    evaluatePasswordMatch);
            }


            if (
                form &&
                submitButton &&
                submitButtonText
            ) {
                form.addEventListener(
                    "submit",
                    function () {

                        if (
                            typeof $ !== "undefined" &&
                            $.validator &&
                            !$(form).valid()
                        ) {
                            return;
                        }

                        submitButton.disabled =
                            true;

                        submitButtonText.textContent =
                            "Се зачувува...";
                    });
            }


            evaluatePassword();
            evaluatePasswordMatch();
        })();
    </script>
}


<style>
    .reset-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .reset-shell {
        display: grid;
        grid-template-columns: minmax(300px, 0.8fr) minmax(440px, 1.2fr);
        width: min(100%, 1000px);
        min-height: 760px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }


    /* =====================================================
       VISUAL
       ===================================================== */

    .reset-visual {
        position: relative;
        display: grid;
        min-width: 0;
        place-items: center;
        overflow: hidden;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient( circle at 50% 45%, rgba(214, 168, 75, 0.11), transparent 30% ), radial-gradient( circle at 5% 100%, rgba(61, 101, 166, 0.14), transparent 30% ), linear-gradient( 145deg, #151e2b, #0a0f17 57%, #06090e );
        isolation: isolate;
    }

        .reset-visual::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.25;
            background-image: linear-gradient( rgba(255, 255, 255, 0.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px );
            background-size: 44px 44px;
        }

    .reset-visual-content {
        position: relative;
        z-index: 3;
        max-width: 280px;
        text-align: center;
    }

    .reset-visual-label {
        display: block;
        margin-top: 1.8rem;
        color: var(--cinema-gold-light);
        font-size: 0.56rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

    .reset-visual-content > strong {
        display: block;
        margin-top: 0.55rem;
        color: var(--cinema-text);
        font-size: 1.4rem;
    }

    .reset-visual-content > p {
        margin: 0.55rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.75rem;
        line-height: 1.65;
    }


    /* LOCK */

    .reset-lock {
        position: relative;
        width: 100px;
        height: 120px;
        margin: 0 auto;
    }

    .reset-lock-shackle {
        position: absolute;
        top: 0;
        left: 23px;
        width: 54px;
        height: 62px;
        border: 5px solid var(--cinema-gold-light);
        border-bottom: 0;
        border-radius: 30px 30px 0 0;
        box-shadow: 0 0 25px rgba(214, 168, 75, 0.15);
    }

    .reset-lock-body {
        position: absolute;
        right: 5px;
        bottom: 0;
        left: 5px;
        height: 74px;
        border: 1px solid rgba(214, 168, 75, 0.30);
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.16), rgba(214, 168, 75, 0.055) );
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.30);
    }

        .reset-lock-body > span {
            position: absolute;
            top: 25px;
            left: 50%;
            width: 10px;
            height: 22px;
            border-radius: 50% 50% 4px 4px;
            background: var(--cinema-gold-light);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.26);
            transform: translateX(-50%);
        }


    /* ORBITS */

    .reset-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: reset-orbit-spin 26s linear infinite;
    }

        .reset-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.70);
        }

    .reset-orbit-large {
        width: 340px;
        height: 340px;
    }

    .reset-orbit-small {
        width: 235px;
        height: 235px;
        animation-direction: reverse;
        animation-duration: 18s;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .reset-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 6vw, 4rem);
        background: linear-gradient( 180deg, rgba(14, 19, 28, 0.99), rgba(8, 11, 17, 0.99) );
    }

    .reset-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .reset-brand:hover {
            color: var(--cinema-gold-light);
        }

        .reset-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       PROGRESS
       ===================================================== */

    .reset-progress {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
    }

    .reset-progress-step {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        opacity: 0.32;
    }

        .reset-progress-step.active,
        .reset-progress-step.completed {
            opacity: 1;
        }

        .reset-progress-step > span {
            display: grid;
            width: 29px;
            height: 29px;
            place-items: center;
            color: var(--cinema-text-muted);
            border: 1px solid var(--cinema-border-strong);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.02);
            font-size: 0.52rem;
            font-weight: 900;
        }

        .reset-progress-step.completed > span {
            color: #9ae8bd;
            border-color: rgba(66, 199, 131, 0.24);
            background: rgba(66, 199, 131, 0.07);
        }

        .reset-progress-step.active > span {
            color: var(--cinema-gold-light);
            border-color: rgba(214, 168, 75, 0.30);
            background: rgba(214, 168, 75, 0.07);
        }

        .reset-progress-step strong {
            color: var(--cinema-text-soft);
            font-size: 0.62rem;
        }

    .reset-progress-line {
        width: 36px;
        height: 1px;
        margin: 0 0.5rem;
        background: var(--cinema-border-strong);
    }

        .reset-progress-line.completed {
            background: rgba(66, 199, 131, 0.42);
        }

        .reset-progress-line.active {
            background: linear-gradient( 90deg, rgba(66, 199, 131, 0.45), rgba(214, 168, 75, 0.52) );
        }


    /* =====================================================
       HEADING
       ===================================================== */

    .reset-heading {
        margin-bottom: 1.7rem;
    }

        .reset-heading h1 {
            margin-bottom: 0.8rem;
            font-size: clamp( 2.2rem, 5vw, 3.2rem );
            line-height: 1.02;
            letter-spacing: -0.045em;
        }

        .reset-heading p {
            max-width: 500px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.84rem;
            line-height: 1.7;
        }


    /* =====================================================
       FORM
       ===================================================== */

    .reset-validation {
        margin-bottom: 1.1rem;
    }

        .reset-validation:empty {
            display: none;
        }

    .reset-code-error:empty {
        display: none;
    }

    .reset-input-wrapper {
        position: relative;
    }

    .reset-input {
        min-height: 52px;
        padding-left: 3rem;
    }

    .reset-password-field {
        padding-right: 4.7rem;
    }

    .reset-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        color: var(--cinema-text-muted);
        font-size: 0.72rem;
        font-weight: 800;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .reset-password-icon {
        font-size: 1.15rem;
    }

    .reset-password-toggle {
        position: absolute;
        z-index: 3;
        top: 50%;
        right: 0.85rem;
        padding: 0.25rem 0.4rem;
        color: var(--cinema-text-muted);
        border: 0;
        border-radius: 6px;
        outline: 0;
        background: transparent;
        font-size: 0.55rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        transform: translateY(-50%);
        transition: color var(--cinema-transition), background-color var(--cinema-transition);
    }

        .reset-password-toggle:hover {
            color: var(--cinema-gold-light);
            background: rgba(255, 255, 255, 0.04);
        }

        .reset-password-toggle:focus-visible {
            box-shadow: 0 0 0 3px rgba(214, 168, 75, 0.12);
        }


    /* =====================================================
       PASSWORD STRENGTH
       ===================================================== */

    .reset-strength {
        margin-top: 0.8rem;
    }

    .reset-strength-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.45rem;
        color: var(--cinema-text-muted);
        font-size: 0.65rem;
    }

        .reset-strength-header strong {
            color: var(--cinema-text-soft);
            font-size: 0.65rem;
        }

    .reset-strength-track {
        height: 4px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.07);
    }

    #passwordStrengthBar {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        transition: width 250ms ease, background-color 250ms ease;
    }

        #passwordStrengthBar.weak {
            background: var(--cinema-danger);
        }

        #passwordStrengthBar.medium {
            background: var(--cinema-warning);
        }

        #passwordStrengthBar.strong {
            background: var(--cinema-success);
        }


    /* =====================================================
       REQUIREMENTS
       ===================================================== */

    .reset-requirements {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0, 1fr) );
