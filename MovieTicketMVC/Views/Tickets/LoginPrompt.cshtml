@{
    ViewBag.Title = "Log In Required";

    var returnUrl = ViewBag.ReturnUrl as string;

    if (string.IsNullOrWhiteSpace(returnUrl) ||
        !Url.IsLocalUrl(returnUrl))
    {
        returnUrl = Url.Action("Buy", "Tickets");
    }

    var loginUrl = Url.Action("Login", "Account", new { returnUrl = returnUrl });
    var registerUrl = Url.Action("Register", "Account");
    var moviesUrl = Url.Action("Current", "Movies");
}

<div class="booking-gate-page" aria-labelledby="booking-gate-title">
    <section class="booking-gate-shell">
        <div class="booking-gate-showcase">
            <div class="booking-gate-orbit booking-gate-orbit-outer" aria-hidden="true"></div>
            <div class="booking-gate-orbit booking-gate-orbit-inner" aria-hidden="true"></div>

            <div class="booking-gate-showcase-copy">
                <div class="booking-gate-brand">
                    <a href="@Url.Action("Index", "Home")"
                       class="booking-gate-brand-link"
                       aria-label="MovieTicket - Home">
                        <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                             alt="MovieTicket"
                             width="170"
                             height="48"
                             decoding="async" />
                    </a>

                    <span class="booking-gate-brand-label">
                        RESERVATIONS
                    </span>
                </div>

                <h2>
                    Your Movie.<br />
                    <span class="cinema-text-gradient">Your Seat.</span>
                </h2>

                <p>
                    Choose the screening that works best for you
                    and reserve your seats in one place.
                </p>
            </div>

            <div class="booking-gate-art" aria-hidden="true">
                <div class="booking-gate-ticket">
                    <div class="booking-gate-ticket-heading">
                        <img src="@Url.Content("~/Content/Images/movieticket-logo.png")"
                             alt=""
                             width="135"
                             height="36"
                             decoding="async" />
                        <span>CINEMA TICKET</span>
                    </div>

                    <div class="booking-gate-ticket-center">
                        <span class="booking-gate-ticket-label">YOUR NEXT SCREENING</span>
                        <strong>Movie<br />Night</strong>
                    </div>

                    <div class="booking-gate-ticket-divider"></div>

                    <div class="booking-gate-ticket-details">
                        <span>MOVIE</span>
                        <span>SHOWTIME</span>
                        <span>SEAT</span>
                    </div>

                    <div class="booking-gate-ticket-bars">
                        @for (var i = 0; i < 24; i++)
                        {
                            <span></span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="booking-gate-content">
            <div class="booking-gate-content-inner">
                <div class="booking-gate-lock" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         width="25"
                         height="25"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="4.5" y="10.5" width="15" height="10.5" rx="2.2"></rect>
                        <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path>
                        <path d="M12 14.5v2.5"></path>
                    </svg>
                </div>

                <div class="cinema-eyebrow booking-gate-eyebrow">ONE MORE STEP</div>

                <h1 id="booking-gate-title">
                    Log In to
                    <span class="cinema-text-gradient">Book Your Tickets.</span>
                </h1>

                <p class="booking-gate-description">
                    A MovieTicket account is required to make a reservation.
                    Log in or create a new account to continue.
                </p>

                <div class="booking-gate-actions">
                    <a href="@loginUrl" class="btn btn-primary booking-gate-primary">
                        <span>Log In</span>
                        <span aria-hidden="true">→</span>
                    </a>

                    <a href="@registerUrl" class="btn btn-outline-secondary booking-gate-secondary">
                        Create Account
                    </a>
                </div>

                <div class="booking-gate-return-note">
                    <div class="booking-gate-note-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             width="19"
                             height="19"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.9"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M20 11a8 8 0 1 1-3.1-6.3"></path>
                            <path d="m9 11 3 3 8-8"></path>
                        </svg>
                    </div>

                    <p>
                        <strong>Pick Up Where You Left Off.</strong>
                        After logging in successfully, you will automatically
                        return to the movie and seat selection page.
                    </p>
                </div>

                <a href="@moviesUrl" class="booking-gate-back">
                    <span aria-hidden="true">←</span>
                    Continue Browsing Movies
                </a>

                <p class="booking-gate-footnote">
                    After booking, your tickets will be available under "My Tickets".
                    If you create a new account, select "Buy Tickets" to continue.
                </p>
            </div>
        </div>
    </section>
</div>

<style>
    .booking-gate-page {
        width: 100%;
        min-width: 0;
    }

    .booking-gate-shell {
        display: grid;
        grid-template-columns: minmax(0, 1.04fr) minmax(0, .96fr);
        width: min(100%, 1120px);
        min-height: 585px;
        margin: 0 auto;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #0b1018;
        box-shadow: var(--cinema-shadow-lg);
    }

    .booking-gate-showcase {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2.1rem;
        min-width: 0;
        padding: clamp(2.25rem, 4vw, 3.75rem);
        overflow: hidden;
        isolation: isolate;
        background: radial-gradient(circle at 5% 5%, rgba(214,168,75,.13), transparent 40%), radial-gradient(circle at 100% 100%, rgba(60,102,169,.18), transparent 47%), linear-gradient(145deg, #19212d 0%, #0d1420 54%, #090d15 100%);
    }

        .booking-gate-showcase::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: .36;
            background-image: linear-gradient(rgba(255,255,255,.023) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.023) 1px, transparent 1px);
            background-size: 45px 45px;
            -webkit-mask-image: linear-gradient(135deg, #000, transparent 82%);
            mask-image: linear-gradient(135deg, #000, transparent 82%);
            pointer-events: none;
        }

        .booking-gate-showcase::after {
            position: absolute;
            z-index: -1;
            right: -150px;
            bottom: -220px;
            width: 590px;
            height: 590px;
            border: 1px solid rgba(214,168,75,.08);
            border-radius: 50%;
            content: "";
            pointer-events: none;
        }

    .booking-gate-showcase-copy {
        position: relative;
        z-index: 2;
        max-width: 480px;
    }

    .booking-gate-kicker {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        color: #f0d28b;
        font-size: .73rem;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .booking-gate-kicker-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        border-radius: 50%;
        background: var(--cinema-gold);
        box-shadow: 0 0 0 5px rgba(214,168,75,.1);
    }

    .booking-gate-showcase-copy h2 {
        margin: 1.8rem 0 1.2rem;
        color: var(--cinema-text);
        font-size: clamp(2.6rem, 4.5vw, 4.15rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -.057em;
    }

    .booking-gate-showcase-copy p {
        max-width: 430px;
        margin: 0;
        color: #c1cad7;
        font-size: .99rem;
        line-height: 1.8;
    }

    .booking-gate-orbit {
        position: absolute;
        z-index: 0;
        border: 1px solid rgba(214,168,75,.08);
        border-radius: 50%;
        pointer-events: none;
    }

    .booking-gate-orbit-outer {
        right: -110px;
        bottom: -85px;
        width: 425px;
        height: 425px;
    }

    .booking-gate-orbit-inner {
        right: -18px;
        bottom: 4px;
        width: 255px;
        height: 255px;
    }

    .booking-gate-orbit-outer::after {
        position: absolute;
        top: 12%;
        left: 15%;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--cinema-gold);
        box-shadow: 0 0 16px rgba(214,168,75,.6);
        content: "";
    }

    .booking-gate-art {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: flex-end;
        padding: 0 1rem 0 0;
        pointer-events: none;
    }

    .booking-gate-ticket {
        position: relative;
        width: min(100%, 335px);
        padding: 1.25rem 1.45rem 1.3rem;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 22px;
        background: linear-gradient(150deg, #1d2839 0%, #111824 60%, #0c111b 100%);
        box-shadow: 0 22px 60px rgba(0,0,0,.38), 0 0 45px rgba(214,168,75,.045);
        transform: rotate(-4deg);
        animation: booking-gate-ticket-float 7s ease-in-out infinite;
    }

        .booking-gate-ticket::before,
        .booking-gate-ticket::after {
            position: absolute;
            top: 67%;
            width: 22px;
            height: 22px;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 50%;
            background: #101826;
            content: "";
            transform: translateY(-50%);
        }

        .booking-gate-ticket::before {
            left: -12px;
        }

        .booking-gate-ticket::after {
            right: -12px;
        }

    .booking-gate-ticket-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .7rem;
    }

        .booking-gate-ticket-heading img {
            display: block;
            max-width: 55%;
            height: 36px;
            object-fit: contain;
            object-position: left center;
        }

        .booking-gate-ticket-heading > span {
            padding: .3rem .55rem;
            border: 1px solid rgba(214,168,75,.29);
            border-radius: 999px;
            color: #f0cb76;
            font-size: .62rem;
            font-weight: 800;
            white-space: nowrap;
        }

    .booking-gate-ticket-center {
        padding: 2.15rem 0 1.7rem;
    }

    .booking-gate-ticket-label {
        display: block;
        margin-bottom: .65rem;
        color: #e0b454;
        font-size: .65rem;
        font-weight: 800;
        letter-spacing: .13em;
    }

    .booking-gate-ticket-center strong {
        display: block;
        color: #f5f7fb;
        font-size: 1.7rem;
        line-height: 1.12;
        letter-spacing: -.04em;
    }

    .booking-gate-ticket-divider {
        height: 1px;
        background: repeating-linear-gradient(90deg, rgba(255,255,255,.18) 0 7px, transparent 7px 14px);
    }

    .booking-gate-ticket-details {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .5rem;
        padding: 1.1rem 0;
    }

        .booking-gate-ticket-details span {
            color: #a6b1c0;
            font-size: .64rem;
            font-weight: 800;
            letter-spacing: .05em;
        }

    .booking-gate-ticket-bars {
        display: flex;
        justify-content: center;
        gap: 3px;
        height: 25px;
        opacity: .77;
    }

        .booking-gate-ticket-bars span {
            display: block;
            width: 3px;
            background: #c8d0db;
        }

            .booking-gate-ticket-bars span:nth-child(2n) {
                width: 1px;
            }

            .booking-gate-ticket-bars span:nth-child(3n) {
                width: 5px;
            }

    .booking-gate-content {
        display: grid;
        place-items: center;
        min-width: 0;
        padding: clamp(2.2rem, 4.4vw, 4.25rem);
        background: linear-gradient(180deg, #0c111a, #090d14);
    }

    .booking-gate-content-inner {
        width: 100%;
        max-width: 405px;
    }

    .booking-gate-lock {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        margin-bottom: 1.65rem;
        border: 1px solid rgba(214,168,75,.28);
        border-radius: 17px;
        background: linear-gradient(145deg, rgba(214,168,75,.11), rgba(214,168,75,.025));
        color: var(--cinema-gold-light);
    }

    .booking-gate-eyebrow {
        margin-bottom: .75rem;
    }

    .booking-gate-content h1 {
        margin: 0 0 1.1rem;
        color: var(--cinema-text);
        font-size: clamp(2.25rem, 3.2vw, 3.1rem);
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -.05em;
    }

        .booking-gate-content h1 span {
            display: block;
        }

    .booking-gate-description {
        margin: 0 0 1.65rem;
        color: #bfc8d5;
        font-size: .96rem;
        line-height: 1.75;
    }

    .booking-gate-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .7rem;
    }

        .booking-gate-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 49px;
            padding: .7rem .95rem;
            font-size: .89rem;
            font-weight: 750;
            white-space: nowrap;
        }

    .booking-gate-primary {
        justify-content: space-between !important;
        gap: .65rem;
    }

        .booking-gate-primary > span:last-child,
        .booking-gate-back > span {
            transition: transform var(--cinema-transition);
        }

        .booking-gate-primary:hover > span:last-child {
            transform: translateX(4px);
        }

    .booking-gate-return-note {
        display: flex;
        align-items: flex-start;
        gap: .8rem;
        margin: 1.75rem 0 1.3rem;
        padding: 1rem;
        border: 1px solid rgba(66,199,131,.2);
        border-radius: 14px;
        background: rgba(66,199,131,.045);
    }

    .booking-gate-note-icon {
        display: grid;
        flex: 0 0 30px;
        place-items: center;
        width: 30px;
        height: 30px;
        color: #8fe1b3;
    }

    .booking-gate-return-note p {
        margin: 0;
        color: #bac9c5;
        font-size: .82rem;
        line-height: 1.65;
    }

    .booking-gate-return-note strong {
        display: block;
        margin-bottom: .2rem;
        color: #e5f0e9;
        font-size: .87rem;
        font-weight: 750;
    }

    .booking-gate-back {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        color: #c5cedc;
        font-size: .85rem;
        font-weight: 650;
        text-decoration: none;
    }

        .booking-gate-back:hover {
            color: var(--cinema-gold-light);
        }

            .booking-gate-back:hover > span {
                transform: translateX(-4px);
            }

    .booking-gate-footnote {
        margin: 1.35rem 0 0;
        padding-top: 1.15rem;
        border-top: 1px solid var(--cinema-border);
        color: #9ba7b8;
        font-size: .78rem;
        line-height: 1.7;
    }

    .booking-gate-page a:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 4px;
    }

    @@keyframes booking-gate-ticket-float {
        0%, 100% {
            transform: rotate(-4deg) translateY(0);
        }

        50% {
            transform: rotate(-2deg) translateY(-9px);
        }
    }

    @@media (max-width: 1020px) {
        .booking-gate-shell {
            grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
        }

        .booking-gate-showcase,
        .booking-gate-content {
            padding: 2.4rem;
        }

        .booking-gate-showcase-copy h2 {
            font-size: clamp(2.35rem, 4.5vw, 3.15rem);
        }

        .booking-gate-ticket {
            width: min(100%, 300px);
        }
    }

    @@media (max-width: 780px) {
        .booking-gate-shell {
            grid-template-columns: minmax(0, 1fr);
            max-width: 650px;
        }

        .booking-gate-showcase {
            gap: 0;
            padding: 2rem 2rem 1.85rem;
        }

        .booking-gate-showcase-copy h2 {
            margin: 1rem 0 .9rem;
            font-size: clamp(2rem, 6vw, 2.75rem);
        }

        .booking-gate-showcase-copy p {
            font-size: .91rem;
        }

        .booking-gate-art,
        .booking-gate-orbit {
            display: none;
        }

        .booking-gate-content {
            padding: 2.25rem 2rem;
        }

        .booking-gate-content-inner {
            max-width: none;
        }

        .booking-gate-lock {
            width: 48px;
            height: 48px;
            margin-bottom: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .booking-gate-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .booking-gate-showcase,
        .booking-gate-content {
            padding: 1.6rem 1.25rem;
        }

        .booking-gate-showcase-copy h2 {
            font-size: clamp(1.85rem, 8vw, 2.3rem);
        }

        .booking-gate-content h1 {
            font-size: clamp(2rem, 8vw, 2.35rem);
        }

        .booking-gate-actions {
            grid-template-columns: minmax(0, 1fr);
        }

            .booking-gate-actions .btn {
                width: 100%;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .booking-gate-ticket {
            animation: none;
            transform: none;
        }

        .booking-gate-primary > span:last-child,
        .booking-gate-back > span {
            transition: none;
        }
    }

    .booking-gate-brand {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        position: relative;
        z-index: 3;
    }

    .booking-gate-brand-link {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        text-decoration: none;
    }

        .booking-gate-brand-link img {
            display: block;
            width: 170px;
            max-width: 100%;
            height: 48px;
            object-fit: contain;
            object-position: left center;
        }

    .booking-gate-brand-label {
        padding: 0.4rem 0.75rem;
        border: 1px solid rgba(214, 168, 75, 0.25);
        border-radius: 999px;
        background: rgba(214, 168, 75, 0.07);
        color: #f0cb76;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        white-space: nowrap;
    }

    .booking-gate-brand-link:focus-visible {
        outline: 2px solid #f0cb76;
        outline-offset: 4px;
        border-radius: 8px;
    }

    @@media (max-width: 480px) {
        .booking-gate-brand {
            gap: 0.65rem;
        }

        .booking-gate-brand-link img {
            width: 145px;
            height: 42px;
        }

        .booking-gate-brand-label {
            font-size: 0.6rem;
            padding: 0.3rem 0.55rem;
        }
    }
</style>