@{
    ViewBag.Title = "Потребна е најава";

    var returnUrl =
        ViewBag.ReturnUrl as string
        ?? Url.Action("Buy", "Tickets");
}

<main class="login-prompt-page"
      aria-labelledby="login-prompt-title">

    <section class="login-prompt-shell">

        <div class="login-prompt-grid"
             aria-hidden="true">
        </div>

        <div class="login-prompt-glow login-prompt-glow-one"
             aria-hidden="true">
        </div>

        <div class="login-prompt-glow login-prompt-glow-two"
             aria-hidden="true">
        </div>


        <a class="login-prompt-brand"
           href="@Url.Action("Index", "Home")">

            <span></span>

            MOVIETICKET
        </a>


        <div class="login-prompt-visual"
             aria-hidden="true">

            <div class="login-prompt-orbit
                        login-prompt-orbit-large">
            </div>

            <div class="login-prompt-orbit
                        login-prompt-orbit-small">
            </div>


            <div class="login-prompt-ticket">

                <div class="login-prompt-ticket-top">

                    <span>
                        MOVIETICKET
                    </span>

                    <strong>
                        ACCESS
                    </strong>

                </div>


                <div class="login-prompt-ticket-body">

                    <div class="login-prompt-ticket-lock">

                        <div class="login-prompt-lock-shackle">
                        </div>

                        <div class="login-prompt-lock-body">

                            <span></span>

                        </div>

                    </div>

                </div>


                <div class="login-prompt-ticket-divider">
                </div>


                <div class="login-prompt-ticket-status">

                    <span></span>

                    SIGN IN REQUIRED

                </div>

            </div>


            <div class="login-prompt-spark
                        login-prompt-spark-one">
            </div>

            <div class="login-prompt-spark
                        login-prompt-spark-two">
            </div>

        </div>


        <div class="login-prompt-content">

            <div class="cinema-eyebrow">
                CONTINUE TO CHECKOUT
            </div>

            <h1 id="login-prompt-title">
                Најави се за да го
                <span class="cinema-text-gradient">
                    резервираш местото
                </span>
            </h1>

            <p class="login-prompt-description">
                За купување билет потребен е MovieTicket
                профил. По успешното најавување ќе можеш
                да продолжиш кон процесот за избор на
                проекција и седишта.
            </p>


            <div class="login-prompt-info">

                <div class="login-prompt-info-icon"
                     aria-hidden="true">
                    ✓
                </div>

                <div>

                    <span>
                        YOUR BOOKING
                    </span>

                    <strong>
                        Продолжи без да го изгубиш flow-от
                    </strong>

                    <p>
                        По најавувањето MovieTicket ќе те
                        врати кон страницата од која
                        започна купувањето.
                    </p>

                </div>

            </div>


            <div class="login-prompt-actions">

                <a class="btn btn-primary
                          login-prompt-primary"
                   href="@Url.Action(
                       "Login",
                       "Account",
                       new
                       {
                           returnUrl = returnUrl
                       })">

                    <span>
                        Најави се
                    </span>

                    <span aria-hidden="true">
                        →
                    </span>

                </a>


                <a class="btn btn-outline-secondary
                          login-prompt-register"
                   href="@Url.Action(
                       "Register",
                       "Account")">

                    Креирај профил

                </a>

            </div>


            <div class="login-prompt-divider">

                <span>
                    OR
                </span>

            </div>


            <a class="login-prompt-browse"
               href="@Url.Action("Current", "Movies")">

                <span aria-hidden="true">
                    ←
                </span>

                Продолжи со разгледување филмови

            </a>


            <div class="login-prompt-security">

                <span aria-hidden="true">
                    ✓
                </span>

                <p>
                    Најавувањето е потребно за билетите да
                    бидат поврзани со твојот MovieTicket
                    профил и достапни во „Мои билети“.
                </p>

            </div>

        </div>

    </section>

</main>


<style>
    .login-prompt-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .login-prompt-shell {
        position: relative;
        width: min(100%, 860px);
        min-height: 690px;
        padding: clamp(2rem, 6vw, 4.5rem);
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 50% 19%, rgba(214, 168, 75, 0.11), transparent 30% ), radial-gradient( circle at 0% 100%, rgba(58, 100, 168, 0.12), transparent 32% ), linear-gradient( 145deg, #151e2b, #090e16 58%, #06090e );
        box-shadow: var(--cinema-shadow-lg);
        isolation: isolate;
    }


    /* =====================================================
       BACKGROUND
       ===================================================== */

    .login-prompt-grid {
        position: absolute;
        z-index: -3;
        inset: 0;
        opacity: 0.24;
        background-image: linear-gradient( rgba(255, 255, 255, 0.021) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.021) 1px, transparent 1px );
        background-size: 48px 48px;
        mask-image: linear-gradient( 180deg, #000, transparent 82% );
    }

    .login-prompt-glow {
        position: absolute;
        z-index: -2;
        border-radius: 50%;
        filter: blur(28px);
        pointer-events: none;
    }

    .login-prompt-glow-one {
        top: -180px;
        right: -120px;
        width: 450px;
        height: 450px;
        background: rgba(214, 168, 75, 0.065);
    }

    .login-prompt-glow-two {
        bottom: -200px;
        left: -130px;
        width: 460px;
        height: 460px;
        background: rgba(58, 100, 168, 0.07);
    }


    /* =====================================================
       BRAND
       ===================================================== */

    .login-prompt-brand {
        position: relative;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 2.1rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .login-prompt-brand:hover {
            color: var(--cinema-gold-light);
        }

        .login-prompt-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       VISUAL
       ===================================================== */

    .login-prompt-visual {
        position: relative;
        display: grid;
        width: 280px;
        height: 210px;
        margin: 0 auto 1.8rem;
        place-items: center;
    }

    .login-prompt-ticket {
        position: relative;
        z-index: 4;
        width: 185px;
        padding: 1.15rem;
        overflow: hidden;
        text-align: left;
        border: 1px solid rgba(214, 168, 75, 0.26);
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(31, 40, 55, 0.90), rgba(9, 13, 20, 0.95) );
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.38), 0 0 45px rgba(214, 168, 75, 0.07);
        transform: rotate(-3deg);
        animation: login-prompt-ticket-float 6s ease-in-out infinite;
    }

        .login-prompt-ticket::before,
        .login-prompt-ticket::after {
            position: absolute;
            top: 63%;
            width: 20px;
            height: 20px;
            content: "";
            border-radius: 50%;
            background: #0a0e15;
        }

        .login-prompt-ticket::before {
            left: -11px;
        }

        .login-prompt-ticket::after {
            right: -11px;
        }

    .login-prompt-ticket-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .login-prompt-ticket-top span {
            color: var(--cinema-text-muted);
            font-size: 0.43rem;
            font-weight: 900;
            letter-spacing: 0.12em;
        }

        .login-prompt-ticket-top strong {
            color: var(--cinema-gold-light);
            font-size: 0.43rem;
            letter-spacing: 0.1em;
        }

    .login-prompt-ticket-body {
        display: grid;
        height: 92px;
        place-items: center;
    }


    /* =====================================================
       LOCK
       ===================================================== */

    .login-prompt-ticket-lock {
        position: relative;
        width: 48px;
        height: 59px;
    }

    .login-prompt-lock-shackle {
        position: absolute;
        top: 0;
        left: 11px;
        width: 27px;
        height: 31px;
        border: 3px solid var(--cinema-gold-light);
        border-bottom: 0;
        border-radius: 18px 18px 0 0;
    }

    .login-prompt-lock-body {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 36px;
        border: 1px solid rgba(214, 168, 75, 0.28);
        border-radius: 10px;
        background: rgba(214, 168, 75, 0.09);
    }

        .login-prompt-lock-body > span {
            position: absolute;
            top: 11px;
            left: 50%;
            width: 6px;
            height: 14px;
            border-radius: 50% 50% 3px 3px;
            background: var(--cinema-gold-light);
            transform: translateX(-50%);
        }


    /* =====================================================
       TICKET DETAILS
       ===================================================== */

    .login-prompt-ticket-divider {
        height: 1px;
        margin-bottom: 0.9rem;
        background: repeating-linear-gradient( 90deg, rgba(255, 255, 255, 0.15) 0, rgba(255, 255, 255, 0.15) 6px, transparent 6px, transparent 12px );
    }

    .login-prompt-ticket-status {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--cinema-text-muted);
        font-size: 0.43rem;
        font-weight: 900;
        letter-spacing: 0.08em;
    }

        .login-prompt-ticket-status > span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--cinema-warning);
            box-shadow: 0 0 10px rgba(246, 200, 95, 0.60);
        }


    /* =====================================================
       ORBITS
       ===================================================== */

    .login-prompt-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: login-prompt-orbit-spin 25s linear infinite;
    }

        .login-prompt-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 16px rgba(214, 168, 75, 0.65);
        }

    .login-prompt-orbit-large {
        width: 210px;
        height: 210px;
    }

    .login-prompt-orbit-small {
        width: 155px;
        height: 155px;
        animation-direction: reverse;
        animation-duration: 18s;
    }


    /* =====================================================
       SPARKS
       ===================================================== */

    .login-prompt-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cinema-gold-light);
        box-shadow: 0 0 12px rgba(214, 168, 75, 0.60);
        animation: login-prompt-spark-pulse 2.8s ease-in-out infinite;
    }

    .login-prompt-spark-one {
        top: 26px;
        left: 30px;
    }

    .login-prompt-spark-two {
        right: 31px;
        bottom: 28px;
        animation-delay: 1s;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .login-prompt-content {
        position: relative;
        z-index: 5;
    }

        .login-prompt-content h1 {
            max-width: 720px;
            margin: 0 auto 1rem;
            font-size: clamp( 2.6rem, 6vw, 4.2rem );
            line-height: 0.98;
            letter-spacing: -0.055em;
        }

    .login-prompt-description {
        max-width: 610px;
        margin: 0 auto 1.8rem;
        color: var(--cinema-text-muted);
        font-size: 0.88rem;
        line-height: 1.75;
    }


    /* =====================================================
       INFORMATION
       ===================================================== */

    .login-prompt-info {
        display: flex;
        max-width: 580px;
        align-items: flex-start;
        gap: 0.9rem;
        margin: 0 auto 1.7rem;
        padding: 1rem;
        text-align: left;
        border: 1px solid rgba(66, 199, 131, 0.14);
        border-radius: 14px;
        background: rgba(66, 199, 131, 0.035);
    }

    .login-prompt-info-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.19);
        border-radius: 12px;
        background: rgba(66, 199, 131, 0.06);
        font-size: 0.7rem;
        font-weight: 900;
    }

    .login-prompt-info
    div:last-child > span {
        display: block;
        margin-bottom: 0.15rem;
        color: #8fd8ad;
        font-size: 0.5rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .login-prompt-info strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.8rem;
    }

    .login-prompt-info p {
        margin: 0.25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.67rem;
        line-height: 1.55;
    }


    /* =====================================================
       ACTIONS
       ===================================================== */

    .login-prompt-actions {
        display: flex;
        max-width: 580px;
        justify-content: center;
        gap: 0.7rem;
        margin: 0 auto;
    }

        .login-prompt-actions .btn {
            min-height: 50px;
        }

    .login-prompt-primary {
        display: inline-flex;
        min-width: 210px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .login-prompt-primary > span:last-child {
            transition: transform var(--cinema-transition);
        }

        .login-prompt-primary:hover > span:last-child {
            transform: translateX(5px);
        }

    .login-prompt-register {
        min-width: 170px;
    }


    /* =====================================================
       DIVIDER
       ===================================================== */

    .login-prompt-divider {
        position: relative;
        max-width: 580px;
        height: 20px;
        margin: 1.25rem auto 0.7rem;
        text-align: center;
    }

        .login-prompt-divider::before {
            position: absolute;
            top: 50%;
            right: 0;
            left: 0;
            height: 1px;
            content: "";
            background: linear-gradient( 90deg, transparent, var(--cinema-border-strong), transparent );
        }

        .login-prompt-divider > span {
            position: relative;
            z-index: 2;
            display: inline-block;
            padding: 0 0.7rem;
            color: var(--cinema-text-muted);
            background: #090e16;
            font-size: 0.45rem;
            font-weight: 900;
            letter-spacing: 0.12em;
        }


    /* =====================================================
       BROWSE
       ===================================================== */

    .login-prompt-browse {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--cinema-text-muted);
        font-size: 0.7rem;
        font-weight: 600;
    }

        .login-prompt-browse > span {
            transition: transform var(--cinema-transition);
        }

        .login-prompt-browse:hover {
            color: var(--cinema-gold-light);
        }

            .login-prompt-browse:hover > span {
                transform: translateX(-4px);
            }


    /* =====================================================
       SECURITY
       ===================================================== */

    .login-prompt-security {
        display: flex;
        max-width: 580px;
        align-items: flex-start;
        gap: 0.6rem;
        margin: 1.6rem auto 0;
        padding-top: 1.2rem;
        text-align: left;
        border-top: 1px solid var(--cinema-border);
    }

        .login-prompt-security > span {
            display: grid;
            flex: 0 0 25px;
            width: 25px;
            height: 25px;
            place-items: center;
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.18);
            border-radius: 50%;
            background: rgba(66, 199, 131, 0.055);
            font-size: 0.55rem;
            font-weight: 900;
        }

        .login-prompt-security p {
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.65rem;
            line-height: 1.55;
        }


    /* =====================================================
       ANIMATIONS
       ===================================================== */

    @@keyframes login-prompt-orbit-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes login-prompt-ticket-float {
        0%,
        100% {
            transform: rotate(-3deg) translateY(0);
        }

        50% {
            transform: rotate(-1deg) translateY(-10px);
        }
    }

    @@keyframes login-prompt-spark-pulse {
        0%,
        100% {
            opacity: 0.25;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 575.98px) {
        .login-prompt-shell {
            min-height: 0;
            padding: 2rem 1.1rem;
            border-radius: var(--cinema-radius-lg);
        }

        .login-prompt-visual {
            width: 220px;
            height: 180px;
        }

        .login-prompt-orbit-large {
            width: 180px;
            height: 180px;
        }

        .login-prompt-orbit-small {
            width: 132px;
            height: 132px;
        }

        .login-prompt-ticket {
            width: 160px;
        }

        .login-prompt-content h1 {
            font-size: 2.4rem;
        }

        .login-prompt-actions {
            align-items: stretch;
            flex-direction: column;
        }

            .login-prompt-actions .btn {
                width: 100%;
            }

        .login-prompt-primary,
        .login-prompt-register {
            min-width: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .login-prompt-orbit,
        .login-prompt-ticket,
        .login-prompt-spark {
            animation: none;
        }
    }
</style>