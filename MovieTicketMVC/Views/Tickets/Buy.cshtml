@using System
@using System.Collections.Generic
@using System.Linq
@model MovieTicketMVC.Models.Ticket

@{
    ViewBag.Title = "Buy Tickets";

    var currentMovies =
        ViewBag.CurrentMovies as List<MovieTicketMVC.Models.Movie>
        ?? new List<MovieTicketMVC.Models.Movie>();

    var comingSoonMovies =
        ViewBag.ComingSoonMovies as List<MovieTicketMVC.Models.Movie>
        ?? new List<MovieTicketMVC.Models.Movie>();

    var userSeats =
        string.IsNullOrWhiteSpace(Model.SelectedSeats)
            ? new string[0]
            : Model.SelectedSeats
                .Split(
                    new[] { ',' },
                    StringSplitOptions.RemoveEmptyEntries)
                .Select(seat =>
                    seat.Trim().ToUpperInvariant())
                .ToArray();

    var selectedDayValue =
        Model.SelectedDay != default(DateTime)
            ? Model.SelectedDay.ToString("yyyy-MM-dd")
            : string.Empty;
}

<div class="booking-page"
     aria-labelledby="booking-title">

    <section class="booking-hero">

        <div class="booking-hero-content">

            <div class="cinema-eyebrow">
                BOOK TICKETS
            </div>

            <h1 id="booking-title">
                Reserve Your
                <span class="cinema-text-gradient">
                    Seat
                </span>
            </h1>

            <p>
                Choose a movie, showtime, and seats.
                Check available seats and confirm your booking.
                Seat availability updates in real time.
            </p>

        </div>

    </section>


    <section class="booking-progress"
             aria-label="Booking steps">

        <div class="booking-step active"
             id="bookingStepMovie">

            <span class="booking-step-number">
                01
            </span>

            <div>
                <strong>
                    Movie &amp; Showtime
                </strong>

                <small>
                    Select a Screening
                </small>
            </div>

        </div>

        <div class="booking-progress-line"></div>

        <div class="booking-step"
             id="bookingStepSeats">

            <span class="booking-step-number">
                02
            </span>

            <div>
                <strong>
                    Seats
                </strong>

                <small>
                    Choose a Seat
                </small>
            </div>

        </div>

        <div class="booking-progress-line"></div>

        <div class="booking-step"
             id="bookingStepConfirm">

            <span class="booking-step-number">
                03
            </span>

            <div>
                <strong>
                    Confirmation
                </strong>

                <small>
                    Complete Booking
                </small>
            </div>

        </div>

    </section>


    @using (Html.BeginForm(
        "Buy",
        "Tickets",
        FormMethod.Post,
        new
        {
            id = "ticketForm",
            role = "form",
            @class = "booking-form"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
                           true,
                           "",
                           new
                           {
                               @class =
                                   "validation-summary-errors booking-validation"
                           })


        <div class="booking-layout">

            <div class="booking-main">

                <section class="cinema-panel booking-selection-panel">

                    <div class="booking-section-heading">

                        <span class="booking-section-number">
                            01
                        </span>

                        <div>
                            <h2>
                                Select a Screening
                            </h2>

                            <p>
                                Choose a movie, date, and showtime.
                            </p>
                        </div>

                    </div>


                    <div class="booking-selection-grid">

                        <div class="form-group booking-field-full">

                            <label for="MovieId"
                                   class="form-label">
                                Movie
                            </label>

                            <select id="MovieId"
                                    name="MovieId"
                                    class="form-select booking-movie-select"
                                    required>

                                <option value="">
                                    Select a Movie
                                </option>

                                @if (currentMovies.Any())
                                {
                                    <optgroup label="Now Showing">

                                        @foreach (var movie in currentMovies)
                                        {
                                            var selected =
                                                Model.MovieId ==
                                                movie.Id;

                                            <option value="@movie.Id"
                                                    data-release="@movie.ReleaseDate.ToString("yyyy-MM-dd")"
                                                    @(selected ? "selected" : "")>
                                                @movie.Title
                                            </option>
                                        }

                                    </optgroup>
                                }

                                @if (comingSoonMovies.Any())
                                {
                                    <optgroup label="Coming Soon">

                                        @foreach (var movie in comingSoonMovies)
                                        {
                                            var selected =
                                                Model.MovieId ==
                                                movie.Id;

                                            <option value="@movie.Id"
                                                    data-release="@movie.ReleaseDate.ToString("yyyy-MM-dd")"
                                                    @(selected ? "selected" : "")>
                                                @movie.Title
                                            </option>
                                        }

                                    </optgroup>
                                }

                            </select>

                            @Html.ValidationMessageFor(
                                               m => m.MovieId,
                                               "",
                                               new
                                               {
                                                   @class =
                                                       "text-danger"
                                               })

                        </div>


                        <div class="form-group">

                            <label for="SelectedDay"
                                   class="form-label">
                                Date
                            </label>

                            @Html.TextBox(
                                               "SelectedDay",
                                               selectedDayValue,
                                               new
                                               {
                                                   @class =
                                                       "form-control",
                                                   type =
                                                       "date",
                                                   id =
                                                       "SelectedDay",
                                                   required =
                                                       "required",
                                                   disabled =
                                                       "disabled"
                                               })

                            @Html.ValidationMessageFor(
                                               m => m.SelectedDay,
                                               "",
                                               new
                                               {
                                                   @class =
                                                       "text-danger"
                                               })

                            <small class="booking-date-hint">First select a movie, then choose a screening date.</small>

                        </div>


                        <div class="form-group">

                            <label for="SelectedTime"
                                   class="form-label">
                                Showtime
                            </label>

                            <select id="SelectedTime"
                                    name="SelectedTime"
                                    class="form-select"
                                    required
                                    disabled>

                                <option value="">
                                    Select a Showtime
                                </option>

                                <option value="10:00"
                                        @(Model.SelectedTime == "10:00" ? "selected" : "")>
                                    10:00
                                </option>

                                <option value="14:00"
                                        @(Model.SelectedTime == "14:00" ? "selected" : "")>
                                    14:00
                                </option>

                                <option value="18:00"
                                        @(Model.SelectedTime == "18:00" ? "selected" : "")>
                                    18:00
                                </option>

                                <option value="21:00"
                                        @(Model.SelectedTime == "21:00" ? "selected" : "")>
                                    21:00
                                </option>

                            </select>

                            @Html.ValidationMessageFor(
                                               m => m.SelectedTime,
                                               "",
                                               new
                                               {
                                                   @class =
                                                       "text-danger"
                                               })

                            <div id="timeErrorMessage"
                                 class="booking-inline-error"
                                 role="alert"
                                 aria-live="polite"
                                 hidden>
                            </div>

                        </div>

                    </div>

                </section>


                <section class="cinema-panel booking-seats-panel">

                    <div class="booking-section-heading">

                        <span class="booking-section-number">
                            02
                        </span>

                        <div>
                            <h2>
                                Select Seats
                            </h2>

                            <p>
                                Green seats are your selection.
                                Unavailable seats cannot
                                be booked.
                            </p>
                        </div>

                    </div>


                    <div class="booking-seat-legend">

                        <div class="booking-legend-item">

                            <span class="booking-legend-seat available">
                            </span>

                            <span>
                                Available
                            </span>

                        </div>

                        <div class="booking-legend-item">

                            <span class="booking-legend-seat premium">
                            </span>

                            <span>
                                Premium · 500 MKD
                            </span>

                        </div>

                        <div class="booking-legend-item">

                            <span class="booking-legend-seat selected">
                            </span>

                            <span>
                                Selected
                            </span>

                        </div>

                        <div class="booking-legend-item">

                            <span class="booking-legend-seat unavailable">
                            </span>

                            <span>
                                Unavailable
                            </span>

                        </div>

                    </div>


                    <div class="cinema-auditorium">

                        <div class="cinema-screen-wrapper">

                            <span>
                                CINEMA SCREEN
                            </span>

                            <div class="cinema-screen"></div>

                            <small>
                                Screen
                            </small>

                        </div>


                        <div class="seat-area">

                            <div class="seat-layout">

                                <div class="seat-map">

                                    @for (var row = 1;
                                          row <= 10;
                                          row++)
                                    {
                                        <div class="seat-row">

                                            <div class="row-label">
                                                @("R" + row)
                                            </div>

                                            @for (var col = 1;
                                                  col <= 5;
                                                  col++)
                                            {
                                                var seatId =
                                                    string.Format(
                                                        "R{0}C{1}",
                                                        row,
                                                        col);

                                                var selected =
                                                    userSeats.Contains(
                                                        seatId,
                                                        StringComparer.OrdinalIgnoreCase);

                                                var priceClass =
                                                    row <= 2
                                                        ? "premium-seat"
                                                        : "standard-seat";

                                                <button type="button"
                                                        class="seat-circle @priceClass @(selected ? "selected" : "")"
                                                        data-seat="@seatId"
                                                        data-row="@row"
                                                        data-column="@col"
                                                        title="Row @row, Seat @col"
                                                        aria-label="Row @row, Seat @col"
                                                        aria-pressed="@(selected ? "true" : "false")"
                                                        disabled>
                                                    @col
                                                </button>
                                            }

                                            <div class="aisle-spacer">
                                                <span>
                                                    AISLE
                                                </span>
                                            </div>

                                            @for (var col = 6;
                                                  col <= 10;
                                                  col++)
                                            {
                                                var seatId =
                                                    string.Format(
                                                        "R{0}C{1}",
                                                        row,
                                                        col);

                                                var selected =
                                                    userSeats.Contains(
                                                        seatId,
                                                        StringComparer.OrdinalIgnoreCase);

                                                var priceClass =
                                                    row <= 2
                                                        ? "premium-seat"
                                                        : "standard-seat";

                                                <button type="button"
                                                        class="seat-circle @priceClass @(selected ? "selected" : "")"
                                                        data-seat="@seatId"
                                                        data-row="@row"
                                                        data-column="@col"
                                                        title="Row @row, Seat @col"
                                                        aria-label="Row @row, Seat @col"
                                                        aria-pressed="@(selected ? "true" : "false")"
                                                        disabled>
                                                    @col
                                                </button>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        <input type="hidden"
                               id="SignalRConnectionId"
                               name="signalRConnectionId"
                               value="" />

                        <div id="selectedSeatsInputs">
                        </div>


                        <div id="seatErrorMessage"
                             class="booking-inline-error booking-seat-error"
                             role="alert"
                             aria-live="polite"
                             hidden>
                        </div>

                        @Html.ValidationMessage(
                                 "SelectedSeats",
                                 "",
                                 new { @class = "text-danger" })

                    </div>

                </section>


                <section class="cinema-panel booking-customer-panel">

                    <div class="booking-section-heading">

                        <span class="booking-section-number">
                            03
                        </span>

                        <div>
                            <h2>
                                Ticket Details
                            </h2>

                            <p>
                                Confirm your age category
                                before booking.
                            </p>
                        </div>

                    </div>


                    <fieldset class="booking-age-selector">

                        <legend>
                            Age Category
                        </legend>


                        <label class="booking-age-option"
                               for="AgeCategoryAdult">

                            @Html.RadioButtonFor(
                                               m => m.AgeCategory,
                                               "18+",
                                               new
                                               {
                                                   @class =
                                                       "booking-age-radio",
                                                   id =
                                                       "AgeCategoryAdult",
                                                   required =
                                                       "required"
                                               })

                            <span class="booking-age-card">

                                <span class="booking-age-icon adult">
                                    18+
                                </span>

                                <span>

                                    <strong>
                                        18 or Older
                                    </strong>

                                    <small>
                                        Can book movies
                                        rated 18+.
                                    </small>

                                </span>

                            </span>

                        </label>


                        <label class="booking-age-option"
                               for="AgeCategoryUnder18">

                            @Html.RadioButtonFor(
                                               m => m.AgeCategory,
                                               "Under18",
                                               new
                                               {
                                                   @class =
                                                       "booking-age-radio",
                                                   id =
                                                       "AgeCategoryUnder18",
                                                   required =
                                                       "required"
                                               })

                            <span class="booking-age-card">

                                <span class="booking-age-icon">
                                    U18
                                </span>

                                <span>

                                    <strong>
                                        Under 18
                                    </strong>

                                    <small>
                                        Movies rated 18+ cannot
                                        be booked.
                                    </small>

                                </span>

                            </span>

                        </label>


                        <div>
                            @Html.ValidationMessageFor(
                                               m => m.AgeCategory,
                                               "",
                                               new
                                               {
                                                   @class =
                                                       "text-danger"
                                               })
                        </div>

                    </fieldset>


                    <div class="booking-email-field">

                        <label for="Email"
                               class="form-label">
                            Ticket Email Address
                        </label>

                        @Html.TextBoxFor(
                                           m => m.Email,
                                           new
                                           {
                                               @class =
                                                   "form-control",
                                               id =
                                                   "Email",
                                               type =
                                                   "email",
                                               @readonly =
                                                   "readonly"
                                           })

                        <small>
                            Your confirmation and PDF ticket will
                            be sent to this email address.
                        </small>

                    </div>

                </section>

            </div>


            <aside class="booking-sidebar">

                <section class="booking-summary-card">

                    <div class="booking-summary-header">

                        <div>

                            <span>
                                YOUR BOOKING
                            </span>

                            <h2>
                                Booking
                            </h2>

                        </div>

                        <span class="booking-summary-ticket-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 9a3 3 0 0 0 0 6v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a3 3 0 0 1 0-6V6a2 2 0 0 0-2 2v3Z"></path>
                                <path d="M13 5v2m0 3v2m0 3v2m0 3v1"></path>
                            </svg>
                        </span>

                    </div>


                    <div class="booking-summary-movie">

                        <span>
                            MOVIE
                        </span>

                        <strong id="selectedMovieSummary">
                            Not Selected
                        </strong>

                    </div>


                    <div class="booking-summary-grid">

                        <div class="booking-summary-item">

                            <span>
                                DATE
                            </span>

                            <strong id="selectedDaySummary">
                                —
                            </strong>

                        </div>

                        <div class="booking-summary-item">

                            <span>
                                SHOWTIME
                            </span>

                            <strong id="selectedTimeSummary">
                                —
                            </strong>

                        </div>

                        <div class="booking-summary-item">

                            <span>
                                SEATS
                            </span>

                            <strong id="selectedSeatCount">
                                0
                            </strong>

                        </div>

                        <div class="booking-summary-item">

                            <span>
                                CATEGORY
                            </span>

                            <strong id="selectedAgeSummary">
                                —
                            </strong>

                        </div>

                    </div>


                    <div class="booking-summary-seats">

                        <span>
                            SELECTED SEATS
                        </span>

                        <div id="selectedSeatList"
                             class="booking-selected-seat-list">
                            <span class="booking-no-seats">
                                No Seats Selected
                            </span>
                        </div>

                    </div>


                    <div class="booking-price-breakdown">

                        <div>

                            <span>
                                Premium
                            </span>

                            <span>
                                500 MKD
                            </span>

                        </div>

                        <div>

                            <span>
                                Standard
                            </span>

                            <span>
                                250 MKD
                            </span>

                        </div>

                    </div>


                    <div class="booking-summary-total">

                        <span>
                            Total
                        </span>

                        <div>

                            <strong id="totalPrice">
                                0
                            </strong>

                            <small>
                                MKD
                            </small>

                        </div>

                    </div>


                    <button type="submit"
                            id="buyButton"
                            class="btn btn-primary booking-buy-button">

                        <span id="buyButtonText">
                            Confirm Booking
                        </span>

                        <span aria-hidden="true">
                            →
                        </span>

                    </button>


                    <div class="booking-summary-security">

                        <span aria-hidden="true">
                            ✓
                        </span>

                        <p>
                            Prices and availability are checked again
                            on the server before your
                            booking is saved.
                        </p>

                    </div>

                </section>

            </aside>

        </div>
    }

</div>


@section scripts
{
    <script src="@Url.Content("~/Scripts/jquery.signalR-2.4.3.min.js")"></script>
    <script src="@Url.Content("~/signalr/hubs")"></script>

    <script>
        $(function () {
            var movieSelect =
                document.getElementById("MovieId");

            var dayInput =
                document.getElementById("SelectedDay");

            var timeSelect =
                document.getElementById("SelectedTime");

            var ticketForm =
                document.getElementById("ticketForm");

            var signalRConnectionIdInput =
                document.getElementById("SignalRConnectionId");

            var buyButton =
                document.getElementById("buyButton");

            var buyButtonText =
                document.getElementById("buyButtonText");

            var selectedSeatsInputs =
                document.getElementById("selectedSeatsInputs");

            var totalPriceSpan =
                document.getElementById("totalPrice");

            var timeErrorMessage =
                document.getElementById("timeErrorMessage");

            var seatErrorMessage =
                document.getElementById("seatErrorMessage");

            var selectedMovieSummary =
                document.getElementById("selectedMovieSummary");

            var selectedDaySummary =
                document.getElementById("selectedDaySummary");

            var selectedTimeSummary =
                document.getElementById("selectedTimeSummary");

            var selectedSeatCount =
                document.getElementById("selectedSeatCount");

            var selectedSeatList =
                document.getElementById("selectedSeatList");

            var selectedAgeSummary =
                document.getElementById("selectedAgeSummary");

            var bookingStepMovie =
                document.getElementById("bookingStepMovie");

            var bookingStepSeats =
                document.getElementById("bookingStepSeats");

            var bookingStepConfirm =
                document.getElementById("bookingStepConfirm");

            var ageInputs =
                Array.prototype.slice.call(
                    document.querySelectorAll(
                        'input[name="AgeCategory"]'));

            var seats =
                Array.prototype.slice.call(
                    document.querySelectorAll(".seat-circle"));

            var seatHub =
                $.connection.seatHub;

            var hubReady = false;
            var availabilityReady = false;
            var isSubmitting = false;
            var activeLockContext = null;
            var availabilityRequestId = 0;
            var remoteEventVersion = 0;
            var reconnectTimer = null;
            var seatOperations = {};
            var purchasedSeats = {};
            var remoteLockedSeats = {};
            var pendingRestoreSeats = [];

            var initialSelectedSeats =
                @Html.Raw(
                    System.Web.Helpers.Json.Encode(userSeats));


            function normalizeSeatId(value) {
                return String(value || "")
                    .trim()
                    .toUpperCase();
            }


            function parseDateOnly(value) {
                if (!value) {
                    return null;
                }

                var parts =
                    value.split("-");

                if (parts.length !== 3) {
                    return null;
                }

                var year =
                    parseInt(
                        parts[0],
                        10);

                var month =
                    parseInt(
                        parts[1],
                        10);

                var day =
                    parseInt(
                        parts[2],
                        10);

                if (
                    isNaN(year) ||
                    isNaN(month) ||
                    isNaN(day)
                ) {
                    return null;
                }

                var parsed =
                    new Date(
                        year,
                        month - 1,
                        day);

                if (
                    parsed.getFullYear() !== year ||
                    parsed.getMonth() !== month - 1 ||
                    parsed.getDate() !== day
                ) {
                    return null;
                }

                return parsed;
            }


            function formatDateOnly(date) {
                var year =
                    date.getFullYear();

                var month =
                    String(
                        date.getMonth() + 1)
                        .padStart(
                            2,
                            "0");

                var day =
                    String(
                        date.getDate())
                        .padStart(
                            2,
                            "0");

                return year
                    + "-"
                    + month
                    + "-"
                    + day;
            }


            function formatDisplayDate(value) {
                var parsed =
                    parseDateOnly(value);

                if (!parsed) {
                    return "—";
                }

                return String(
                    parsed.getDate())
                    .padStart(
                        2,
                        "0")
                    + "."
                    + String(
                        parsed.getMonth() + 1)
                        .padStart(
                            2,
                            "0")
                    + "."
                    + parsed.getFullYear();
            }


            function getCurrentContext() {
                var movieId =
                    movieSelect.value;

                var day =
                    dayInput.value;

                var time =
                    timeSelect.value;

                if (
                    !movieId ||
                    !day ||
                    !time
                ) {
                    return null;
                }

                return {
                    movieId:
                        String(movieId),

                    day:
                        day,

                    time:
                        time
                };
            }


            function contextsMatch(
                first,
                second) {

                if (!first || !second) {
                    return false;
                }

                return (
                    String(first.movieId) ===
                        String(second.movieId) &&
                    first.day === second.day &&
                    first.time === second.time
                );
            }


            function getSeatElement(seatId) {
                return document.querySelector(
                    '.seat-circle[data-seat="'
                    + normalizeSeatId(seatId)
                    + '"]');
            }


            function getSelectedSeatIds() {
                return seats
                    .filter(function (seat) {
                        return seat.classList
                            .contains("selected");
                    })
                    .map(function (seat) {
                        return normalizeSeatId(
                            seat.getAttribute(
                                "data-seat"));
                    })
                    .sort(function (first, second) {
                        return getSeatSortValue(first)
                            - getSeatSortValue(second);
                    });
            }


            function getSeatSortValue(seatId) {
                var match =
                    /^R(\d+)C(\d+)$/i
                        .exec(seatId);

                if (!match) {
                    return Number.MAX_SAFE_INTEGER;
                }

                return (
                    parseInt(
                        match[1],
                        10) * 100
                    + parseInt(
                        match[2],
                        10)
                );
            }


            function updateBookingSteps() {
                var hasMovieContext =
                    movieSelect.value &&
                    dayInput.value &&
                    timeSelect.value;

                var hasSeats =
                    getSelectedSeatIds()
                        .length > 0;

                bookingStepMovie.classList.add(
                    "active");

                bookingStepSeats.classList.toggle(
                    "active",
                    !!hasMovieContext);

                bookingStepConfirm.classList.toggle(
                    "active",
                    !!hasMovieContext &&
                    hasSeats);
            }


            function updateBookingSummary() {
                var selectedOption =
                    movieSelect.options[
                        movieSelect.selectedIndex
                    ];

                var movieName =
                    movieSelect.value &&
                    selectedOption
                        ? selectedOption.textContent
                            .trim()
                        : "Not Selected";

                selectedMovieSummary.textContent =
                    movieName;

                selectedDaySummary.textContent =
                    formatDisplayDate(
                        dayInput.value);

                selectedTimeSummary.textContent =
                    timeSelect.value || "—";

                var selectedIds =
                    getSelectedSeatIds();

                selectedSeatCount.textContent =
                    selectedIds.length;

                selectedSeatList.innerHTML =
                    "";

                if (selectedIds.length === 0) {
                    var empty =
                        document.createElement(
                            "span");

                    empty.className =
                        "booking-no-seats";

                    empty.textContent =
                        "No Seats Selected";

                    selectedSeatList.appendChild(
                        empty);
                }
                else {
                    selectedIds.forEach(
                        function (seatId) {

                            var badge =
                                document.createElement(
                                    "span");

                            badge.className =
                                "booking-selected-seat";

                            badge.textContent =
                                seatId;

                            selectedSeatList.appendChild(
                                badge);
                        });
                }

                var selectedAge =
                    ageInputs.filter(
                        function (input) {
                            return input.checked;
                        })[0];

                if (!selectedAge) {
                    selectedAgeSummary.textContent =
                        "—";
                }
                else {
                    selectedAgeSummary.textContent =
                        selectedAge.value === "18+"
                            ? "18+"
                            : "Under 18";
                }

                updateBookingSteps();
            }


            function calculateTotalAndSyncInputs() {
                var selectedSeatIds =
                    getSelectedSeatIds();

                var total =
                    0;

                selectedSeatsInputs.innerHTML =
                    "";

                selectedSeatIds.forEach(
                    function (seatId) {

                        var seat =
                            getSeatElement(
                                seatId);

                        if (!seat) {
                            return;
                        }

                        var row =
                            parseInt(
                                seat.getAttribute(
                                    "data-row"),
                                10);

                        total +=
                            row <= 2
                                ? 500
                                : 250;

                        var input =
                            document.createElement(
                                "input");

                        input.type =
                            "hidden";

                        input.name =
                            "selectedSeats";

                        input.value =
                            seatId;

                        selectedSeatsInputs
                            .appendChild(
                                input);
                    });

                totalPriceSpan.textContent =
                    total;

                updateBookingSummary();
            }


            function clearSeatError() {
                seatErrorMessage.textContent =
                    "";

                seatErrorMessage.hidden =
                    true;
            }


            function showSeatError(message) {
                seatErrorMessage.textContent =
                    message;

                seatErrorMessage.hidden =
                    false;
            }


            function clearTimeError() {
                timeErrorMessage.textContent =
                    "";

                timeErrorMessage.hidden =
                    true;
            }


            function showTimeError(message) {
                timeErrorMessage.textContent =
                    message;

                timeErrorMessage.hidden =
                    false;
            }


            function disableAllSeats() {
                seats.forEach(
                    function (seat) {

                        seat.disabled =
                            true;

                        seat.setAttribute(
                            "aria-disabled",
                            "true");
                    });
            }


            function renderSeatAvailability() {
                var context =
                    getCurrentContext();

                var canChooseSeats =
                    hubReady &&
                    availabilityReady &&
                    !isSubmitting &&
                    context !== null &&
                    !isProjectionElapsed(
                        context.day,
                        context.time);

                seats.forEach(
                    function (seat) {

                        var seatId =
                            normalizeSeatId(
                                seat.getAttribute(
                                    "data-seat"));

                        var selected =
                            seat.classList
                                .contains(
                                    "selected");

                        var purchased =
                            purchasedSeats[
                                seatId
                            ] === true;

                        var remotelyLocked =
                            remoteLockedSeats[
                                seatId
                            ] === true;

                        var unavailable =
                            purchased ||
                            remotelyLocked;

                        seat.classList.toggle(
                            "purchased",
                            purchased &&
                            !selected);

                        seat.classList.toggle(
                            "remote-locked",
                            remotelyLocked &&
                            !selected);

                        if (
                            unavailable &&
                            !selected
                        ) {
                            seat.classList.add(
                                "unavailable");
                        }
                        else {
                            seat.classList.remove(
                                "unavailable");
                        }

                        seat.disabled =
                            !canChooseSeats ||
                            seatOperations[seatId] === true ||
                            (unavailable &&
                             !selected);

                        seat.setAttribute(
                            "aria-disabled",
                            seat.disabled
                                ? "true"
                                : "false");

                        seat.setAttribute(
                            "aria-pressed",
                            selected
                                ? "true"
                                : "false");
                    });

                calculateTotalAndSyncInputs();
            }


            function clearLocalSelections() {
                seats.forEach(
                    function (seat) {

                        seat.classList.remove(
                            "selected");

                        seat.setAttribute(
                            "aria-pressed",
                            "false");
                    });

                activeLockContext =
                    null;

                calculateTotalAndSyncInputs();
            }


            function clearAvailabilityState() {
                availabilityRequestId++;
                availabilityReady = false;
                seatOperations = {};

                purchasedSeats =
                    {};

                remoteLockedSeats =
                    {};

                seats.forEach(
                    function (seat) {

                        seat.classList.remove(
                            "unavailable",
                            "purchased",
                            "remote-locked");
                    });
            }


            function releaseSelectedLocks() {
                var selectedSeatIds =
                    getSelectedSeatIds();

                if (
                    !hubReady ||
                    !activeLockContext
                ) {
                    clearLocalSelections();
                    return;
                }

                var context =
                    activeLockContext;

                selectedSeatIds.forEach(
                    function (seatId) {

                        seatHub.server
                            .unlockSeat(
                                context.movieId,
                                context.day,
                                context.time,
                                seatId);
                    });

                clearLocalSelections();
            }


            function resetSeatState() {
                releaseSelectedLocks();
                clearAvailabilityState();
                clearSeatError();
                renderSeatAvailability();
            }


            function getEarliestValidDate() {
                var today =
                    new Date();

                today.setHours(
                    0,
                    0,
                    0,
                    0);

                var selectedOption =
                    movieSelect.options[
                        movieSelect.selectedIndex
                    ];

                if (!selectedOption) {
                    return today;
                }

                var releaseValue =
                    selectedOption.getAttribute(
                        "data-release");

                var releaseDate =
                    parseDateOnly(
                        releaseValue);

                if (!releaseDate) {
                    return today;
                }

                releaseDate.setHours(
                    0,
                    0,
                    0,
                    0);

                return releaseDate > today
                    ? releaseDate
                    : today;
            }


            function updateDayInputMin() {
                dayInput.min =
                    formatDateOnly(
                        getEarliestValidDate());
            }


            function isBeforeEarliestDay(value) {
                var chosen =
                    parseDateOnly(value);

                if (!chosen) {
                    return true;
                }

                chosen.setHours(
                    0,
                    0,
                    0,
                    0);

                return chosen <
                    getEarliestValidDate();
            }


            function isProjectionElapsed(
                dayValue,
                timeValue) {

                var selectedDate =
                    parseDateOnly(
                        dayValue);

                if (
                    !selectedDate ||
                    !timeValue
                ) {
                    return false;
                }

                var timeParts =
                    timeValue.split(":");

                if (timeParts.length !== 2) {
                    return true;
                }

                var hours =
                    parseInt(
                        timeParts[0],
                        10);

                var minutes =
                    parseInt(
                        timeParts[1],
                        10);

                if (
                    isNaN(hours) ||
                    isNaN(minutes)
                ) {
                    return true;
                }

                selectedDate.setHours(
                    hours,
                    minutes,
                    0,
                    0);

                return selectedDate <=
                    new Date();
            }


            function loadUnavailableSeats() {
                var context = getCurrentContext();
                var requestId = ++availabilityRequestId;
                var eventVersion = remoteEventVersion;

                availabilityReady = false;
                renderSeatAvailability();

                if (!context || !hubReady) {
                    return Promise.resolve(false);
                }

                var url =
                    '@Url.Action("GetUnavailableSeats", "Tickets")' +
                    "?movieId=" + encodeURIComponent(context.movieId) +
                    "&day=" + encodeURIComponent(context.day) +
                    "&time=" + encodeURIComponent(context.time);

                var purchasedRequest = fetch(url, {
                    credentials: "same-origin"
                }).then(function (response) {
                    if (!response.ok) {
                        throw new Error("Unable to load purchased seats.");
                    }
                    return response.json();
                });

                var lockedRequest = new Promise(function (resolve, reject) {
                    seatHub.server.getLockedSeats(
                        context.movieId,
                        context.day,
                        context.time
                    ).done(resolve).fail(reject);
                });

                return Promise.all([purchasedRequest, lockedRequest])
                    .then(function (results) {
                        if (requestId !== availabilityRequestId ||
                            !contextsMatch(getCurrentContext(), context) ||
                            !hubReady) {
                            return false;
                        }

                        if (eventVersion !== remoteEventVersion) {
                            return loadUnavailableSeats();
                        }

                        if (!Array.isArray(results[0]) ||
                            !Array.isArray(results[1])) {
                            throw new Error("Invalid seat availability response.");
                        }

                        purchasedSeats = {};
                        remoteLockedSeats = {};

                        results[0].forEach(function (seatId) {
                            purchasedSeats[normalizeSeatId(seatId)] = true;
                        });

                        results[1].forEach(function (seatId) {
                            remoteLockedSeats[normalizeSeatId(seatId)] = true;
                        });

                        var lostSelection = false;

                        seats.forEach(function (seat) {
                            var seatId = normalizeSeatId(
                                seat.getAttribute("data-seat"));

                            if (seat.classList.contains("selected") &&
                                (purchasedSeats[seatId] === true ||
                                 remoteLockedSeats[seatId] === true)) {
                                seat.classList.remove("selected");
                                lostSelection = true;
                            }
                        });

                        availabilityReady = true;
                        renderSeatAvailability();

                        if (lostSelection) {
                            showSeatError(
                                "Some seats are no longer available. " +
                                "Please review your selection.");
                        }

                        return true;
                    })
                    .catch(function (error) {
                        console.error(error);

                        if (requestId === availabilityRequestId &&
                            contextsMatch(getCurrentContext(), context)) {
                            availabilityReady = false;
                            showSeatError(
                                "We could not load the current seat availability. " +
                                "Please try again.");
                            disableAllSeats();
                        }

                        return false;
                    });
            }


            function restoreSelections(seatIds) {
                var context = getCurrentContext();

                if (!context || !hubReady || !availabilityReady ||
                    !seatIds || seatIds.length === 0) {
                    calculateTotalAndSyncInputs();
                    return Promise.resolve();
                }

                return Promise.all(seatIds.map(function (rawSeatId) {
                    var seatId = normalizeSeatId(rawSeatId);
                    var seat = getSeatElement(seatId);

                    if (!seat || purchasedSeats[seatId] === true ||
                        remoteLockedSeats[seatId] === true) {
                        return Promise.resolve();
                    }

                    seatOperations[seatId] = true;
                    renderSeatAvailability();

                    return new Promise(function (resolve) {
                        seatHub.server.lockSeat(
                            context.movieId,
                            context.day,
                            context.time,
                            seatId
                        ).done(function (locked) {
                            if (!contextsMatch(getCurrentContext(), context)) {
                                if (locked && hubReady) {
                                    seatHub.server.unlockSeat(
                                        context.movieId,
                                        context.day,
                                        context.time,
                                        seatId);
                                }
                                resolve();
                                return;
                            }

                            if (locked) {
                                seat.classList.add("selected");
                                delete remoteLockedSeats[seatId];
                                activeLockContext = context;
                            } else {
                                seat.classList.remove("selected");
                                remoteLockedSeats[seatId] = true;
                            }

                            delete seatOperations[seatId];
                            renderSeatAvailability();
                            resolve();
                        }).fail(function () {
                            if (contextsMatch(getCurrentContext(), context)) {
                                seat.classList.remove("selected");
                                delete seatOperations[seatId];
                                renderSeatAvailability();
                            }
                            resolve();
                        });
                    });
                }));
            }


            function synchronizeAvailability(restoreSeatIds) {
                return loadUnavailableSeats().then(function (loaded) {
                    if (!loaded) {
                        return false;
                    }
                    return restoreSelections(restoreSeatIds).then(function () {
                        return true;
                    });
                });
            }


            function renewSelectedLocks() {
                var context = getCurrentContext();
                var selectedIds = getSelectedSeatIds();

                if (!hubReady || !context || isSubmitting ||
                    isProjectionElapsed(context.day, context.time)) {
                    return Promise.resolve(false);
                }

                if (selectedIds.length === 0) {
                    return loadUnavailableSeats();
                }

                return Promise.all(selectedIds.map(function (seatId) {
                    return new Promise(function (resolve) {
                        seatHub.server.lockSeat(
                            context.movieId,
                            context.day,
                            context.time,
                            seatId
                        ).done(function (locked) {
                            resolve({ seatId: seatId, locked: !!locked });
                        }).fail(function () {
                            resolve({ seatId: seatId, locked: false });
                        });
                    });
                })).then(function (results) {
                    if (!contextsMatch(getCurrentContext(), context) ||
                        !hubReady) {
                        return false;
                    }

                    var lost = false;

                    results.forEach(function (result) {
                        if (!result.locked) {
                            var seat = getSeatElement(result.seatId);
                            if (seat) {
                                seat.classList.remove("selected");
                            }
                            lost = true;
                        }
                    });

                    renderSeatAvailability();

                    if (lost) {
                        showSeatError(
                            "One or more seat holds have expired. " +
                            "Please select an available seat again.");
                    }

                    return loadUnavailableSeats();
                });
            }


            function handleSeatClick(seat) {
                if (
                    !hubReady ||
                    !availabilityReady ||
                    seat.disabled
                ) {
                    return;
                }

                clearSeatError();

                var context =
                    getCurrentContext();

                if (!context) {
                    return;
                }

                var seatId =
                    normalizeSeatId(
                        seat.getAttribute(
                            "data-seat"));

                if (seatOperations[seatId] === true) {
                    return;
                }

                seatOperations[seatId] = true;

                if (
                    seat.classList.contains(
                        "selected")
                ) {
                    var unlockContext =
                        activeLockContext &&
                        contextsMatch(
                            activeLockContext,
                            context)
                            ? activeLockContext
                            : context;

                    seat.disabled =
                        true;

                    seatHub.server
                        .unlockSeat(
                            unlockContext.movieId,
                            unlockContext.day,
                            unlockContext.time,
                            seatId)
                        .always(
                            function () {
                                delete seatOperations[seatId];

                                if (
                                    !contextsMatch(
                                        getCurrentContext(),
                                        context)
                                ) {
                                    return;
                                }

                                seat.classList.remove(
                                    "selected");

                                seat.setAttribute(
                                    "aria-pressed",
                                    "false");

                                if (
                                    getSelectedSeatIds()
                                        .length === 0
                                ) {
                                    activeLockContext =
                                        null;
                                }

                                renderSeatAvailability();
                            });

                    return;
                }

                seat.disabled =
                    true;

                seatHub.server
                    .lockSeat(
                        context.movieId,
                        context.day,
                        context.time,
                        seatId)
                    .done(
                        function (locked) {
                            delete seatOperations[seatId];

                            if (
                                !contextsMatch(
                                    getCurrentContext(),
                                    context)
                            ) {
                                if (locked) {
                                    seatHub.server
                                        .unlockSeat(
                                            context.movieId,
                                            context.day,
                                            context.time,
                                            seatId);
                                }

                                return;
                            }

                            if (locked) {
                                seat.classList.add(
                                    "selected");

                                seat.setAttribute(
                                    "aria-pressed",
                                    "true");

                                delete remoteLockedSeats[
                                    seatId
                                ];

                                activeLockContext =
                                    context;
                            }
                            else {
                                seat.classList.remove(
                                    "selected");

                                seat.setAttribute(
                                    "aria-pressed",
                                    "false");

                                remoteLockedSeats[
                                    seatId
                                ] = true;

                                showSeatError(
                                    "Seat "
                                    + seatId
                                    + " is currently selected by another user.");
                            }

                            renderSeatAvailability();
                        })
                    .fail(
                        function () {
                            delete seatOperations[seatId];

                            if (
                                !contextsMatch(
                                    getCurrentContext(),
                                    context)
                            ) {
                                return;
                            }

                            showSeatError(
                                "We could not reserve this seat. "
                                + "Please try again.");

                            renderSeatAvailability();
                        });
            }


            seats.forEach(
                function (seat) {

                    seat.addEventListener(
                        "click",
                        function () {

                            handleSeatClick(
                                seat);
                        });
                });


            ageInputs.forEach(
                function (input) {

                    input.addEventListener(
                        "change",
                        function () {

                            updateBookingSummary();
                        });
                });


            seatHub.client.seatLocked =
                function (
                    movieId,
                    day,
                    time,
                    seatId) {

                    var currentContext =
                        getCurrentContext();

                    var eventContext =
                    {
                        movieId:
                            String(movieId),

                        day:
                            day,

                        time:
                            time
                    };

                    if (
                        !contextsMatch(
                            currentContext,
                            eventContext)
                    ) {
                        return;
                    }

                    seatId =
                        normalizeSeatId(
                            seatId);

                    remoteEventVersion++;
                    remoteLockedSeats[seatId] = true;

                    var seat =
                        getSeatElement(
                            seatId);

                    if (seat && seat.classList.contains("selected")) {
                        seat.classList.remove("selected");
                        showSeatError(
                            "A selected seat is no longer held by you. " +
                            "Please choose another available seat.");
                    }

                    renderSeatAvailability();
                };


            seatHub.client.seatUnlocked =
                function (
                    movieId,
                    day,
                    time,
                    seatId) {

                    var currentContext =
                        getCurrentContext();

                    var eventContext =
                    {
                        movieId:
                            String(movieId),

                        day:
                            day,

                        time:
                            time
                    };

                    if (
                        !contextsMatch(
                            currentContext,
                            eventContext)
                    ) {
                        return;
                    }

                    seatId =
                        normalizeSeatId(
                            seatId);

                    remoteEventVersion++;
                    delete remoteLockedSeats[seatId];

                    if (hubReady && !isSubmitting) {
                        loadUnavailableSeats();
                    }
                };


            ticketForm.addEventListener("submit", function (event) {
                event.preventDefault();

                if (isSubmitting) {
                    return;
                }

                clearSeatError();
                clearTimeError();

                var context = getCurrentContext();

                if (!context) {
                    showSeatError("Please choose a movie, date, and showtime.");
                    return;
                }

                if (isProjectionElapsed(context.day, context.time)) {
                    showTimeError("The selected showtime has already passed.");
                    return;
                }

                if (!hubReady || !availabilityReady ||
                    Object.keys(seatOperations).length > 0) {
                    showSeatError(
                        "Seat availability is still being checked. " +
                        "Please try again.");
                    return;
                }

                var selectedIds = getSelectedSeatIds();
                var bookingConnectionId = $.connection.hub.id;

                if (!bookingConnectionId) {
                    showSeatError(
                        "Your seat selection session has expired. " +
                        "Please reconnect and select your seats again.");
                    return;
                }

                if (selectedIds.length === 0) {
                    showSeatError("Please select at least one seat.");
                    return;
                }

                isSubmitting = true;
                buyButton.disabled = true;
                buyButtonText.textContent = "Checking seats...";
                renderSeatAvailability();

                Promise.all(selectedIds.map(function (seatId) {
                    return new Promise(function (resolve) {
                        seatHub.server.lockSeat(
                            context.movieId,
                            context.day,
                            context.time,
                            seatId
                        ).done(function (locked) {
                            resolve({ seatId: seatId, locked: !!locked });
                        }).fail(function () {
                            resolve({ seatId: seatId, locked: false });
                        });
                    });
                })).then(function (results) {
                    if (!contextsMatch(getCurrentContext(), context) ||
                        !hubReady) {
                        throw new Error("The booking context has changed.");
                    }

                    var rejected = results.filter(function (result) {
                        return !result.locked;
                    });

                    if (rejected.length > 0) {
                        rejected.forEach(function (result) {
                            var seat = getSeatElement(result.seatId);
                            if (seat) {
                                seat.classList.remove("selected");
                            }
                        });
                        throw new Error(
                            "Some selected seats are no longer available. " +
                            "Please review your selection.");
                    }

                    return loadUnavailableSeats().then(function (loaded) {
                        if (!loaded || !hubReady ||
                            !contextsMatch(getCurrentContext(), context)) {
                            throw new Error("Could not verify seat availability.");
                        }

                        if (selectedIds.some(function (seatId) {
                            return purchasedSeats[seatId] === true ||
                                remoteLockedSeats[seatId] === true;
                        })) {
                            throw new Error(
                                "One or more selected seats are no longer available.");
                        }

                        if (getSelectedSeatIds().length !== selectedIds.length) {
                            throw new Error("Your seat selection has changed.");
                        }

                        if ($.connection.hub.id !== bookingConnectionId) {
                            throw new Error(
                                "Your seat selection session changed. " +
                                "Please verify the seats again.");
                        }

                        signalRConnectionIdInput.value = bookingConnectionId;
                        calculateTotalAndSyncInputs();
                        buyButtonText.textContent = "Processing...";
                        HTMLFormElement.prototype.submit.call(ticketForm);
                    });
                }).catch(function (error) {
                    isSubmitting = false;
                    buyButton.disabled = false;
                    buyButtonText.textContent = "Confirm Booking";
                    showSeatError(
                        error.message ||
                        "Unable to confirm the selected seats. Please try again.");
                    renderSeatAvailability();
                });
            });


            function handleConnectionLoss() {
                if (isSubmitting) {
                    return;
                }

                var selectedIds = getSelectedSeatIds();
                if (selectedIds.length > 0) {
                    pendingRestoreSeats = selectedIds;
                }

                hubReady = false;
                availabilityReady = false;
                signalRConnectionIdInput.value = "";
                clearLocalSelections();
                clearAvailabilityState();
                disableAllSeats();
                showSeatError(
                    "The seat selection connection was interrupted. " +
                    "Your seats will be checked again after reconnection.");
            }


            function handleConnected() {
                hubReady = true;
                signalRConnectionIdInput.value = $.connection.hub.id || "";
                clearSeatError();
                clearLocalSelections();
                clearAvailabilityState();

                var seatsToRestore = pendingRestoreSeats.slice();
                pendingRestoreSeats = [];

                var context = getCurrentContext();
                if (!context || isProjectionElapsed(context.day, context.time)) {
                    renderSeatAvailability();
                    return;
                }

                synchronizeAvailability(seatsToRestore).then(function (loaded) {
                    if (!loaded && seatsToRestore.length > 0) {
                        pendingRestoreSeats = seatsToRestore;
                    }
                });
            }


            function scheduleReconnect() {
                if (reconnectTimer !== null || isSubmitting) {
                    return;
                }

                reconnectTimer = window.setTimeout(function () {
                    reconnectTimer = null;
                    startConnection();
                }, 5000);
            }


            function startConnection() {
                if (isSubmitting || hubReady ||
                    $.connection.hub.state !==
                        $.signalR.connectionState.disconnected) {
                    return;
                }

                $.connection.hub.start().done(function () {
                    handleConnected();
                }).fail(function () {
                    hubReady = false;
                    availabilityReady = false;
                    disableAllSeats();
                    showSeatError(
                        "Real-time seat selection is unavailable. " +
                        "Reconnecting automatically...");
                    scheduleReconnect();
                });
            }


            movieSelect.addEventListener("change", function () {
                resetSeatState();
                pendingRestoreSeats = [];
                dayInput.value = "";
                timeSelect.value = "";
                clearTimeError();

                if (!movieSelect.value) {
                    dayInput.disabled = true;
                    timeSelect.disabled = true;
                    disableAllSeats();
                    updateBookingSummary();
                    return;
                }

                updateDayInputMin();
                dayInput.disabled = false;
                timeSelect.disabled = true;
                disableAllSeats();
                updateBookingSummary();
            });


            dayInput.addEventListener("change", function () {
                resetSeatState();
                pendingRestoreSeats = [];
                timeSelect.value = "";
                clearTimeError();

                if (!dayInput.value || isBeforeEarliestDay(dayInput.value)) {
                    timeSelect.disabled = true;
                    disableAllSeats();
                    updateBookingSummary();
                    return;
                }

                timeSelect.disabled = false;
                disableAllSeats();
                updateBookingSummary();
            });


            timeSelect.addEventListener("change", function () {
                resetSeatState();
                pendingRestoreSeats = [];
                clearTimeError();

                var context = getCurrentContext();
                if (!context) {
                    disableAllSeats();
                    updateBookingSummary();
                    return;
                }

                if (isProjectionElapsed(context.day, context.time)) {
                    showTimeError(
                        "Sorry, the selected showtime has already passed.");
                    disableAllSeats();
                    updateBookingSummary();
                    return;
                }

                updateBookingSummary();
                synchronizeAvailability([]);
            });


            updateDayInputMin();
            dayInput.disabled = !movieSelect.value;
            timeSelect.disabled = !(
                movieSelect.value && dayInput.value &&
                !isBeforeEarliestDay(dayInput.value));

            pendingRestoreSeats = initialSelectedSeats.slice();
            clearLocalSelections();
            disableAllSeats();

            $.connection.hub.reconnecting(function () {
                handleConnectionLoss();
            });

            $.connection.hub.reconnected(function () {
                handleConnected();
            });

            $.connection.hub.disconnected(function () {
                handleConnectionLoss();
                scheduleReconnect();
            });

            startConnection();

            window.setInterval(function () {
                if (hubReady && !isSubmitting &&
                    getCurrentContext() !== null) {
                    renewSelectedLocks();
                }
            }, 120000);

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden && hubReady && !isSubmitting &&
                    getCurrentContext() !== null) {
                    renewSelectedLocks();
                }
            });
        });
    </script>
}


