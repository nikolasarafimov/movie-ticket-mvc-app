@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Text.RegularExpressions
@model MovieTicketMVC.Models.Ticket

@{
    ViewBag.Title = "Ticket Details";

    var flashMessage = Convert.ToString(TempData["SuccessMessage"]);

    var emailDeliveryFlag = TempData["EmailDeliveryFailed"];

    var emailDeliveryFailed = emailDeliveryFlag is bool
        ? (bool)emailDeliveryFlag
        : !string.IsNullOrWhiteSpace(flashMessage) &&
          (flashMessage.IndexOf(
              "\u043d\u0435 \u043c\u043e\u0436\u0435\u0448\u0435 \u0434\u0430 \u0431\u0438\u0434\u0435 \u0438\u0441\u043f\u0440\u0430\u0442\u0435\u043d\u0430",
              StringComparison.OrdinalIgnoreCase) >= 0 ||
           flashMessage.IndexOf(
              "could not be sent",
              StringComparison.OrdinalIgnoreCase) >= 0 ||
           flashMessage.IndexOf(
              "failed to send",
              StringComparison.OrdinalIgnoreCase) >= 0);

    var hasBookingFeedback =
        !string.IsNullOrWhiteSpace(flashMessage) ||
        emailDeliveryFlag is bool;

    var logoUrl = Url.Content("~/Content/Images/movieticket-logo.png");

    var isAdmin =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated &&
        User.IsInRole("Admin");

    var numberCulture =
        CultureInfo.GetCultureInfo("mk-MK");

    var monthCulture =
        CultureInfo.GetCultureInfo("en-US");

    var allowedTimes =
        new HashSet<string>(
            new[]
            {
                "10:00",
                "14:00",
                "18:00",
                "21:00"
                                                    },
            StringComparer.Ordinal);

    var seatPattern =
        new Regex(
            @"^R([1-9]|10)C([1-9]|10)$",
            RegexOptions.IgnoreCase |
            RegexOptions.CultureInvariant);

    var groupedSeats =
        new SortedDictionary<int, SortedSet<int>>();

    var invalidSeats =
        new SortedSet<string>(
            StringComparer.OrdinalIgnoreCase);

    if (!string.IsNullOrWhiteSpace(Model.SelectedSeats))
    {
        var seatIds =
            Model.SelectedSeats.Split(
                new[] { ',' },
                StringSplitOptions.RemoveEmptyEntries);

        foreach (var rawSeatId in seatIds)
        {
            var seatId =
                rawSeatId.Trim().ToUpperInvariant();

            if (string.IsNullOrWhiteSpace(seatId))
            {
                continue;
            }

            var match =
                seatPattern.Match(seatId);

            if (!match.Success)
            {
                invalidSeats.Add(seatId);
                continue;
            }

            var row =
                int.Parse(
                    match.Groups[1].Value,
                    CultureInfo.InvariantCulture);

            var column =
                int.Parse(
                    match.Groups[2].Value,
                    CultureInfo.InvariantCulture);

            if (!groupedSeats.ContainsKey(row))
            {
                groupedSeats[row] =
                    new SortedSet<int>();
            }

            groupedSeats[row].Add(column);
        }
    }

    var seatCount =
        groupedSeats.Sum(group => group.Value.Count);

    var premiumSeats =
        groupedSeats
            .Where(group => group.Key <= 2)
            .Sum(group => group.Value.Count);

    var standardSeats =
        groupedSeats
            .Where(group => group.Key > 2)
            .Sum(group => group.Value.Count);

    var movieTitle =
        Model.Movie != null &&
        !string.IsNullOrWhiteSpace(Model.Movie.Title)
            ? Model.Movie.Title
            : "Unknown Movie";

    TimeSpan projectionTime = TimeSpan.Zero;

    var hasValidTime =
    allowedTimes.Contains(
    Model.SelectedTime ?? string.Empty) &&
    TimeSpan.TryParseExact(
    Model.SelectedTime,
    @"hh\:mm",
    CultureInfo.InvariantCulture,
    out projectionTime);

    var isUpcoming =
        hasValidTime &&
        Model.SelectedDay.Date.Add(projectionTime) >
        DateTime.Now;

    var statusClass =
        !hasValidTime
            ? "unknown"
            : isUpcoming
                ? "active"
                : "past";

    var statusText =
        !hasValidTime
            ? "UNKNOWN SHOWTIME"
            : isUpcoming
                ? "UPCOMING SCREENING"
                : "PAST SCREENING";

    var formattedDate =
        Model.SelectedDay.ToString(
            "dd.MM.yyyy",
            CultureInfo.InvariantCulture);

    var formattedDay =
        Model.SelectedDay.ToString(
            "dd",
            CultureInfo.InvariantCulture);

    var formattedMonth =
        Model.SelectedDay.ToString(
            "MMM",
            monthCulture).ToUpperInvariant();

    var formattedYear =
        Model.SelectedDay.ToString(
            "yyyy",
            CultureInfo.InvariantCulture);

    var formattedPrice =
        Model.TotalPrice.ToString(
            "N0",
            numberCulture);

    var ticketEmail =
        string.IsNullOrWhiteSpace(Model.Email)
            ? "Unknown Email Address"
            : Model.Email;

    var ticketsUrl =
        Url.Action("Index", "Tickets");

    var buyUrl =
        Url.Action("Buy", "Tickets");
}

<div class="ticket-summary-page"
     aria-labelledby="ticket-summary-title">

    @if (hasBookingFeedback)
    {
        <div class="ticket-success-message"
             role="status"
             aria-live="polite">
            <span aria-hidden="true">✓</span>
            <div>
                <strong>Booking Confirmed</strong>
                <p>
                    @(emailDeliveryFailed
                        ? "Your ticket has been saved successfully and is available under My Tickets."
                        : "Thank you! Your tickets have been booked successfully and sent to your email address.")
                </p>
            </div>
        </div>

        if (emailDeliveryFailed)
        {
            <div class="ticket-email-warning" role="alert">
                <span class="ticket-email-warning-icon" aria-hidden="true">!</span>
                <div>
                    <strong>Email Confirmation Could Not Be Sent</strong>
                    <p>
                        Your booking remains valid. You can view it under My Tickets.
                        If you need an email confirmation, please contact support.
                    </p>
                </div>
            </div>
        }
    }

    <section class="ticket-summary-header">

        <div>
            <div class="cinema-eyebrow">
                BOOKING CONFIRMATION
            </div>

            <h1 id="ticket-summary-title">
                Your
                <span class="cinema-text-gradient">
                    Ticket
                </span>
            </h1>

            <p>
                All details of your booked screening
                are shown below.
            </p>
        </div>

        <a class="btn btn-outline-secondary"
           href="@ticketsUrl">

            @(isAdmin
                ? "All Tickets"
                : "My Tickets")

        </a>

    </section>

    <section class="digital-ticket"
             aria-label="Details for ticket number @Model.Id">

        <div class="digital-ticket-main">

            <div class="digital-ticket-top">

                <div>
                    <img class="digital-ticket-brand"
                         src="@logoUrl"
                         alt="MovieTicket"
                         width="142"
                         height="38"
                         decoding="async" />

                    <span class="digital-ticket-id">
                        RESERVATION #@Model.Id
                    </span>
                </div>

                <div class="digital-ticket-status @statusClass">

                    <span aria-hidden="true"></span>

                    @statusText

                </div>

            </div>

            <div class="digital-ticket-film">

                <span>
                    MOVIE
                </span>

                <h2>
                    @movieTitle
                </h2>

            </div>

            <div class="digital-ticket-primary-info">

                <div>
                    <span>
                        DATE
                    </span>

                    <strong>
                        @formattedDate
                    </strong>
                </div>

                <div>
                    <span>
                        SHOWTIME
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.SelectedTime)
                            ? "—"
                            : Model.SelectedTime)
                    </strong>
                </div>

                <div>
                    <span>
                        SEATS
                    </span>

                    <strong>
                        @seatCount
                    </strong>
                </div>

            </div>

            <div class="digital-ticket-seat-section">

                <span class="digital-ticket-section-label">
                    RESERVED SEATS
                </span>

                @if (groupedSeats.Any())
                {
                    <div class="digital-ticket-seat-grid">

                        @foreach (var group in groupedSeats)
                        {
                            foreach (var column in group.Value)
                            {
                                <span class="digital-ticket-seat">
                                    Row @(group.Key) · Seat @(column)
                                </span>
                            }
                        }

                    </div>
                }
                else
                {
                    <p class="digital-ticket-no-seats">
                        No valid seats selected.
                    </p>
                }

                @if (invalidSeats.Any())
                {
                    <div class="digital-ticket-invalid">

                        Invalid entries:

                        @string.Join(", ", invalidSeats)

                    </div>
                }

            </div>

            <div class="digital-ticket-customer">

                <span>
                    TICKET HOLDER
                </span>

                <strong>
                    @ticketEmail
                </strong>

            </div>

        </div>

        <aside class="digital-ticket-stub">

            <img class="digital-ticket-stub-brand"
                 src="@logoUrl"
                 alt="MovieTicket"
                 width="126"
                 height="36"
                 decoding="async" />

            <div class="digital-ticket-stub-date">

                <span>
                    @formattedMonth
                </span>

                <strong>
                    @formattedDay
                </strong>

                <small>
                    @formattedYear
                </small>

            </div>

            <div class="digital-ticket-stub-time">

                <span>
                    SHOWTIME
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.SelectedTime)
                        ? "—"
                        : Model.SelectedTime)
                </strong>

            </div>

            <div class="digital-ticket-barcode"
                 aria-hidden="true">

                @for (var barcode = 0; barcode < 25; barcode++)
                {
                    <span></span>
                }

            </div>

            <span class="digital-ticket-stub-id">
                #@Model.Id
            </span>

        </aside>

    </section>

    <section class="ticket-summary-information"
             aria-label="Price breakdown">

        <div class="ticket-summary-info-card">

            <span>
                PREMIUM
            </span>

            <strong>
                @premiumSeats
            </strong>

            <small>
                × 500 MKD
            </small>

        </div>

        <div class="ticket-summary-info-card">

            <span>
                STANDARD
            </span>

            <strong>
                @standardSeats
            </strong>

            <small>
                × 250 MKD
            </small>

        </div>

        <div class="ticket-summary-info-card highlight">

            <span>
                TOTAL PRICE
            </span>

            <strong>
                @formattedPrice
            </strong>

            <small>
                MKD
            </small>

        </div>

    </section>

    <section class="ticket-summary-footer">

        <div>

            <span class="ticket-summary-footer-label">
                BOOKING DETAILS
            </span>

            <strong>
                This ticket is associated with
                @ticketEmail
            </strong>

            <p>
                Your booking has been saved to your account.
                You can also find the details under My Tickets.
            </p>

        </div>

        <div class="ticket-summary-actions">

            <a class="btn btn-outline-secondary"
               href="@ticketsUrl">

                @(isAdmin
                    ? "Back to All Tickets"
                    : "Back to My Tickets")

            </a>

            @if (!isAdmin)
            {
                <a class="btn btn-primary"
                   href="@buyUrl">

                    Book Another Ticket

                </a>
            }

        </div>

    </section>

</div>



<style>
    .ticket-summary-page {
        width: min(100%, 1050px);
        margin: 0 auto;
    }

    .ticket-success-message {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        margin-bottom: 1.5rem;
        padding: 1rem 1.2rem;
        border: 1px solid rgba(66, 199, 131, 0.22);
        border-radius: var(--cinema-radius-md);
        background: rgba(66, 199, 131, 0.07);
        box-shadow: var(--cinema-shadow-sm);
        animation: ticket-success-enter 450ms cubic-bezier(0.22, 1, 0.36, 1);
    }

        .ticket-success-message > span {
            display: grid;
            flex: 0 0 40px;
            place-items: center;
            width: 40px;
            height: 40px;
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.24);
            border-radius: 50%;
            background: rgba(66, 199, 131, 0.08);
            font-weight: 900;
        }

        .ticket-success-message strong {
            color: #a5e9c1;
        }

        .ticket-success-message p {
            margin: 0.15rem 0 0;
            color: var(--cinema-text-muted);
            font-size: 0.8rem;
        }

    .ticket-summary-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 2rem;
    }

        .ticket-summary-header > div {
            max-width: 700px;
        }

        .ticket-summary-header h1 {
            margin-bottom: 0.8rem;
        }

        .ticket-summary-header p {
            margin: 0;
            color: var(--cinema-text-muted);
        }

    .digital-ticket {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        overflow: hidden;
        border: 1px solid rgba(214, 168, 75, 0.18);
        border-radius: 28px;
        background: linear-gradient( 150deg, rgba(23, 31, 44, 0.99), rgba(7, 10, 15, 0.99) );
        box-shadow: var(--cinema-shadow-lg);
    }

        .digital-ticket::before {
            position: absolute;
            top: -200px;
            left: 15%;
            width: 500px;
            height: 500px;
            content: "";
            pointer-events: none;
            border-radius: 50%;
            background: rgba(214, 168, 75, 0.04);
            filter: blur(10px);
        }

    .digital-ticket-main {
        position: relative;
        z-index: 1;
        min-width: 0;
        padding: clamp(1.5rem, 4vw, 2.5rem);
    }

    .digital-ticket-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .digital-ticket-brand {
        display: block;
        width: 142px;
        max-width: 100%;
        height: 38px;
        margin-bottom: 0.35rem;
        object-fit: contain;
        object-position: left center;
    }

    .digital-ticket-id {
        color: var(--cinema-text-muted);
        font-size: 0.6rem;
        letter-spacing: 0.08em;
    }

    .digital-ticket-status {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        font-size: 0.56rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-align: center;
    }

        .digital-ticket-status > span {
            width: 6px;
            height: 6px;
            flex: 0 0 6px;
            border-radius: 50%;
        }

        .digital-ticket-status.active {
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.20);
            background: rgba(66, 199, 131, 0.07);
        }

            .digital-ticket-status.active > span {
                background: var(--cinema-success);
                box-shadow: 0 0 12px rgba(66, 199, 131, 0.65);
            }

        .digital-ticket-status.past,
        .digital-ticket-status.unknown {
            color: var(--cinema-text-muted);
            border: 1px solid var(--cinema-border);
            background: rgba(255, 255, 255, 0.025);
        }

            .digital-ticket-status.past > span,
            .digital-ticket-status.unknown > span {
                background: #737c89;
            }

    .digital-ticket-film {
        margin-bottom: 1.4rem;
    }

        .digital-ticket-film > span {
            display: block;
            margin-bottom: 0.55rem;
            color: var(--cinema-text-muted);
            font-size: 0.58rem;
            font-weight: 900;
            letter-spacing: 0.13em;
        }

        .digital-ticket-film h2 {
            max-width: 720px;
            margin: 0;
            font-size: clamp(2rem, 5vw, 3.6rem);
            line-height: 1.05;
            letter-spacing: -0.05em;
            overflow-wrap: anywhere;
        }

    .digital-ticket-primary-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1.4rem;
    }

        .digital-ticket-primary-info > div {
            min-width: 0;
            padding: 1rem;
            border: 1px solid var(--cinema-border);
            border-radius: 13px;
            background: rgba(255, 255, 255, 0.02);
        }

        .digital-ticket-primary-info span,
        .digital-ticket-section-label,
        .digital-ticket-customer > span {
            display: block;
            margin-bottom: 0.3rem;
            color: var(--cinema-text-muted);
            font-size: 0.55rem;
            font-weight: 900;
            letter-spacing: 0.1em;
        }

        .digital-ticket-primary-info strong {
            color: var(--cinema-text);
            font-size: 0.9rem;
            overflow-wrap: anywhere;
        }

    .digital-ticket-seat-section {
        margin-bottom: 1.4rem;
    }

    .digital-ticket-seat-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .digital-ticket-seat {
        display: inline-flex;
        align-items: center;
        min-height: 35px;
        padding: 0.45rem 0.75rem;
        border: 1px solid rgba(66, 199, 131, 0.2);
        border-radius: 9px;
        background: rgba(66, 199, 131, 0.07);
        color: #a5e9c1;
        font-size: 0.78rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .digital-ticket-no-seats {
        color: var(--cinema-text-muted);
        font-size: 0.8rem;
    }

    .digital-ticket-invalid {
        margin-top: 0.7rem;
        color: #ff8b96;
        font-size: 0.7rem;
        overflow-wrap: anywhere;
    }

    .digital-ticket-customer {
        padding-top: 1.2rem;
        border-top: 1px dashed var(--cinema-border-strong);
    }

        .digital-ticket-customer strong {
            display: block;
            overflow-wrap: anywhere;
            color: var(--cinema-text-soft);
            font-size: 0.8rem;
        }

    .digital-ticket-stub {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: space-between;
        padding: 2rem 1.3rem;
        border-left: 1px dashed rgba(255, 255, 255, 0.15);
        background: radial-gradient( circle at 50% 30%, rgba(214, 168, 75, 0.08), transparent 35% ), rgba(255, 255, 255, 0.016);
    }

        .digital-ticket-stub::before,
        .digital-ticket-stub::after {
            position: absolute;
            left: -16px;
            width: 31px;
            height: 31px;
            content: "";
            border: 1px solid var(--cinema-border);
            border-radius: 50%;
            background: var(--cinema-bg);
        }

        .digital-ticket-stub::before {
            top: -16px;
        }

        .digital-ticket-stub::after {
            bottom: -16px;
        }

    .digital-ticket-stub-brand {
        display: block;
        width: 126px;
        max-width: 100%;
        height: 36px;
        object-fit: contain;
        object-position: center;
    }

    .digital-ticket-stub-date {
        text-align: center;
    }

        .digital-ticket-stub-date > span {
            display: block;
            color: var(--cinema-gold-light);
            font-size: 0.7rem;
            font-weight: 900;
            letter-spacing: 0.15em;
        }

        .digital-ticket-stub-date strong {
            display: block;
            margin: 0.2rem 0;
            color: var(--cinema-text);
            font-size: 4rem;
            line-height: 0.95;
            letter-spacing: -0.07em;
        }

        .digital-ticket-stub-date small {
            color: var(--cinema-text-muted);
            font-size: 0.7rem;
            letter-spacing: 0.1em;
        }

    .digital-ticket-stub-time {
        text-align: center;
    }

        .digital-ticket-stub-time span {
            display: block;
            margin-bottom: 0.3rem;
            color: var(--cinema-text-muted);
            font-size: 0.52rem;
            font-weight: 900;
            letter-spacing: 0.1em;
        }

        .digital-ticket-stub-time strong {
            color: var(--cinema-text);
            font-size: 1.2rem;
        }

    .digital-ticket-barcode {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 2px;
        width: 120px;
        height: 90px;
        opacity: 0.55;
    }

        .digital-ticket-barcode span {
            width: 2px;
            background: var(--cinema-text-soft);
        }

            .digital-ticket-barcode span:nth-child(2n) {
                width: 1px;
            }

            .digital-ticket-barcode span:nth-child(3n) {
                width: 4px;
            }

            .digital-ticket-barcode span:nth-child(5n) {
                width: 5px;
            }

    .digital-ticket-stub-id {
        color: var(--cinema-text-muted);
        font-size: 0.6rem;
        letter-spacing: 0.1em;
    }

    .ticket-summary-information {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .ticket-summary-info-card {
        padding: 1.2rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-md);
        background: rgba(15, 21, 31, 0.75);
        box-shadow: var(--cinema-shadow-sm);
    }

        .ticket-summary-info-card > span {
            display: block;
            margin-bottom: 0.6rem;
            color: var(--cinema-text-muted);
            font-size: 0.54rem;
            font-weight: 900;
            letter-spacing: 0.1em;
        }

        .ticket-summary-info-card strong {
            color: var(--cinema-text);
            font-size: 1.55rem;
        }

        .ticket-summary-info-card small {
            margin-left: 0.3rem;
            color: var(--cinema-text-muted);
            font-size: 0.68rem;
        }

        .ticket-summary-info-card.highlight {
            border-color: rgba(214, 168, 75, 0.24);
            background: rgba(214, 168, 75, 0.045);
        }

            .ticket-summary-info-card.highlight strong {
                color: var(--cinema-gold-light);
            }

    .ticket-summary-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin-top: 1.5rem;
        padding: 1.4rem 1.5rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: rgba(15, 21, 31, 0.68);
    }

    .ticket-summary-footer-label {
        display: block;
        margin-bottom: 0.25rem;
        color: var(--cinema-gold-light);
        font-size: 0.54rem;
        font-weight: 900;
        letter-spacing: 0.12em;
    }

    .ticket-summary-footer strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.86rem;
        overflow-wrap: anywhere;
    }

    .ticket-summary-footer p {
        margin: 0.25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.72rem;
    }

    .ticket-summary-actions {
        display: flex;
        flex: 0 0 auto;
        gap: 0.65rem;
    }

    @@keyframes ticket-success-enter {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 800px) {
        .ticket-summary-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .digital-ticket {
            grid-template-columns: 1fr;
        }

        .digital-ticket-stub {
            display: grid;
            grid-template-columns: repeat(4, auto);
            align-items: center;
