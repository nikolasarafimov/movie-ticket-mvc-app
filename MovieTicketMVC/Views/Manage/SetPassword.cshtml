@model MovieTicketMVC.Models.SetPasswordViewModel

@{
    ViewBag.Title = "Set Password";
}

<main class="set-password-page"
      aria-labelledby="set-password-title">

    <section class="set-password-shell">

        <div class="set-password-visual"
             aria-hidden="true">

            <div class="set-password-grid">
            </div>

            <div class="set-password-orbit
                        set-password-orbit-large">
            </div>

            <div class="set-password-orbit
                        set-password-orbit-small">
            </div>


            <div class="set-password-connection">

                <div class="set-password-account-icon">
                    <span>M</span>
                </div>

                <div class="set-password-connection-line">

                    <span></span>
                    <span></span>
                    <span></span>

                </div>

                <div class="set-password-key-icon">

                    <span class="set-password-key-head">
                    </span>

                    <span class="set-password-key-body">
                    </span>

                </div>

            </div>


            <div class="set-password-visual-copy">

                <span>
                    ADD LOCAL SIGN-IN
                </span>

                <strong>
                    Another Way to Sign In
                </strong>

                <p>
                    Add a local password and use
                    your email address to sign in
                    directly to MovieTicket.
                </p>

            </div>

        </div>


        <div class="set-password-content">

            <a class="set-password-brand"
               href="@Url.Action("Index", "Home")">

                <span></span>

                MOVIETICKET
            </a>


            <a class="set-password-back"
               href="@Url.Action("Index", "Manage")">

                <span aria-hidden="true">
                    ←
                </span>

                Account settings
            </a>


            <div class="set-password-heading">

                <div class="cinema-eyebrow">
                    CREATE LOCAL PASSWORD
                </div>

                <h1 id="set-password-title">
                    Set a
                    <span class="cinema-text-gradient">
                        Password
                    </span>
                </h1>

                <p>
                    Your account does not currently have a local
                    MovieTicket password. Create one so
                    you can also sign in using your email
                    address and password.
                </p>

            </div>


            <div class="set-password-info">

                <div class="set-password-info-icon"
                     aria-hidden="true">
                    +
                </div>

                <div>

                    <span>
                        NEW SIGN-IN METHOD
                    </span>

                    <strong>
                        Your Existing Account Stays the Same
                    </strong>

                    <p>
                        Setting a password simply adds
                        a local sign-in method to your
                        existing MovieTicket account.
                    </p>

                </div>

            </div>


            @using (Html.BeginForm(
                "SetPassword",
                "Manage",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "setPasswordForm",
                    @class = "set-password-form"
                }))
            {
                @Html.AntiForgeryToken()


                @Html.ValidationSummary(
                              true,
                              "",
                              new
                              {
                                  @class =
                                      "validation-summary-errors set-password-validation",
                                  role = "alert"
                              })


                <div class="form-group">

                    @Html.LabelFor(
                                  m => m.NewPassword,
                                  "New Password",
                                  new
                                  {
                                      @class = "form-label"
                                  })


                    <div class="set-password-input-wrapper">

                        <span class="set-password-input-icon"
                              aria-hidden="true">
                            •
                        </span>

                        @Html.PasswordFor(
                                      m => m.NewPassword,
                                      new
                                      {
                                          @class =
                                              "form-control set-password-input set-password-field",
                                          autocomplete =
                                              "new-password",
                                          placeholder =
                                              "Create a password",
                                          required =
                                              "required",
                                          minlength =
                                              "8",
                                          maxlength =
                                              "100",
                                          id =
                                              "NewPassword",
                                          autofocus =
                                              "autofocus"
                                      })


                        <button type="button"
                                class="set-password-toggle"
                                data-password-target="NewPassword"
                                aria-label="Show password"
                                aria-pressed="false">
                            SHOW
                        </button>

                    </div>


                    @Html.ValidationMessageFor(
                                  m => m.NewPassword,
                                  "",
                                  new
                                  {
                                      @class = "text-danger"
                                  })


                    <div class="set-password-strength">

                        <div class="set-password-strength-header">

                            <span>
                                Password Requirements Met
                            </span>

                            <strong id="passwordStrengthText">
                                —
                            </strong>

                        </div>


                        <div class="set-password-strength-track">

                            <span id="passwordStrengthBar">
                            </span>

                        </div>

                    </div>


                    <div class="set-password-requirements"
                         aria-label="Password requirements">

                        <div class="set-password-requirement"
                             id="requirementLength">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            8–100 characters

                        </div>


                        <div class="set-password-requirement"
                             id="requirementUpper">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Uppercase letter

                        </div>


                        <div class="set-password-requirement"
                             id="requirementLower">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Lowercase letter

                        </div>


                        <div class="set-password-requirement"
                             id="requirementNumber">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Number

                        </div>


                        <div class="set-password-requirement"
                             id="requirementSpecial">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Special character

                        </div>

                    </div>

                </div>


                <div class="form-group">

                    @Html.LabelFor(
                                  m => m.ConfirmPassword,
                                  "Confirm Password",
                                  new
                                  {
                                      @class = "form-label"
                                  })


                    <div class="set-password-input-wrapper">

                        <span class="set-password-input-icon"
                              aria-hidden="true">
                            •
                        </span>

                        @Html.PasswordFor(
                                      m => m.ConfirmPassword,
                                      new
                                      {
                                          @class =
                                              "form-control set-password-input set-password-field",
                                          autocomplete =
                                              "new-password",
                                          placeholder =
                                              "Re-enter your password",
                                          required =
                                              "required",
                                          id =
                                              "ConfirmPassword"
                                      })


                        <button type="button"
                                class="set-password-toggle"
                                data-password-target="ConfirmPassword"
                                aria-label="Show password"
                                aria-pressed="false">
                            SHOW
                        </button>

                    </div>


                    @Html.ValidationMessageFor(
                                  m => m.ConfirmPassword,
                                  "",
                                  new
                                  {
                                      @class = "text-danger"
                                  })


                    <div id="passwordMatchIndicator"
                         class="set-password-match"
                         aria-live="polite">
                    </div>

                    <div id="passwordClientError"
                         class="set-password-client-error"
                         role="alert"
                         hidden>
                    </div>

                </div>


                <div class="set-password-actions">

                    <a class="btn btn-outline-secondary"
                       href="@Url.Action(
                           "Index",
                           "Manage")">
                        Cancel
                    </a>


                    <button type="submit"
                            id="setPasswordButton"
                            class="btn btn-primary set-password-submit">

                        <span id="setPasswordButtonText">
                            Set Password
                        </span>

                        <span aria-hidden="true">
                            →
                        </span>

                    </button>

                </div>
            }


            <div class="set-password-security-note">

                <span aria-hidden="true">
                    ✓
                </span>

                <p>
                    Use a unique password that you do not
                    use for other accounts or services.
                </p>

            </div>

        </div>

    </section>

</main>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            "use strict";

            var form = document.getElementById("setPasswordForm");
            var newPassword = document.getElementById("NewPassword");
            var confirmPassword = document.getElementById("ConfirmPassword");
            var submitButton = document.getElementById("setPasswordButton");
            var submitButtonText = document.getElementById("setPasswordButtonText");
            var strengthBar = document.getElementById("passwordStrengthBar");
            var strengthText = document.getElementById("passwordStrengthText");
            var matchIndicator = document.getElementById("passwordMatchIndicator");
            var clientError = document.getElementById("passwordClientError");
            var toggleButtons = document.querySelectorAll(".set-password-toggle");
            var submitting = false;

            if (!form || !newPassword || !confirmPassword ||
                !submitButton || !submitButtonText) {
                return;
            }

            var requirements = {
                length: document.getElementById("requirementLength"),
                upper: document.getElementById("requirementUpper"),
                lower: document.getElementById("requirementLower"),
                number: document.getElementById("requirementNumber"),
                special: document.getElementById("requirementSpecial")
            };

            var upperRegex = /[A-Z\u0410-\u042F\u0401\u0403\u040C\u0405\u0409\u040A\u040F\u0407\u0406\u0404\u0490]/;
            var lowerRegex = /[a-z\u0430-\u044F\u0451\u0453\u045C\u0455\u0459\u045A\u045F\u0457\u0456\u0454\u0491]/;
            var numberRegex = /[0-9]/;
            var specialRegex = /[^A-Za-z0-9\u0410-\u042F\u0430-\u044F\u0401\u0451\u0403\u0453\u040C\u045C\u0405\u0455\u0409\u0459\u040A\u045A\u040F\u045F\u0407\u0457\u0406\u0456\u0404\u0454\u0490\u0491]/;

            try {
                upperRegex = new RegExp("\\p{Lu}", "u");
                lowerRegex = new RegExp("\\p{Ll}", "u");
                numberRegex = new RegExp("\\p{Nd}", "u");
                specialRegex = new RegExp("[^\\p{L}\\p{N}]", "u");
            } catch (error) {
            }

            function getChecks(value) {
                return {
                    length: value.length >= 8 && value.length <= 100,
                    upper: upperRegex.test(value),
                    lower: lowerRegex.test(value),
                    number: numberRegex.test(value),
                    special: specialRegex.test(value)
                };
            }

            function setRequirement(element, isValid) {
                if (!element) {
                    return;
                }

                element.classList.toggle("valid", isValid);
            }

            function clearClientError() {
                if (!clientError) {
                    return;
                }

                clientError.textContent = "";
                clientError.hidden = true;
            }

            function showClientError(message) {
                if (!clientError) {
                    return;
                }

                clientError.textContent = message;
                clientError.hidden = false;
            }

            function updatePasswordMatch() {
                if (!matchIndicator) {
                    return;
                }

                var confirmation = confirmPassword.value;

                matchIndicator.classList.remove("valid", "invalid");

                if (!confirmation) {
                    matchIndicator.textContent = "";
                    return;
                }

                if (newPassword.value === confirmation) {
                    matchIndicator.classList.add("valid");
                    matchIndicator.textContent = "Passwords match.";
                } else {
                    matchIndicator.classList.add("invalid");
                    matchIndicator.textContent = "Passwords do not match.";
                }
            }

            function updatePasswordRules() {
                var value = newPassword.value || "";
                var checks = getChecks(value);
                var satisfied = 0;
                var key;

                for (key in checks) {
                    if (Object.prototype.hasOwnProperty.call(checks, key)) {
                        setRequirement(requirements[key], checks[key]);

                        if (checks[key]) {
                            satisfied++;
                        }
                    }
                }

                if (strengthBar && strengthText) {
                    strengthBar.className = "";

                    if (!value) {
                        strengthBar.style.width = "0%";
                        strengthText.textContent = "—";
                    } else {
                        strengthBar.style.width = (satisfied * 20) + "%";

                        if (satisfied <= 2) {
                            strengthBar.classList.add("weak");
                        } else if (satisfied <= 4) {
                            strengthBar.classList.add("medium");
                        } else {
                            strengthBar.classList.add("strong");
                        }

                        strengthText.textContent =
                            satisfied === 5
                                ? "All 5 requirements met"
                                : satisfied + " of 5 requirements";
                    }
                }

                updatePasswordMatch();
            }

            function hasValidPassword() {
                var checks = getChecks(newPassword.value);

                return checks.length &&
                    checks.upper &&
                    checks.lower &&
                    checks.number &&
                    checks.special;
            }

            Array.prototype.forEach.call(toggleButtons, function (button) {
                button.addEventListener("click", function () {
                    var targetId = button.getAttribute("data-password-target");
                    var input = document.getElementById(targetId);

                    if (!input) {
                        return;
                    }

                    var willShow = input.type === "password";

                    input.type = willShow ? "text" : "password";
                    button.textContent = willShow ? "HIDE" : "SHOW";
                    button.setAttribute("aria-pressed", willShow ? "true" : "false");
                    button.setAttribute(
                        "aria-label",
                        willShow ? "Hide password" : "Show password"
                    );
                });
            });

            newPassword.addEventListener("input", function () {
                clearClientError();
                updatePasswordRules();
            });

            confirmPassword.addEventListener("input", function () {
                clearClientError();
                updatePasswordMatch();
            });

            form.addEventListener("submit", function (event) {
                if (submitting) {
                    event.preventDefault();
                    return;
                }

                clearClientError();
                updatePasswordRules();

                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.reportValidity();
                    return;
                }

                if (window.jQuery &&
                    jQuery.validator &&
                    typeof jQuery(form).valid === "function" &&
                    !jQuery(form).valid()) {
                    event.preventDefault();
                    return;
                }

                if (!hasValidPassword()) {
                    event.preventDefault();
                    showClientError(
                        "The new password must be 8–100 characters long and include " +
                        "uppercase and lowercase letters, a number, and a special character."
                    );
                    newPassword.focus();
                    return;
                }

                if (newPassword.value !== confirmPassword.value) {
                    event.preventDefault();
                    showClientError("The confirmation does not match the new password.");
                    confirmPassword.focus();
                    return;
                }

                if (event.defaultPrevented) {
                    return;
                }

                submitting = true;
                submitButton.disabled = true;
                submitButton.setAttribute("aria-busy", "true");
                submitButtonText.textContent = "Setting password...";
            });

            window.addEventListener("pageshow", function (event) {
                if (event.persisted && submitting) {
                    submitting = false;
                    submitButton.disabled = false;
                    submitButton.removeAttribute("aria-busy");
                    submitButtonText.textContent = "Set Password";
                }
            });

            updatePasswordRules();
        })();
    </script>
}

<style>
    .set-password-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .set-password-shell {
        display: grid;
        grid-template-columns: minmax(300px, 0.8fr) minmax(450px, 1.2fr);
        width: min(100%, 1020px);
        min-height: 770px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }

    .set-password-visual {
        position: relative;
        display: grid;
        min-width: 0;
        place-items: center;
        overflow: hidden;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient( circle at 50% 40%, rgba(214, 168, 75, 0.12), transparent 31% ), radial-gradient( circle at 0% 100%, rgba(58, 100, 168, 0.14), transparent 32% ), linear-gradient( 145deg, #151e2b, #0a0f17 58%, #06090e );
        isolation: isolate;
    }

    .set-password-grid {
        position: absolute;
        z-index: -2;
        inset: 0;
        opacity: 0.25;
        background-image: linear-gradient( rgba(255, 255, 255, 0.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px );
        background-size: 44px 44px;
    }

    .set-password-connection {
        position: absolute;
        top: 175px;
        left: 50%;
        z-index: 4;
        display: flex;
        align-items: center;
        transform: translateX(-50%);
    }

    .set-password-account-icon,
    .set-password-key-icon {
        position: relative;
        display: grid;
        flex: 0 0 78px;
        width: 78px;
        height: 78px;
        place-items: center;
        border-radius: 22px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.32);
    }

    .set-password-account-icon {
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.26);
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.15), rgba(214, 168, 75, 0.045) );
    }

        .set-password-account-icon span {
            font-size: 1.45rem;
            font-weight: 900;
            letter-spacing: -0.06em;
        }

    .set-password-key-icon {
        border: 1px solid rgba(66, 199, 131, 0.23);
        background: linear-gradient( 145deg, rgba(66, 199, 131, 0.12), rgba(66, 199, 131, 0.035) );
    }

    .set-password-key-head {
        position: absolute;
        top: 23px;
        left: 20px;
        width: 22px;
        height: 22px;
        border: 3px solid #9ae8bd;
        border-radius: 50%;
    }

    .set-password-key-body {
        position: absolute;
        top: 38px;
        left: 39px;
        width: 28px;
        height: 3px;
        border-radius: 999px;
        background: #9ae8bd;
        transform: rotate(-35deg);
        transform-origin: left center;
    }

        .set-password-key-body::after {
            position: absolute;
            right: 4px;
            bottom: -6px;
            width: 3px;
            height: 9px;
            content: "";
            background: #9ae8bd;
        }

    .set-password-connection-line {
        position: relative;
        display: flex;
        width: 92px;
        align-items: center;
        justify-content: space-evenly;
    }

        .set-password-connection-line::before {
            position: absolute;
            top: 50%;
            right: 0;
            left: 0;
            height: 1px;
            content: "";
            background: linear-gradient( 90deg, rgba(214, 168, 75, 0.34), rgba(66, 199, 131, 0.40) );
            transform: translateY(-50%);
        }

        .set-password-connection-line > span {
            position: relative;
            z-index: 2;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--cinema-gold-light);
            box-shadow: 0 0 12px rgba(214, 168, 75, 0.55);
            animation: set-password-pulse 1.8s ease-in-out infinite;
        }

            .set-password-connection-line > span:nth-child(2) {
                animation-delay: 0.3s;
            }

            .set-password-connection-line > span:nth-child(3) {
                animation-delay: 0.6s;
            }

    .set-password-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: set-password-orbit-spin 26s linear infinite;
    }

        .set-password-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.68);
        }

    .set-password-orbit-large {
        top: 95px;
        left: 50%;
        width: 330px;
        height: 330px;
        transform: translateX(-50%);
    }

    .set-password-orbit-small {
        top: 145px;
        left: 50%;
        width: 230px;
        height: 230px;
        animation-direction: reverse;
        animation-duration: 18s;
        transform: translateX(-50%);
    }

    .set-password-visual-copy {
        position: absolute;
        right: 2rem;
        bottom: 3.2rem;
        left: 2rem;
        z-index: 4;
        text-align: center;
    }

        .set-password-visual-copy > span {
            display: block;
            margin-bottom: 0.45rem;
            color: var(--cinema-gold-light);
            font-size: 0.55rem;
            font-weight: 900;
            letter-spacing: 0.16em;
        }

        .set-password-visual-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 1.35rem;
        }

        .set-password-visual-copy p {
            max-width: 290px;
            margin: 0.55rem auto 0;
            color: var(--cinema-text-muted);
            font-size: 0.72rem;
            line-height: 1.6;
        }

    .set-password-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 4rem);
        background: linear-gradient( 180deg, rgba(14, 19, 28, 0.99), rgba(8, 11, 17, 0.99) );
    }

    .set-password-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.6rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .set-password-brand:hover {
            color: var(--cinema-gold-light);
        }

        .set-password-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }

    .set-password-back {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1.7rem;
        color: var(--cinema-text-muted);
        font-size: 0.7rem;
        font-weight: 600;
    }

        .set-password-back > span {
            transition: transform var(--cinema-transition);
        }

        .set-password-back:hover {
            color: var(--cinema-gold-light);
        }

            .set-password-back:hover > span {
                transform: translateX(-4px);
            }

    .set-password-heading {
        margin-bottom: 1.3rem;
    }

        .set-password-heading h1 {
            margin-bottom: 0.8rem;
            font-size: clamp( 2.2rem, 5vw, 3.2rem );
            line-height: 1.02;
            letter-spacing: -0.05em;
        }

        .set-password-heading p {
            max-width: 520px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.82rem;
            line-height: 1.7;
        }

    .set-password-info {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        margin-bottom: 1.5rem;
        padding: 0.9rem;
        border: 1px solid rgba(214, 168, 75, 0.14);
        border-radius: 12px;
        background: rgba(214, 168, 75, 0.035);
    }

    .set-password-info-icon {
        display: grid;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.20);
        border-radius: 11px;
        background: rgba(214, 168, 75, 0.06);
        font-size: 1rem;
        font-weight: 500;
    }

    .set-password-info div:last-child > span {
        display: block;
        margin-bottom: 0.15rem;
        color: var(--cinema-gold-light);
        font-size: 0.5rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .set-password-info strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.76rem;
    }

    .set-password-info p {
        margin: 0.2rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.64rem;
        line-height: 1.5;
    }

    .set-password-validation {
        margin-bottom: 1rem;
    }

        .set-password-validation:empty {
            display: none;
        }

    .set-password-input-wrapper {
        position: relative;
    }

    .set-password-input {
        min-height: 52px;
        padding-left: 3rem;
    }

    .set-password-field {
        padding-right: 4.8rem;
