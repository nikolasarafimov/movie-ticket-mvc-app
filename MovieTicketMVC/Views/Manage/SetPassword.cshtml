@model MovieTicketMVC.Models.SetPasswordViewModel

@{
    ViewBag.Title = "Постави лозинка";
}

<main class="set-password-page"
      aria-labelledby="set-password-title">

    <section class="set-password-shell">

        <div class="set-password-visual"
             aria-hidden="true">

            <div class="set-password-grid">
            </div>

            <div class="set-password-orbit
                        set-password-orbit-large">
            </div>

            <div class="set-password-orbit
                        set-password-orbit-small">
            </div>


            <div class="set-password-connection">

                <div class="set-password-account-icon">
                    <span>M</span>
                </div>

                <div class="set-password-connection-line">

                    <span></span>
                    <span></span>
                    <span></span>

                </div>

                <div class="set-password-key-icon">

                    <span class="set-password-key-head">
                    </span>

                    <span class="set-password-key-body">
                    </span>

                </div>

            </div>


            <div class="set-password-visual-copy">

                <span>
                    ADD LOCAL SIGN-IN
                </span>

                <strong>
                    Уште еден начин за најава
                </strong>

                <p>
                    Додај локална лозинка и користи
                    ја e-mail адресата за директно
                    MovieTicket најавување.
                </p>

            </div>

        </div>


        <div class="set-password-content">

            <a class="set-password-brand"
               href="@Url.Action("Index", "Home")">

                <span></span>

                MOVIETICKET
            </a>


            <a class="set-password-back"
               href="@Url.Action("Index", "Manage")">

                <span aria-hidden="true">
                    ←
                </span>

                Account settings
            </a>


            <div class="set-password-heading">

                <div class="cinema-eyebrow">
                    CREATE LOCAL PASSWORD
                </div>

                <h1 id="set-password-title">
                    Постави
                    <span class="cinema-text-gradient">
                        лозинка
                    </span>
                </h1>

                <p>
                    Твојот профил моментално нема локална
                    MovieTicket лозинка. Креирај една за
                    да можеш да се најавуваш и со e-mail
                    адреса и лозинка.
                </p>

            </div>


            <div class="set-password-info">

                <div class="set-password-info-icon"
                     aria-hidden="true">
                    +
                </div>

                <div>

                    <span>
                        NEW SIGN-IN METHOD
                    </span>

                    <strong>
                        Постоечкиот профил останува ист
                    </strong>

                    <p>
                        Со поставувањето лозинка само додаваш
                        локален начин за најава на истиот
                        MovieTicket профил.
                    </p>

                </div>

            </div>


            @using (Html.BeginForm(
                "SetPassword",
                "Manage",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "setPasswordForm",
                    @class = "set-password-form"
                }))
            {
                @Html.AntiForgeryToken()


                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class =
                            "validation-summary-errors set-password-validation"
                    })


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.NewPassword,
                        "Нова лозинка",
                        new
                        {
                            @class = "form-label"
                        })


                    <div class="set-password-input-wrapper">

                        <span class="set-password-input-icon"
                              aria-hidden="true">
                            •
                        </span>

                        @Html.PasswordFor(
                            m => m.NewPassword,
                            new
                            {
                                @class =
                                    "form-control set-password-input set-password-field",
                                autocomplete =
                                    "new-password",
                                placeholder =
                                    "Креирај лозинка",
                                id =
                                    "NewPassword",
                                autofocus =
                                    "autofocus"
                            })


                        <button type="button"
                                class="set-password-toggle"
                                data-password-target="NewPassword"
                                aria-label="Прикажи лозинка"
                                aria-pressed="false">
                            SHOW
                        </button>

                    </div>


                    @Html.ValidationMessageFor(
                        m => m.NewPassword,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })


                    <div class="set-password-strength">

                        <div class="set-password-strength-header">

                            <span>
                                Сигурност на лозинката
                            </span>

                            <strong id="passwordStrengthText">
                                —
                            </strong>

                        </div>


                        <div class="set-password-strength-track">

                            <span id="passwordStrengthBar">
                            </span>

                        </div>

                    </div>


                    <div class="set-password-requirements"
                         aria-label="Услови за лозинка">

                        <div class="set-password-requirement"
                             id="requirementLength">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Најмалку 8 карактери

                        </div>


                        <div class="set-password-requirement"
                             id="requirementUpper">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Голема буква

                        </div>


                        <div class="set-password-requirement"
                             id="requirementLower">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Мала буква

                        </div>


                        <div class="set-password-requirement"
                             id="requirementNumber">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Број

                        </div>


                        <div class="set-password-requirement"
                             id="requirementSpecial">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            Специјален карактер

                        </div>

                    </div>

                </div>


                <div class="form-group">

                    @Html.LabelFor(
                        m => m.ConfirmPassword,
                        "Потврди лозинка",
                        new
                        {
                            @class = "form-label"
                        })


                    <div class="set-password-input-wrapper">

                        <span class="set-password-input-icon"
                              aria-hidden="true">
                            •
                        </span>

                        @Html.PasswordFor(
                            m => m.ConfirmPassword,
                            new
                            {
                                @class =
                                    "form-control set-password-input set-password-field",
                                autocomplete =
                                    "new-password",
                                placeholder =
                                    "Повтори ја лозинката",
                                id =
                                    "ConfirmPassword"
                            })


                        <button type="button"
                                class="set-password-toggle"
                                data-password-target="ConfirmPassword"
                                aria-label="Прикажи лозинка"
                                aria-pressed="false">
                            SHOW
                        </button>

                    </div>


                    @Html.ValidationMessageFor(
                        m => m.ConfirmPassword,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })


                    <div id="passwordMatchIndicator"
                         class="set-password-match"
                         aria-live="polite">
                    </div>

                </div>


                <div class="set-password-actions">

                    <a class="btn btn-outline-secondary"
                       href="@Url.Action(
                           "Index",
                           "Manage")">
                        Откажи
                    </a>


                    <button type="submit"
                            id="setPasswordButton"
                            class="btn btn-primary set-password-submit">

                        <span id="setPasswordButtonText">
                            Постави лозинка
                        </span>

                        <span aria-hidden="true">
                            →
                        </span>

                    </button>

                </div>
            }


            <div class="set-password-security-note">

                <span aria-hidden="true">
                    ✓
                </span>

                <p>
                    Користи уникатна лозинка што не ја
                    користиш за други профили или сервиси.
                </p>

            </div>

        </div>

    </section>

</main>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            var form =
                document.getElementById(
                    "setPasswordForm");

            var newPassword =
                document.getElementById(
                    "NewPassword");

            var confirmPassword =
                document.getElementById(
                    "ConfirmPassword");

            var submitButton =
                document.getElementById(
                    "setPasswordButton");

            var submitButtonText =
                document.getElementById(
                    "setPasswordButtonText");

            var strengthBar =
                document.getElementById(
                    "passwordStrengthBar");

            var strengthText =
                document.getElementById(
                    "passwordStrengthText");

            var matchIndicator =
                document.getElementById(
                    "passwordMatchIndicator");


            var requirements =
                {
                    length:
                        document.getElementById(
                            "requirementLength"),

                    upper:
                        document.getElementById(
                            "requirementUpper"),

                    lower:
                        document.getElementById(
                            "requirementLower"),

                    number:
                        document.getElementById(
                            "requirementNumber"),

                    special:
                        document.getElementById(
                            "requirementSpecial")
                };


            function setRequirement(
                element,
                valid) {

                if (!element) {
                    return;
                }

                element.classList.toggle(
                    "valid",
                    valid);
            }


            function evaluatePassword() {
                if (
                    !newPassword ||
                    !strengthBar ||
                    !strengthText
                ) {
                    return;
                }


                var value =
                    newPassword.value || "";


                var checks =
                    {
                        length:
                            value.length >= 8,

                        upper:
                            /[A-Z]/.test(value),

                        lower:
                            /[a-z]/.test(value),

                        number:
                            /\d/.test(value),

                        special:
                            /[^A-Za-z0-9]/.test(value)
                    };


                setRequirement(
                    requirements.length,
                    checks.length);

                setRequirement(
                    requirements.upper,
                    checks.upper);

                setRequirement(
                    requirements.lower,
                    checks.lower);

                setRequirement(
                    requirements.number,
                    checks.number);

                setRequirement(
                    requirements.special,
                    checks.special);


                var score =
                    Object.keys(checks)
                        .filter(function (key) {
                            return checks[key];
                        })
                        .length;


                strengthBar.className =
                    "";


                if (!value) {
                    strengthBar.style.width =
                        "0%";

                    strengthText.textContent =
                        "—";
                }
                else if (score <= 2) {
                    strengthBar.style.width =
                        "35%";

                    strengthBar.classList.add(
                        "weak");

                    strengthText.textContent =
                        "Слаба";
                }
                else if (score <= 4) {
                    strengthBar.style.width =
                        "68%";

                    strengthBar.classList.add(
                        "medium");

                    strengthText.textContent =
                        "Добра";
                }
                else {
                    strengthBar.style.width =
                        "100%";

                    strengthBar.classList.add(
                        "strong");

                    strengthText.textContent =
                        "Силна";
                }


                evaluatePasswordMatch();
            }


            function evaluatePasswordMatch() {
                if (
                    !newPassword ||
                    !confirmPassword ||
                    !matchIndicator
                ) {
                    return;
                }


                var confirmation =
                    confirmPassword.value || "";


                matchIndicator.classList.remove(
                    "valid",
                    "invalid");


                if (!confirmation) {
                    matchIndicator.textContent =
                        "";

                    return;
                }


                if (
                    newPassword.value ===
                    confirmation
                ) {
                    matchIndicator.classList.add(
                        "valid");

                    matchIndicator.textContent =
                        "Лозинките се совпаѓаат.";
                }
                else {
                    matchIndicator.classList.add(
                        "invalid");

                    matchIndicator.textContent =
                        "Лозинките не се совпаѓаат.";
                }
            }


            var toggleButtons =
                document.querySelectorAll(
                    ".set-password-toggle");


            Array.prototype.forEach.call(
                toggleButtons,
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            var targetId =
                                button.getAttribute(
                                    "data-password-target");

                            var input =
                                document.getElementById(
                                    targetId);


                            if (!input) {
                                return;
                            }


                            var isHidden =
                                input.type ===
                                "password";


                            input.type =
                                isHidden
                                    ? "text"
                                    : "password";


                            button.textContent =
                                isHidden
                                    ? "HIDE"
                                    : "SHOW";


                            button.setAttribute(
                                "aria-pressed",
                                isHidden
                                    ? "true"
                                    : "false");


                            button.setAttribute(
                                "aria-label",
                                isHidden
                                    ? "Сокриј лозинка"
                                    : "Прикажи лозинка");
                        });
                });


            if (newPassword) {
                newPassword.addEventListener(
                    "input",
                    evaluatePassword);
            }


            if (confirmPassword) {
                confirmPassword.addEventListener(
                    "input",
                    evaluatePasswordMatch);
            }


            if (
                form &&
                submitButton &&
                submitButtonText
            ) {
                form.addEventListener(
                    "submit",
                    function () {

                        if (
                            typeof $ !== "undefined" &&
                            $.validator &&
                            !$(form).valid()
                        ) {
                            return;
                        }


                        submitButton.disabled =
                            true;

                        submitButtonText.textContent =
                            "Се поставува...";
                    });
            }


            evaluatePassword();
            evaluatePasswordMatch();
        })();
    </script>
}


<style>
    .set-password-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .set-password-shell {
        display: grid;
        grid-template-columns: minmax(300px, 0.8fr) minmax(450px, 1.2fr);
        width: min(100%, 1020px);
        min-height: 770px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }


    /* =====================================================
       VISUAL
       ===================================================== */

    .set-password-visual {
        position: relative;
        display: grid;
        min-width: 0;
        place-items: center;
        overflow: hidden;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient( circle at 50% 40%, rgba(214, 168, 75, 0.12), transparent 31% ), radial-gradient( circle at 0% 100%, rgba(58, 100, 168, 0.14), transparent 32% ), linear-gradient( 145deg, #151e2b, #0a0f17 58%, #06090e );
        isolation: isolate;
    }

    .set-password-grid {
        position: absolute;
        z-index: -2;
        inset: 0;
        opacity: 0.25;
        background-image: linear-gradient( rgba(255, 255, 255, 0.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px );
        background-size: 44px 44px;
    }


    /* =====================================================
       CONNECTION ART
       ===================================================== */

    .set-password-connection {
        position: absolute;
        top: 175px;
        left: 50%;
        z-index: 4;
        display: flex;
        align-items: center;
        transform: translateX(-50%);
    }

    .set-password-account-icon,
    .set-password-key-icon {
        position: relative;
        display: grid;
        flex: 0 0 78px;
        width: 78px;
        height: 78px;
        place-items: center;
        border-radius: 22px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.32);
    }

    .set-password-account-icon {
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.26);
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.15), rgba(214, 168, 75, 0.045) );
    }

        .set-password-account-icon span {
            font-size: 1.45rem;
            font-weight: 900;
            letter-spacing: -0.06em;
        }

    .set-password-key-icon {
        border: 1px solid rgba(66, 199, 131, 0.23);
        background: linear-gradient( 145deg, rgba(66, 199, 131, 0.12), rgba(66, 199, 131, 0.035) );
    }

    .set-password-key-head {
        position: absolute;
        top: 23px;
        left: 20px;
        width: 22px;
        height: 22px;
        border: 3px solid #9ae8bd;
        border-radius: 50%;
    }

    .set-password-key-body {
        position: absolute;
        top: 38px;
        left: 39px;
        width: 28px;
        height: 3px;
        border-radius: 999px;
        background: #9ae8bd;
        transform: rotate(-35deg);
        transform-origin: left center;
    }

        .set-password-key-body::after {
            position: absolute;
            right: 4px;
            bottom: -6px;
            width: 3px;
            height: 9px;
            content: "";
            background: #9ae8bd;
        }

    .set-password-connection-line {
        position: relative;
        display: flex;
        width: 92px;
        align-items: center;
        justify-content: space-evenly;
    }

        .set-password-connection-line::before {
            position: absolute;
            top: 50%;
            right: 0;
            left: 0;
            height: 1px;
            content: "";
            background: linear-gradient( 90deg, rgba(214, 168, 75, 0.34), rgba(66, 199, 131, 0.40) );
            transform: translateY(-50%);
        }

        .set-password-connection-line > span {
            position: relative;
            z-index: 2;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--cinema-gold-light);
            box-shadow: 0 0 12px rgba(214, 168, 75, 0.55);
            animation: set-password-pulse 1.8s ease-in-out infinite;
        }

            .set-password-connection-line > span:nth-child(2) {
                animation-delay: 0.3s;
            }

            .set-password-connection-line > span:nth-child(3) {
                animation-delay: 0.6s;
            }


    /* =====================================================
       ORBITS
       ===================================================== */

    .set-password-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: set-password-orbit-spin 26s linear infinite;
    }

        .set-password-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.68);
        }

    .set-password-orbit-large {
        top: 95px;
        left: 50%;
        width: 330px;
        height: 330px;
        transform: translateX(-50%);
    }

    .set-password-orbit-small {
        top: 145px;
        left: 50%;
        width: 230px;
        height: 230px;
        animation-direction: reverse;
        animation-duration: 18s;
        transform: translateX(-50%);
    }


    /* =====================================================
       VISUAL COPY
       ===================================================== */

    .set-password-visual-copy {
        position: absolute;
        right: 2rem;
        bottom: 3.2rem;
        left: 2rem;
        z-index: 4;
        text-align: center;
    }

        .set-password-visual-copy > span {
            display: block;
            margin-bottom: 0.45rem;
            color: var(--cinema-gold-light);
            font-size: 0.55rem;
            font-weight: 900;
            letter-spacing: 0.16em;
        }

        .set-password-visual-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 1.35rem;
        }

        .set-password-visual-copy p {
            max-width: 290px;
            margin: 0.55rem auto 0;
            color: var(--cinema-text-muted);
            font-size: 0.72rem;
            line-height: 1.6;
        }


    /* =====================================================
       CONTENT
       ===================================================== */

    .set-password-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 4rem);
        background: linear-gradient( 180deg, rgba(14, 19, 28, 0.99), rgba(8, 11, 17, 0.99) );
    }


    /* =====================================================
       BRAND / BACK
       ===================================================== */

    .set-password-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.6rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .set-password-brand:hover {
            color: var(--cinema-gold-light);
        }

        .set-password-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }

    .set-password-back {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1.7rem;
        color: var(--cinema-text-muted);
        font-size: 0.7rem;
        font-weight: 600;
    }

        .set-password-back > span {
            transition: transform var(--cinema-transition);
        }

        .set-password-back:hover {
            color: var(--cinema-gold-light);
        }

            .set-password-back:hover > span {
                transform: translateX(-4px);
            }


    /* =====================================================
       HEADING
       ===================================================== */

    .set-password-heading {
        margin-bottom: 1.3rem;
    }

        .set-password-heading h1 {
            margin-bottom: 0.8rem;
            font-size: clamp( 2.2rem, 5vw, 3.2rem );
            line-height: 1.02;
            letter-spacing: -0.05em;
        }

        .set-password-heading p {
            max-width: 520px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.82rem;
            line-height: 1.7;
        }


    /* =====================================================
       INFORMATION
       ===================================================== */

    .set-password-info {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        margin-bottom: 1.5rem;
        padding: 0.9rem;
        border: 1px solid rgba(214, 168, 75, 0.14);
        border-radius: 12px;
        background: rgba(214, 168, 75, 0.035);
    }

    .set-password-info-icon {
        display: grid;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.20);
        border-radius: 11px;
        background: rgba(214, 168, 75, 0.06);
        font-size: 1rem;
        font-weight: 500;
    }

    .set-password-info div:last-child > span {
        display: block;
        margin-bottom: 0.15rem;
        color: var(--cinema-gold-light);
        font-size: 0.5rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .set-password-info strong {
        display: block;
        color: var(--cinema-text);
        font-size: 0.76rem;
    }

    .set-password-info p {
        margin: 0.2rem 0 0;
        color: var(--cinema-text-muted);
        font-size: 0.64rem;
        line-height: 1.5;
    }


    /* =====================================================
       FORM
       ===================================================== */

    .set-password-validation {
        margin-bottom: 1rem;
    }

        .set-password-validation:empty {
            display: none;
        }

    .set-password-input-wrapper {
        position: relative;
    }

    .set-password-input {
        min-height: 52px;
        padding-left: 3rem;
    }

    .set-password-field {
        padding-right: 4.8rem;
    }

    .set-password-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        color: var(--cinema-text-muted);
        font-size: 1.15rem;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .set-password-toggle {
        position: absolute;
        z-index: 3;
        top: 50%;
