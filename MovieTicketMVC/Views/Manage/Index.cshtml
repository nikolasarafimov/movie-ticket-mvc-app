@model MovieTicketMVC.Models.IndexViewModel

@{
    ViewBag.Title = "Управување со профил";

    var externalLoginCount =
        Model.Logins != null
            ? Model.Logins.Count
            : 0;
}

<main class="account-page"
      aria-labelledby="account-title">

    <section class="account-hero">

        <div class="account-hero-glow"
             aria-hidden="true">
        </div>

        <div class="account-hero-copy">

            <div class="cinema-eyebrow">
                ACCOUNT & SECURITY
            </div>

            <h1 id="account-title">
                Твојот
                <span class="cinema-text-gradient">
                    профил
                </span>
            </h1>

            <p>
                Управувај со лозинката, поврзаните начини
                за најава и безбедносните поставки
                на MovieTicket профилот.
            </p>

        </div>


        <div class="account-hero-security"
             aria-hidden="true">

            <div class="account-security-ring
                        account-security-ring-one">
            </div>

            <div class="account-security-ring
                        account-security-ring-two">
            </div>

            <div class="account-security-shield">

                <span>
                    ✓
                </span>

            </div>

        </div>

    </section>


    @if (!string.IsNullOrWhiteSpace(
        ViewBag.StatusMessage as string))
    {
        <div class="account-status-message"
             role="status">

            <div class="account-status-icon"
                 aria-hidden="true">
                ✓
            </div>

            <div>

                <span>
                    ACCOUNT UPDATE
                </span>

                <p>
                    @ViewBag.StatusMessage
                </p>

            </div>

        </div>
    }


    <section class="account-overview"
             aria-label="Преглед на безбедносни поставки">

        <article class="account-overview-card">

            <span class="account-overview-label">
                PASSWORD
            </span>

            <strong>
                @(Model.HasPassword
                    ? "Поставена"
                    : "Не е поставена")
            </strong>

            <span class="account-overview-indicator
                         @(Model.HasPassword ? "active" : "warning")">
            </span>

        </article>


        <article class="account-overview-card">

            <span class="account-overview-label">
                EXTERNAL LOGINS
            </span>

            <strong>
                @externalLoginCount
            </strong>

            <small>
                @(externalLoginCount == 1
                    ? "поврзан профил"
                    : "поврзани профили")
            </small>

        </article>


        <article class="account-overview-card">

            <span class="account-overview-label">
                TWO-FACTOR
            </span>

            <strong>
                @(Model.TwoFactor
                    ? "Активна"
                    : "Неактивна")
            </strong>

            <span class="account-overview-indicator
                         @(Model.TwoFactor ? "active" : "muted")">
            </span>

        </article>

    </section>


    <section class="account-settings">

        <div class="account-section-heading">

            <div>

                <div class="cinema-eyebrow">
                    SECURITY SETTINGS
                </div>

                <h2>
                    Безбедност на профилот
                </h2>

            </div>

            <p>
                Контролирај како се најавуваш и како
                MovieTicket го штити пристапот до профилот.
            </p>

        </div>


        <div class="account-settings-grid">

            <article class="account-setting-card">

                <div class="account-setting-top">

                    <div class="account-setting-icon
                                password"
                         aria-hidden="true">

                        <span class="account-lock">
                        </span>

                    </div>

                    <div class="account-setting-status
                                @(Model.HasPassword
                                    ? "success"
                                    : "warning")">

                        <span></span>

                        @(Model.HasPassword
                            ? "ACTIVE"
                            : "SETUP REQUIRED")

                    </div>

                </div>


                <div class="account-setting-content">

                    <span class="account-setting-number">
                        01
                    </span>

                    <h3>
                        Лозинка
                    </h3>

                    @if (Model.HasPassword)
                    {
                        <p>
                            Твојот профил има поставена лозинка.
                            Промени ја периодично или доколку
                            сметаш дека повеќе не е безбедна.
                        </p>
                    }
                    else
                    {
                        <p>
                            Профилот моментално нема локална
                            MovieTicket лозинка. Можеш да
                            поставиш една за дополнителен
                            начин на најава.
                        </p>
                    }

                </div>


                <div class="account-setting-footer">

                    @if (Model.HasPassword)
                    {
                        <a class="btn btn-outline-secondary
                                  account-setting-action"
                           href="@Url.Action(
                               "ChangePassword",
                               "Manage")">

                            <span>
                                Промени лозинка
                            </span>

                            <span aria-hidden="true">
                                →
                            </span>

                        </a>
                    }
                    else
                    {
                        <a class="btn btn-primary
                                  account-setting-action"
                           href="@Url.Action(
                               "SetPassword",
                               "Manage")">

                            <span>
                                Постави лозинка
                            </span>

                            <span aria-hidden="true">
                                →
                            </span>

                        </a>
                    }

                </div>

            </article>


            <article class="account-setting-card">

                <div class="account-setting-top">

                    <div class="account-setting-icon
                                connections"
                         aria-hidden="true">

                        <span></span>
                        <span></span>

                    </div>

                    <div class="account-setting-status neutral">

                        @externalLoginCount

                        @(externalLoginCount == 1
                            ? " CONNECTION"
                            : " CONNECTIONS")

                    </div>

                </div>


                <div class="account-setting-content">

                    <span class="account-setting-number">
                        02
                    </span>

                    <h3>
                        External logins
                    </h3>

                    <p>
                        Прегледај ги надворешните профили
                        поврзани со твојот MovieTicket account
                        и управувај со достапните начини
                        за најава.
                    </p>

                </div>


                <div class="account-setting-footer">

                    <a class="btn btn-outline-secondary
                              account-setting-action"
                       href="@Url.Action(
                           "ManageLogins",
                           "Manage")">

                        <span>
                            Управувај со поврзувања
                        </span>

                        <span aria-hidden="true">
                            →
                        </span>

                    </a>

                </div>

            </article>


            <article class="account-setting-card
                            account-two-factor-card
                            @(Model.TwoFactor
                                ? "enabled"
                                : "")">

                <div class="account-setting-top">

                    <div class="account-setting-icon
                                two-factor"
                         aria-hidden="true">

                        <span>
                            2
                        </span>

                    </div>


                    <div class="account-setting-status
                                @(Model.TwoFactor
                                    ? "success"
                                    : "muted")">

                        <span></span>

                        @(Model.TwoFactor
                            ? "ENABLED"
                            : "DISABLED")

                    </div>

                </div>


                <div class="account-setting-content">

                    <span class="account-setting-number">
                        03
                    </span>

                    <h3>
                        Two-factor authentication
                    </h3>

                    @if (Model.TwoFactor)
                    {
                        <p>
                            Дополнителната verification проверка
                            е активна и се користи како втор
                            безбедносен чекор при најавување.
                        </p>
                    }
                    else
                    {
                        <p>
                            Активирај дополнителна verification
                            проверка при најавување за уште еден
                            слој заштита на профилот.
                        </p>
                    }


                    @if (Model.BrowserRemembered)
                    {
                        <div class="account-browser-status">

                            <span aria-hidden="true">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Trusted browser
                                </strong>

                                <small>
                                    Овој прелистувач моментално
                                    е запомнет за 2FA.
                                </small>

                            </div>

                        </div>
                    }

                </div>


                <div class="account-setting-footer">

                    @if (Model.TwoFactor)
                    {
                        using (Html.BeginForm(
                            "DisableTwoFactorAuthentication",
                            "Manage",
                            FormMethod.Post,
                            new
                            {
                                role = "form",
                                @class =
                                    "account-security-form"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger
                                           account-setting-action">

                                <span>
                                    Исклучи 2FA
                                </span>

                                <span aria-hidden="true">
                                    ×
                                </span>

                            </button>
                        }
                    }
                    else
                    {
                        using (Html.BeginForm(
                            "EnableTwoFactorAuthentication",
                            "Manage",
                            FormMethod.Post,
                            new
                            {
                                role = "form",
                                @class =
                                    "account-security-form"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary
                                           account-setting-action">

                                <span>
                                    Активирај 2FA
                                </span>

                                <span aria-hidden="true">
                                    →
                                </span>

                            </button>
                        }
                    }

                </div>

            </article>

        </div>

    </section>


    <section class="account-security-note">

        <div class="account-security-note-icon"
             aria-hidden="true">
            i
        </div>

        <div>

            <span>
                SECURITY TIP
            </span>

            <strong>
                Чувај го профилот безбеден
            </strong>

            <p>
                Користи уникатна лозинка и активирај
                two-factor authentication кога е достапна.
                Не избирај „remember browser“ на јавни
                или споделени уреди.
            </p>

        </div>

    </section>

</main>


<style>
    .account-page {
        width: 100%;
    }


    /* =====================================================
       HERO
       ===================================================== */

    .account-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        min-height: 300px;
        align-items: center;
        gap: 2rem;
        padding: clamp(2rem, 5vw, 4rem);
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 80% 30%, rgba(214, 168, 75, 0.11), transparent 26% ), radial-gradient( circle at 0% 100%, rgba(55, 96, 161, 0.13), transparent 32% ), linear-gradient( 145deg, #151e2b, #090e16 58%, #06090e );
        box-shadow: var(--cinema-shadow);
        isolation: isolate;
    }

        .account-hero::before {
            position: absolute;
            z-index: -2;
            inset: 0;
            content: "";
            opacity: 0.24;
            background-image: linear-gradient( rgba(255, 255, 255, 0.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px );
            background-size: 48px 48px;
            mask-image: linear-gradient( 90deg, #000, transparent );
        }

    .account-hero-glow {
        position: absolute;
        z-index: -1;
        top: -160px;
        right: -100px;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: rgba(214, 168, 75, 0.06);
        filter: blur(20px);
    }

    .account-hero-copy {
        position: relative;
        z-index: 3;
        max-width: 720px;
    }

        .account-hero-copy h1 {
            margin-bottom: 1rem;
            font-size: clamp( 3rem, 7vw, 5.4rem );
            line-height: 0.95;
            letter-spacing: -0.06em;
        }

        .account-hero-copy p {
            max-width: 610px;
            margin: 0;
            color: var(--cinema-text-soft);
            font-size: 0.95rem;
            line-height: 1.75;
        }


    /* =====================================================
       HERO SECURITY ART
       ===================================================== */

    .account-hero-security {
        position: relative;
        display: grid;
        width: 230px;
        height: 230px;
        place-items: center;
    }

    .account-security-ring {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.11);
        border-radius: 50%;
        animation: account-security-rotate 25s linear infinite;
    }

        .account-security-ring::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.65);
        }

    .account-security-ring-one {
        width: 210px;
        height: 210px;
    }

    .account-security-ring-two {
        width: 150px;
        height: 150px;
        animation-direction: reverse;
        animation-duration: 18s;
    }

    .account-security-shield {
        position: relative;
        z-index: 3;
        display: grid;
        width: 88px;
        height: 102px;
        place-items: center;
        color: #a5e9c1;
        border: 1px solid rgba(214, 168, 75, 0.30);
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.15), rgba(214, 168, 75, 0.04) );
        clip-path: polygon( 50% 0, 94% 16%, 88% 68%, 50% 100%, 12% 68%, 6% 16% );
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    }

        .account-security-shield span {
            display: grid;
            width: 36px;
            height: 36px;
            place-items: center;
            border: 1px solid rgba(66, 199, 131, 0.24);
            border-radius: 50%;
            background: rgba(66, 199, 131, 0.07);
            font-weight: 900;
        }


    /* =====================================================
       STATUS MESSAGE
       ===================================================== */

    .account-status-message {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        margin-top: 1.2rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(66, 199, 131, 0.17);
        border-radius: var(--cinema-radius-md);
        background: rgba(66, 199, 131, 0.045);
        animation: account-status-enter 450ms ease-out;
    }

    .account-status-icon {
        display: grid;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        place-items: center;
        color: #9ae8bd;
        border: 1px solid rgba(66, 199, 131, 0.20);
        border-radius: 10px;
        background: rgba(66, 199, 131, 0.07);
        font-size: 0.65rem;
        font-weight: 900;
    }

    .account-status-message span {
        display: block;
        margin-bottom: 0.15rem;
        color: #8fd8ad;
        font-size: 0.51rem;
        font-weight: 900;
        letter-spacing: 0.11em;
    }

    .account-status-message p {
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: 0.76rem;
        line-height: 1.55;
    }


    /* =====================================================
       OVERVIEW
       ===================================================== */

    .account-overview {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.2rem;
    }

    .account-overview-card {
        position: relative;
        min-width: 0;
        padding: 1.2rem 1.3rem;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: linear-gradient( 145deg, rgba(20, 27, 39, 0.88), rgba(10, 14, 21, 0.92) );
        box-shadow: var(--cinema-shadow-sm);
        transition: transform var(--cinema-transition), border-color var(--cinema-transition);
    }

        .account-overview-card:hover {
            border-color: var(--cinema-border-strong);
            transform: translateY(-3px);
        }

    .account-overview-label {
        display: block;
        margin-bottom: 0.55rem;
        color: var(--cinema-text-muted);
        font-size: 0.53rem;
        font-weight: 900;
        letter-spacing: 0.13em;
    }

    .account-overview-card > strong {
        display: inline-block;
        color: var(--cinema-text);
        font-size: 1.25rem;
    }

    .account-overview-card > small {
        margin-left: 0.3rem;
        color: var(--cinema-text-muted);
        font-size: 0.65rem;
    }

    .account-overview-indicator {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

        .account-overview-indicator.active {
            background: var(--cinema-success);
            box-shadow: 0 0 13px rgba(66, 199, 131, 0.55);
        }

        .account-overview-indicator.warning {
            background: var(--cinema-warning);
            box-shadow: 0 0 13px rgba(246, 200, 95, 0.45);
        }

        .account-overview-indicator.muted {
            background: #5d6673;
        }


    /* =====================================================
       SETTINGS
       ===================================================== */

    .account-settings {
        margin-top: clamp(3rem, 6vw, 5rem);
    }

    .account-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 1.5rem;
    }

        .account-section-heading h2 {
            margin: 0;
            font-size: clamp( 1.8rem, 4vw, 2.5rem );
        }

        .account-section-heading > p {
            max-width: 460px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.76rem;
            line-height: 1.65;
            text-align: right;
        }

    .account-settings-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }


    /* =====================================================
       SETTING CARDS
       ===================================================== */

    .account-setting-card {
        display: flex;
        min-width: 0;
        min-height: 370px;
        flex-direction: column;
        padding: 1.4rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: linear-gradient( 145deg, rgba(20, 27, 39, 0.86), rgba(9, 13, 20, 0.94) );
        box-shadow: var(--cinema-shadow-sm);
        transition: transform var(--cinema-transition), border-color var(--cinema-transition), box-shadow var(--cinema-transition);
    }

        .account-setting-card:hover {
            border-color: rgba(214, 168, 75, 0.20);
            box-shadow: var(--cinema-shadow);
            transform: translateY(-4px);
        }

    .account-two-factor-card.enabled {
        border-color: rgba(66, 199, 131, 0.15);
        background: radial-gradient( circle at 100% 0%, rgba(66, 199, 131, 0.055), transparent 36% ), linear-gradient( 145deg, rgba(20, 27, 39, 0.86), rgba(9, 13, 20, 0.94) );
    }

    .account-setting-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .account-setting-icon {
        position: relative;
        display: grid;
        width: 48px;
        height: 48px;
        place-items: center;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, 0.18);
        border-radius: 14px;
        background: rgba(214, 168, 75, 0.055);
    }


    /* PASSWORD ICON */

    .account-lock {
        position: relative;
        display: block;
        width: 20px;
        height: 17px;
        margin-top: 7px;
        border: 2px solid currentColor;
        border-radius: 5px;
    }

        .account-lock::before {
            position: absolute;
            top: -12px;
            left: 4px;
            width: 9px;
            height: 11px;
            content: "";
            border: 2px solid currentColor;
            border-bottom: 0;
            border-radius: 7px 7px 0 0;
        }


    /* CONNECTION ICON */

    .account-setting-icon.connections {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .account-setting-icon.connections > span {
            position: relative;
            display: block;
            width: 14px;
            height: 14px;
            border: 2px solid currentColor;
            border-radius: 50%;
        }

            .account-setting-icon.connections > span:first-child::after {
                position: absolute;
                top: 4px;
                left: 10px;
                width: 9px;
                height: 2px;
                content: "";
                background: currentColor;
            }


    /* 2FA ICON */

    .account-setting-icon.two-factor > span {
        display: grid;
        width: 27px;
        height: 27px;
        place-items: center;
        border: 1px solid rgba(214, 168, 75, 0.24);
        border-radius: 9px;
        font-size: 0.75rem;
        font-weight: 900;
    }


    /* STATUS */

    .account-setting-status {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.55rem;
        border-radius: 999px;
        color: var(--cinema-text-muted);
        background: rgba(255, 255, 255, 0.03);
        font-size: 0.49rem;
        font-weight: 900;
        letter-spacing: 0.07em;
    }

        .account-setting-status > span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .account-setting-status.success {
            color: #91dcb0;
            background: rgba(66, 199, 131, 0.055);
        }

            .account-setting-status.success > span {
                background: var(--cinema-success);
                box-shadow: 0 0 10px rgba(66, 199, 131, 0.55);
            }

        .account-setting-status.warning {
            color: #e6c67d;
            background: rgba(246, 200, 95, 0.05);
        }

            .account-setting-status.warning > span {
                background: var(--cinema-warning);
            }

        .account-setting-status.muted {
            color: var(--cinema-text-muted);
        }

            .account-setting-status.muted > span {
                background: #646d79;
            }


    /* CARD CONTENT */

    .account-setting-content {
        padding: 2rem 0 1.5rem;
    }

    .account-setting-number {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--cinema-gold-light);
        font-size: 0.52rem;
        font-weight: 900;
        letter-spacing: 0.1em;
    }

    .account-setting-content h3 {
        margin-bottom: 0.8rem;
        color: var(--cinema-text);
        font-size: 1.25rem;
    }

    .account-setting-content > p {
        margin: 0;
        color: var(--cinema-text-muted);
        font-size: 0.74rem;
        line-height: 1.7;
    }


    /* TRUSTED BROWSER */

    .account-browser-status {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-top: 1rem;
        padding: 0.75rem;
        border: 1px solid rgba(66, 199, 131, 0.13);
        border-radius: 10px;
        background: rgba(66, 199, 131, 0.035);
    }

        .account-browser-status > span {
            display: grid;
            flex: 0 0 23px;
            width: 23px;
            height: 23px;
            place-items: center;
            color: #9ae8bd;
            border: 1px solid rgba(66, 199, 131, 0.18);
            border-radius: 50%;
            font-size: 0.5rem;
        }

        .account-browser-status strong {
            display: block;
            color: var(--cinema-text-soft);
            font-size: 0.68rem;
        }

        .account-browser-status small {
            display: block;
            margin-top: 0.1rem;
