
@using System
@using System.Collections.Generic
@model MovieTicketMVC.Models.IndexViewModel

@{
    ViewBag.Title = "Твојот профил";

    var externalLoginCount = Model != null && Model.Logins != null
        ? Model.Logins.Count
        : 0;

    var hasPassword = Model != null && Model.HasPassword;
    var twoFactorEnabled = Model != null && Model.TwoFactor;
    var browserRemembered = Model != null && Model.BrowserRemembered;

    var statusMessage = Convert.ToString(ViewBag.StatusMessage);
    var statusTranslations = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
{
        { "Your password has been changed.", "Лозинката е успешно променета." },
        { "Your password has been set.", "Лозинката е успешно поставена." },
        { "Two-factor authentication has been enabled.", "Двофакторската автентикација е активирана." },
        { "Two-factor authentication has been disabled.", "Двофакторската автентикација е исклучена." },
        { "The external login was removed.", "Надворешниот начин на најава е отстранет." },
        { "Your phone number was removed.", "Телефонскиот број е отстранет." },
        { "Phone verification is not configured for this application.", "Потврдувањето телефонски број не е конфигурирано во апликацијата." },
        { "Two-factor authentication cannot be enabled because no verified provider is available.", "Двофакторската автентикација не може да се активира бидејќи нема достапен потврден метод за верификација." },
        { "You cannot remove your only sign-in method.", "Не можеш да го отстраниш единствениот начин за најава." },
        { "An error has occurred.", "Настана грешка. Обиди се повторно." }
    };

    string translatedStatus = string.Empty;

    if (!string.IsNullOrWhiteSpace(statusMessage) &&
    statusTranslations.TryGetValue(statusMessage, out translatedStatus))
    {
        statusMessage = translatedStatus;
    }

    var isWarning =
        statusMessage == "Настана грешка. Обиди се повторно." ||
        statusMessage == "Потврдувањето телефонски број не е конфигурирано во апликацијата." ||
        statusMessage == "Двофакторската автентикација не може да се активира бидејќи нема достапен потврден метод за верификација." ||
        statusMessage == "Не можеш да го отстраниш единствениот начин за најава.";
}

<main class="account-page" aria-labelledby="account-title">
    <section class="account-hero" aria-labelledby="account-title">
        <div class="account-hero-copy">
            <div class="cinema-eyebrow">МОЈ ПРОФИЛ</div>

            <h1 id="account-title">
                Твојот <span class="cinema-text-gradient">профил</span>
            </h1>

            <p>
                Управувај со лозинката, поврзаните начини за најава
                и безбедноста на твојот MovieTicket профил.
            </p>

            <div class="account-hero-summary"
                 aria-label="Моментална состојба на профилот">

                <span class="account-hero-pill">
                    <span class="account-pill-dot @(hasPassword ? "is-positive" : "is-warning")"
                          aria-hidden="true"></span>

                    @(hasPassword
                        ? "Лозинката е поставена"
                        : "Нема поставена лозинка")
                </span>

                <span class="account-hero-pill">
                    <span class="account-pill-dot @(twoFactorEnabled ? "is-positive" : "is-neutral")"
                          aria-hidden="true"></span>

                    @(twoFactorEnabled
                        ? "2FA е активна"
                        : "2FA не е активна")
                </span>
            </div>
        </div>

        <div class="account-hero-visual" aria-hidden="true">
            <div class="account-orbit account-orbit-large"></div>
            <div class="account-orbit account-orbit-small"></div>

            <div class="account-shield">
                <svg viewBox="0 0 64 74"
                     width="80"
                     height="94"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M32 4 58 14v18c0 17-10 29-26 38C16 61 6 49 6 32V14L32 4Z"
                          fill="#d6a84b"
                          fill-opacity=".13"
                          stroke="#d6a84b"
                          stroke-opacity=".42"
                          stroke-width="2" />

                    <circle cx="32"
                            cy="35"
                            r="16"
                            fill="#42c783"
                            fill-opacity=".12"
                            stroke="#42c783"
                            stroke-opacity=".4" />

                    <path d="m24 35 6 6 11-13"
                          stroke="#8de4b2"
                          stroke-width="3.5"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="account-feedback @(isWarning ? "account-feedback-warning" : "account-feedback-success")"
             role="@(isWarning ? "alert" : "status")">

            <span class="account-feedback-symbol"
                  aria-hidden="true">
                @(isWarning ? "!" : "✓")
            </span>

            <div>
                <strong>
                    @(isWarning
                        ? "Потребно е внимание"
                        : "Промената е зачувана")
                </strong>

                <p>@statusMessage</p>
            </div>
        </div>
    }

    <section class="account-settings"
             aria-labelledby="account-settings-title">

        <div class="account-section-heading">
            <div>
                <div class="cinema-eyebrow">
                    ПОСТАВКИ НА ПРОФИЛОТ
                </div>

                <h2 id="account-settings-title">
                    Безбедност и најавување
                </h2>
            </div>

            <p>
                Избери ја поставката што сакаш да ја промениш
                или провериш.
            </p>
        </div>

        <div class="account-settings-grid">
            <article class="account-setting-card">
                <div class="account-card-heading">
                    <span class="account-setting-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             width="24"
                             height="24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="4"
                                  y="10"
                                  width="16"
                                  height="11"
                                  rx="2" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>
                    </span>

                    <span class="account-card-status @(hasPassword ? "is-success" : "is-warning")">
                        <span class="account-card-status-dot"
                              aria-hidden="true"></span>

                        @(hasPassword
                            ? "Поставена"
                            : "Не е поставена")
                    </span>
                </div>

                <div class="account-card-content">
                    <span class="account-card-number">
                        01 / ЛОЗИНКА
                    </span>

                    <h3>Лозинка</h3>

                    <p>
                        @(hasPassword
                            ? "Промени ја лозинката за да го заштитиш пристапот до твојот профил."
                            : "Постави лозинка за да можеш да се најавуваш и со е-пошта.")
                    </p>
                </div>

                <div class="account-card-action">
                    @if (hasPassword)
                    {
                        <a class="btn btn-outline-secondary account-card-button"
                           href="@Url.Action("ChangePassword", "Manage")">

                            <span>Промени лозинка</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-primary account-card-button"
                           href="@Url.Action("SetPassword", "Manage")">

                            <span>Постави лозинка</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    }
                </div>
            </article>

            <article class="account-setting-card">
                <div class="account-card-heading">
                    <span class="account-setting-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             width="24"
                             height="24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="7"
                                    cy="12"
                                    r="4" />

                            <circle cx="17"
                                    cy="12"
                                    r="4" />

                            <path d="M11 12h2" />
                        </svg>
                    </span>

                    <span class="account-card-status is-neutral">
                        @externalLoginCount
                        @(externalLoginCount == 1
                            ? "поврзан профил"
                            : "поврзани профили")
                    </span>
                </div>

                <div class="account-card-content">
                    <span class="account-card-number">
                        02 / НАЈАВУВАЊЕ
                    </span>

                    <h3>Поврзани профили</h3>

                    <p>
                        Прегледај ги надворешните сметки поврзани
                        со MovieTicket и управувај со достапните
                        начини за најава.
                    </p>
                </div>

                <div class="account-card-action">
                    <a class="btn btn-outline-secondary account-card-button"
                       href="@Url.Action("ManageLogins", "Manage")">

                        <span>Управувај со поврзувања</span>
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            <article class="account-setting-card @(twoFactorEnabled ? "account-two-factor-on" : "")">
                <div class="account-card-heading">
                    <span class="account-setting-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             width="24"
                             height="24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M12 2 20 6v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4Z" />

                            <path d="M9 12l2 2 4-4" />
                        </svg>
                    </span>

                    <span class="account-card-status @(twoFactorEnabled ? "is-success" : "is-neutral")">
                        <span class="account-card-status-dot"
                              aria-hidden="true"></span>

                        @(twoFactorEnabled
                            ? "Активна"
                            : "Неактивна")
                    </span>
                </div>

                <div class="account-card-content">
                    <span class="account-card-number">
                        03 / ДОПОЛНИТЕЛНА ЗАШТИТА
                    </span>

                    <h3>Двофакторска автентикација</h3>

                    <p>
                        @(twoFactorEnabled
                            ? "Дополнителната проверка при најавување е активна и го заштитува твојот профил."
                            : "Додај уште еден чекор за проверка при најавување и зголеми ја безбедноста на профилот.")
                    </p>

                    @if (browserRemembered)
                    {
                        <div class="account-browser-note">
                            <span aria-hidden="true">✓</span>

                            <div>
                                <strong>Запомнет прелистувач</strong>

                                <small>
                                    Овој прелистувач е запомнет
                                    за двофакторска најава.
                                </small>
                            </div>
                        </div>
                    }
                    else if (!twoFactorEnabled)
                    {
                        <div class="account-browser-note account-browser-note-muted">
                            <span aria-hidden="true">i</span>

                            <div>
                                <small>
                                    За активирање е потребен
                                    достапен и потврден начин
                                    за верификација.
                                </small>
                            </div>
                        </div>
                    }
                </div>

                <div class="account-card-action">
                    @if (twoFactorEnabled)
                    {
                        using (Html.BeginForm(
                            "DisableTwoFactorAuthentication",
                            "Manage",
                            FormMethod.Post,
                            new { @class = "account-security-form" }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger account-card-button">

                                <span>Исклучи 2FA</span>
                                <span aria-hidden="true">→</span>
                            </button>
                        }
                    }
                    else
                    {
                        using (Html.BeginForm(
                            "EnableTwoFactorAuthentication",
                            "Manage",
                            FormMethod.Post,
                            new { @class = "account-security-form" }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary account-card-button">

                                <span>Активирај 2FA</span>
                                <span aria-hidden="true">→</span>
                            </button>
                        }
                    }
                </div>
            </article>
        </div>
    </section>

    <aside class="account-security-note"
           aria-labelledby="account-security-note-title">

        <span class="account-note-icon"
              aria-hidden="true">

            <svg viewBox="0 0 24 24"
                 width="21"
                 height="21"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="12"
                        cy="12"
                        r="9" />

                <path d="M12 11v5M12 8h.01" />
            </svg>
        </span>

        <div>
            <span class="account-note-eyebrow">
                БЕЗБЕДНОСЕН СОВЕТ
            </span>

            <h2 id="account-security-note-title">
                Чувај го профилот безбеден
            </h2>

            <p>
                Користи уникатна лозинка. Доколку е достапна
                двофакторската автентикација, активирај ја
                за дополнителна заштита. Не избирај
                „Запомни го прелистувачот“ на јавен или споделен уред.
            </p>
        </div>
    </aside>
</main>

<style>
    .account-page {
        width: 100%;
        min-width: 0;
    }

    .account-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 245px;
        align-items: center;
        gap: 2.5rem;
        min-height: 285px;
        padding: clamp(2rem, 4.5vw, 3.5rem);
        overflow: hidden;
        isolation: isolate;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient( circle at 85% 18%, rgba(214, 168, 75, .1), transparent 34% ), radial-gradient( circle at 0% 100%, rgba(68, 104, 158, .11), transparent 38% ), linear-gradient( 145deg, #151e2b, #090e16 60%, #070a10 );
        box-shadow: var(--cinema-shadow-lg);
    }

        .account-hero::before {
            position: absolute;
            inset: 0;
            z-index: -1;
            content: "";
            opacity: .18;
            background-image: linear-gradient( rgba(255, 255, 255, .025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, .025) 1px, transparent 1px );
            background-size: 46px 46px;
            -webkit-mask-image: linear-gradient(90deg, #000, transparent);
            mask-image: linear-gradient(90deg, #000, transparent);
            pointer-events: none;
        }

    .account-hero-copy {
        position: relative;
        z-index: 2;
        max-width: 750px;
        min-width: 0;
    }

    .account-hero h1 {
        margin: .9rem 0 1rem;
        color: var(--cinema-text);
        font-size: clamp(2.8rem, 5.2vw, 4.85rem);
        line-height: 1.04;
        letter-spacing: -.06em;
        overflow-wrap: break-word;
    }

    .account-hero-copy > p {
        max-width: 620px;
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: .96rem;
        line-height: 1.8;
    }

    .account-hero-summary {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem;
        margin-top: 1.4rem;
    }

    .account-hero-pill {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        min-height: 34px;
        padding: .45rem .75rem;
        color: #d2d9e4;
        border: 1px solid rgba(255, 255, 255, .1);
        border-radius: 999px;
        background: rgba(255, 255, 255, .025);
        font-size: .77rem;
        font-weight: 650;
    }

    .account-pill-dot {
        display: block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #76808d;
    }

        .account-pill-dot.is-positive {
            background: #42c783;
            box-shadow: 0 0 10px rgba(66, 199, 131, .4);
        }

        .account-pill-dot.is-warning {
            background: #f6c85f;
        }

    .account-hero-visual {
        position: relative;
        display: grid;
        place-items: center;
        width: 230px;
        height: 230px;
        pointer-events: none;
    }

    .account-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, .1);
        border-radius: 50%;
        animation: account-orbit-rotate 32s linear infinite;
    }

        .account-orbit::after {
            position: absolute;
            top: -4px;
            left: 50%;
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: #d6a84b;
            box-shadow: 0 0 18px rgba(214, 168, 75, .55);
        }

    .account-orbit-large {
        width: 215px;
        height: 215px;
    }

    .account-orbit-small {
        width: 151px;
        height: 151px;
        animation-direction: reverse;
        animation-duration: 23s;
    }

    .account-shield {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 94px;
        height: 104px;
        filter: drop-shadow(0 15px 28px rgba(0, 0, 0, .25));
    }

    .account-feedback {
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        margin-top: 1.2rem;
        padding: 1rem 1.15rem;
        border: 1px solid rgba(66, 199, 131, .24);
        border-radius: 14px;
        background: rgba(66, 199, 131, .055);
    }

    .account-feedback-warning {
        border-color: rgba(246, 200, 95, .25);
        background: rgba(246, 200, 95, .06);
    }

    .account-feedback-symbol {
        display: grid;
        flex: 0 0 29px;
        place-items: center;
        width: 29px;
        height: 29px;
        border: 1px solid rgba(66, 199, 131, .25);
        border-radius: 50%;
        color: #9ae8bd;
        font-weight: 800;
    }

    .account-feedback-warning .account-feedback-symbol {
        border-color: rgba(246, 200, 95, .32);
        color: #f0cb76;
    }

    .account-feedback strong {
        display: block;
        margin-bottom: .15rem;
        color: var(--cinema-text);
        font-size: .88rem;
    }

    .account-feedback p {
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: .82rem;
        line-height: 1.6;
    }

    .account-settings {
        margin-top: clamp(2.6rem, 4.5vw, 3.8rem);
    }

    .account-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 1.35rem;
    }

        .account-section-heading h2 {
            margin: .3rem 0 0;
            font-size: clamp(1.75rem, 3.6vw, 2.5rem);
            letter-spacing: -.04em;
        }

        .account-section-heading > p {
            max-width: 310px;
            margin: 0 0 .15rem;
            color: var(--cinema-text-muted);
            font-size: .81rem;
            line-height: 1.65;
            text-align: right;
        }

    .account-settings-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: stretch;
        gap: 1rem;
    }

    .account-setting-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 360px;
        padding: clamp(1.3rem, 2.2vw, 1.7rem);
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: radial-gradient( circle at 100% 0%, rgba(214, 168, 75, .04), transparent 35% ), linear-gradient( 145deg, rgba(21, 29, 41, .96), rgba(9, 13, 20, .98) );
        box-shadow: var(--cinema-shadow-sm);
        transition: transform var(--cinema-transition), border-color var(--cinema-transition), box-shadow var(--cinema-transition);
    }

        .account-setting-card:hover {
            border-color: rgba(214, 168, 75, .23);
            transform: translateY(-3px);
            box-shadow: var(--cinema-shadow-lg);
        }

    .account-two-factor-on {
        border-color: rgba(66, 199, 131, .22);
    }

    .account-card-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .7rem;
    }

    .account-setting-icon {
        display: grid;
        flex: 0 0 49px;
        place-items: center;
        width: 49px;
        height: 49px;
        color: var(--cinema-gold-light);
        border: 1px solid rgba(214, 168, 75, .22);
        border-radius: 14px;
        background: rgba(214, 168, 75, .055);
    }

    .account-card-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        max-width: 62%;
        padding: .38rem .6rem;
        border-radius: 999px;
        color: #b9c3d0;
        background: rgba(255, 255, 255, .045);
        font-size: .67rem;
        font-weight: 750;
        line-height: 1.35;
        text-align: right;
    }

    .account-card-status-dot {
        flex: 0 0 6px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6c7888;
    }

    .account-card-status.is-success {
        color: #a2eac0;
        background: rgba(66, 199, 131, .09);
    }

        .account-card-status.is-success .account-card-status-dot {
            background: #42c783;
        }

    .account-card-status.is-warning {
        color: #f4d28e;
        background: rgba(246, 200, 95, .08);
    }

        .account-card-status.is-warning .account-card-status-dot {
            background: #f6c85f;
        }

    .account-card-content {
        flex: 1;
        padding: 1.75rem 0 1.5rem;
    }

    .account-card-number {
        display: block;
        margin-bottom: .5rem;
        color: var(--cinema-gold-light);
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .085em;
    }

    .account-card-content h3 {
        margin: 0 0 .8rem;
        color: var(--cinema-text);
        font-size: clamp(1.05rem, 1.8vw, 1.3rem);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    .account-card-content > p {
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: .84rem;
        line-height: 1.75;
    }

    .account-browser-note {
        display: flex;
        align-items: flex-start;
        gap: .6rem;
        margin-top: 1.1rem;
        padding: .75rem;
        border: 1px solid rgba(66, 199, 131, .17);
