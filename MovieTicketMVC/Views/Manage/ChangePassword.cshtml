@model MovieTicketMVC.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Промени лозинка";
}

<main class="change-password-page"
      aria-labelledby="change-password-title">

    <section class="change-password-shell">

        <div class="change-password-visual"
             aria-hidden="true">

            <div class="change-password-grid">
            </div>

            <div class="change-password-orbit
                        change-password-orbit-large">
            </div>

            <div class="change-password-orbit
                        change-password-orbit-small">
            </div>


            <div class="change-password-lock">

                <div class="change-password-lock-shackle">
                </div>

                <div class="change-password-lock-body">

                    <span></span>

                </div>

            </div>


            <div class="change-password-visual-copy">

                <span>
                    ACCOUNT SECURITY
                </span>

                <strong>
                    Освежи ја безбедноста
                </strong>

                <p>
                    Промени ја постоечката лозинка
                    со нова силна комбинација.
                </p>

            </div>

        </div>


        <div class="change-password-content">

            <a class="change-password-brand"
               href="@Url.Action("Index", "Home")">

                <span></span>

                MOVIETICKET
            </a>


            <a class="change-password-back"
               href="@Url.Action("Index", "Manage")">

                <span aria-hidden="true">
                    ←
                </span>

                Account settings
            </a>


            <div class="change-password-heading">

                <div class="cinema-eyebrow">
                    PASSWORD SECURITY
                </div>

                <h1 id="change-password-title">
                    Промени ја
                    <span class="cinema-text-gradient">
                        лозинката
                    </span>
                </h1>

                <p>
                    Потврди ја моменталната лозинка,
                    а потоа избери нова безбедна лозинка
                    за MovieTicket профилот.
                </p>

            </div>


            @using (Html.BeginForm(
                "ChangePassword",
                "Manage",
                FormMethod.Post,
                new
                {
                    role = "form",
                    id = "changePasswordForm",
                    @class = "change-password-form"
                }))
            {
                @Html.AntiForgeryToken()


                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class =
                            "validation-summary-errors change-password-validation"
                    })


                <div class="change-password-section">

                    <div class="change-password-section-header">

                        <span>
                            01
                        </span>

                        <div>

                            <strong>
                                Моментална лозинка
                            </strong>

                            <small>
                                Потврди дека профилот е твој.
                            </small>

                        </div>

                    </div>


                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.OldPassword,
                            "Моментална лозинка",
                            new
                            {
                                @class = "form-label"
                            })


                        <div class="change-password-input-wrapper">

                            <span class="change-password-input-icon"
                                  aria-hidden="true">
                                •
                            </span>

                            @Html.PasswordFor(
                                m => m.OldPassword,
                                new
                                {
                                    @class =
                                        "form-control change-password-input change-password-field",
                                    autocomplete =
                                        "current-password",
                                    placeholder =
                                        "Внеси ја моменталната лозинка",
                                    id =
                                        "OldPassword",
                                    autofocus =
                                        "autofocus"
                                })


                            <button type="button"
                                    class="change-password-toggle"
                                    data-password-target="OldPassword"
                                    aria-label="Прикажи лозинка"
                                    aria-pressed="false">
                                SHOW
                            </button>

                        </div>


                        @Html.ValidationMessageFor(
                            m => m.OldPassword,
                            "",
                            new
                            {
                                @class = "text-danger"
                            })

                    </div>

                </div>


                <div class="change-password-divider">
                </div>


                <div class="change-password-section">

                    <div class="change-password-section-header">

                        <span>
                            02
                        </span>

                        <div>

                            <strong>
                                Нова лозинка
                            </strong>

                            <small>
                                Креирај нова силна комбинација.
                            </small>

                        </div>

                    </div>


                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.NewPassword,
                            "Нова лозинка",
                            new
                            {
                                @class = "form-label"
                            })


                        <div class="change-password-input-wrapper">

                            <span class="change-password-input-icon"
                                  aria-hidden="true">
                                •
                            </span>

                            @Html.PasswordFor(
                                m => m.NewPassword,
                                new
                                {
                                    @class =
                                        "form-control change-password-input change-password-field",
                                    autocomplete =
                                        "new-password",
                                    placeholder =
                                        "Креирај нова лозинка",
                                    id =
                                        "NewPassword"
                                })


                            <button type="button"
                                    class="change-password-toggle"
                                    data-password-target="NewPassword"
                                    aria-label="Прикажи лозинка"
                                    aria-pressed="false">
                                SHOW
                            </button>

                        </div>


                        @Html.ValidationMessageFor(
                            m => m.NewPassword,
                            "",
                            new
                            {
                                @class = "text-danger"
                            })


                        <div class="change-password-strength">

                            <div class="change-password-strength-header">

                                <span>
                                    Сигурност на лозинката
                                </span>

                                <strong id="passwordStrengthText">
                                    —
                                </strong>

                            </div>


                            <div class="change-password-strength-track">

                                <span id="passwordStrengthBar">
                                </span>

                            </div>

                        </div>


                        <div class="change-password-requirements"
                             aria-label="Услови за лозинка">

                            <div class="change-password-requirement"
                                 id="requirementLength">

                                <span aria-hidden="true">
                                    ✓
                                </span>

                                Најмалку 8 карактери

                            </div>


                            <div class="change-password-requirement"
                                 id="requirementUpper">

                                <span aria-hidden="true">
                                    ✓
                                </span>

                                Голема буква

                            </div>


                            <div class="change-password-requirement"
                                 id="requirementLower">

                                <span aria-hidden="true">
                                    ✓
                                </span>

                                Мала буква

                            </div>


                            <div class="change-password-requirement"
                                 id="requirementNumber">

                                <span aria-hidden="true">
                                    ✓
                                </span>

                                Број

                            </div>


                            <div class="change-password-requirement"
                                 id="requirementSpecial">

                                <span aria-hidden="true">
                                    ✓
                                </span>

                                Специјален карактер

                            </div>

                        </div>

                    </div>


                    <div class="form-group">

                        @Html.LabelFor(
                            m => m.ConfirmPassword,
                            "Потврди нова лозинка",
                            new
                            {
                                @class = "form-label"
                            })


                        <div class="change-password-input-wrapper">

                            <span class="change-password-input-icon"
                                  aria-hidden="true">
                                •
                            </span>

                            @Html.PasswordFor(
                                m => m.ConfirmPassword,
                                new
                                {
                                    @class =
                                        "form-control change-password-input change-password-field",
                                    autocomplete =
                                        "new-password",
                                    placeholder =
                                        "Повтори ја новата лозинка",
                                    id =
                                        "ConfirmPassword"
                                })


                            <button type="button"
                                    class="change-password-toggle"
                                    data-password-target="ConfirmPassword"
                                    aria-label="Прикажи лозинка"
                                    aria-pressed="false">
                                SHOW
                            </button>

                        </div>


                        @Html.ValidationMessageFor(
                            m => m.ConfirmPassword,
                            "",
                            new
                            {
                                @class = "text-danger"
                            })


                        <div id="passwordMatchIndicator"
                             class="change-password-match"
                             aria-live="polite">
                        </div>

                    </div>

                </div>


                <div class="change-password-actions">

                    <a class="btn btn-outline-secondary"
                       href="@Url.Action(
                           "Index",
                           "Manage")">
                        Откажи
                    </a>


                    <button type="submit"
                            id="changePasswordButton"
                            class="btn btn-primary change-password-submit">

                        <span id="changePasswordButtonText">
                            Промени лозинка
                        </span>

                        <span aria-hidden="true">
                            →
                        </span>

                    </button>

                </div>
            }


            <div class="change-password-security-note">

                <span aria-hidden="true">
                    ✓
                </span>

                <p>
                    Користи уникатна лозинка што не ја користиш
                    на други веб-страници или сервиси.
                </p>

            </div>

        </div>

    </section>

</main>


@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        (function () {
            var form =
                document.getElementById(
                    "changePasswordForm");

            var newPassword =
                document.getElementById(
                    "NewPassword");

            var confirmPassword =
                document.getElementById(
                    "ConfirmPassword");

            var submitButton =
                document.getElementById(
                    "changePasswordButton");

            var submitButtonText =
                document.getElementById(
                    "changePasswordButtonText");

            var strengthBar =
                document.getElementById(
                    "passwordStrengthBar");

            var strengthText =
                document.getElementById(
                    "passwordStrengthText");

            var matchIndicator =
                document.getElementById(
                    "passwordMatchIndicator");


            var requirements =
                {
                    length:
                        document.getElementById(
                            "requirementLength"),

                    upper:
                        document.getElementById(
                            "requirementUpper"),

                    lower:
                        document.getElementById(
                            "requirementLower"),

                    number:
                        document.getElementById(
                            "requirementNumber"),

                    special:
                        document.getElementById(
                            "requirementSpecial")
                };


            function setRequirement(
                element,
                valid) {

                if (!element) {
                    return;
                }

                element.classList.toggle(
                    "valid",
                    valid);
            }


            function evaluatePassword() {
                if (
                    !newPassword ||
                    !strengthBar ||
                    !strengthText
                ) {
                    return;
                }

                var value =
                    newPassword.value || "";

                var checks =
                    {
                        length:
                            value.length >= 8,

                        upper:
                            /[A-Z]/.test(value),

                        lower:
                            /[a-z]/.test(value),

                        number:
                            /\d/.test(value),

                        special:
                            /[^A-Za-z0-9]/.test(value)
                    };


                setRequirement(
                    requirements.length,
                    checks.length);

                setRequirement(
                    requirements.upper,
                    checks.upper);

                setRequirement(
                    requirements.lower,
                    checks.lower);

                setRequirement(
                    requirements.number,
                    checks.number);

                setRequirement(
                    requirements.special,
                    checks.special);


                var score =
                    Object.keys(checks)
                        .filter(function (key) {
                            return checks[key];
                        })
                        .length;


                strengthBar.className =
                    "";

                if (!value) {
                    strengthBar.style.width =
                        "0%";

                    strengthText.textContent =
                        "—";
                }
                else if (score <= 2) {
                    strengthBar.style.width =
                        "35%";

                    strengthBar.classList.add(
                        "weak");

                    strengthText.textContent =
                        "Слаба";
                }
                else if (score <= 4) {
                    strengthBar.style.width =
                        "68%";

                    strengthBar.classList.add(
                        "medium");

                    strengthText.textContent =
                        "Добра";
                }
                else {
                    strengthBar.style.width =
                        "100%";

                    strengthBar.classList.add(
                        "strong");

                    strengthText.textContent =
                        "Силна";
                }


                evaluatePasswordMatch();
            }


            function evaluatePasswordMatch() {
                if (
                    !newPassword ||
                    !confirmPassword ||
                    !matchIndicator
                ) {
                    return;
                }

                var confirmation =
                    confirmPassword.value || "";


                matchIndicator.classList.remove(
                    "valid",
                    "invalid");


                if (!confirmation) {
                    matchIndicator.textContent =
                        "";

                    return;
                }


                if (
                    newPassword.value ===
                    confirmation
                ) {
                    matchIndicator.classList.add(
                        "valid");

                    matchIndicator.textContent =
                        "Лозинките се совпаѓаат.";
                }
                else {
                    matchIndicator.classList.add(
                        "invalid");

                    matchIndicator.textContent =
                        "Лозинките не се совпаѓаат.";
                }
            }


            var toggleButtons =
                document.querySelectorAll(
                    ".change-password-toggle");


            Array.prototype.forEach.call(
                toggleButtons,
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            var targetId =
                                button.getAttribute(
                                    "data-password-target");

                            var input =
                                document.getElementById(
                                    targetId);


                            if (!input) {
                                return;
                            }


                            var isHidden =
                                input.type ===
                                "password";


                            input.type =
                                isHidden
                                    ? "text"
                                    : "password";


                            button.textContent =
                                isHidden
                                    ? "HIDE"
                                    : "SHOW";


                            button.setAttribute(
                                "aria-pressed",
                                isHidden
                                    ? "true"
                                    : "false");


                            button.setAttribute(
                                "aria-label",
                                isHidden
                                    ? "Сокриј лозинка"
                                    : "Прикажи лозинка");
                        });
                });


            if (newPassword) {
                newPassword.addEventListener(
                    "input",
                    evaluatePassword);
            }


            if (confirmPassword) {
                confirmPassword.addEventListener(
                    "input",
                    evaluatePasswordMatch);
            }


            if (
                form &&
                submitButton &&
                submitButtonText
            ) {
                form.addEventListener(
                    "submit",
                    function () {

                        if (
                            typeof $ !== "undefined" &&
                            $.validator &&
                            !$(form).valid()
                        ) {
                            return;
                        }


                        submitButton.disabled =
                            true;

                        submitButtonText.textContent =
                            "Се зачувува...";
                    });
            }


            evaluatePassword();
            evaluatePasswordMatch();
        })();
    </script>
}


<style>
    .change-password-page {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .change-password-shell {
        display: grid;
        grid-template-columns: minmax(300px, 0.8fr) minmax(450px, 1.2fr);
        width: min(100%, 1020px);
        min-height: 790px;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #090d13;
        box-shadow: var(--cinema-shadow-lg);
    }


    /* =====================================================
       VISUAL
       ===================================================== */

    .change-password-visual {
        position: relative;
        display: grid;
        min-width: 0;
        place-items: center;
        overflow: hidden;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient( circle at 50% 40%, rgba(214, 168, 75, 0.12), transparent 30% ), radial-gradient( circle at 0% 100%, rgba(58, 100, 168, 0.14), transparent 32% ), linear-gradient( 145deg, #151e2b, #0a0f17 58%, #06090e );
        isolation: isolate;
    }

    .change-password-grid {
        position: absolute;
        z-index: -2;
        inset: 0;
        opacity: 0.25;
        background-image: linear-gradient( rgba(255, 255, 255, 0.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px );
        background-size: 44px 44px;
    }


    /* =====================================================
       LOCK
       ===================================================== */

    .change-password-lock {
        position: absolute;
        top: 160px;
        left: 50%;
        z-index: 4;
        width: 110px;
        height: 130px;
        transform: translateX(-50%);
    }

    .change-password-lock-shackle {
        position: absolute;
        top: 0;
        left: 25px;
        width: 60px;
        height: 68px;
        border: 5px solid var(--cinema-gold-light);
        border-bottom: 0;
        border-radius: 34px 34px 0 0;
        box-shadow: 0 0 25px rgba(214, 168, 75, 0.15);
    }

    .change-password-lock-body {
        position: absolute;
        right: 5px;
        bottom: 0;
        left: 5px;
        height: 80px;
        border: 1px solid rgba(214, 168, 75, 0.30);
        border-radius: 20px;
        background: linear-gradient( 145deg, rgba(214, 168, 75, 0.16), rgba(214, 168, 75, 0.05) );
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    }

        .change-password-lock-body > span {
            position: absolute;
            top: 27px;
            left: 50%;
            width: 11px;
            height: 24px;
            border-radius: 50% 50% 4px 4px;
            background: var(--cinema-gold-light);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.28);
            transform: translateX(-50%);
        }


    /* =====================================================
       ORBITS
       ===================================================== */

    .change-password-orbit {
        position: absolute;
        border: 1px solid rgba(214, 168, 75, 0.09);
        border-radius: 50%;
        animation: change-password-orbit 26s linear infinite;
    }

        .change-password-orbit::after {
            position: absolute;
            top: -5px;
            left: 50%;
            width: 9px;
            height: 9px;
            content: "";
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 18px rgba(214, 168, 75, 0.68);
        }

    .change-password-orbit-large {
        top: 90px;
        left: 50%;
        width: 320px;
        height: 320px;
        transform: translateX(-50%);
    }

    .change-password-orbit-small {
        top: 140px;
        left: 50%;
        width: 220px;
        height: 220px;
        animation-direction: reverse;
        animation-duration: 18s;
        transform: translateX(-50%);
    }


    /* =====================================================
       VISUAL COPY
       ===================================================== */

    .change-password-visual-copy {
        position: absolute;
        right: 2rem;
        bottom: 3.2rem;
        left: 2rem;
        z-index: 4;
        text-align: center;
    }

        .change-password-visual-copy > span {
            display: block;
            margin-bottom: 0.45rem;
            color: var(--cinema-gold-light);
            font-size: 0.55rem;
            font-weight: 900;
            letter-spacing: 0.16em;
        }

        .change-password-visual-copy strong {
            display: block;
            color: var(--cinema-text);
            font-size: 1.35rem;
        }

        .change-password-visual-copy p {
            max-width: 280px;
            margin: 0.55rem auto 0;
            color: var(--cinema-text-muted);
            font-size: 0.72rem;
            line-height: 1.6;
        }


    /* =====================================================
       CONTENT
       ===================================================== */

    .change-password-content {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 4rem);
        background: linear-gradient( 180deg, rgba(14, 19, 28, 0.99), rgba(8, 11, 17, 0.99) );
    }


    /* =====================================================
       BRAND
       ===================================================== */

    .change-password-brand {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.6rem;
        color: var(--cinema-text);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.17em;
    }

        .change-password-brand:hover {
            color: var(--cinema-gold-light);
        }

        .change-password-brand > span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cinema-gold);
            box-shadow: 0 0 0 5px rgba(214, 168, 75, 0.09), 0 0 18px rgba(214, 168, 75, 0.55);
        }


    /* =====================================================
       BACK
       ===================================================== */

    .change-password-back {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1.7rem;
        color: var(--cinema-text-muted);
        font-size: 0.7rem;
        font-weight: 600;
    }

        .change-password-back span {
            transition: transform var(--cinema-transition);
        }

        .change-password-back:hover {
            color: var(--cinema-gold-light);
        }

            .change-password-back:hover span {
                transform: translateX(-4px);
            }


    /* =====================================================
       HEADING
       ===================================================== */

    .change-password-heading {
        margin-bottom: 1.7rem;
    }

        .change-password-heading h1 {
            margin-bottom: 0.8rem;
            font-size: clamp( 2.2rem, 5vw, 3.2rem );
            line-height: 1.02;
            letter-spacing: -0.05em;
        }

        .change-password-heading p {
            max-width: 520px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: 0.82rem;
            line-height: 1.7;
        }


    /* =====================================================
       VALIDATION
       ===================================================== */

    .change-password-validation {
        margin-bottom: 1rem;
    }

        .change-password-validation:empty {
            display: none;
        }


    /* =====================================================
       SECTIONS
       ===================================================== */

    .change-password-section {
        padding: 0.2rem 0;
    }

    .change-password-section-header {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin-bottom: 1.1rem;
    }

        .change-password-section-header > span {
            display: grid;
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            place-items: center;
            color: var(--cinema-gold-light);
            border: 1px solid rgba(214, 168, 75, 0.18);
            border-radius: 10px;
            background: rgba(214, 168, 75, 0.055);
            font-size: 0.53rem;
            font-weight: 900;
        }

        .change-password-section-header
        strong {
            display: block;
            color: var(--cinema-text);
            font-size: 0.78rem;
        }

        .change-password-section-header
        small {
            display: block;
            margin-top: 0.08rem;
            color: var(--cinema-text-muted);
            font-size: 0.62rem;
        }

    .change-password-divider {
        height: 1px;
        margin: 1.4rem 0;
        background: linear-gradient( 90deg, transparent, var(--cinema-border-strong), transparent );
    }


    /* =====================================================
       INPUTS
       ===================================================== */

    .change-password-input-wrapper {
        position: relative;
    }

    .change-password-input {
        min-height: 52px;
        padding-left: 3rem;
    }

    .change-password-field {
        padding-right: 4.8rem;
    }

    .change-password-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 1rem;
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        color: var(--cinema-text-muted);
        font-size: 1.15rem;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .change-password-toggle {
        position: absolute;
        z-index: 3;
        top: 50%;
        right: 0.85rem;
        padding: 0.25rem 0.4rem;
        color: var(--cinema-text-muted);
        border: 0;
        border-radius: 6px;
        outline: 0;
        background: transparent;
        font-size: 0.55rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        transform: translateY(-50%);
        transition: color var(--cinema-transition), background-color var(--cinema-transition);
    }

        .change-password-toggle:hover {
