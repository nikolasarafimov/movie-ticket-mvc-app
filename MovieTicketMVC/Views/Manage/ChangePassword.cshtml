@model MovieTicketMVC.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Промени лозинка";
}

<main class="change-pass-page" aria-labelledby="change-pass-title">
    <div class="change-pass-shell">
        <aside class="change-pass-aside" aria-label="Безбедност на профилот">
            <div class="change-pass-aside-top">
                <span class="change-pass-small-line"></span>
                БЕЗБЕДНОСТ НА ПРОФИЛОТ
            </div>

            <div class="change-pass-aside-center">
                <div class="change-pass-lock-art" aria-hidden="true">
                    <div class="change-pass-orbit change-pass-orbit-large"></div>
                    <div class="change-pass-orbit change-pass-orbit-small"></div>
                    <div class="change-pass-lock-circle">
                        <svg width="74" height="74" viewBox="0 0 74 74" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M23 33V24a14 14 0 0 1 28 0v9" stroke="#F0CB76" stroke-width="4" stroke-linecap="round"/>
                            <rect x="16" y="31" width="42" height="34" rx="10" fill="#D6A84B" fill-opacity="0.12" stroke="#D6A84B" stroke-opacity="0.55" stroke-width="1.5"/>
                            <circle cx="37" cy="46" r="4" fill="#F0CB76"/>
                            <path d="M37 49v6" stroke="#F0CB76" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                    </div>
                </div>

                <h2>Заштити го она што е твое.</h2>
                <p>Ажурирај ја лозинката и задржи ја контролата врз твојот MovieTicket профил.</p>
            </div>

            <div class="change-pass-aside-bottom">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2 20 6v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4Z"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
                Безбедна промена на лозинка
            </div>
        </aside>

        <section class="change-pass-content" aria-labelledby="change-pass-title">
            <a href="@Url.Action("Index", "Manage")" class="change-pass-back">
                <span aria-hidden="true">←</span>
                Назад кон профилот
            </a>

            <header class="change-pass-heading">
                <div class="cinema-eyebrow">ПОСТАВКИ НА ПРОФИЛОТ</div>
                <h1 id="change-pass-title">Промени ја <span class="cinema-text-gradient">лозинката</span></h1>
                <p>Внеси ја тековната лозинка и постави нова за твојот профил.</p>
            </header>

            @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post,
                new { id = "changePasswordForm", @class = "change-pass-form", role = "form", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "change-pass-errors", role = "alert" })

                <div class="change-pass-group">
                    @Html.LabelFor(m => m.OldPassword, "Моментална лозинка", new { @class = "change-pass-label" })
                    <div class="change-pass-input-wrap">
                        @Html.PasswordFor(m => m.OldPassword, new
                        {
                            @class = "form-control change-pass-input",
                            id = "OldPassword",
                            autocomplete = "current-password",
                            placeholder = "Внеси ја моменталната лозинка",
                            aria_describedby = "oldPasswordHelp"
                        })
                        <button type="button" class="change-pass-toggle" data-password-target="OldPassword" aria-controls="OldPassword" aria-pressed="false" aria-label="Прикажи моментална лозинка">Прикажи</button>
                    </div>
                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "change-pass-field-error" })
                    <span id="oldPasswordHelp" class="change-pass-help">Лозинката што моментално ја користиш за најава.</span>
                </div>

                <div class="change-pass-divider" aria-hidden="true"></div>

                <div class="change-pass-group">
                    @Html.LabelFor(m => m.NewPassword, "Нова лозинка", new { @class = "change-pass-label" })
                    <div class="change-pass-input-wrap">
                        @Html.PasswordFor(m => m.NewPassword, new
                        {
                            @class = "form-control change-pass-input",
                            id = "NewPassword",
                            autocomplete = "new-password",
                            placeholder = "Креирај нова лозинка",
                            maxlength = "100",
                            aria_describedby = "passwordRules"
                        })
                        <button type="button" class="change-pass-toggle" data-password-target="NewPassword" aria-controls="NewPassword" aria-pressed="false" aria-label="Прикажи нова лозинка">Прикажи</button>
                    </div>
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "change-pass-field-error" })

                    <div class="change-pass-rules" id="passwordRules" aria-label="Услови за новата лозинка">
                        <div class="change-pass-rules-heading">
                            <span>Услови за лозинката</span>
                            <span id="changePassRuleCount" aria-live="polite">0 од 5</span>
                        </div>
                        <div class="change-pass-progress" role="progressbar" id="changePassProgress" aria-label="Исполнети услови за лозинката" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
                            <span id="changePassProgressFill"></span>
                        </div>
                        <div class="change-pass-rules-grid">
                            <span class="change-pass-rule" data-password-rule="length"><span aria-hidden="true">✓</span>8–100 знаци</span>
                            <span class="change-pass-rule" data-password-rule="upper"><span aria-hidden="true">✓</span>Голема буква</span>
                            <span class="change-pass-rule" data-password-rule="lower"><span aria-hidden="true">✓</span>Мала буква</span>
                            <span class="change-pass-rule" data-password-rule="digit"><span aria-hidden="true">✓</span>Број</span>
                            <span class="change-pass-rule" data-password-rule="special"><span aria-hidden="true">✓</span>Специјален знак</span>
                        </div>
                    </div>
                </div>

                <div class="change-pass-group change-pass-confirm-group">
                    @Html.LabelFor(m => m.ConfirmPassword, "Потврди ја новата лозинка", new { @class = "change-pass-label" })
                    <div class="change-pass-input-wrap">
                        @Html.PasswordFor(m => m.ConfirmPassword, new
                        {
                            @class = "form-control change-pass-input",
                            id = "ConfirmPassword",
                            autocomplete = "new-password",
                            placeholder = "Повтори ја новата лозинка",
                            maxlength = "100",
                            aria_describedby = "changePassMatch"
                        })
                        <button type="button" class="change-pass-toggle" data-password-target="ConfirmPassword" aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Прикажи потврда на лозинка">Прикажи</button>
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "change-pass-field-error" })
                    <div class="change-pass-match" id="changePassMatch" aria-live="polite"></div>
                </div>

                <div class="change-pass-actions">
                    <a href="@Url.Action("Index", "Manage")" class="btn btn-outline-secondary change-pass-cancel">Откажи</a>
                    <button type="submit" class="btn btn-primary change-pass-submit">
                        Промени лозинка
                        <span aria-hidden="true">→</span>
                    </button>
                </div>
            }

            <div class="change-pass-security-note">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 11v5M12 8h.01"/>
                </svg>
                <p>Користи единствена лозинка што не ја употребуваш на други веб-страници.</p>
            </div>
        </section>
    </div>
</main>

<style>
    .change-pass-page {
        width: 100%;
        min-width: 0;
    }

    .change-pass-shell {
        display: grid;
        grid-template-columns: minmax(280px, .78fr) minmax(0, 1.22fr);
        width: min(100%, 1100px);
        margin: 0 auto;
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: #0a0e15;
        box-shadow: var(--cinema-shadow-lg);
    }

    .change-pass-aside {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-width: 0;
        min-height: 645px;
        padding: clamp(2rem, 3.5vw, 3.1rem);
        overflow: hidden;
        isolation: isolate;
        border-right: 1px solid var(--cinema-border);
        background: radial-gradient(circle at 50% 45%, rgba(214,168,75,.12), transparent 45%), radial-gradient(circle at 5% 100%, rgba(57,96,154,.17), transparent 48%), linear-gradient(150deg, #172132, #0d1520 56%, #080c13);
    }

    .change-pass-aside::before {
        position: absolute;
        z-index: -1;
        inset: 0;
        content: "";
        opacity: .23;
        background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
        background-size: 46px 46px;
        pointer-events: none;
    }

    .change-pass-aside-top {
        display: flex;
        align-items: center;
        gap: .65rem;
        color: #efc774;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .11em;
    }

    .change-pass-small-line {
        width: 22px;
        height: 1px;
        background: #d6a84b;
    }

    .change-pass-aside-center {
        text-align: center;
    }

    .change-pass-lock-art {
        position: relative;
        display: grid;
        place-items: center;
        width: 210px;
        height: 210px;
        margin: 0 auto 1.65rem;
    }

    .change-pass-orbit {
        position: absolute;
        border: 1px solid rgba(214,168,75,.18);
        border-radius: 50%;
        pointer-events: none;
    }

    .change-pass-orbit-large {
        width: 205px;
        height: 205px;
    }

    .change-pass-orbit-small {
        width: 145px;
        height: 145px;
        border-color: rgba(214,168,75,.11);
    }

    .change-pass-orbit-large::after {
        position: absolute;
        top: 21px;
        right: 29px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d6a84b;
        box-shadow: 0 0 17px rgba(214,168,75,.7);
        content: "";
    }

    .change-pass-lock-circle {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 106px;
        height: 106px;
        border: 1px solid rgba(214,168,75,.19);
        border-radius: 28px;
        background: rgba(214,168,75,.04);
        box-shadow: 0 15px 50px rgba(0,0,0,.24);
    }

    .change-pass-aside-center h2 {
        max-width: 340px;
        margin: 0 auto .75rem;
        color: var(--cinema-text);
        font-size: clamp(1.65rem, 2.5vw, 2.05rem);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.2;
    }

    .change-pass-aside-center p {
        max-width: 310px;
        margin: 0 auto;
        color: var(--cinema-text-soft);
        font-size: .86rem;
        line-height: 1.75;
    }

    .change-pass-aside-bottom {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        color: #b9c7d0;
        font-size: .77rem;
        font-weight: 650;
    }

    .change-pass-aside-bottom svg {
        flex: 0 0 18px;
        color: #f0cb76;
    }

    .change-pass-content {
        min-width: 0;
        padding: clamp(2rem, 4vw, 3.1rem);
        background: linear-gradient(165deg, #0e141e, #090d14 75%);
    }

    .change-pass-back {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        margin-bottom: 1.85rem;
        color: var(--cinema-text-soft);
        font-size: .82rem;
        font-weight: 650;
        text-decoration: none;
    }

    .change-pass-back:hover {
        color: var(--cinema-gold-light);
    }

    .change-pass-heading {
        margin-bottom: 1.65rem;
    }

    .change-pass-heading h1 {
        margin: .65rem 0 .8rem;
        color: var(--cinema-text);
        font-size: clamp(2.15rem, 3.2vw, 3rem);
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -.05em;
    }

    .change-pass-heading h1 span {
        display: block;
    }

    .change-pass-heading p {
        max-width: 480px;
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: .9rem;
        line-height: 1.7;
    }

    .change-pass-form {
        width: 100%;
    }

    .change-pass-errors.validation-summary-valid,
    .change-pass-field-error.field-validation-valid {
        display: none;
    }

    .change-pass-errors.validation-summary-errors {
        margin-bottom: 1.4rem;
        padding: .9rem 1rem;
        border: 1px solid rgba(239,102,115,.3);
        border-radius: 12px;
        background: rgba(239,102,115,.075);
        color: #ffd4d8;
        font-size: .85rem;
        line-height: 1.6;
    }

    .change-pass-errors ul {
        margin: 0;
        padding-left: 1.15rem;
    }

    .change-pass-group {
        margin-bottom: 1.3rem;
    }

    .change-pass-label {
        display: block;
        margin-bottom: .55rem;
        color: var(--cinema-text);
        font-size: .85rem;
        font-weight: 750;
    }

    .change-pass-input-wrap {
        position: relative;
    }

    .change-pass-page .change-pass-input {
        width: 100%;
        min-height: 51px;
        padding: .8rem 6.5rem .8rem 1rem;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 11px;
        background: #131b27;
        color: #f5f7fb;
        font-size: .93rem;
        box-shadow: none;
    }

    .change-pass-page .change-pass-input::placeholder {
        color: #8995a6;
        opacity: 1;
    }

    .change-pass-page .change-pass-input:focus {
        border-color: rgba(240,203,118,.8);
        background: #151e2b;
        box-shadow: 0 0 0 3px rgba(214,168,75,.1);
        outline: 0;
    }

    .change-pass-toggle {
        position: absolute;
        top: 50%;
        right: .7rem;
        padding: .45rem .55rem;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: #e0c17b;
        font-size: .78rem;
        font-weight: 750;
        transform: translateY(-50%);
        cursor: pointer;
    }

    .change-pass-toggle:hover {
        background: rgba(214,168,75,.1);
        color: #f0cb76;
    }

    .change-pass-field-error.field-validation-error {
        display: block;
        margin-top: .35rem;
        color: #ff9da6;
        font-size: .78rem;
        line-height: 1.5;
    }

    .change-pass-help {
        display: block;
        margin-top: .45rem;
        color: var(--cinema-text-muted);
        font-size: .77rem;
    }

    .change-pass-divider {
        height: 1px;
        margin: 1.5rem 0;
        background: var(--cinema-border);
    }

    .change-pass-rules {
        margin-top: .9rem;
        padding: .9rem 1rem;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 12px;
        background: rgba(255,255,255,.018);
    }

    .change-pass-rules-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .6rem;
        color: #c4cad4;
        font-size: .78rem;
        font-weight: 700;
    }

    .change-pass-rules-heading span:last-child {
        color: #f0cb76;
        font-variant-numeric: tabular-nums;
    }

    .change-pass-progress {
        height: 4px;
        margin-bottom: .85rem;
        overflow: hidden;
        border-radius: 99px;
        background: rgba(255,255,255,.09);
    }

    .change-pass-progress > span {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: #d6a84b;
        transition: width .2s ease, background-color .2s ease;
    }

    .change-pass-progress.is-complete > span {
        background: #42c783;
    }

    .change-pass-rules-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .45rem .8rem;
    }

    .change-pass-rule {
        display: flex;
        align-items: center;
        gap: .45rem;
        color: #8792a4;
        font-size: .75rem;
    }

    .change-pass-rule > span {
        display: grid;
        flex: 0 0 17px;
        place-items: center;
        width: 17px;
        height: 17px;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 50%;
        color: transparent;
        font-size: .66rem;
    }

    .change-pass-rule.is-valid {
        color: #a2e9c0;
    }

    .change-pass-rule.is-valid > span {
        border-color: rgba(66,199,131,.35);
        background: rgba(66,199,131,.1);
        color: #a2e9c0;
    }

    .change-pass-confirm-group {
        margin-top: 1.45rem;
    }

    .change-pass-match {
        min-height: 0;
        margin-top: .35rem;
        font-size: .77rem;
    }

    .change-pass-match.is-valid {
        color: #a2e9c0;
    }

    .change-pass-match.is-invalid {
        color: #ff9da6;
    }

    .change-pass-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: .7rem;
        margin-top: 1.7rem;
        padding-top: 1.35rem;
        border-top: 1px solid var(--cinema-border);
    }

    .change-pass-actions .btn {
        min-height: 48px;
        font-size: .85rem;
        font-weight: 750;
    }

    .change-pass-submit {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        min-width: 200px;
    }

    .change-pass-security-note {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        margin-top: 1.2rem;
        padding: .85rem 1rem;
        border: 1px solid rgba(214,168,75,.15);
        border-radius: 12px;
        background: rgba(214,168,75,.04);
    }

    .change-pass-security-note svg {
        flex: 0 0 19px;
        color: #f0cb76;
    }

    .change-pass-security-note p {
        margin: 0;
        color: #b4bfcd;
        font-size: .77rem;
        line-height: 1.6;
    }

    .change-pass-page a:focus-visible,
    .change-pass-page button:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 3px;
    }

    @@media (max-width: 840px) {
        .change-pass-shell {
            grid-template-columns: minmax(0, 1fr);
            max-width: 630px;
        }

        .change-pass-aside {
            min-height: 0;
            padding: 1.6rem 2rem;
            border-right: 0;
            border-bottom: 1px solid var(--cinema-border);
        }

        .change-pass-aside-center,
        .change-pass-aside-bottom {
            display: none;
        }

        .change-pass-content {
            padding: 2rem;
        }
    }

    @@media (max-width: 520px) {
        .change-pass-shell {
            border-radius: var(--cinema-radius-lg);
        }

        .change-pass-aside {
            padding: 1.15rem 1.25rem;
        }

        .change-pass-content {
            padding: 1.65rem 1.2rem;
        }

        .change-pass-heading h1 {
            font-size: clamp(1.95rem, 8vw, 2.45rem);
        }

        .change-pass-rules-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .change-pass-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .change-pass-actions .btn {
            width: 100%;
        }

        .change-pass-submit {
            min-width: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .change-pass-progress > span {
            transition: none;
        }
    }
</style>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            "use strict";

            var newPassword = document.getElementById("NewPassword");
            var confirmPassword = document.getElementById("ConfirmPassword");
            var match = document.getElementById("changePassMatch");
            var ruleCount = document.getElementById("changePassRuleCount");
            var progress = document.getElementById("changePassProgress");
            var progressFill = document.getElementById("changePassProgressFill");

            var rules = {
                length: function (value) { return value.length >= 8 && value.length <= 100; },
                upper: function (value) { return /\p{Lu}/u.test(value); },
                lower: function (value) { return /\p{Ll}/u.test(value); },
                digit: function (value) { return /\p{Nd}/u.test(value); },
                special: function (value) { return /[^\p{L}\p{N}]/u.test(value); }
            };

            function updateMatch() {
                if (!newPassword || !confirmPassword || !match) {
                    return;
                }

                var value = confirmPassword.value;
                match.classList.remove("is-valid", "is-invalid");
                match.textContent = "";

                if (!value) {
                    return;
                }

                var equal = value === newPassword.value;
                match.classList.add(equal ? "is-valid" : "is-invalid");
                match.textContent = equal ? "Лозинките се совпаѓаат." : "Лозинките не се совпаѓаат.";
            }

            function updateRules() {
                if (!newPassword || !progress || !progressFill || !ruleCount) {
                    return;
                }

                var value = newPassword.value;
                var validCount = 0;
                var names = Object.keys(rules);

                names.forEach(function (name) {
                    var valid = rules[name](value);
                    var element = document.querySelector('[data-password-rule="' + name + '"]');

                    if (valid) {
                        validCount++;
                    }

                    if (element) {
                        element.classList.toggle("is-valid", valid);
                    }
                });

                ruleCount.textContent = validCount + " од 5";
                progress.setAttribute("aria-valuenow", String(validCount));
                progressFill.style.width = (validCount * 20) + "%";
                progress.classList.toggle("is-complete", validCount === 5);
                updateMatch();
            }

            document.querySelectorAll(".change-pass-toggle").forEach(function (button) {
                button.addEventListener("click", function () {
                    var input = document.getElementById(button.getAttribute("data-password-target"));

                    if (!input) {
                        return;
                    }

                    var reveal = input.type === "password";
                    input.type = reveal ? "text" : "password";
                    button.textContent = reveal ? "Сокриј" : "Прикажи";
                    button.setAttribute("aria-pressed", reveal ? "true" : "false");
                    button.setAttribute("aria-label", (reveal ? "Сокриј" : "Прикажи") + " лозинка");
                });
            });

            if (newPassword) {
                newPassword.addEventListener("input", updateRules);
            }

            if (confirmPassword) {
                confirmPassword.addEventListener("input", updateMatch);
            }

            updateRules();
        })();
    </script>
}