@using System
@model MovieTicketMVC.Models.ManageLoginsViewModel

@{
    ViewBag.Title = "Linked Accounts";

    var connectedCount = Model != null && Model.CurrentLogins != null
        ? Model.CurrentLogins.Count
        : 0;

    var availableCount = Model != null && Model.OtherLogins != null
        ? Model.OtherLogins.Count
        : 0;

    var canRemove = ViewBag.ShowRemoveButton == true;
    var statusMessage = Convert.ToString(ViewBag.StatusMessage);
    var isStatusWarning = statusMessage == "An error has occurred." ||
        statusMessage == "You cannot remove your only sign-in method.";

    if (statusMessage == "The external login was removed.")
    {
        statusMessage = "The linked account was successfully removed.";
    }
    else if (statusMessage == "An error has occurred.")
    {
        statusMessage = "An error occurred. Please try again.";
    }
    else if (statusMessage == "You cannot remove your only sign-in method.")
    {
        statusMessage = "You cannot remove your only sign-in method.";
    }
}

<main class="linked-page" aria-labelledby="linked-title">
    <section class="linked-hero" aria-labelledby="linked-title">
        <div class="linked-hero-copy">
            <a class="linked-back" href="@Url.Action("Index", "Manage")">
                <span class="linked-back-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5"></path>
                        <path d="m12 19-7-7 7-7"></path>
                    </svg>
                </span>
                <span>Back to Profile</span>
            </a>

            <div class="cinema-eyebrow linked-hero-eyebrow">
                SIGN-IN METHODS
            </div>

            <h1 id="linked-title">
                Linked <span class="cinema-text-gradient">Accounts</span>
            </h1>

            <p>
                Review external accounts connected to your MovieTicket
                account and manage additional sign-in methods.
            </p>

            <div class="linked-hero-facts" aria-label="Linked accounts overview">
                <span>
                    <strong>@connectedCount</strong>
                    @(connectedCount == 1 ? "linked account" : "linked accounts")
                </span>
                <span>
                    <strong>@availableCount</strong>
                    @(availableCount == 1 ? "available provider" : "available providers")
                </span>
            </div>
        </div>

        <div class="linked-hero-art" aria-hidden="true">
            <div class="linked-art-ring"></div>
            <svg viewBox="0 0 240 180" width="240" height="180" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="20" y="57" width="72" height="72" rx="21" fill="#D6A84B" fill-opacity=".10" stroke="#D6A84B" stroke-opacity=".42" />
                <path d="M40 95h32M56 79v32" stroke="#F0CB76" stroke-width="3" stroke-linecap="round" />
                <path d="M93 93h51" stroke="#D6A84B" stroke-opacity=".75" stroke-width="2" stroke-dasharray="5 7" />
                <rect x="145" y="57" width="72" height="72" rx="21" fill="#42C783" fill-opacity=".08" stroke="#42C783" stroke-opacity=".35" />
                <path d="m165 93 12 12 22-25" stroke="#9AE8BD" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="linked-feedback @(isStatusWarning ? "linked-feedback-warning" : "")"
             role="@(isStatusWarning ? "alert" : "status")">
            <span class="linked-feedback-icon" aria-hidden="true">@(isStatusWarning ? "!" : "✓")</span>
            <div>
                <strong>@(isStatusWarning ? "Attention Required" : "Changes Saved")</strong>
                <p>@statusMessage</p>
            </div>
        </div>
    }

    @if (connectedCount > 0)
    {
        <section class="linked-section" aria-labelledby="linked-current-title">
            <div class="linked-section-heading">
                <div>
                    <div class="cinema-eyebrow">ACTIVE CONNECTIONS</div>
                    <h2 id="linked-current-title">Connected Accounts</h2>
                </div>
                <p>These accounts can be used as additional sign-in methods.</p>
            </div>

            <div class="linked-list">
                @foreach (var account in Model.CurrentLogins)
                {
                    var providerName = string.IsNullOrWhiteSpace(account.LoginProvider)
                        ? "External Provider"
                        : account.LoginProvider;

                    <article class="linked-account-card">
                        <div class="linked-provider-icon" aria-hidden="true">
                            @providerName.Substring(0, 1).ToUpperInvariant()
                        </div>
                        <div class="linked-account-info">
                            <span class="linked-account-caption">SIGN-IN METHOD</span>
                            <h3>@providerName</h3>
                            <span class="linked-connected-label">
                                <span aria-hidden="true"></span>
                                Connected Account
                            </span>
                        </div>
                        <div class="linked-account-action">
                            @if (canRemove)
                            {
                                using (Html.BeginForm("RemoveLogin", "Manage", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("loginProvider", account.LoginProvider)
                                    @Html.Hidden("providerKey", account.ProviderKey)

                                    <button type="submit" class="btn btn-outline-danger linked-remove-button"
                                            aria-label="Remove connection to @providerName">
                                        Remove Connection
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="linked-cannot-remove">
                                    This is your only sign-in method and cannot be removed.
                                </span>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (availableCount > 0)
    {
        <section class="linked-section" aria-labelledby="linked-available-title">
            <div class="linked-section-heading">
                <div>
                    <div class="cinema-eyebrow">ADDITIONAL ACCESS</div>
                    <h2 id="linked-available-title">Link Another Account</h2>
                </div>
                <p>Select an available provider to add a new sign-in method.</p>
            </div>

            @using (Html.BeginForm("LinkLogin", "Manage", FormMethod.Post, new { @class = "linked-provider-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="linked-provider-grid">
                    @foreach (var provider in Model.OtherLogins)
                    {
                        var providerName = !string.IsNullOrWhiteSpace(provider.Caption)
                            ? provider.Caption
                            : provider.AuthenticationType;

                        <button type="submit" name="provider" value="@provider.AuthenticationType"
                                class="linked-provider-option"
                                aria-label="Link account using @providerName">
                            <span class="linked-provider-icon" aria-hidden="true">@providerName.Substring(0, 1).ToUpperInvariant()</span>
                            <span class="linked-provider-copy">
                                <strong>@providerName</strong>
                                <small>Link as an additional sign-in method</small>
                            </span>
                            <span class="linked-provider-arrow" aria-hidden="true">→</span>
                        </button>
                    }
                </div>
            }
        </section>
    }

    @if (connectedCount == 0 && availableCount == 0)
    {
        <section class="linked-empty" aria-labelledby="linked-empty-title">
            <div class="linked-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 56 56" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 34 34 22" />
                    <path d="M21 19h-3a10 10 0 0 0 0 20h9" />
                    <path d="M29 17h9a10 10 0 0 1 0 20h-3" />
                </svg>
            </div>
            <div class="cinema-eyebrow">EXTERNAL SIGN-IN</div>
            <h2 id="linked-empty-title">No Accounts Available to Link</h2>
            <p>
                No external sign-in providers, such as Google or Microsoft,
                are currently configured. You can continue using your
                MovieTicket account with your email address and password.
            </p>
            <a class="btn btn-outline-secondary linked-empty-button" href="@Url.Action("Index", "Manage")">
                <span aria-hidden="true">←</span>
                Back to Profile
            </a>
        </section>
    }
    else if (connectedCount == 0)
    {
        <section class="linked-empty linked-empty-compact" aria-labelledby="linked-empty-title">
            <div class="linked-empty-icon" aria-hidden="true">+</div>
            <h2 id="linked-empty-title">You Haven't Linked Any External Accounts Yet</h2>
            <p>Select one of the available providers to add a sign-in method.</p>
        </section>
    }

    <aside class="linked-security-note" aria-label="Security tip">
        <div class="linked-note-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 20 6v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </div>
        <div>
            <strong>Protect Your Account Access</strong>
            <p>
                Do not remove your only sign-in method. The system prevents
                removal if you have not set a password or linked another account.
            </p>
        </div>
    </aside>
</main>

<style>
    .linked-page {
        width: 100%;
        min-width: 0;
    }

    .linked-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 245px;
        align-items: center;
        gap: 1.5rem;
        min-height: 285px;
        padding: clamp(2rem, 4vw, 3.3rem);
        overflow: hidden;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient(circle at 85% 20%, rgba(214,168,75,.08), transparent 35%), linear-gradient(140deg, #151e2b, #0b111b 58%, #080c12);
        box-shadow: var(--cinema-shadow-lg);
    }

    .linked-hero-copy {
        position: relative;
        z-index: 2;
        min-width: 0;
    }

    .linked-back {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        width: fit-content;
        margin-bottom: 2rem;
        padding: 0.55rem 0.9rem 0.55rem 0.6rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.025);
        color: var(--cinema-text-soft);
        font-size: 0.8rem;
        font-weight: 650;
        text-decoration: none;
        transition: color 220ms ease, border-color 220ms ease, background 220ms ease;
    }

    .linked-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: rgba(214, 168, 75, 0.08);
        color: var(--cinema-gold-light);
        transition: transform 220ms ease;
    }

    .linked-back:hover {
        color: var(--cinema-gold-light);
        border-color: rgba(214, 168, 75, 0.3);
        background: rgba(214, 168, 75, 0.055);
        text-decoration: none;
    }

        .linked-back:hover .linked-back-icon {
            transform: translateX(-3px);
        }

    .linked-hero-eyebrow {
        display: flex;
        width: fit-content;
        margin-bottom: 0.5rem;
        color: var(--cinema-gold-light);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
    }

    .linked-hero h1 {
        margin: .85rem 0 1rem;
        font-size: clamp(2.5rem, 4.8vw, 4.6rem);
        line-height: 1.07;
        letter-spacing: -.055em;
        overflow-wrap: break-word;
    }

    .linked-hero-copy > p {
        max-width: 650px;
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: .96rem;
        line-height: 1.75;
    }

    .linked-hero-facts {
        display: flex;
        flex-wrap: wrap;
        gap: .65rem;
        margin-top: 1.3rem;
    }

        .linked-hero-facts > span {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .5rem .75rem;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 10px;
            background: rgba(255,255,255,.025);
            color: var(--cinema-text-soft);
            font-size: .79rem;
        }

        .linked-hero-facts strong {
            color: var(--cinema-gold-light);
            font-size: .97rem;
        }

    .linked-hero-art {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 190px;
        pointer-events: none;
    }

    .linked-art-ring {
        position: absolute;
        width: 205px;
        height: 205px;
        border: 1px solid rgba(214,168,75,.1);
        border-radius: 50%;
    }

    .linked-feedback {
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        margin-top: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(66,199,131,.22);
        border-radius: 14px;
        background: rgba(66,199,131,.055);
    }

    .linked-feedback-warning {
        border-color: rgba(246,200,95,.26);
        background: rgba(246,200,95,.06);
    }

    .linked-feedback-icon {
        display: grid;
        flex: 0 0 29px;
        place-items: center;
        width: 29px;
        height: 29px;
        border: 1px solid rgba(66,199,131,.27);
        border-radius: 50%;
        color: #9ae8bd;
        font-weight: 800;
    }

    .linked-feedback-warning .linked-feedback-icon {
        border-color: rgba(246,200,95,.35);
        color: #f0cb76;
    }

    .linked-feedback strong {
        color: var(--cinema-text);
        font-size: .9rem;
    }

    .linked-feedback p {
        margin: .1rem 0 0;
        color: var(--cinema-text-soft);
        font-size: .84rem;
    }

    .linked-section {
        margin-top: clamp(1.75rem, 3vw, 2.7rem);
    }

    .linked-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 1.1rem;
    }

        .linked-section-heading h2 {
            margin: .45rem 0 0;
            font-size: clamp(1.55rem, 3vw, 2.25rem);
        }

        .linked-section-heading > p {
            max-width: 380px;
            margin: 0;
            color: var(--cinema-text-muted);
            font-size: .83rem;
            line-height: 1.6;
            text-align: right;
        }

    .linked-list {
        display: grid;
        gap: .8rem;
    }

    .linked-account-card {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        padding: 1.2rem 1.4rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: linear-gradient(145deg, rgba(21,29,41,.95), rgba(9,13,20,.96));
    }

    .linked-provider-icon {
        display: grid;
        flex: 0 0 50px;
        place-items: center;
        width: 50px;
        height: 50px;
        border: 1px solid rgba(214,168,75,.25);
        border-radius: 14px;
        background: rgba(214,168,75,.06);
        color: var(--cinema-gold-light);
        font-size: 1.1rem;
        font-weight: 850;
    }

    .linked-account-caption {
        display: block;
        margin-bottom: .25rem;
        color: var(--cinema-text-muted);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .07em;
    }

    .linked-account-info h3 {
        margin: 0 0 .35rem;
        color: var(--cinema-text);
        font-size: 1.08rem;
    }

    .linked-connected-label {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: #98dfb5;
        font-size: .75rem;
    }

        .linked-connected-label > span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--cinema-success);
        }

    .linked-account-action form {
        margin: 0;
    }

    .linked-remove-button {
        min-height: 43px;
    }

    .linked-cannot-remove {
        display: block;
        max-width: 280px;
        color: var(--cinema-text-muted);
        font-size: .8rem;
        line-height: 1.6;
    }

    .linked-provider-form {
        margin: 0;
    }

    .linked-provider-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .85rem;
    }

    .linked-provider-option {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
        padding: 1.15rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: linear-gradient(145deg, rgba(21,29,41,.95), rgba(9,13,20,.97));
        color: var(--cinema-text);
        text-align: left;
        cursor: pointer;
        transition: border-color var(--cinema-transition), transform var(--cinema-transition);
    }

        .linked-provider-option:hover {
            border-color: rgba(214,168,75,.32);
            transform: translateY(-2px);
        }

    .linked-provider-copy {
        min-width: 0;
        flex: 1;
    }

        .linked-provider-copy strong,
        .linked-provider-copy small {
            display: block;
        }

        .linked-provider-copy strong {
            font-size: .98rem;
        }

        .linked-provider-copy small {
            margin-top: .3rem;
            color: var(--cinema-text-muted);
            font-size: .78rem;
            line-height: 1.4;
        }

    .linked-provider-arrow {
        color: var(--cinema-gold-light);
    }

    .linked-empty {
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        gap: 0;
        min-height: 245px;
        margin-top: 1.4rem;
        padding: clamp(1.8rem, 4vw, 3rem);
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-xl);
        background: radial-gradient(circle at 50% 0%, rgba(214,168,75,.045), transparent 40%), rgba(255,255,255,.013);
        text-align: center;
    }

    .linked-empty-icon {
        display: grid;
        place-items: center;
        width: 64px;
        height: 64px;
        margin-bottom: 1rem;
        border: 1px solid rgba(214,168,75,.2);
        border-radius: 18px;
        background: rgba(214,168,75,.06);
        color: var(--cinema-gold-light);
        font-size: 1.7rem;
    }

    .linked-empty h2 {
        margin: .5rem 0 .75rem;
        color: var(--cinema-text);
        font-size: clamp(1.4rem, 2.8vw, 2rem);
        line-height: 1.25;
    }

    .linked-empty p {
        max-width: 610px;
        margin: 0;
        color: var(--cinema-text-soft);
        font-size: .89rem;
        line-height: 1.75;
    }

    .linked-empty-button {
        display: inline-flex;
        align-items: center;
        gap: .7rem;
        margin-top: 1.3rem;
    }

    .linked-empty-compact {
        min-height: 170px;
    }

    .linked-security-note {
        display: flex;
        align-items: flex-start;
        gap: .9rem;
        margin-top: 1rem;
        padding: 1rem 1.2rem;
        border: 1px solid var(--cinema-border);
        border-radius: var(--cinema-radius-lg);
        background: rgba(255,255,255,.017);
    }

    .linked-note-icon {
        display: grid;
        flex: 0 0 38px;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 1px solid rgba(214,168,75,.2);
        border-radius: 11px;
        background: rgba(214,168,75,.05);
        color: var(--cinema-gold-light);
    }

    .linked-security-note strong {
        color: var(--cinema-text);
        font-size: .88rem;
    }

    .linked-security-note p {
        max-width: 830px;
        margin: .25rem 0 0;
        color: var(--cinema-text-muted);
        font-size: .8rem;
        line-height: 1.6;
    }

    .linked-page a:focus-visible,
    .linked-page button:focus-visible {
        outline: 2px solid var(--cinema-gold-light);
        outline-offset: 3px;
    }

    @@media (max-width: 900px) {
        .linked-hero {
            grid-template-columns: 1fr;
        }

        .linked-hero-art {
            display: none;
        }
    }

    @@media (max-width: 720px) {
        .linked-section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: .5rem;
        }

            .linked-section-heading > p {
                max-width: none;
                text-align: left;
            }

        .linked-account-card {
            grid-template-columns: 50px minmax(0, 1fr);
        }

        .linked-account-action {
            grid-column: 1 / -1;
            padding-top: .65rem;
            border-top: 1px solid var(--cinema-border);
        }

            .linked-account-action form,
            .linked-remove-button {
                width: 100%;
            }

        .linked-provider-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .linked-hero,
        .linked-empty {
            padding: 1.65rem 1.2rem;
            border-radius: var(--cinema-radius-lg);
        }

            .linked-hero h1 {
                font-size: clamp(2rem, 8.5vw, 3rem);
            }

        .linked-account-card {
            padding: 1rem;
        }

        .linked-security-note {
            padding: .85rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .linked-provider-option {
            transition: none;
        }

            .linked-provider-option:hover {
                transform: none;
            }
    }
</style>